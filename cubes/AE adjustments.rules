# RULE 0014
# Populate underlying cash account with data from cash flow cube
[{'current', 'parameter', 'efficiency dividend'}, status:'cash flow', spp:'-',movementaccount:'-', '9000701', jurisdiction:'-'] = N:
# TEST AA - If ID is to use NEW CF Derivation Cube
IF(DB('AE id details', !headline year, !scenario, !id, 'use new cash flow derivation') @= 'Y',
# TEST A - if account is a cash flow account and related entity is a dash
IF(!related entity @= '-'  & !outcome @= DIMNM('outcome', DIMIX('outcome', DB('AE id details', !headline year, !scenario, !id, 'outcome'))) &
# AND all other elements equal the ID details cube
!appropriation type @=  'A010' &
!reason @= DIMNM('reason', DIMIX('reason', DB('AE id details', !headline year, !scenario, !id, 'reason'))) &
!function @= DIMNM('function', DIMIX('function', DB('AE id details', !headline year, !scenario, !id, 'function'))) &
!programme @= DIMNM('programme', DIMIX('programme', DB('AE id details', !headline year, !scenario, !id, 'programme code'))) &
!measure code @= DIMNM('measure code', DIMIX('measure code', DB('AE id details', !headline year, !scenario, !id, 'measure'))) &
!appropriation item @= 'A010-00014-01436',
# TEST A - populate with data from the cash flow cube
DB('AE cash flow derivation', !headline year, !scenario, 'cash flow movement', !id, '9000701',!programme, 'Total', 'Total approp item', !related entity, !period, 'PL and BS data'),
# FALSE PART A - TEST PART B - Check if the adjustments are multiple (group) and ID is not any opening balance adjustments
IF ((DB('AE id details', !headline year, !scenario, !id, 'programme code') @= 'multiple' & (ELISANC('id', '00000', !ID) = 0)),
# TRUE PART B - populate with data from the cash flow cube
DB('AE cash flow derivation', !headline year, !scenario, 'cash flow movement', !id, '9000701',!programme, 'Total', !appropriation item, !related entity, !period, 'PL and BS data'),
# FALSEPART B - allow data entry
STET)),
IF(!related entity @= '-'  & !outcome @= DIMNM('outcome', DIMIX('outcome', DB('AE id details', !headline year, !scenario, !id, 'outcome'))) &
# AND all other elements equal the ID details cube
!appropriation type @=  'A010' &
!reason @= DIMNM('reason', DIMIX('reason', DB('AE id details', !headline year, !scenario, !id, 'reason'))) &
!function @= DIMNM('function', DIMIX('function', DB('AE id details', !headline year, !scenario, !id, 'function'))) &
!programme @= DIMNM('programme', DIMIX('programme', DB('AE id details', !headline year, !scenario, !id, 'programme code'))) &
!measure code @= DIMNM('measure code', DIMIX('measure code', DB('AE id details', !headline year, !scenario, !id, 'measure'))) &
!appropriation item @= 'A010-00014-01436',
# TEST A - populate with data from the cash flow cube
DB('AE cash flow', !headline year, !scenario, 'cash flow movement', !id, '9000701',!programme, 'Total', !related entity,'PL and BS data', !period),
# FALSE PART A - TEST PART B - Check if the adjustments are multiple (group) and ID is not any opening balance adjustments
IF ((DB('AE id details', !headline year, !scenario, !id, 'programme code') @= 'multiple' & (ELISANC('id', '00000', !ID) = 0)) ,
# TRUE PART B - populate with data from the cash flow cube
DB('AE cash flow', !headline year, !scenario, 'cash flow movement', !id, '9000701',!programme, 'Total',!related entity, 'PL and BS data', !period),
# FALSEPART B - allow data entry
STET)));

