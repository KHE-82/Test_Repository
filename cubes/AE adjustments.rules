# RULE 004A
# populate balance sheet values for ALL IDS (NEW FOR GEUS 2020)
[{'current', 'parameter', 'efficiency dividend'}, 'balance sheet data'] = N: roundp(
# TEST A - If period is not the first element in the dimension AND account is a bal sheet account that doesn't hold movement data
IF((DIMIX('period', !period) <> 1) & (ATTRS('account', !account, 'B/M') @= 'M'  & ELISANC ('id', '0BASE', !ID) = 0),
# TRUEPART A - get data from All IDs consolidation from the previous period
DB('AE adjustments', !headline year, !scenario, 'data', !outcome, !related entity, !function, !reason, !spp, !measure code, !appropriation type, !movement account, !appropriation item, !programme,
!account, !id, !jurisdiction, DIMNM('period', DIMIX('period', !period)-1))+
DB('AE adjustments', !headline year, !scenario, 'balance sheet data', !outcome, !related entity, !function, !reason, !spp, !measure code, !appropriation type, !movement account, !appropriation item, !programme,
!account, !id, !jurisdiction, DIMNM('period', DIMIX('period', !period)-1)),
# FALSEPART A - allow data entry
STET), 0);



