SKIPCHECK;
# Rule 0000
# Allow data entry
[{'0000-0000','Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'P0'}] = N: STET;
['Actual'] = N: STET;

# RULE 001
# Parameter
# Approp revenue for departmental programmes equals expense calculation
['parameter', 'data', '49800', '1280004', jurisdiction:'-'] = N:  roundp(
# TEST A - if account is to have parameter applied
IF(ELISANC('programme', 'Departmental programmes', !programme) = 1,
# TRUEPART A - data from the CURRENT scenario, multiplied by adjustment factor
# TEST B - if period is equal to the HL year
IF ((ATTRS('period', !period, 'type') @= 'annual') & !period @= DIMNM('period', DIMIX('period', SUBST(ATTRS('variables', 'headline year', 'value'), 3, 9)) -1),
# TRUEPART B
0,
# TESTPART C - IF ID is not applied parameters
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details', !headline year, 'current', !id, 'apply parameters') @= 'Y'),
# TRUE PART C - IF ID has parameters applied
['current', 'data', 'total related entity', movementaccount:'-', '1280004'] *
DB('index', !headline year, 'current', DB('programme details',!headline year,'current',!programme, 'parameter'), 'adjustment factor', !period),
# FALSE PART C - IF ID has parameters applied
0)),
# FALSEPART A - populate with zero
0), 0);

# Approp revenue for administered programmes equals expense calculation
['parameter', 'data', appropriationtype:'A001',appropriationitem:'A001-00001-05000','49800', '7593', '4100001'] = N:  roundp(
# TEST A - if account is to have parameter applied
IF(ELISANC('programme', 'Administered programmes', !programme) = 1,
# TRUEPART A - data from the CURRENT scenario, multiplied by adjustment factor
# TEST B - if period is equal to the HL year
IF ((ATTRS('period', !period, 'type') @= 'annual') & !period @= DIMNM('period', DIMIX('period', SUBST(ATTRS('variables', 'headline year', 'value'), 3, 9)) -1),
# TRUEPART B
0,
# TESTPART C - IF ID is not applied parameters
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details', !headline year, 'current', !id, 'apply parameters') @= 'Y'),
# TRUE PART C - IF ID has parameters applied
['current', 'data', '49800', movementaccount:'7593', '4100001'] *
DB('index', !headline year, 'current', DB('programme details',!headline year,'current',!programme, 'parameter'), 'adjustment factor', !period),
# FALSE PART C - IF ID has parameters applied
0)),
# FALSEPART A - populate with zero
0), 0);

# Appropriation Bill 1 Expense calculation
[appropriationtype:'A001',appropriationitem:'A001-00001-05000','parameter', 'data'] = N:  roundp(
# TEST A -  if period is equal to the HL year
IF ((ATTRS('period', !period, 'type') @= 'annual') & !period @= DIMNM('period', DIMIX('period', SUBST(ATTRS('variables', 'headline year', 'value'), 3, 9)) -1),
# TRUEPART A - Current Period is same as headline year
0,
# FALSE PART A - Not current period, so apply parameters
# TEST B - if account and ID is to have parameter applied and is an expense account and is within Administered Programmes
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details', !headline year, 'current', !id, 'apply parameters') @= 'Y') & (!account @=  DB('programme details', !headline year, 'current', !programme, 'parameter account')) & (!movement a
ccount @=  DB('programme details', !headline year, 'current', !programme, 'parameter movement account')) & (!related entity @= '-') & (ELISANC('programme', 'Administered programmes', !programme) = 1),
# TRUEPART B - Apply parameters on Administered Programmes
['parameter', 'data', movementaccount:'7593', '49800', '4100001', jurisdiction:'-'],
# FALSE PART B - Not Administered Programmes
# TEST C - if account and ID is to have parameter applied and is an expense account and is within Departmental Programmes
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details', !headline year, 'current', !id, 'apply parameters') @= 'Y') & (!account @=  DB('programme details', !headline year, 'current', !programme, 'parameter account')) & (!movement a
ccount @=  DB('programme details', !headline year, 'current', !programme, 'parameter movement account')) &  (!related entity @= '-') & ELISANC('programme', 'Departmental programmes', !programme) = 1,
# TRUEPART C - Programme is administered, copy from appropriations
['parameter', 'data', '49800', '1280004', jurisdiction:'-'],
# FALSEPART A - allow data entry
0))), 0);

