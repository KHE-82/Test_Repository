[{'current'}, status:'sys_user entered cash flow', spp:'-',movementaccount:'-', jurisdiction:'-', appropriationtype:'Appropriation Type - Unallocated',appropriationitem:'-'] = N:
# TEST A - if account is a cash flow account and related entity is a dash
IF(SUBST(!account, 1, 1) @= '6' & DB('AE id details', !headline year, !scenario, !id, 'disagree cashflow') @= 'Y' &
# AND all other elements equal the ID details cube
!outcome @= DIMNM('outcome', DIMIX('outcome', DB('AE id details', !headline year, !scenario, !id, 'outcome'))) &
!reason @= DIMNM('reason', DIMIX('reason', DB('AE id details', !headline year, !scenario, !id, 'reason'))) &
!function @= DIMNM('function', DIMIX('function', DB('AE id details', !headline year, !scenario, !id, 'function'))) &
!programme @= DIMNM('programme', DIMIX('programme', DB('AE id details', !headline year, !scenario, !id, 'programme code'))) &
!measure code @= DIMNM('measure code', DIMIX('measure code', DB('AE id details', !headline year, !scenario, !id, 'measure'))),
# TEST A - populate with data from the cash flow cube
DB('AE adjustments', !headline year, !scenario, 'data', !outcome, !related entity, !function, !reason, !SPP, !measure code, 'Total approp types', 'total movement', 'Total approp item', !programme, !account, !id, 'total jurisdictions', !period),
# FALSEPART A - allow data entry
STET);

# RULE 0999
# allow data entry to the following elements (placed here deliberately for rule order)
['data'] = N: STET;

FEEDERS;
# Internal Feeders
# RULE 001
# Parameter
['current', 'data'] => ['parameter', 'data'];
['parameter', 'data', '49800', '1280004'] => ['parameter', 'data', relatedentity:'-', '2230002'];
['parameter', 'data', 'total related entity', movementaccount:'-', '2000000', 'total jurisdictions'] => ['parameter', 'data', '49800', '7593', '4100001', jurisdiction:'-'];
['parameter', 'data', 'total related entity', movementaccount:'-', '2000000', 'total jurisdictions'] => ['parameter', 'data', relatedentity:'-', movementaccount:'-',  '1270030', jurisdiction:'-'];

# RULE 002
# Efficiency Dividend
['current', 'data'] => ['efficiency dividend', 'data'];

# RULE 003
# Allow data entry
# no feeder required

# RULE 004
# populate balance sheet values for ID 0000B
[{'current', 'parameter', 'efficiency dividend'}, 'Total IDs'] =>
DB('AE adjustments', !headline year, !scenario, !status, !outcome, !related entity, !function, !reason, !spp, !measure code, !appropriation type, !movement account, !appropriation item, !programme,
!account, '0000B', !jurisdiction, DIMNM('period', DIMIX('period', !period)+1));

# RULE 004A
# populate balance sheet values for all IDS
[{'current', 'parameter', 'efficiency dividend'}, 'New Adjustments', 'data'] =>
DB('AE adjustments', !headline year, !scenario, 'balance sheet data', !outcome, !related entity, !function, !reason, !spp, !measure code, !appropriation type, !movement account, !appropriation item, !programme,
!account, !id, !jurisdiction, DIMNM('period', DIMIX('period', !period)+1));

[{'current', 'parameter', 'efficiency dividend'}, 'New Adjustments', 'balance sheet data'] =>
DB('AE adjustments', !headline year, !scenario, 'balance sheet data', !outcome, !related entity, !function, !reason, !spp, !measure code, !appropriation type, !movement account, !appropriation item, !programme,
!account, !id, !jurisdiction, DIMNM('period', DIMIX('period', !period)+1));










# RULE 005
# replicate "data" status element against status element indicated against each ID in the ID details cube
