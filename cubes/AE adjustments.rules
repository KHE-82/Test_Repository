[relatedentity:'-', movementaccount:'-', '9000525', jurisdiction:'-'] = N:
['Total related entity', 'Total movement', '1000001', 'Total jurisdictions'] -
['Total related entity', 'Total movement', '1280004', 'Total jurisdictions'];

