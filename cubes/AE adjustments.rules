# RULE 0017
# Populate programme allocation accounts - Gross Cash Payments
[{'current', 'parameter', 'efficiency dividend'}, status:'data', relatedentity:'-', spp:'-', movementaccount:'-','9000510', jurisdiction:'-'] = N:
# Calculate programme cash from cash flow accounts
['Total related entity', 'Total movement', '6212000', 'Total jurisdictions'] +
['Total related entity', 'Total movement', '6221200', 'Total jurisdictions'] +
['Total related entity', 'Total movement', '6232000', 'Total jurisdictions'] -
['Total related entity', 'Total movement', '6212008', 'Total jurisdictions'];

