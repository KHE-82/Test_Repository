['Total related entity', 'Total movement', '6231000', 'Total jurisdictions'] -
#['Total related entity', 'Total movement', '6231010', 'Total jurisdictions'] -
['Total related entity', 'Total movement', '6211006', 'Total jurisdictions'] -
['Total related entity', 'Total movement', '6211007', 'Total jurisdictions'];

# RULE 0019
