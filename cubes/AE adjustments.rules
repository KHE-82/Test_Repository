# RULE 0999
# allow data entry to the following elements (placed here deliberately for rule order)
# no feeder required

# EXTERNAL FEEDERS;

# Feeder - Government Measures Rule - Expenses
['Total approved','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total approp types', 'Capital Measures', 'Total approp item', 'Departmental Programmes', '2000000', 'Total Ids', 'Total jurisdictions'] =>
DB('government measures',!headline year, !scenario, 'data', 'Departmental', 'Total Fund Type', 'Expenses', !measure code, !period, 'value');

['Total approved','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total approp types', 'Capital Measures', 'Total approp item', 'Administered Programmes', '2000000', 'Total Ids', 'Total jurisdictions'] =>
DB('government measures',!headline year, !scenario, 'data', 'Administered', 'Total fund type', 'Expenses', !measure code, !period, 'value');

# Feeder - Government Measures Rule - Revenue
['Total approved','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total approp types', 'Capital Measures', 'Total approp item', 'Departmental Programmes', 'Total Income Less Approps', 'Total Ids', 'Total jurisdic
tions'] =>
DB('government measures',!headline year, !scenario, 'data', 'Departmental', 'Total fund type', 'Revenue', !measure code, !period, 'value');

['Total approved','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total approp types', 'Capital Measures', 'Total approp item', 'Administered Programmes', 'Total Income Less Approps', 'Total Ids', 'Total jurisdic
tions'] =>
DB('government measures',!headline year, !scenario, 'data', 'Administered', 'Total fund type', 'Revenue', !measure code, !period, 'value');

# Feeder - Government Measures Rule - Capital
['Total approved','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP','Total approp types', 'Capital Measures', 'Total approp item', 'Departmental Programmes', '4100003', 'Total Ids', 'Total jurisdictions'] =>
DB('government measures',!headline year, !scenario, 'data', 'Departmental', 'Total fund type', 'Capital', !measure code, !period, 'value');

['Total approved','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total approp types', 'Capital Measures', 'Total approp item', 'Administered Programmes', '4100003', 'Total Ids', 'Total jurisdictions'] =>
DB('government measures',!headline year, !scenario, 'data', 'Administered', 'Total fund type', 'Capital', !measure code, !period, 'value');

# Feeder - cash flow cube - Rule 0010
['data', 'Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total Measures', 'Total approp types', 'Total approp item', 'Total Programmes', 'Total jurisdictions'] =>
DB('AE cash flow', !headline year, !scenario, !movement account, !id, IF(ATTRS('movement account', !movement account, 'cash flow map') @<> '', ATTRS('movement account', !movement account, 'cash flow map'),
ATTRS('account', !account, 'cash flow map')), !programme, !account,  !related entity, 'PL and BS data', !period);

# Feeder - cash flow cube - Rule 0004 - For SYSTEM DERIVED (NEW 2019)
['data', 'Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total Measures', 'Total approp types', 'Total approp item', 'Total programmes', 'Total jurisdictions'] =>
DB('AE cash flow', !headline year, !scenario, !movement account, !id, IF(ATTRS('movement account', !movement account, 'cash flow map') @<> '', ATTRS('movement account', !movement account, 'cash flow map'),
ATTRS('account', !account, 'cash flow map')), !programme, !account,  !related entity, 'system derived', !period);

# underlying cash
['data','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total Measures', 'Total approp types', 'Total approp item', 'Total Programmes', 'Total jurisdictions'] =>
DB('AE cash flow', !headline year, !scenario, !movement account, !id, '9000701',!programme, !account, !related entity, 'PL and BS data', !period);

# fiscal balance
['data','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', 'Total Measures', 'Total approp types', 'Total approp item', 'Total Programmes', 'Total jurisdictions'] =>
DB('AE cash flow', !headline year, !scenario, !movement account, !id, '9000702', !programme, !account, !related entity, 'PL and BS data', !period);



