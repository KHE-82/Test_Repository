#DB('AE adjustments',!status, !outcome, !function, !reason, !related entity,!spp,!measure code,!appropriation type,!movement account,!appropriation item,!programme,!account,!id,!jurisdiction,!period)
#DB('AE parameters and FE3 calculation',  !Programme, !spp, !account, !movement account, !related entity, !jurisdiction, !appropriation item, !measure code, !period, !AE parametes and FE3 calculation measure);
# MYEFO in the 'current budget round' value in the variable attribute is the trigger to determine which FE3 value to use (original value or the Total FE3 adjustment value)
SKIPCHECK;

# RULE 01
# Parameter
# Approp revenue for departmental programmes equals expense calculation
['49800', '1280004', movementaccount:'-',jurisdiction:'-','parameter value'] = N:  roundp(
# TEST A - if account is to have parameter applied
IF(ELISANC('programme', 'Departmental programmes', !programme) = 1,
# TRUEPART A - data from the CURRENT scenario, multiplied by adjustment factor
# TEST B - if period is equal to the HL year
IF ((ATTRS('period', !period, 'type') @= 'annual') & (!period @= DIMNM('period', DIMIX('period', SUBST(ATTRS('variables', 'headline year', 'value'), 3, 9)) -1) % (DB('}ElementAttributes_variables', 'current budget round', 'value') @= 'MYEFO') & DIMIX ('pe
riod', !period) >= DIMIX('period', ATTRS('variables', 'FE3 Period', 'value'))),
# TRUEPART B
STET,
# TESTPART C - IF ID is not applied parameters
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details',  DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', !id, 'apply parameters') @= 'Y'),
# TRUE PART C - IF ID has parameters applied
['total related entity', movementaccount:'-', '1280004', 'Parameters Calculation value'] *
DB('index', DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', DB('programme details', DB('}ElementAttributes_variables', 'headline year', 'value'),'current',!programme, 'parameter'), 'adjustment factor', !period),
# FALSE PART C - IF ID has parameters applied
STET)),
# FALSEPART A - populate with zero
STET), 0);

# Approp revenue for administered programmes equals expense calculation
['parameter value', '49800', '7593', '4100001', jurisdiction:'-'] = N:  roundp(
# TEST A - if account is to have parameter applied
IF(ELISANC('programme', 'Administered programmes', !programme) = 1 & (!appropriation item @= DB('programme details', DB('}ElementAttributes_variables', 'headline year', 'value'),'current', !programme, 'appropriation item')),
# TRUEPART A - data from the CURRENT scenario, multiplied by adjustment factor
# TEST B - if period is equal to the HL year
IF ((ATTRS('period', !period, 'type') @= 'annual') & (!period @= DIMNM('period', DIMIX('period', SUBST(ATTRS('variables', 'headline year', 'value'), 3, 9)) -1) % (DB('}ElementAttributes_variables', 'current budget round', 'value') @= 'MYEFO') & DIMIX ('pe
riod', !period) >= DIMIX('period', ATTRS('variables', 'FE3 Period', 'value'))),
# TRUEPART B
STET,
# TESTPART C - IF ID is not applied parameters
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details',  DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', !id, 'apply parameters') @= 'Y'),
# TRUE PART C - IF ID has parameters applied
['total related entity', movementaccount:'-', '2000000', 'Total jurisdictions', 'parameter value'],
# FALSE PART C - IF ID has parameters applied
STET)),
# FALSEPART A - populate with zero
STET), 0);


# Capital Budget Expense calculation
['parameter value', relatedentity:'-', movementaccount:'-', '9170000'] = N:  roundp(
# TEST A - if period is equal to the HL year
IF ((ATTRS('period', !period, 'type') @= 'annual') & (!period @= DIMNM('period', DIMIX('period', SUBST(ATTRS('variables', 'headline year', 'value'), 3, 9)) -1) % (DB('}ElementAttributes_variables', 'current budget round', 'value') @= 'MYEFO') & DIMIX ('pe
riod', !period) >= DIMIX('period', ATTRS('variables', 'FE3 Period', 'value'))),
# TRUE PART A - Leave Zero (0)
STET,
# FALSE PART A
# TESTPART B - IF ID is not applied parameters
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details',  DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', !id, 'apply parameters') @= 'Y') & (!appropriation item @= DB('programme details', DB('}ElementAttrib
utes_variables', 'headline year', 'value'),'current', !programme, 'appropriation item (DCB)')),
# TRUE PART B - IF ID has parameters applied
[relatedentity:'-', movementaccount:'-', 'Total approp item', '9170000', 'Parameters Calculation value'] *
DB('index', DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', DB('programme details', DB('}ElementAttributes_variables', 'headline year', 'value'),'current',!programme, 'parameter'), 'adjustment factor', !period),
# FALSEPART B - populate with zero
STET)), 0);

# Administered Expenses
['parameter value'] = N:  roundp(
# TEST A -  if period is equal to the HL year
IF ((ATTRS('period', !period, 'type') @= 'annual') & (!period @= DIMNM('period', DIMIX('period', SUBST(ATTRS('variables', 'headline year', 'value'), 3, 9)) -1) % (DB('}ElementAttributes_variables', 'current budget round', 'value') @= 'MYEFO') & DIMIX ('pe
riod', !period) >= DIMIX('period', ATTRS('variables', 'FE3 Period', 'value'))),
# TRUEPART A - Current Period is same as headline year
0,
# FALSE PART A - Not current period, so apply parameters
# TEST B - if account and ID is to have parameter applied and is an expense account and is within Administered Programmes
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details', DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', !id, 'apply parameters') @= 'Y') & ELISANC('account', '2000000', !account) = 1 & (ELISANC('programme',
 'Administered programmes', !programme) = 1),
# TRUEPART B - Apply parameters on Administered Programmes
['original value'] *
DB('index', DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', DB('programme details',DB('}ElementAttributes_variables', 'headline year', 'value') ,'current',!programme, 'parameter'), 'adjustment factor', !period),
# FALSE PART B - Not Administered Programmes
# TEST C - if account and ID is to have parameter applied and is an expense account and is within Departmental Programmes
IF(ATTRS('account', !account, 'apply parameter') @<> 'N' & (DB('AE id details', DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', !id, 'apply parameters') @= 'Y') &  (!account @= DB('programme details',DB('}ElementAttributes_variabl
es', 'headline year', 'value') ,'current',!programme, 'parameter account')) & (!related entity @= DB('programme details',DB('}ElementAttributes_variables', 'headline year', 'value') ,'current',!programme, 'parameter related entity'))  & ELISANC('programme
', 'Departmental programmes', !programme) = 1,
# TRUEPART C - Programme is administered, copy from appropriations
['parameter value', '49800', '1280004', movementaccount:'-',jurisdiction:'-'],
# FALSEPART A - allow data entry
CONTINUE))), 0);



