ers') @= 'Y') & DB('programme details',  DB('}ElementAttributes_variables', 'headline year', 'value'), 'current', !programme, 'efficiency dividend') @= 'Y' &  (!account @= DB('programme details',DB('}ElementAttributes_variables', 'headline year', 'value')
 ,'current',!programme, 'parameter account')) & (!related entity @= DB('programme details',DB('}ElementAttributes_variables', 'headline year', 'value') ,'current',!programme, 'parameter related entity'))  & ELISANC('programme', 'Departmental programmes', 
!programme) = 1,
# TRUEPART C - Programme is administered, copy from appropriations
['FE3 efficiency dividend value', '49800', '1280004', movementaccount:'-',jurisdiction:'-'],
# FALSEPART A - allow data entry
STET))), 0);

# RULE 003
# Opening Balances
# opening balances - entity accounts
# 4100001
[relatedentity:'No Related Entity', spp:'-', '7211', '4100001'] = N: roundp(
# TEST A - If period is not the first in the dimension AND ID is not 0000A
IF((ATTRS('period', !period, 'type') @= 'annual') & (DIMIX('period', !period) <> 1) & (!AE parameters and FE3 calculation measure @<> 'original value'),
# TRUEPART A - take closing balance from previous period
DB('AE parameters and FE3 calculation', !programme, 'Total SPP', '4100001', '7250', 'Total related entity', !jurisdiction, !appropriation item, !measure code, !id, DIMNM('period', DIMIX('period', !period)-1), !AE parameters and FE3 calculation measure),
# FALSEPART A - allow data entry
STET), 0);

