# TRUE PART A - sys_spp value derives from spp
DB('AE id details', !headline year, !scenario, !id, 'spp'),
# FALSE PART A - STET
STET);

# Rule 0013
['sys_appropriation item'] = S: IF (DB('AE id details', !headline year, !scenario, !id, 'appropriation item') @<> '',
# TRUE PART A - sys_appropriation item value derives from appropriation item
DB('AE id details', !headline year, !scenario, !id, 'appropriation item'),
