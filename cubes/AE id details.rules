DB('}ElementAttributes_reason',DB('AE id details', !headline year, !scenario, !id, 'reason'),'CBMS code and description'),
# FALSE PART A - STET
STET);

# Rule 0008
['sys_outcome'] = S: IF (DB('AE id details', !headline year, !scenario, !id, 'outcome') @<> '',
# TRUE PART A - sys_outcome value derives from outcome
DB('AE id details', !headline year, !scenario, !id, 'outcome'),
