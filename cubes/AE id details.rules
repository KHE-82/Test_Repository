FEEDSTRINGS;
SKIPCHECK;
# Rule 0000
# Set used element to zero for zero IDs
['0000A', 'used'] = N: 0;
['0000B', 'used'] = N: 0;
['00FBO', 'used'] = N: 0;

## Rule 00001
# Set Measure Code to be description of measure
['CBMS measure code'] = S:
# TEST PART A - See if ID is 0000A/00FBO/0000B
IF ((!id @= '0000A' & !id @<> '00FBO' & !id @<> '0000B'),
# TRUE PART A - STET
STET,
# FALSE PART A - DO ANOTHER CHECK TO SEE IF MEASURE IS NOT BLANK
# TEST PART B - SEE IF MEASURE IS NOT BLANK
IF(DB('AE id details', !headline year, !scenario, !id, 'measure') @<> '',
# TRUE PART B - MEASURE IS NOT BLANK, DERIVE VALUES FROM ATTRIBUTES
# TEST PART C - SEE IF MEASURE EXISTS
IF (DIMIX ('measure code', DB('AE id details', !headline year, !scenario, !id, 'measure')) <> 0,
# TRUE PART C - GET ATTRIBUTE
ATTRS ('measure code', DB('AE id details', !headline year, !scenario, !id, 'measure'), 'CBMS'),
# FALSE PART C - STET
DB('AE id details', !headline year, !scenario, !id, 'measure')),
# FALSE PART B - STET
STET));

## Rule 00002
# Set reason coe description
['reason description'] = S:
# TEST PART A - See if ID is 0000A/00FBO/0000B
IF ((!id @= '0000A' & !id @<> '00FBO' & !id @<> '0000B'),
# TRUE PART A - STET
STET,
# FALSE PART A - DO ANOTHER CHECK TO SEE IF reason IS NOT BLANK
# TEST PART B - SEE IF reason IS NOT BLANK
IF(DB('AE id details', !headline year, !scenario, !id, 'reason') @<> '',
# TRUE PART B - REASON IS NOT BLANK, DERIVE VALUES FROM ATTRIBUTES
# TEST PART C - SEE IF REASON EXISTS
IF (DIMIX ('reason', DB('AE id details', !headline year, !scenario, !id, 'reason')) <> 0,
# TRUE PART C - GET ATTRIBUTE
ATTRS ('reason', DB('AE id details', !headline year, !scenario, !id, 'reason'), 'CBMS'),
# FALSE PART C - STET
DB('AE id details', !headline year, !scenario, !id, 'reason')),
# FALSE PART B - STET
STET));

## Rule 00003
# Set APPROPRIATION TYPE description
['appropriation type description'] = S:
# TEST PART A - See if ID is 0000A/00FBO/0000B
IF ((!id @= '0000A' & !id @<> '00FBO' & !id @<> '0000B'),
# TRUE PART A - STET
STET,
# FALSE PART A - DO ANOTHER CHECK TO SEE IF APPROPRIATION TYPE IS NOT BLANK
# TEST PART B - SEE IF APPROPRIATION TYPE IS NOT BLANK
IF(DB('AE id details', !headline year, !scenario, !id, 'appropriation type') @<> '',
# TRUE PART B - APPROPRIATION TYPE IS NOT BLANK, DERIVE VALUES FROM ATTRIBUTES
# TEST PART C - SEE IF APPROPRIATION TYPE EXISTS
IF (DIMIX ('appropriation type', DB('AE id details', !headline year, !scenario, !id, 'appropriation type')) <> 0,
# TRUE PART C - GET ATTRIBUTE
ATTRS ('appropriation type', DB('AE id details', !headline year, !scenario, !id, 'appropriation type'), 'description'),
# FALSE PART C - STET
DB('AE id details', !headline year, !scenario, !id, 'appropriation tye')),
# FALSE PART B - STET
STET));

## Rule 00004
# Set APPROPRIATION TYPE description
['appropriation item description'] = S:
# TEST PART A - See if ID is 0000A/00FBO/0000B
IF ((!id @= '0000A' & !id @<> '00FBO' & !id @<> '0000B'),
# TRUE PART A - STET
STET,
# FALSE PART A - DO ANOTHER CHECK TO SEE IF appropriation item IS NOT BLANK
# TEST PART B - SEE IF appropriation item IS NOT BLANK
IF(DB('AE id details', !headline year, !scenario, !id, 'appropriation item') @<> '',
# TRUE PART B - appropriation item IS NOT BLANK, DERIVE VALUES FROM ATTRIBUTES
# TEST PART C - SEE IF appropriation item EXISTS
IF (DIMIX ('appropriation item', DB('AE id details', !headline year, !scenario, !id, 'appropriation item')) <> 0,
# TRUE PART C - GET ATTRIBUTE
ATTRS ('appropriation item', DB('AE id details', !headline year, !scenario, !id, 'appropriation item'), 'code and description'),
# FALSE PART C - STET
DB('AE id details', !headline year, !scenario, !id, 'appropriation tye')),
# FALSE PART B - STET
STET));

##### REQUIRED FOR NEW GEUS - 2019
# Rule 0001
['sys_headline year'] = S: IF (DB('AE id details', !headline year, !scenario, !id, 'used') <> 0, !headline year, STET);
['sys_scenario'] = S: IF (DB('AE id details', !headline year, !scenario, !id, 'used') <> 0, !scenario, STET);
['sys_ID'] = S: IF (DB('AE id details', !headline year, !scenario, !id, 'used') <> 0, !id, STET);

# Rule 0002
['sys_programme code'] = S: IF (DB('AE id details', !headline year, !scenario, !id, 'programme code') @<> '',
# TRUE PART A - sys_programme code value derives from programme code
DB('AE id details', !headline year, !scenario, !id, 'programme code'),
# FALSE PART A - STET
STET);

# Rule 0003
['sys_programme description'] = S: IF (DB('AE id details', !headline year, !scenario, !id, 'programme description') @<> '',
