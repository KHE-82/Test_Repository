
# DB('AE adjustments',!headline year,!scenario,!status,!outcome,!related entity,!function,!reason,!spp,!appropriation type,!movement account,!appropriation item,!programme,!account,!id,!jurisdiction,!period)
# RULE 0001
# Total Assets balances with total Liabilities and Equity
['001'] = N:
# TEST A - check that Account 4000000 = Account 5000000 - Account 3000000
IF(DB('AE adjustments',!headline year,!scenario,ATTRS('variables', 'Validation Status', 'value'),'Total outcomes','Total related entity','Total functions','Total reason',
'Total SPP','Total Measures','Total approp types','balance check','Total approp item','Total Programmes','4000000',!id,'Total jurisdictions',!period) -
DB('AE adjustments',!headline year,!scenario,ATTRS('variables', 'Validation Status', 'value'),'Total outcomes','Total related entity','Total functions','Total reason',
'Total SPP','Total Measures','Total approp types','balance check','Total approp item','Total Programmes','5000000',!id,'Total jurisdictions',!period) +
DB('AE adjustments',!headline year,!scenario,ATTRS('variables', 'Validation Status', 'value'),'Total outcomes','Total related entity','Total functions','Total reason',
'Total SPP','Total Measures','Total approp types','balance check','Total approp item','Total Programmes','3000000',!id,'Total jurisdictions',!period)+
DB('AE adjustments',!headline year,!scenario,ATTRS('variables', 'Validation Status', 'value'),'Total outcomes','Total related entity','Total functions','Total reason',
'Total SPP','Total Measures','Total approp types','balance check','Total approp item','Total Programmes','sys_ae_opening balances',!id,'Total jurisdictions',!period)=0,
# TRUEPART A - TESTB
0,
# FALSEPART A - populate with one
1);

# RULE 0002
# Transfers to / from Reserves in Equity = 0
['002'] = N:
