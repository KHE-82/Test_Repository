IF(DB('AE adjustments',!headline year,!scenario,ATTRS('variables', 'Validation Status', 'value'),'Total outcomes','Total related entity','Total functions','Total reason',
'Total SPP','Total Measures','Total approp types','7221','Total approp item','Total programmes','4100000',!id,'Total jurisdictions',!period)=0,
# TRUEPART A - populate with zero - OK. Account 4100000 equal to 0
0,
# FALSEPART B - Account 4100000 does not equal to 0
1);

