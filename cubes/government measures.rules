Skipcheck;

# Rule 0001
# Measure M00000 - Stet
['M00000'] =N :STET;

# Rule 0001
# Departmental Ongoing Expense Measures
['data','Expenses','ongoing','Departmental','value'] =N:
# TEST A - Check if Measure is Ongoing
IF (DB('government measures details', !headline year, !scenario, !measure code, 'funding life') @= 'ongoing',
# TRUE PART A - MEASURE IS ONGOING
DB('AE adjustments', !headline year, !scenario, 'Total approved','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', !measure code, 'Total approp types', '-', 'Total approp item', 'Departmental Programmes', '2000000',
 'Total Ids', 'Total jurisdictions', !period),
# FALSE PART A - MEASURE IS TERMINATING - STET
STET);

# Rule 0002
# Departmental Terminating Expense Measures
['data','Expenses','terminating','Departmental','value'] =N:
# TEST A - Check if Measure is Ongoing
IF (DB('government measures details', !headline year, !scenario, !measure code, 'funding life') @= 'terminating',
# TRUE PART A - MEASURE IS ONGOING
DB('AE adjustments', !headline year, !scenario, 'Total approved','Total outcomes', 'Total related entity', 'Total functions', 'Total reason', 'Total SPP', !measure code, 'Total approp types', '-', 'Total approp item', 'Departmental Programmes', '2000000',
 'Total Ids', 'Total jurisdictions', !period),
# FALSE PART A - MEASURE IS TERMINATING - STET
STET);

