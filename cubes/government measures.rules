# Rule 0025
# replicate "data" status element against status element indicated against each ID in the ID details cube
[scenario:'CBMS', 'Finance validated'] = N: [scenario:'CBMS', 'data'];

['draft',{'value','ASL'}] = N:
# TEST A - if status equals status on the ID in the ID details cube
IF(DB('government measures details', !headline year, !scenario, !measure code, 'status') @= 'draft',
# TRUEPART A - populate with data from the "data" status element
['data'] + [status:'cash flow'],
# FALSEPART A - populate with zero
0);

['business unit authorised',{'value','ASL'}] = N:
# TEST A - if status equals status on the ID in the ID details cube
IF(DB('government measures details', !headline year, !scenario, !measure code, 'status') @= 'business unit authorised',
# TRUEPART A - populate with data from the "data" status element
['data'] + [status:'cash flow'],
# FALSEPART A - populate with zero
0);

['approved',{'value','ASL'}] = N:
# TEST A - if status equals status on the ID in the ID details cube
IF(DB('government measures details', !headline year, !scenario, !measure code, 'status') @= 'approved',
# TRUEPART A - populate with data from the "data" status element
['data'] + [status:'cash flow'],
# FALSEPART A - populate with zero
0);

['approved non-flat file',{'value','ASL'}] = N:
# TEST A - if status equals status on the ID in the ID details cube
IF(DB('government measures details', !headline year, !scenario, !measure code, 'status') @= 'approved non-flat file',
# TRUEPART A - populate with data from the "data" status element
['data'] + [status:'cash flow'],
# FALSEPART A - populate with zero
0);

[status:'CBMS',{'value','ASL'}] = N:
# TEST A - if status equals status on the ID in the ID details cube
IF(DB('government measures details', !headline year, !scenario, !measure code, 'status') @= 'cbms',
# TRUEPART A - populate with data from the "data" status element
['data'] + [status:'cash flow'],
# FALSEPART A - populate with zero
0);

['agency authorised',{'value','ASL'}] = N:
# TEST A - if status equals status on the ID in the ID details cube
IF(DB('government measures details', !headline year, !scenario, !measure code, 'status') @= 'agency authorised',
# TRUEPART A - populate with data from the "data" status element
['data'] + [status:'cash flow'],
# FALSEPART A - populate with zero
0);

['submitted',{'value','ASL'}] = N:
# TEST A - if status equals status on the ID in the ID details cube
IF(DB('government measures details', !headline year, !scenario, !measure code, 'status') @= 'DOFA validated',
# TRUEPART A - populate with data from the "data" status element
['data'] + [status:'cash flow'],
# FALSEPART A - populate with zero
0);

['Finance validated',{'value','ASL'}] = N:
# TEST A - if status equals status on the ID in the ID details cube
IF(DB('government measures details', !headline year, !scenario, !measure code, 'status') @= 'DOFA validated',
# TRUEPART A - populate with data from the "data" status element
['data'] + [status:'cash flow'],
# FALSEPART A - populate with zero
0);

Feeders;
# Feeder - rule 0025
[scenario:'CBMS', 'data'] => [scenario:'CBMS', 'Finance validated'];
[{'data', 'cash flow'}] =>
['draft'],
['business unit authorised'],
['approved'],
['approved non-flat file'],
[status:'cbms'],
['submitted'],
['agency authorised'],
['finance validated'];
























































































































































































































































































































































































































