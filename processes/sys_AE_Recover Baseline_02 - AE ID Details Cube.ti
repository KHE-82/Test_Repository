#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE_Recover Baseline_02 - AE ID Details Cube
#**** DESCRIPTION:       This process creates of view of all data in the CURRENT scenario in the id details cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials      Comments
#****  ====              ======    =========
#**** 12/05/2014    KG           Initial Revision
#****  2019	KG	Updated for NEW GEUS
#***********************************************************************************************************************



#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

sHLYear = ATTRS(dmVar, 'archive year', 'old value');
sScenario = ATTRS(dmVar, 'archive scenario', 'old value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = sUser | '_$RecoverBaseline';
sSubset = sView;

#***********************************************************************************************************************
#--- STEP 1 - DELETE TARGET VIEW
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY(cbID, sView);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmIDMeas, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);

# ID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmID | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# ID Measure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmIDMeas | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbID, sView);

ViewSubsetAssign(cbID, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbID, sView, dmScenario, sSubset);
ViewSubsetAssign(cbID, sView, dmID, sSubset);
ViewSubsetAssign(cbID, sView, dmIDMeas, sSubset);


ViewExtractSkipZeroesSet (cbID, sView, 1);
ViewExtractSkipCalcsSet (cbID, sView, 1);
ViewExtractSkipRuleValuesSet (cbID, sView, 1);


#---------------------------------------------------------------------------------------------------------------------------
#--- ZERO OUT CUBE
#---------------------------------------------------------------------------------------------------------------------------
VIEWZEROOUT (cbID, sView);

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY(cbID, sView);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmIDMeas, sSubset);


#***********************************************************************************************************************
#--- STEP 2 - CREATE SOURCE VIEW
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY(cbID, sView);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmIDMeas, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

# ID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmID | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# ID Measure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmIDMeas | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbID, sView);

ViewSubsetAssign(cbID, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbID, sView, dmScenario, sSubset);
ViewSubsetAssign(cbID, sView, dmID, sSubset);
ViewSubsetAssign(cbID, sView, dmIDMeas, sSubset);


ViewExtractSkipZeroesSet (cbID, sView, 1);
ViewExtractSkipCalcsSet (cbID, sView, 1);
ViewExtractSkipRuleValuesSet (cbID, sView, 1);

#---------------------------------------------------------------------------------------------------------------------------
#--- DEFINE DATA SOURCE
#---------------------------------------------------------------------------------------------------------------------------
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

IF (CELLISUPDATEABLE (cbID, psTargetHLYear, psTargetScenario, vsID, vsMeas) = 1);
	IF (VALUE_IS_STRING=0);
          		CellPutN(NVALUE, cbID, psTargetHLYear, psTargetScenario, vsID, vsMeas);
     	ELSE;
		CellPutS(SVALUE, cbID, psTargetHLYear, psTargetScenario, vsID, vsMeas);
	ENDIF;
ENDIF;


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****



#---------------------------------------------------------------------------------------------------------------------------
#--- ZERO OUT SOURCE VIEW
#---------------------------------------------------------------------------------------------------------------------------
VIEWZEROOUT (cbID, sView);

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY(cbID, sView);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmIDMeas, sSubset);

#endregion