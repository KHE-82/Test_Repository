#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_AE Initial Load Baseline - 09 - Copy between different rounds - AE Adjustment
#**** DESCRIPTION:       This process creates a view of all data in the CURRENT scenario in the adjustments cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 12/05/2014    KG             Initial Revision
#****
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------
sHLYear = ATTRS(dmVar,'headline year','value');
sScenario = ATTRS(dmVar, 'headline scenario', 'value');

sHLYear = ATTRS(dmVar, 'archive year', 'old value');
sScenario = ATTRS(dmVar, 'archive scenario', 'old value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = '$Archive';
sSubset = sView;


#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbAE, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmID, sSubset);
SubsetDestroy(dmProg, sSubset);
SubsetDestroy(dmPer, sSubset);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);




#*****************************************************************************
# Programme
#*****************************************************************************
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].['| psTarProg | '] }, ALL, RECURSIVE )}, 0)}';
#MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].['| psTarProg | '] }, ALL, RECURSIVE )}, 0)}+{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].['| psSrcProg | '] }, ALL, RECURSIVE )}, 0)} ';

#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

#*****************************************************************************
# ID
#*****************************************************************************
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmID | '].['| psTargetID | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

#*****************************************************************************
# PERIOD
#*****************************************************************************
#MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmPer | '].['| psPeriod | '] }, ALL, RECURSIVE )}, 0)}';
MDX = '{union({['| dmPer |'].['| psPeriod |']:['| dmPer |'].[2045-2046]},{[period].[0000-0000]})}';
SUBSETCREATEBYMDX (sSubset, MDX);

#****BUILD VIEW****#
ViewCreate(cbAE, sView);

ViewSubsetAssign(cbAE, sView,dmHLYear, sSubset);
ViewSubsetAssign(cbAE, sView, dmScenario, sSubset);
ViewSubsetAssign(cbAE, sView,dmProg, sSubset);
ViewSubsetAssign(cbAE, sView, dmID, sSubset);
ViewSubsetAssign(cbAE, sView, dmPer, sSubset);

#ViewZeroOut(cbAE,sView);

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbAE, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmID, sSubset);
SubsetDestroy(dmProg, sSubset);
SubsetDestroy(dmPer, sSubset);


#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

#*****************************************************************************
# Programme
#*****************************************************************************
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].['| psSrcProg | '] }, ALL, RECURSIVE )}, 0)}';
#MDX = '{ [' | dmProg | '].['| psSrcProg | '] }';
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

#*****************************************************************************
# ID
#*****************************************************************************
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmID | '].['| psSourceID | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


#*****************************************************************************
# PERIOD
#*****************************************************************************
#MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmPer | '].['| psPeriod | '] }, ALL, RECURSIVE )}, 0)}';
MDX = '{union({['| dmPer |'].['| psPeriod |']:['| dmPer |'].[2045-2046]},{[period].[0000-0000]})}';
SUBSETCREATEBYMDX (sSubset, MDX);


#****BUILD VIEW****#
ViewCreate(cbAE, sView);

ViewSubsetAssign(cbAE, sView,dmHLYear, sSubset);
ViewSubsetAssign(cbAE, sView, dmScenario, sSubset);
ViewSubsetAssign(cbAE, sView,dmProg, sSubset);
ViewSubsetAssign(cbAE, sView, dmID, sSubset);
ViewSubsetAssign(cbAE, sView, dmPer, sSubset);


ViewSetSkipZeroes(cbAE, sView, 1);
ViewSetSkipCalcs(cbAE, sView, 1);
ViewExtractSkipRuleValuesSet(cbAE, sView,1);


DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#asciioutput('src.csv',cbAE, vsHLYear, vsScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc,vsID, vsJur, vsPeriod,numbertostring(vnValue));

IF( psClearTargetView@<>'');
	ItemSkip;
ENDIF;

vsStatus = 'data';

IF (CellisUpdateable(cbAE, psTargetHLYear, psTargetScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, psTarProg, vsAcc, psTargetID, vsJur, vsPeriod) = 1);

#asciioutput('data.csv',cbAE, psTargetHLYear, psTargetScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, psTarProg, vsAcc,psTargetID, vsJur, vsPeriod);
	CellIncrementN(vnValue,cbAE, psTargetHLYear, psTargetScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, psTarProg, vsAcc, psTargetID, vsJur, vsPeriod);
ENDIF;

IF (CellisUpdateable(cbAE, psSourceHLYear, psSourceScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psTargetID, vsJur, vsPeriod) = 1);

#asciioutput('data.csv',cbAE, psSourceHLYear, psSourceScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psTargetID, vsJur, vsPeriod);
	 CellPutN(vnValue*-1,cbAE, psSourceHLYear, psSourceScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psTargetID, vsJur, vsPeriod);
ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#ViewZeroOut(cbAE,sView);
#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbAE, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmID, sSubset);
SubsetDestroy(dmProg, sSubset);
SubsetDestroy(dmPer, sSubset);

#endregion