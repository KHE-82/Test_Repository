#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_ae favourites - create temp account id
#**** DESCRIPTION:       This process will create a temporary id for the account selected by the user
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 15/01/2014    KG             Initial Revision
#****
#***********************************************************************************************************************

#*** DECLARE CUBES & DIMENSIONS ***#
snProg = 'programme';
cbFav = 'Favourites';
dmFavID = 'favourites_id';
dmFavMeas = 'favourites_measure';
dmMAMap = '}movement account mapping';
sUserAttr = 'geus_temp_acc_id';

cbID = 'id details';

dmVar = 'variables';
dmClients = '}Clients';

#*** IF USER IS ADMIN, LEAVE AS IS ***#
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;


# *** TEMP ID USED FOR FAVOURITES
sTempID = sUser | '_Accounts';

IF ( DIMIX (dmFavID, sTempID) = 0);
     DIMENSIONELEMENTINSERT (dmFavID, '', sTempID, 'N');
ELSE;
     DIMENSIONELEMENTDELETE (dmFavID, sTempID);
     DIMENSIONELEMENTINSERT (dmFavID, '', sTempID, 'N');
ENDIF;


#endregion
