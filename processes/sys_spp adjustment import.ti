#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_spp adjustments import
#**** DESCRIPTION:       This process will create subsets in the account template for program
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#******************************************************************************************************************
#*** DECLARE SYS_SPP AGENCY MAPPING CUBES & DIMENSIONS
#******************************************************************************************************************
cbSppAg='sys_spp agency mapping';
dmHLyear = 'headline year';
dmScenario = 'scenario';
dmSpp = 'spp';
dmSysAg = 'sys_agency';
dmSppAgMeas = ' sys_spp agency mapping measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#--------------------------------------------------------------------------------------------------------------------------
#*** DIMENSION ATTRIBUTES
#--------------------------------------------------------------------------------------------------------------------------
dmReasonAttr = '}ElementAttributes_reason';
dmAccAttr = '}ElementAttributes_account';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
cbID = 'AE id details';
#---------------------------------------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
cbProg = snProg | ' details';
#---------------------------------------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE EXTRACT CUBE
cbProg = snProg | ' details';
#---------------------------------------------------------------------------------------------------------------------------
cbExtract = 'sys_push pumpkin';
dmRowID = 'sys_extract row id';
dmExtractMeas = cbExtract | ' measure';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';



#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
dmProg = ATTRS(dmVar, 'program dimension name', 'value');

#******************************************************************************************************************
#*** DECLARE AE ACCOUNT TEMPLATE MAPPING
#******************************************************************************************************************
cbAccTempMap = 'AE account template mapping';
dmAccTemp = 'account template';
IF (dmProg @= '');
	dmProg = 'programme';
ENDIF;
dmAccTempMapMeas = 'account template measure';


#******************************************************************************************************************
#*** DECLARE CLIENT GROUPS CUBE
#******************************************************************************************************************
cbGroups = '}ClientGroups';
dmGroups = '}Groups';


#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED
#******************************************************************************************************************
sPro = GETProcessName();
sView = sUser | '_' | sPro;

#******************************************************************************************************************
#*** DERIVED VALUE
#******************************************************************************************************************
sSPP = ATTRS(dmSpp,psSpp,'code and description');
sProg = ATTRS(dmProg, psSPP,'Treasury level 3 program');
sSysAg = ATTRS(dmSysAg, psSysAg, 'description');
sAgPBS = ATTRS(dmSPP, psSPP, 'agency PBS program');
sName =  ATTRS(dmSysAg, psSysAg, 'agency contact'); 
sNumber = ATTRS(dmSysAg,  psSysAg, 'contact number'); 
sEmail = ATTRS(dmSysAg,  psSysAg, 'contact email');



#*****************************************************************************
#*** CSV EXPORT
#*****************************************************************************
#sFilePath = ATTRS (dmVar, 'save location', 'value');
sFilePath='';
sFileName = sFilePath | '\' | psSysAg | ' - ' | psSPP | ' Adjustment Upload Template.csv';


nLineMeta = 0;

#****************************************************************
#******Meta Data ******#
#****************************************************************
asciioutput(sFileName,'SPP',sSPP);
asciioutput(sFileName,'Program Name',sProg);
asciioutput(sFileName,'Agency',sSysAg);
asciioutput(sFileName,'Agency PBS Program',sAgPBS);
asciioutput(sFileName,'Agency Contact',sName);
asciioutput(sFileName,'Contact Number',sNumber);
asciioutput(sFileName,'Contact Email',sEmail);


#****************************************************************
#******Blank Row******#
#****************************************************************
asciioutput(sFileName,'');

#****************************************************************
#******TITLE******#
#****************************************************************
asciioutput(sFileName, 'ADJUSTMENTS TO ESTIMATES','','','','','','Note: Please ensure numbers entered are whole numbers and avoid linking to external spreadsheets');

#****************************************************************
#******Blank Row******#
#****************************************************************
asciioutput(sFileName,'');


#****************************************************************
#******ADJUSTMENT TITLE******#
#****************************************************************
sYr01 = Dimnm(dmPer, Dimix(dmPer, ps1stYr));
sYr02 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+1);
sYr03 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+2);
sYr04 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+3);
sYr05 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+4);
sYr06 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+5);
sYr07 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+6);
sYr08 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+7);
sYr09 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+8);
sYr10 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+9);
sYr11 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+10);
sYr12 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+11);
sYr13 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+12);
sYr14 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+13);
sYr15 = Dimnm(dmPer, Dimix(dmPer, ps1stYr)+14);


asciioutput(sFileName, 'ADJ#','Reason Code','Measure Code','Adjustment Description','Authority','Account','Jurisdictin',sYr01,sYr02,sYr03,sYr04,sYr05,sYr06,sYr07,sYr08,sYr09,sYr10,syr11,sYr12,sYr13,sYr14,sYr15, 'Note');

#****************************************************************
#******THOUSAND DOLLOR SIGN******#
#****************************************************************

sThousand  = '$' | Char(39) | '000'; 
asciioutput(sFileName, '','','','','','','',sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand,sThousand);

#****************************************************************
#******ADJUSTMENT TABLE  - ADJ FIRST ROW******#
#****************************************************************

#*****************************************#
#------Loop ADJUSTMENT ID------#
#****************************************#
nAdjMax = 25;
nAdj = 1; 

WHILE(nAdj<=nAdjMax);
	sAdj = NumberTostring(nAdj);
	sAdjID = 'ADJ-' | FILL('0', 2-LONG(sAdj)) | sAdj;

	#********************************#
	#------Loop Jurisidiction------#
	#*******************************#
	nIndexAccTyp = 1;
	nLoopAccTyp = 2;

	WHILE( nIndexAccTyp <= nLoopAccTyp);
		IF( nIndexAccTyp = 1);
			sELAccTyp = 'Cash';
		ELSE;
			sELAccTyp = 'Accrual';
		ENDIF;
	
		#********************************#
		#------Loop Jurisidiction------#
		#********************************#
		nIndex = 3;
		nLoop = 10;

		WHILE( nIndex <= nLoop);

			sEL = DIMNM( dmJur,nIndex);
			asciioutput( sFileName,sAdjID,'','','','',sELAccTyp,sEL);
			nIndex = nIndex +1;
		END;

		nIndexAccTyp = nIndexAccTyp+1;
	END; 

	#****************************************************************
	#******Blank Row******#
	#****************************************************************
	asciioutput(sFileName,'');
	nAdj = nAdj+1;
END;




#endregion
