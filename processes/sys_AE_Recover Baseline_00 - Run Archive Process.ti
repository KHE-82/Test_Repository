#******************************************************************************************************************
#*** STEP 04 - POST VALUES IN VARIABLES
#******************************************************************************************************************


sOldHLYear = ATTRS (dmVar, 'headline year', 'old value');
sOldScenario = ATTRS (dmVar, 'headline scenario', 'old value');
sOldArcHLYear = ATTRS (dmVar, 'archive year', 'old value');
sOldArcScenario = ATTRS (dmVar, 'archive scenario', 'old value');

IF (psTargetScenario @= 'current');
	
	#--------------------------------------------------
	#--- ONL:Y WANT TO UPDATE VARIABLES IF TARGET SCENARIO IS CURRENT
	#--------------------------------------------------
	ATTRPUTS (psTargetHLYear, dmVar, 'headline year', 'value');
	ATTRPUTS (psTargetScenario, dmVar, 'headline scenario', 'value');

	ATTRPUTS (psSourceHLYear, dmVar, 'headline year', 'old value');
	ATTRPUTS (psSourceScenario, dmVar, 'headline scenario', 'old value');

	ATTRPUTS (sOldHLYear, dmVar, 'archive year', 'value');
	ATTRPUTS (sOldScenario, dmVar, 'archive scenario', 'value');

	ATTRPUTS (psCurrentRoundName, dmVar, 'current budget round', 'value');

	ATTRPUTS (psSourceHLYear, dmVar, 'archive year', 'old value');
	ATTRPUTS (psSourceScenario, dmVar, 'archive scenario', 'old value');
ENDIF;


#******************************************************************************************************************
#*** STEP 05 - CALL SET DEFAULT HEADLINE YEAR
#******************************************************************************************************************
IF (psTargetScenario @= 'current');
	sProcess = 'sys_Set Default Headline Year';
	EXECUTEPROCESS (sProcess);
ENDIF;

