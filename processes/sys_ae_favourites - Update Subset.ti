#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_ae_favourites - Update Subset
#**** DESCRIPTION:       This process will update a selected favourites
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 10/05/2014    KG             Initial Revision
#****
#***********************************************************************************************************************

#*** DECLARE CUBES & DIMENSIONS ***#
dmAcc = 'account';

dmClients = '}Clients';
# *** IDENTIFY CURRENT USER ***#
IF (psUser @= '');
     sUser = TM1User();
ELSE;
     sUser = psUser;
ENDIF;

#*** IF USER IS ADMIN, LEAVE AS IS ***#
IF (sUser @= 'Admin');
     sUser = sUser;
ELSE;
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     IF (sUser @<> '');
          lScan = SCAN('\',sUser) + 1;
          sUser = TRIM(SUBST(sUser, lScan, 100));
     ELSE;
          sUser = TM1User();
     ENDIF;
ENDIF;

#*** OTHER MEASURES AND SUBSETS USED

IF (SUBSETEXISTS (dmAcc, psSubset) = 1);
     IF (psDelete @= 'Y');
          SUBSETDESTROY (dmAcc, psSubset);
          SUBSETCREATE (dmAcc, psSubset);
          SUBSETELEMENTINSERT (dmAcc, psSubset, psAcc, 1);  
     ELSE;
           nSubSiz = SUBSETGETSIZE (dmAcc, psSubset);
           nIndex = nSubSiz + 1;
           SUBSETELEMENTINSERT (dmAcc, psSubset, psAcc, nIndex );  
     ENDIF;
     
ELSE;
     SUBSETCREATE (dmAcc, psSubset);
      nSubSiz = SUBSETGETSIZE (dmAcc, psSubset);
      nIndex = nSubSiz + 1;
      SUBSETELEMENTINSERT (dmAcc, psSubset, psAcc, nIndex );  
ENDIF;


#endregion
