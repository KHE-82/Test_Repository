#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_spp agency subsets
#**** DESCRIPTION:       This process will create subsets in the account template for program
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#******************************************************************************************************************
#*** DECLARE SYS_SPP AGENCY MAPPING CUBES & DIMENSIONS
#******************************************************************************************************************
cbSppAg='sys_spp agency mapping';
dmHLyear = 'headline year';
dmScenario = 'scenario';
dmSpp = 'spp';
dmSysAg = 'sys_agency';
dmSppAgMeas = ' sys_spp agency mapping measure';

cbProg = 'programme details';
dmPRog= 'programme';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
dmProg = ATTRS(dmVar, 'program dimension name', 'value');

#******************************************************************************************************************
#*** DECLARE AE ACCOUNT TEMPLATE MAPPING
#******************************************************************************************************************
cbAccTempMap = 'AE account template mapping';
dmAccTemp = 'account template';
IF (dmProg @= '');
	dmProg = 'programme';
ENDIF;
dmAccTempMapMeas = 'account template measure';


#******************************************************************************************************************
#*** DECLARE CLIENT GROUPS CUBE
#******************************************************************************************************************
cbGroups = '}ClientGroups';
dmGroups = '}Groups';


#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED
#******************************************************************************************************************
sView = sUser | '_$AccTempSubset01';


#***********************************************************************************************************************
#--- STEP 1 - CREATE SOURCE VIEW
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbSppAg, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmSpp, sView);
SUBSETDESTROY (dmSysAg, sView);
SUBSETDESTROY (dmSppAgMeas, sView);


#---------------------------------------------------------------------------------------------------------------------------
#*** CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# Headline Year
SubsetCreate(dmHLYear, sView);
SubsetElementInsert(dmHLYear, sView, curHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sView);
SubsetElementInsert(dmScenario, sView, curScenario, 1);

#SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

#Sys Agency
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSysAg | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# SPP Agency Measure
SubsetCreate(dmSppAgMeas, sView);
SubsetElementInsert(dmSppAgMeas, sView, 'flag', 1);


#---------------------------------------------------------------------------------------------------------------------------
#---- BUILD VIEW 
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate (cbSppAg, sView);
ViewSubsetAssign (cbSppAg, sView, dmHLYear, sView);
ViewSubsetAssign (cbSppAg, sView, dmScenario, sView);
ViewSubsetAssign (cbSppAg, sView, dmSpp, sView);
ViewSubsetAssign (cbSppAg, sView, dmSysAg, sView);
ViewSubsetAssign (cbSppAg, sView, dmSppAgMeas, sView);


ViewExtractSkipZeroesSet (cbSppAg, sView, 1);
ViewExtractSkipCalcsSet (cbSppAg, sView, 1);
ViewExtractSkipRuleValuesSet (cbSppAg, sView, 1);

#---------------------------------------------------------------------------------------------------------------------------
#--- DEFINE DATA SOURCE
#---------------------------------------------------------------------------------------------------------------------------
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#asciioutput('source.csv', vsHLyear,vsScenario,vsSpp, vsAg,vsMeas, numbertostring(vnValue));

sAg = ATTRS(dmSysAg,vsAg,'description');

sSub = 'sys_' | sAg;

IF( SubSetExists(dmSpp, sSub) = 1);
	SubSetDestroy(dmSpp, sSub);
	SubSetCreate(dmSpp,sSub);
ELSE;
	SubSetCreate(dmSpp,sSub);
ENDIF;


#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

sAg = ATTRS(dmSysAg,vsAg,'description');

sSub = 'sys_' | sAg;

nSubsetSize = SUBSETGETSIZE (dmSpp, sSub);
nSubsetSize = nSubsetSize + 1;

IF (vnValue = 1);
	SUBSETELEMENTINSERT (dmSpp, sSub, vsSpp, nSubsetSize);
ENDIF;


#one-off #
#IF( DIMIX(dmProg, vsSpp) <>0);
#	CELLPUTS( sAg, cbProg, vsHLYear, vsScenario,vsSpp,'agency');
#ENDIF;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbSppAg, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmSpp, sView);
SUBSETDESTROY (dmSysAg, sView);
SUBSETDESTROY (dmSppAgMeas, sView);
#endregion