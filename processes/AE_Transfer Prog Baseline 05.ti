#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Transfer Prog Baseline 05
#**** DESCRIPTION:       This process uses the created view from process 01 and then adds data to the adjustment cube to clear the Source Program
#****
#****                                  It takes parameters from the form
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 25/03/2015    KG             Initial Revision
#****
#***********************************************************************************************************************

dmVar = 'Variables';
sSrcID = 'SrcProgID';
sTarID = 'TarProgID';

cbID = 'AE id details';
sHLYear = ATTRS ('variables', 'headline year', 'value');
sScenario = 'current';
sIDMeas = 'status';
sStatus = 'unauthorised';

cbClient = 'sys_client preference';

#****Change New adjustments to "unauthoised" stage for SrcProg ****# 
sVarMeas = sSrcID;
sIDString = CELLGETS ( cbClient, psUser, sVarMeas, 'Value');
sChar = '|';

IF( sIDString @='');
	ITEMSKIP;
ENDIF;

nString = LONG(sIDString);
nChar = SCAN(sChar, sIDString);

WHILE ( nChar > 0);
	sID = SUBST(sIDString,nChar-5,5);
	CELLPUTS(sStatus, cbID, sHLYear, sScenario, sID, sIDMeas);
	#Asciioutput( 'ID Check.csv', sID);
	sIDString =  DELET( sIDString, 1, nChar);
	nChar = SCAN(sChar, sIDString);
END;

#**** Last one String without '|"  as PreFix****
sID = sIDString;
CELLPUTS(sStatus, cbID, sHLYear, sScenario, sID, sIDmeas);
#Asciioutput( 'ID Check.csv', sID);



#****Change New adjustments to "unauthoised" stage for TarProg ****# 
sVarMeas = sTarID;
sIDString = CELLGETS ( cbClient, psUser, sVarMeas, 'Value');
sChar = '|';

IF( sIDString @='');
	ITEMSKIP;
ENDIF;

nString = LONG(sIDString);
nChar = SCAN(sChar, sIDString);

WHILE ( nChar > 0);
	sID = SUBST(sIDString,nChar-5,5);
	CELLPUTS(sStatus, cbID, sHLYear, sScenario, sID, sIDMeas);
	#Asciioutput( 'ID Check.csv', sID);
	sIDString =  DELET( sIDString, 1, nChar);
	nChar = SCAN(sChar, sIDString);
END;

#**** Last one String without '|"  as PreFix****
sID = sIDString;
CELLPUTS(sStatus, cbID, sHLYear, sScenario, sID, sIDMeas);
#Asciioutput( 'ID Check.csv', sID);


#***CLEAR ID STRINGS ****# 
sPrc = 'sys_Client - Clear Client Preference Data';

EXECUTEPROCESS(sPrc, 'psUser', psUser);

#endregion
