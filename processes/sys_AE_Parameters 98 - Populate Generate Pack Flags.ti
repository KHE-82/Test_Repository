#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               sys_AE_Parameters 98 - Populate Generate Pack Flags
#**** DESCRIPTION:       This process clears the Y Flags in the programme details cube
#****
#****                                  
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 27/10/2014    KG             Initial Revision
#**** 2019	KG	Update for NEW GEUS
#****
#***********************************************************************************************************************

#******************************************************************************************************************
#**** DECLARE CUBES ****#
#******************************************************************************************************************
snProg = 'programme';
sCube = snProg | ' details';

#******************************************************************************************************************
#*** DECLARE DIMENSIONS ***#
#******************************************************************************************************************
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmProg = snProg;
dmMeas = snProg | ' measure';

#******************************************************************************************************************
#*** DECLARE SYSTEM DIMENSIONS ***# 
#******************************************************************************************************************
dmVar = 'variables';
dmClients = '}Clients';

#******************************************************************************************************************
#**** DECLARE VARIABLES ****#
#******************************************************************************************************************
sView = '$CreateReportFlag';
sSubset = sView;

sHLYear = ATTRS (dmVar, 'headline year', 'value');
sScenario = 'current';
sMeas = 'Generate parameter pack';

#*************************************************************************************************************************************************
#****STEP 1 - DELETE EXISTING FLAGS
#*************************************************************************************************************************************************

#******************************************************************************************************************
#****DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
ViewDestroy (sCube, sView);
SubsetDestroy (dmHLYear, sSubset);
SubsetDestroy (dmScenario, sSubset);
SubsetDestroy (dmProg, sSubset);
SubsetDestroy (dmMeas, sSubset);

#******************************************************************************************************************
#****CREATE SUBSETS****#
#******************************************************************************************************************
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, sHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, sScenario, 1);

# Programme
MDX = '{TM1SUBSETALL( [' | dmProg | '] )}';
#MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmProg | '].[' | psProg | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme Measure
SubsetCreate(dmMeas, sSubset);
SubsetElementInsert(dmMeas, sSubset, sMeas, 1);


#******************************************************************************************************************
#****BUILD VIEW****#
#******************************************************************************************************************
ViewCreate (sCube, sView);
ViewSubsetAssign (sCube, sView, dmHLYear, sSubset);
ViewSubsetAssign (sCube, sView, dmScenario, sSubset);
ViewSubsetAssign (sCube, sView, dmProg, sSubset);
ViewSubsetAssign (sCube, sView, dmMeas, sSubset);

VIEWZEROOUT (sCube, sView);

#******************************************************************************************************************
#****DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
ViewDestroy (sCube, sView);
SubsetDestroy (dmHLYear, sSubset);
SubsetDestroy (dmScenario, sSubset);
SubsetDestroy (dmProg, sSubset);

#*************************************************************************************************************************************************
#****STEP 2 - CREATE SOURCE VIEW
#*************************************************************************************************************************************************


#******************************************************************************************************************
#****DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
ViewDestroy (sCube, sView);
SubsetDestroy (dmHLYear, sSubset);
SubsetDestroy (dmScenario, sSubset);
SubsetDestroy (dmProg, sSubset);

#******************************************************************************************************************
#****CREATE SUBSETS****#
#******************************************************************************************************************
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, sHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, sScenario, 1);

# Programme
#MDX = '{TM1SUBSETALL( [' | dmProg | '] )}';
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmProg | '].[' | psProg | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);



#******************************************************************************************************************
#****BUILD VIEW****#
#******************************************************************************************************************
ViewCreate (sCube, sView);
ViewSubsetAssign (sCube, sView, dmHLYear, sSubset);
ViewSubsetAssign (sCube, sView, dmScenario, sSubset);
ViewSubsetAssign (sCube, sView, dmProg, sSubset);


DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;



#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


sMeas = 'Generate parameter pack';


#*** POPULATE CUBE WITH 'Y' IN THE FLAGS
IF (vsValue @<> '');
	CELLPUTS ('Y', sCube, vsHLYear, vsScenario, vsProg, sMeas);
ENDIF;



     

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy (sCube, sView);
SubsetDestroy (dmHLYear, sSubset);
SubsetDestroy (dmScenario, sSubset);
SubsetDestroy (dmProg, sSubset);

#endregion