#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_AE_NewZeroID_11 - AE Grp Adj Cube - Load new opening baseline
#**** DESCRIPTION:       This process creates a view of the newly archived scenario in the adjustments cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 12/05/2014    KG             Initial Revision
#**** 2019	KG	  Updated for NEW GEUS
#***********************************************************************************************************************
#  
#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GROUP ADJUSTMENT ENTRY CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbGrp = 'AE group adjustment entry';
dmAccType = 'account type';
dmAccTemp = 'account template';
dmGrpMeas = 'group adjustment measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sHLYear = ATTRS(dmVar, 'headline year', 'value');
sScenario = 'current';
sID = '0000A';
sNewStatus = 'data';
#sNewReason = 'Other';
sNewReason = 'Other variations not elsewhere defined';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SOURCE VIEWS
#---------------------------------------------------------------------------------------------------------------------------

sView = '$NewBaseline';
sSubset = sView;

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** DATA ENTRY TO AE GROUP ADJUSTMENT ENTRY CUBE ***#

IF (CELLISUPDATEABLE (cbGrp, psTargetHLYear, psTargetScenario, sNewStatus, vsRE, vsMeasCode, vsProg, vsAccType, vsAccTemp, sID, vsJur, vsPeriod, vsGrpMeas) = 1);
	OldValue = CELLGETN (cbGrp, psTargetHLYear, psTargetScenario, sNewStatus, vsRE, vsMeasCode, vsProg, vsAccType, vsAccTemp, sID, vsJur, vsPeriod, vsGrpMeas);
	CELLPUTN (OldValue + Value, cbGrp, psTargetHLYear, psTargetScenario, sNewStatus, vsRE, vsMeasCode, vsProg, vsAccType, vsAccTemp, sID, vsJur, vsPeriod, vsGrpMeas);
ENDIF;



#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbGrp, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAccType, sSubset);
SUBSETDESTROY (dmAccTemp, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);
SUBSETDESTROY (dmGrpMeas, sSubset);
#endregion