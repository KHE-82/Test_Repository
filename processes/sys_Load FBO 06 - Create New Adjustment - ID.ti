#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_Load FBO 06 - Create New Adjustment - ID
#**** DESCRIPTION:       
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** July  2023           EC             Initial Revision
#**** 22/08/2024	KG	  Updated process to use Total Consolidations in SOURCE VIEW
#****
#***********************************************************************************************************************

#*** DECLARE CUBES AND DIMENSIONS ***#
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

cbID = 'ae id details';

cbProg = snProg | ' details';
dmProg = snProg;

#*** DECLARE SYSTEM VARIABLES
dmClient = '}Clients';
dmVar = 'variables'; 
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');


sCube = cbAE;


#sSourceStatus = 'Total approved';
sSourceStatus = 'data';
#sSourceID = 'Total IDs';
sSourceID = '00FBO';
sSourceReason = 'Total reason';
sSourceMeasCode = 'Total Measures';
sSourceAcc = '3800001';
sSourceMA = 'Total movement';

sSourceOC = 'Total outcomes';
sSourceFunc = 'Total functions';
sSourceType = 'Total approp types';
sSourceItem = 'Total approp item';

sSourceType = 'Total approp types';
sSourceItem = 'Total approp item';

sTargetStatus = 'data';
sTargetID = '00FBO';
sTargetReason = 'Other variations not elsewhere defined';
sTargetMeasCode = 'M00000';
sTargetAcc = '4100001';
sTargetMA = '7205';

nStartPerIndex = DIMIX (dmPer, psPeriod);
nChd = ELCOMPN(dmPer, 'Total years');
sLastPer = ELCOMP(dmPer, 'Total years', nChd);
nLastPerIndex = DIMIX (dmPer, sLastPer);

sImpFilePath = ATTRS(dmVar, 'sys_CBMS Upload Directory', ' value');

#--------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#--------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DATE TIMESTAMPS
#******************************************************************************************************************
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 
sHNow = TimST (Now, '\h');
sMinNow = TimST (Now, '\i');
sSNow = TimST (Now, '\s');
 
sDay = TRIM(SUBST(sDNow, 1,2));
 
IF (LONG (sDay) = 1);
     sDay = '0' | sDay;
ELSE;
     sDay = sDay;
ENDIF;
 
sMonth = TRIM(SUBST(sMNow, 1,2));
 
IF (LONG (sMonth) = 1);
     sMonth = '0' | sMonth;
ELSE;
     sMonth = sMonth;
ENDIF;
 
sYear = TRIM(SUBST(sYNow, 1,4));
 
sNow = sYear | sMonth | sDay | sHNow | sMinNow | sSNow ;

sPrc = GetProcessName();
sView = sUser | ' - FBO Adj' ;
sSubset = sView;

#------------------------------------------------------------------------------------------------------------------------------------------
#--- STEP 02 : CREATE SOURCE VIEW
#------------------------------------------------------------------------------------------------------------------------------------------

#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);


#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

# Status
SubsetCreate(dmStatus, sSubset);
SubsetElementInsert(dmStatus, sSubset, sSourceStatus, 1);

# Outcome
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmOC | '] )}, 0)}';
MDX = '{[' | dmOC | '].[' | sSourceOC | ']}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Function
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
MDX = '{[' | dmFunc | '].[' | sSourceFunc | ']}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Reason
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Appropriation Type
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmType | '] )}, 0)}';
MDX = '{[' | dmType | '].[' | sSourceType | ']}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Movement account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Appropriation item
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
MDX = '{[' | dmItem | '].[' | sSourceItem | ']}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
IF (psProg @= 'Departmental Programmes' % SUBST(psProg,1,4) @= '1083');
	MDX = '{FILTER( {TM1DRILLDOWNMEMBER( {[' | dmProg | '].[' | psProg | ']}, ALL, RECURSIVE )}, [' | dmProg | '].[CBMS Level Program] = "Y")}';
ELSE;
	MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].[' | psProg | '] }, ALL, RECURSIVE )}, 0)}';
ENDIF;
SUBSETCREATEBYMDX (sSubset, MDX);


# Account
MDX = '{{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000130]}, ALL, RECURSIVE )}, 0)}, ASC)},{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[3800001]}, ALL, RECURSIVE )}, 0)}, ASC)},{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000850]}, ALL, RECURSIVE )}, 0)}, ASC)}, {TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000003]}, ALL, RECURSIVE )}, 0)}, ASC)} }';
#MDX = '{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[3800001]}, ALL, RECURSIVE )}, 0)}, ASC)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# ID
SubsetCreate(dmID, sSubset);
SubsetElementInsert(dmID, sSubset, sSourceID, 1);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Period
SubsetCreate(dmPer, sSubset);
SubsetElementInsert(dmPer, sSubset, psPeriod, 1);


#****BUILD VIEW****#
ViewCreate(sCube, sView);

ViewSubsetAssign(sCube, sView, dmHLYear, sSubset);
ViewSubsetAssign(sCube, sView, dmScenario, sSubset);
ViewSubsetAssign(sCube, sView, dmStatus, sSubset);
ViewSubsetAssign(sCube, sView, dmOC, sSubset);
ViewSubsetAssign(sCube, sView, dmRE, sSubset);
ViewSubsetAssign(sCube, sView, dmFunc, sSubset);
ViewSubsetAssign(sCube, sView, dmReason, sSubset);
ViewSubsetAssign(sCube, sView, dmSPP, sSubset);
ViewSubsetAssign(sCube, sView, dmMeasCode, sSubset);
ViewSubsetAssign(sCube, sView, dmType, sSubset);
ViewSubsetAssign(sCube, sView, dmMA, sSubset);
ViewSubsetAssign(sCube, sView, dmItem, sSubset);
ViewSubsetAssign(sCube, sView, dmProg, sSubset);
ViewSubsetAssign(sCube, sView, dmAcc, sSubset);
ViewSubsetAssign(sCube, sView, dmID, sSubset);
ViewSubsetAssign(sCube, sView, dmJur, sSubset);
ViewSubsetAssign(sCube, sView, dmPer, sSubset);

ViewExtractSkipZeroesSet (sCube, sView, 1);
ViewExtractSkipCalcsSet (sCube, sView, 0);
ViewExtractSkipRuleValuesSet (sCube, sView, 0);

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;



#------------------------------------------------------------------------------------------------------------------------------------------
#---  CREATE TEMP DIM - IDENTIFY NUMBER OF NEW IDs 
#------------------------------------------------------------------------------------------------------------------------------------------
dmTmpID = 'tmp_ID_' |  sUser;

IF(DimensionExists(dmTmpID)=0);
      DimensionCreate (dmTmpID);
ELSE;
      Dimensiondestroy (dmTmpID);
      DimensionCreate (dmTmpID);

ENDIF;

AttrInsert (dmTmpID, '', 'ID', 'S');
AttrInsert (dmTmpID,'','Program','S');
AttrInsert (dmTmpID,'','Appropriation Type','S');
AttrInsert (dmTmpID,'','Function','S');

DimensionDeleteAllElements(dmTmpID);

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

IF(DTYPE(dmProg,vsProg) @<>'N');
    #  Itemskip;
ENDIF;

#** FIND NEXT AVAILABLE ID (IF REQUIRED)
#sIDProg = vsProg|vsOC|vsAppropType|vsAppropItem|vsFunc|vsSPP;
#sIDProg = vsProg|vsOC|vsFunc;
sIDProg = vsProg|vsOC;

         IF (DIMIX (dmTmpID, sIDProg) = 0);
              DIMENSIONELEMENTINSERT (dmTmpID, '', sIDProg, 'N');
         ENDIF;

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

IF (1=0);
#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);
ENDIF;

#endregion