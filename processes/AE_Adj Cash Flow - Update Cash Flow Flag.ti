#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Adj Cash Flow - Update Cash Flow Flag
#**** DESCRIPTION:       This process is used in the REFRESH button in the Adjustment Template
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#*** 2022		KG	 Process to stop cash flow from updating
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#******************************************************************************************************************
#*** DECLARE AE ID DETAILS CUBE DIMENSIONS
#******************************************************************************************************************
cbID = 'AE id details';
dmIDMeas = 'id measure';


#-------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE
#-------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';
dmCtrlType = 'control type';
dmFavID = 'favourites_id';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sNoMeasCode = ATTRS(dmVar, 'No Measure Code', 'value');

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED
#******************************************************************************************************************
sView = sUser | ' $AdjCFClear';

#******************************************************************************************************************
#*** CASH FLOW CAN ONLY BE CHANGED IN THE CURRENT ROUND
#******************************************************************************************************************
curRound = curHLYear | curScenario;
psRound = psHLYear | psScenario;

IF( curRound @<> psRound);
                sMsg = 'Cash flow cannot be changed in the selected round.';
                ItemReject(sMsg);
ENDIF;



#******************************************************************************************************************
#*** STEP 1 : UPDATE CASH FLOW FLAG
#******************************************************************************************************************
#******************************************************************************************************************
#*** GET ENTERED DATA 
#*** GET DATA AE ID DETAILS
#******************************************************************************************************************
sMeasure = 'value';
sProg = CELLGETS (cbID, psHLYear, psScenario, psID, snProg | ' code');
sReason = CELLGETS (cbID, psHLYear, psScenario, psID, 'reason');
sMeasCode = CELLGETS (cbID, psHLYear, psScenario, psID, 'measure');
sOC = CELLGETS (cbID, psHLYear, psScenario, psID, 'outcome');
sFunc = CELLGETS (cbID, psHLYear, psScenario, psID, 'function');
sDisagreeCF = CELLGETS( cbID, psHLYear, psScenario, psID, 'disagree cashflow');
sStatus = CELLGETS( cbID, psHLYear, psScenario, psID, 'status');



#******************************************************************************************************************
#*** DO UPDATE DEPENDING OF FLAGS SELECTED BY USER
#******************************************************************************************************************
IF (psCFFlag @= 'System Derived');
	IF (sDisagreeCF @= '');
		#******************************************************************************************************************
		#*** IF USER SELECTS SYSTEM DERIVED, BUT DISAGREE CF FLAG IS BLANK
		#*** DO NOTHING
		#******************************************************************************************************************
	ELSE;

		#******************************************************************************************************************
		#*** IF USER SELECTS SYSTEM DERIVED, BUT DISAGREE CF FLAG IS NOT BLANK
		#*** CHANGE DISAGREE CASH FLOW BACK TO NORMAL
		#*** EXECUTE PROCESS THAT CLEARS MANUAL CASH FLOW DATA ENTRY
		#******************************************************************************************************************
		IF ((psHLYear @= curHLYear) % (psScenario @= curScenario) % (sStatus @<> 'approved' % sStatus @<> 'approved non-flat file' % sStatus @<> 'CBMS'));
			CELLPUTS ('', cbID, psHLYear, psScenario, psID, 'disagree cashflow');
			sProcess = 'AE_Adj Cash Flow - Clear Manual Cash Flow';
			EXECUTEPROCESS (sProcess, 'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario, 'psID', psID);
		ENDIF;
	ENDIF;
ELSE;

	#******************************************************************************************************************
	#*** AGENCY ENTERED CASH FLOW
	#******************************************************************************************************************
	IF (sDisagreeCF @= '');
		IF ((psHLYear @= curHLYear) % (psScenario @= curScenario) % (sStatus @<> 'approved' % sStatus @<> 'approved non-flat file' % sStatus @<> 'CBMS'));
			#******************************************************************************************************************
			#*** IF USER SELECTS AGENCY ENTERED, BUT DISAGREE CF FLAG IS BLANK
			#*** POPULATE CASH FLOW
			#******************************************************************************************************************
			#******************************************************************************************************************
			#*** CLEAR MANUAL CASH FLOW IF ANY
			#******************************************************************************************************************

			sProcess = 'AE_Adj Cash Flow - Clear Manual Cash Flow';
			EXECUTEPROCESS (sProcess, 'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario, 'psID', psID);

			#******************************************************************************************************************
			#*** POPULATE CASH FLOW
			#******************************************************************************************************************
			sProcess = 'AE_Adj Cash Flow - Copy Cash Flow Data';
			EXECUTEPROCESS (sProcess, 'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario, 'psID', psID);
			CELLPUTS ('Y', cbID, psHLYear, psScenario, psID, 'disagree cashflow');
		ENDIF;

	ELSE;

		#******************************************************************************************************************
		#*** IF USER SELECTS AGENCY ENTERED, BUT DISAGREE CF FLAG IS NOT BLANK
		#*** DO NOTHING
		#******************************************************************************************************************
	ENDIF;
ENDIF;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbAE, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmStatus, sView);
SUBSETDESTROY (dmOC, sView);
SUBSETDESTROY (dmRE, sView);
SUBSETDESTROY (dmFunc, sView);
SUBSETDESTROY (dmReason, sView);
SUBSETDESTROY (dmSPP, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmType, sView);
SUBSETDESTROY (dmMA, sView);
SUBSETDESTROY (dmItem, sView);
SUBSETDESTROY (dmProg, sView);
SUBSETDESTROY (dmAcc, sView);
SUBSETDESTROY (dmID, sView);
SUBSETDESTROY (dmJur, sView);
SUBSETDESTROY (dmPer, sView);

#endregion