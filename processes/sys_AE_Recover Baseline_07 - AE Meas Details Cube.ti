#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE_Recover Baseline_07 - AE Meas Details Cube
#**** DESCRIPTION:       This process transfers data between headline year and scenario in the government measure details cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials      Comments
#****  ====              ======    =========
#**** 12/05/2014    KG           Initial Revision
#**** 2019	KG	Updated for NEW GEUS
#***********************************************************************************************************************


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GOVERNMENT MEASURE CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbMeas = 'government measures';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GOVERNMENT MEASURE DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbMeasDet = 'government measures details';
dmMeasDet = 'measure details';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

sHLYear = ATTRS(dmVar, 'archive year', 'old value');
sScenario = ATTRS(dmVar, 'archive scenario', 'old value');
#sTargetHLYear = ATTRS(dmVar, 'archive year', 'value');
#sTargetScenario = ATTRS(dmVar, 'archive scenario', 'value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = sUser | '_$RecoverBaseline';
sSubset = sView;

#***********************************************************************************************************************
#--- STEP 1 - DELETE TARGET VIEW
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmMeasCode, sSubset);
SubsetDestroy(dmMeasDet, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure Details
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasDet | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbMeasDet, sView);

ViewSubsetAssign(cbMeasDet, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbMeasDet, sView, dmScenario, sSubset);
ViewSubsetAssign(cbMeasDet, sView, dmMeasCode, sSubset);
ViewSubsetAssign(cbMeasDet, sView, dmMeasDet, sSubset);

ViewExtractSkipZeroesSet (cbMeasDet, sView, 1);
ViewExtractSkipCalcsSet (cbMeasDet, sView, 1);
ViewExtractSkipRuleValuesSet (cbMeasDet, sView, 1);

#---------------------------------------------------------------------------------------------------------------------------
#--- ZERO OUT CUBE
#---------------------------------------------------------------------------------------------------------------------------
VIEWZEROOUT (cbMeasDet, sView);

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmMeasCode, sSubset);
SubsetDestroy(dmMeasDet, sSubset);


#***********************************************************************************************************************
#--- STEP 2 - CREATE SOURCE VIEW
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmMeasCode, sSubset);
SubsetDestroy(dmMeasDet, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure Details
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasDet | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbMeasDet, sView);

ViewSubsetAssign(cbMeasDet, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbMeasDet, sView, dmScenario, sSubset);
ViewSubsetAssign(cbMeasDet, sView, dmMeasCode, sSubset);
ViewSubsetAssign(cbMeasDet, sView, dmMeasDet, sSubset);

ViewExtractSkipZeroesSet (cbMeasDet, sView, 1);
ViewExtractSkipCalcsSet (cbMeasDet, sView, 1);
ViewExtractSkipRuleValuesSet (cbMeasDet, sView, 1);


#---------------------------------------------------------------------------------------------------------------------------
#--- DEFINE DATA SOURCE
#---------------------------------------------------------------------------------------------------------------------------
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


IF (CELLISUPDATEABLE (cbMeasDet, psTargetHLYear, psTargetScenario, vsMeasCode, vsMeasure) = 1);
	IF (VALUE_IS_STRING=0);
		CELLPUTN(NVALUE, cbMeasDet, psTargetHLYear, psTargetScenario, vsMeasCode, vsMeasure);
	ELSE;
		CELLPUTS(SVALUE, cbMeasDet, psTargetHLYear, psTargetScenario, vsMeasCode, vsMeasure);
	ENDIF;
ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#---------------------------------------------------------------------------------------------------------------------------
#--- ZERO OUT SOURCE VIEW
#---------------------------------------------------------------------------------------------------------------------------
VIEWZEROOUT (cbMeasDet, sView);

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmMeasCode, sSubset);
SubsetDestroy(dmMeasDet, sSubset);

#endregion