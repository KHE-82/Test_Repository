#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_FlatFile 01 - Load ID to sys_Extract
#**** DESCRIPTION:       This process creates a view for the flatfile generation
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 02/08/2017    KG             Initial Revision
#**** 23/08/2017	KG	  Some agency has reason code mapping, so this was included
#**** 01/09/2022    KG             Treasury GEU Customisation - Only Extract Jurisdiction when the jurisdiction is required
#****
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#--------------------------------------------------------------------------------------------------------------------------
#*** DIMENSION ATTRIBUTES
#--------------------------------------------------------------------------------------------------------------------------
dmReasonAttr = '}ElementAttributes_reason';
dmAccAttr = '}ElementAttributes_account';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
cbID = 'AE id details';
#---------------------------------------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
cbProg = snProg | ' details';
#---------------------------------------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE EXTRACT CUBE
cbProg = snProg | ' details';
#---------------------------------------------------------------------------------------------------------------------------
cbExtract = 'sys_extract';
dmRowID = 'sys_extract row id';
dmFFScenario = 'sys_flatfile scenario';
dmExtractMeas = 'sys_flatfile measure';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------
sHLYear = ATTRS(dmVar,'headline year','value');
sScenario = ATTRS(dmVar, 'headline scenario', 'value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sTM1User = TM1User();
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
 #    sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     sUser = ATTRS(dmClients, sUser, 'GEUS User Name');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;


#sObject  = sUser | '_$FlatFile';
sAEView = sUser | '_$FlatFile';
#sAEView = '$FlatFile';
sFFScenario = 'upload';
sStatus = 'approved';

#*****************************************************************************************************************************************************
#*** STEP 1 - CLEAR CURRENT ID FLAT FILE ***#
#*****************************************************************************************************************************************************
#---------------------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
#---------------------------------------------------------------------------------------------------------------------------
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sAEView);
VIEWDESTROY (cbExtract, sAEView);
SUBSETDESTROY (dmClients, sAEView);
SUBSETDESTROY (dmFFScenario, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmRowID, sAEView);
SUBSETDESTROY (dmExtractMeas, sAEView);


#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS****#
#---------------------------------------------------------------------------------------------------------------------------

# Client
SubsetCreate(dmClients, sAEView);
SubsetElementInsert(dmClients, sAEView, sUser, 1);

# FF Scenario
SubsetCreate(dmFFScenario, sAEView);
SubsetElementInsert(dmFFScenario, sAEView, sFFScenario, 1);


# ID
SubsetCreate(dmID, sAEView);
SubsetElementInsert(dmID, sAEView, psID, 1);

# Row ID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRowID | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmRowID, sAEView, MDX);


# Extract Measure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmExtractMeas | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmExtractMeas, sAEView, MDX);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW****#
#---------------------------------------------------------------------------------------------------------------------------
VIEWCREATE (cbExtract, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmClients, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmFFScenario, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmRowID, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmID, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmExtractMeas, sAEView);

VIEWZEROOUT (cbExtract, sAEView);

#---------------------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
#---------------------------------------------------------------------------------------------------------------------------
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbExtract, sAEView);
SUBSETDESTROY (dmClients, sAEView);
SUBSETDESTROY (dmFFScenario, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmRowID, sAEView);
SUBSETDESTROY (dmExtractMeas, sAEView);


#*****************************************************************************************************************************************************
#*** STEP 2 - CREATE SOURCE VIEW
#*****************************************************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmOC, sAEView);
SUBSETDESTROY (dmRE, sAEView);
SUBSETDESTROY (dmFunc, sAEView);
SUBSETDESTROY (dmReason, sAEView);
SUBSETDESTROY (dmSPP, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmType, sAEView);
SUBSETDESTROY (dmMA, sAEView);
SUBSETDESTROY (dmItem, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmJur, sAEView);
SUBSETDESTROY (dmPer, sAEView);

#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS****#
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sAEView);
SubsetElementInsert(dmHLYear, sAEView, psHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sAEView);
SubsetElementInsert(dmScenario, sAEView, psScenario, 1);

# Status
SubsetCreate(dmStatus, sAEView);
SubsetElementInsert(dmStatus, sAEView, sStatus, 1);

# Outcome
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmOC | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmOC, sAEView, MDX);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmRE, sAEView, MDX);

# Function
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmFunc, sAEView, MDX);

# Reason
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmReason, sAEView, MDX);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmSPP, sAEView, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmMeasCode, sAEView, MDX);

# Appropriation Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmType | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmType, sAEView, MDX);


# Movement Account
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}, [' | dmMA | '].[flat file] @<> "N")}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmMA, sAEView, MDX);


# Appropriation Item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmItem, sAEView, MDX);

# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmProg, sAEView, MDX);

# Account
MDX = '{FILTER( {TM1SORT( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAcc | '] )}, 0)} , ASC)}, [' | dmAcc | '].[flat file] @<> "N")}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmAcc, sAEView, MDX);


# ID
SubsetCreate(dmID, sAEView);
SubsetElementInsert(dmID, sAEView, psID, 1);
#MDX = '{ EXCEPT( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmID | '] )}, 0)}, { [' | dmID | '].[0000A], [' | dmID | '].[0000B], [' | dmID | '].[00FBO], [' | dmID | '].[Cash flow] }) }';
#SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmJur, sAEView, MDX);


# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmJur, sAEView, MDX);

# Period
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmPer, sAEView, MDX);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW****#
#---------------------------------------------------------------------------------------------------------------------------
VIEWCREATE (cbAE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmHLYear, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmScenario, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmStatus, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmOC, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmRE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmFunc, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmReason, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmSPP, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasCode, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMA, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmItem, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmProg, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmAcc, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmID, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmJur, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmPer, sAEView);

ViewTitleElementSet (cbAE, sAEView, dmHLYear, 1);
ViewTitleElementSet (cbAE, sAEView, dmScenario, 2);
ViewTitleElementSet (cbAE, sAEView, dmStatus, 3);
#ViewTitleElementSet (cbAE, sAEView, dmMeasCode, 4);

ViewColumnDimensionSet (cbAE, sAEView, dmPer, 1);

ViewRowDimensionSet (cbAE, sAEView, dmID, 1);
ViewRowDimensionSet (cbAE, sAEView, dmProg, 2);
ViewRowDimensionSet (cbAE, sAEView, dmOC, 3);
ViewRowDimensionSet (cbAE, sAEView, dmFunc, 4);
ViewRowDimensionSet (cbAE, sAEView, dmType, 5);
ViewRowDimensionSet (cbAE, sAEView, dmItem, 6);
ViewRowDimensionSet (cbAE, sAEView, dmReason, 7);
ViewRowDimensionSet (cbAE, sAEView, dmAcc, 8);
ViewRowDimensionSet (cbAE, sAEView, dmMA, 9);
ViewRowDimensionSet (cbAE, sAEView, dmRE, 10);
ViewRowDimensionSet (cbAE, sAEView, dmSPP, 11);
ViewRowDimensionSet (cbAE, sAEView, dmJur, 12);
ViewRowDimensionSet (cbAE, sAEView, dmMeasCode, 13);

ViewSuppressZeroesSet (cbAE, sAEView,1);
ViewExtractSkipZeroesSet (cbAE, sAEView, 1);

#DatasourceASCIIDecimalSeparator='.';
#DatasourceASCIIThousandSeparator='';

#*****************************************************************************************************************************************************
#*** STEP 3 - GET ROW ID NUMBER ***#
#*****************************************************************************************************************************************************
sOldIDRow = '';

nRowID = CELLGETN(cbExtract, sUser, sFFScenario, psID, 'Total Rows', 'used') + 1;
sRowID = NUMBERTOSTRING (nRowID);

IF (LONG (sRowID) = 1);
	sRowID = '00' | sRowID;
ENDIF;

IF (LONG (sRowID) = 2);
	sRowID = '0' | sRowID;
ENDIF;

IF (LONG (sRowID) = 3);
	sRowID = sRowID;
ENDIF;

lCounter = 0;

#*****************************************************************************************************************************************************
#*** STEP 4 - GET PERIODS ***#
#*****************************************************************************************************************************************************

sHLYearPeriod = SUBST(psHLYear, 3,9);
sPA = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) -2);
sRB = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) -1);
sNB = sHLYearPeriod;
sFE01 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +1);
sFE02 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +2);
sFE03 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +3);
sFE04 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +4); 
sFE05 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +5);
sFE06 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +6);
sFE07 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +7);
sFE08 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +8);
sFE09 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +9);
sFE10 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +10);
sFE11 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +11);
sFE12 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +12);
sFE13 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +13);

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sAEView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


#---------------------------------------------------------------------------------------------------------------------------
#**** GET METADATA
#---------------------------------------------------------------------------------------------------------------------------
sDisagreeCF = CELLGETS (cbID, vsHLYear, vsScenario, vsID, 'disagree cash flow');
sTItle = CELLGETS (cbID, vsHLYear, vsScenario, vsID, 'title');
sDesc = CELLGETS (cbID, vsHLYear, vsScenario, vsID, 'description');
sProg = DIMENSIONELEMENTPRINCIPALNAME(dmProg, vsProg);
sProg = CELLGETS (cbProg, vsHLYear, vsScenario, vsProg, 'programme');

#---------------------------------------------------------------------------------------------------------------------------
#--- REASON CODE
#--- Some agency has customised reason code (DHS/DSS) which likes to map to certain CBMS codes
#--- This needs to be remapped
#---------------------------------------------------------------------------------------------------------------------------
IF (DIMIX (dmReasonAttr, 'CBMS Mapping') <> 0);
	sCheckReasonMap = ATTRS (dmReason, vsReason, 'CBMS Mapping');
ELSE;
	sCheckReasonMap = '';
ENDIF;

IF (sCheckReasonMap @= '');
#	sReason = ATTRS (dmReason, vsReason, 'CBMS Reason Code');
	sReason = ATTRS (dmReason, vsReason, 'CBMS code and description');
ELSE;
	#--------------------------------------------------------------------
	#--- THERE IS A REASON MAPPING
	#--- CONVERT TO CBMS REASON CODE
	#--------------------------------------------------------------------
	IF (DIMIX (dmReason, sCheckReasonMap) <> 0);
		#sReason = ATTRS (dmReason, sCheckReasonMap, 'CBMS Reason Code');
		sReason = ATTRS (dmReason, sCheckReasonMap, 'CBMS code and description');
	ELSE;
		#sReason = ATTRS (dmReason, vsReason, 'CBMS Reason Code');
		sReason = ATTRS (dmReason, vsReason, 'CBMS code and description');
	ENDIF;
ENDIF;

#--------------------------------------------------------------------
#--- After all mapping/checking, reason code is still blank, just use element name
#--------------------------------------------------------------------
IF (sReason @= '');
	sReason = vsReason;
ENDIF;

sRE = DIMENSIONELEMENTPRINCIPALNAME (dmRE, vsRE);
IF (sRE @= '-');
	sRE = '';
ENDIF;

#---------------------------------------------------------------------------------------------------------------------------
#--- ACCOUNT CODE
#--- Some agency has customised account codes (DHS) 
#--- This needs to be remapped using account attribute 'flatfile map'
#---------------------------------------------------------------------------------------------------------------------------
sAcc = DIMENSIONELEMENTPRINCIPALNAME(dmAcc, vsAcc);

IF (DIMIX (dmAccAttr, 'flatfile map') <> 0);
	sAccFFMap = ATTRS (dmAcc, sAcc, 'flatfile map');
ELSE;
	sAccFFMap = '';
ENDIF;

IF (sAccFFMap @= '');
	sAcc = sAcc;
ELSE;
	#--------------------------------------------------------------------
	#--- THERE IS A FLATFILE ACCOUNT MAPPING
	#--- CONVERT ACCOUNT
	#--------------------------------------------------------------------
	IF (DIMIX (dmAcc, sAcc) <> 0);
		#--------------------------------------------------------
		#--- CHECK IF MAPPED ACCOUNT IS DISABLED
		#--------------------------------------------------------
		sAccDisabled = ATTRS (dmAcc, sAcc, 'disabled');
		IF (sAccDisabled @= '');
			sAcc = sAccFFMap;
		ELSE;
			sAcc = sAcc;
		ENDIF;
	ELSE;
		sAcc = sAcc;
	ENDIF;
ENDIF;


sMA = DIMENSIONELEMENTPRINCIPALNAME (dmMA, vsMA);
IF (sMA @= '-');
	sMA = '';
ENDIF;

IF (vsMeasCode @= 'M00000');
	sMeasCode = '';
ELSE;
	sMeasCode = CELLGETS (cbID, vsHLYear, vsScenario, vsID, 'CBMS measure code');
	#sMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, vsMeasCode);
	#sMeasCode = ATTRS (dmMeasCode, sMeasCode, 'CBMS');
ENDIF;


sAccSPPRequired = ATTRS (dmAcc, sAcc, 'SPP Required');
sAccMARequired = ATTRS (dmAcc, sAcc, 'movement account required');
sAccJurRequired = ATTRS (dmAcc, sAcc, 'jurisdiction required');
sAccJurOptional = ATTRS (dmAcc, sAcc, 'jurisdiction Optional');

sJur = DIMENSIONELEMENTPRINCIPALNAME (dmJur, vsJur);

IF (sJur @= '-');
	sJur = '';
ENDIF;

#------------------------------------------------------------------------#
#------20220901 Treasury Geus Customisation----#
#------------------------------------------------------------------------#
IF( sAccJurOptional @='Y');
	sJur = '';
ENDIF;


#---------------------------------------------------------------------------------------------------------------------------
#**** CERTAIN ACCOUNT CODES REQUIRE APPROPRIATION, 
#**** GET APPROPRIATION CODE FROM PROGRAMME DETAILS OR FROM ADJ
#---------------------------------------------------------------------------------------------------------------------------

IF (sAccMARequired @= '');
	sAccAppropRequired = ATTRS (dmAcc, sAcc, 'Appropriation Type Required');
ELSE;
	sAccAppropRequired = ATTRS (dmMA, vsMA, 'Appropriation Type Required');
ENDIF;

IF (sAccAppropRequired @<> '');
#	sAppropriation = vsType;
	sAppropCheck = CELLGETS (cbProg, vsHLYear, vsScenario, vsProg, 'appropriation item');
	sAppropriation = DIMENSIONELEMENTPRINCIPALNAME (dmItem, vsItem);
	sAppropriation = ATTRS(dmItem, sAppropriation, 'code and description');
ELSE;
	sAppropriation = '';
ENDIF;



#---------------------------------------------------------------------------------------------------------------------------
#**** CERTAIN ACCOUNT CODES REQUIRE SPP
#**** GET SPP CODE FROM PROGRAMME DETAILS OR FROM ADJ
#---------------------------------------------------------------------------------------------------------------------------
IF (sAccSPPRequired @<> '');
	sSPPCheck = CELLGETS (cbProg, vsHLYear, vsScenario, vsProg, 'spp');
	sSPP = DIMENSIONELEMENTPRINCIPALNAME (dmSPP, vsSPP);
	IF (sSPP @= '-');
		sSPP = '';
	ENDIF;
ELSE;
	sSPP = '';
ENDIF;


#---------------------------------------------------------------------------------------------------------------------------
#**** SKIP CERTAIN ACCOUNTS
#---------------------------------------------------------------------------------------------------------------------------
IF (sDisagreeCF @= '');
	IF (SUBST (vsAcc, 1, 1) @= '6');
		ITEMSKIP;
	ENDIF;

ENDIF;

#---------------------------------------------------------------------------------------------------------------------------
#**** CHECK ROW ID IS DIFFERENT AS PER PREVIOUS ROWS
#--- This uses vsAcc instead of sAcc due to the mapping process and enables to separate lines
#---------------------------------------------------------------------------------------------------------------------------
sIDRowCheck = vsProg | vsType | vsItem | vsMeasCode | vsAcc | vsMA | vsRE | vsJur;
IF (sOldIDRow @= sIDRowCheck);
	#---------------------------------------------------------------------------------------------------------------------------
	#**** SAME COMBINATION AS PREVIOUS ROW, SO USE SAME ROW ID
	#---------------------------------------------------------------------------------------------------------------------------
	# DO NOTHING
	sRowID = sRowID;
	CELLPUTN (1, cbExtract, sUser, sFFScenario, vsID, sRowID, 'used');
ELSE;
	#---------------------------------------------------------------------------------------------------------------------------
	#**** DIFFERENT COMBINATION AS PREVIOUS ROW, SO POPULATE NEW USED COLUMNS
	#---------------------------------------------------------------------------------------------------------------------------
	nRowID = CELLGETN(cbExtract, sUser, sFFScenario, vsID, 'Total Rows', 'used') + 1;
	sRowID = NUMBERTOSTRING (nRowID);

	IF (LONG (sRowID) = 1);
		sRowID = '00' | sRowID;
	ENDIF;

	IF (LONG (sRowID) = 2);
		sRowID = '0' | sRowID;
	ENDIF;

	IF (LONG (sRowID) = 3);
		sRowID = sRowID;
	ENDIF;
	CELLPUTN (1, cbExtract, sUser, sFFScenario, vsID, sRowID, 'used');
ENDIF;


#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#**** POPULATE DATA - METADATA (NEW)
#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
CELLPUTS (sProg, cbExtract, sUser, sFFScenario, vsID, sRowID, 'programme');
CELLPUTS (sReason, cbExtract, sUser, sFFScenario, vsID, sRowID, 'reason');
CELLPUTS (sAcc, cbExtract, sUser, sFFScenario, vsID, sRowID, 'account');
CELLPUTS (sRE, cbExtract, sUser, sFFScenario, vsID, sRowID, 'related entity');
CELLPUTS (sSPP, cbExtract, sUser, sFFScenario, vsID, sRowID, 'spp');
#CELLPUTS (sAppropriation, cbExtract, sUser, sFFScenario, vsID, sRowID, 'appropriation');
CELLPUTS (sAppropriation, cbExtract, sUser, sFFScenario, vsID, sRowID, 'appropriation');
CELLPUTS (sJur, cbExtract, sUser, sFFScenario, vsID, sRowID, 'jurisdiction');
CELLPUTS (sMA, cbExtract, sUser, sFFScenario, vsID, sRowID, 'movement account');
CELLPUTS (sMeasCode, cbExtract, sUser, sFFScenario, vsID, sRowID, 'measure');
CELLPUTS (sTitle, cbExtract, sUser, sFFScenario, vsID, sRowID, 'title');
CELLPUTS (sDesc, cbExtract, sUser, sFFScenario, vsID, sRowID, 'description');

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#**** POPULATE DATA - METADATA (OLD CBMS)
#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
CELLPUTS (vsHLYear, cbExtract, sUser, sFFScenario, vsID, sRowID, 'headline year');
CELLPUTS (vsScenario, cbExtract, sUser, sFFScenario, vsID, sRowID, 'scenario');
CELLPUTS (vsID, cbExtract, sUser, sFFScenario, vsID, sRowID, 'geus id');
CELLPUTS (vsOC, cbExtract, sUser, sFFScenario, vsID, sRowID, 'outcome');
CELLPUTS (vsFunc, cbExtract, sUser, sFFScenario, vsID, sRowID, 'function');
CELLPUTS (vsType, cbExtract, sUser, sFFScenario, vsID, sRowID, 'appropriation type');
CELLPUTS (vsItem, cbExtract, sUser, sFFScenario, vsID, sRowID, 'appropriation item');
CELLPUTS (vsID, cbExtract, sUser, sFFScenario, vsID, sRowID, 'geus id');

sValue = NUMBERTOSTRING (vnValue);

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#**** POPULATE FINANCIAL DATA
#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

IF (vsPer @= sPA);
#	CELLPUTN (vnValue, cbExtract, sUser, sFFScenario, vsID, sRowID, 'PA');
	CELLPUTS (sValue, cbExtract, sUser, sFFScenario, vsID, sRowID, 'PA');
ENDIF;

