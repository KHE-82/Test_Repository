IF (1=1);
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#
#------Generate FBO Adjustments FOR B/S with MA rolling to a New Mvt Acc (NFA) and B/S Account with Open Bal Account (Lease/Loan Liability--------------------#
#------Source - CBMS-R FBO Ad (C)/ 00FBO-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------#
#------Target - CBMS-R FBO Adj/ 00FBO -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#
sPrc = 'sys_Load FBO 03 - Create GEUS Variances For Other Accounts';
ExecuteProcess(sPrc,
	'psSourceHLyear', psSourceHLYear, 
	'psSourceScenario',psTargetScenario, 
	'psTargetHLYear', psTargetHLYear,
	'psTargetScenario',psTargetScenario, 
	'psProg',psProg,
	'psPeriod',psPeriod);


#------------------------------------------------------------------
#--- Run Process To Update System Process Cube
#----------------------------------------------------------------
NUMERICGLOBALVARIABLE ('ProcessReturnCode');
sProcessReturnCode = NUMBERTOSTRING(ProcessReturnCode);
sProcessReturnCodeDesc = ATTRS (dmReturnProcCode, sProcessReturnCode, 'description');

IF (ProcessReturnCode = ProcessExitNormal() );
	#-------------------------------------------------------------
	#--- Process Completed Successfully
	#-------------------------------------------------------------

	CELLPUTN (1, cbProc, sPrc, 'completed flag');
	CELLPUTS (sProcessReturnCode, cbProc, sPrc, 'error description');
	CELLPUTS ('SUCCESS', cbProc, sPrc, 'status flag');
ELSE;
	#-------------------------------------------------------------
	#--- Process Completed With Errors
	#-------------------------------------------------------------
	CELLPUTN (1, cbProc, sPrc, 'error flag');
	CELLPUTS (sProcessReturnCodeDesc, cbProc, sPrc, 'error description');
	CELLPUTS ('FAILED', cbProc, sPrc, 'status flag');

	ProcessQuit;
ENDIF;


ENDIF;

#-----------------------------------------------------------------------------------------------------#
#------Transfer FBO adjustments to Current/00FBO-------------------------#
#----------------------------------------------------------------------------------------------------#
IF(psFBOAdjType @= 'Baseline - 00FBO');
	sPrc = 'sys_Load FBO 04 - Upload GEUS Variances to Current 00FBO';
	ExecuteProcess(sPrc,'psSourceHLyear', psTargetHLYear, 'psSourceScenario',psTargetScenario,'psTargetHLYear', psTargetHLYear,'psTargetScenario','Current', 'psProg',psProg,'psPeriod',psPeriod);
ELSEIF(psFBOAdjType @= 'FBO Flatfile');
	sPrc = 'sys_Load FBO 05 - Create FBO Flatfile';
	ExecuteProcess(sPrc,'psSourceHLyear', psTargetHLYear, 'psSourceScenario',psTargetScenario, 'psProg',psProg,'psPeriod',psPeriod);
ELSEIF(psFBOAdjType @= 'NewAdjustments');
	sPrc = 'sys_Load FBO 06 - Create New Adjustment - ID';
	ExecuteProcess(sPrc,'psSourceHLyear', psTargetHLYear, 'psSourceScenario',psTargetScenario, 'psProg',psProg,'psPeriod',psPeriod);
	sPrc = 'sys_Load FBO 07 - Create New Adjustment - Data';
	ExecuteProcess(sPrc,'psSourceHLyear', psTargetHLYear, 'psSourceScenario',psTargetScenario, 'psProg',psProg,'psPeriod',psPeriod);
ELSE;

ENDIF;


#------------------------------------------------------------------
#--- Run Process To Update System Process Cube
#----------------------------------------------------------------
NUMERICGLOBALVARIABLE ('ProcessReturnCode');
sProcessReturnCode = NUMBERTOSTRING(ProcessReturnCode);
sProcessReturnCodeDesc = ATTRS (dmReturnProcCode, sProcessReturnCode, 'description');

IF (ProcessReturnCode = ProcessExitNormal() );
	#-------------------------------------------------------------
	#--- Process Completed Successfully
	#-------------------------------------------------------------

	CELLPUTN (1, cbProc, sPrc, 'completed flag');
	CELLPUTS (sProcessReturnCode, cbProc, sPrc, 'error description');
	CELLPUTS ('SUCCESS', cbProc, sPrc, 'status flag');
ELSE;
	#-------------------------------------------------------------
	#--- Process Completed With Errors
	#-------------------------------------------------------------
	CELLPUTN (1, cbProc, sPrc, 'error flag');
	CELLPUTS (sProcessReturnCodeDesc, cbProc, sPrc, 'error description');
	CELLPUTS ('FAILED', cbProc, sPrc, 'status flag');

	ProcessError;
ENDIF;





