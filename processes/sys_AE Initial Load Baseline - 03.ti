#MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER({FILTER( {TM1SUBSETALL( ['| dmProg|'] )}, ['| dmProg|'].[baseline derived] = "Y")}, ALL, RECURSIVE )}, 0)}';
