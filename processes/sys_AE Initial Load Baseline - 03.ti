# Movement Account
sDim = 'movement account';
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | sDim | '] )}, 0)}, [' | sDim | '].[flat file] <> "N")}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Appropriation Item
