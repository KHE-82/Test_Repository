#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE_Archive_11 - AE CF Cube Populate Target Scenario
#**** DESCRIPTION:       This process copies data in the cash flow cube from the CURRENT scenario into the target scenario, after clearing the target scenario
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials      Comments
#****  ====              ======    =========
#**** 12/05/2014    KG           Initial Revision
#**** 2019	KG	Updated For NEW GEUS
#***********************************************************************************************************************


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE CASHFLOW CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbCF= 'AE cash flow';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

#sHLYear = ATTRS(dmVar, 'archive year', 'old value');
#sScenario = ATTRS(dmVar, 'archive scenario', 'old value');
sTargetHLYear = ATTRS(dmVar, 'archive year', 'value');
sTargetScenario = ATTRS(dmVar, 'archive scenario', 'value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#sView = '$Archive';
sView = '$ArchiveClear';
sSubset = sView;


#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbCF, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);


#****BUILD VIEW****#
ViewCreate(cbCF, sView);

ViewSubsetAssign(cbCF, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbCF, sView, dmScenario, sSubset);

ViewSetSkipZeroes(cbCF, sView, 1);
ViewSetSkipCalcs(cbCF, sView, 1);
ViewZeroOut(cbCF, sView);

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbCF, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SOURCE VIEWS
#---------------------------------------------------------------------------------------------------------------------------
sView = '$Archive';
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


IF (CELLISUPDATEABLE (cbCF, psTargetHLYear, psTargetScenario, vsMA, vsID, vsAcc_CF, vsProg, vsAcc_Oth, vsRE, vsMeas, vsPeriod) = 1);
	CELLPUTN (Value, cbCF, psTargetHLYear, psTargetScenario, vsMA, vsID, vsAcc_CF, vsProg, vsAcc_Oth, vsRE, vsMeas, vsPeriod);
ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

cbCF= 'AE cash flow';
sView = '$Archive';
sSubset = sView;

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbCF, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);

#endregion