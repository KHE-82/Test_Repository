#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_GrpAdj_GetMappingData
#**** DESCRIPTION:       This process will transfer the current data to the adjustments cube with mapping
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 06/05/2014    KG             Initial Revision
#****
#***********************************************************************************************************************

#*** DECLARE CUBES & DIMENSIONS ***#
snProg = 'programme';

cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#*** DECLARE GROUP ADJUSTMENT CUBE ***#
cbGrp = 'AE group adjustment entry';
dmGrpMeas = 'group adjustment measure';

#*** DECLARE ACCOUNT TEMPLATE CUBE ***#
cbAccTemp = 'AE account template';
dmAccTemp = 'account template';
dmAccTempRecType = 'account template record type';
dmAccType = 'account type';
dmAccTempMeas = 'account template measure';

#*** DECLARE PROGRAMME DETAILS CUBE ***#
cbProg = snProg | ' details';


#*** DECLARE ID DETAILS CUBE DIMENSIONS
cbID = 'AE id details';
dmIDMeas = 'id measure';

#*** DECLARE SYSTEM DIMENSIONS ***# 
dmVar = 'variables';
dmClients = '}Clients';

#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');

#*** DECLARE SUBSETS AND VIEWS ***#
nNUM = RAND;
sNUM = NUMBERTOSTRING (nNUM);
sNUM = SUBST(sNUM, 3, 6);

sObject  = sNUM | '_$AccTempView';
sAEView = sNUM | '_$AccTempView';

#*****************************************************************************************************************************************************
#*** STEP 1 - CREATE SOURCE VIEW OF AE ADJUSTMENT CUBE TO CLEAR DATA ***#
#IF (curHLYear @<> psHLYear & curScenario @<> psScenario);

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmID, sAEView);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sAEView);
SubsetElementInsert(dmHLYear, sAEView, psHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sAEView);
SubsetElementInsert(dmScenario, sAEView, psScenario, 1);

# Status
SubsetCreate(dmStatus, sAEView);
SubsetElementInsert(dmStatus, sAEView, 'data', 1);

# ID
SubsetCreate(dmID, sAEView);
SubsetElementInsert(dmID, sAEView, psID, 1);

#*** BUILD VIEW ***#
VIEWCREATE (cbAE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmHLYear, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmScenario, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmStatus, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmID, sAEView);

# *** DEFINE VIEW EXTRACT
ViewExtractSkipZeroesSet(cbAE, sAEView, 1);
ViewSuppressZeroesSet(cbAE, sAEView, 1);
ViewExtractSkipCalcsSet(cbAE, sAEView, 1);

#*** CLEAR VIEW
IF (pnCounter = 0);
     VIEWZEROOUT (cbAE, sAEView);
ENDIF;

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmID, sAEView);

#*****************************************************************************************************************************************************
#*** STEP 2 - CREATE SOURCE VIEW OF ACCOUNT TEMPLATES ***#
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbAccTemp, sAEView);
SUBSETDESTROY (dmAccTemp, sAEView);
SUBSETDESTROY (dmAccTempRecType, sAEView);
SUBSETDESTROY (dmAccType, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmAccTempMeas, sAEView);

#****CREATE SUBSETS****#
# Account Template
SubsetCreate(dmAccTemp, sAEView);
SubsetElementInsert(dmAccTemp, sAEView, psAccTemp, 1);

#****CREATE SUBSETS****#
# Account Template Recprd Type
SubsetCreate(dmAccTempRecType, sAEView);
SubsetElementInsert(dmAccTempRecType, sAEView, 'mapping', 1);

#****CREATE SUBSETS****#
# Account Type
SubsetCreate(dmAccType, sAEView);
SubsetElementInsert(dmAccType, sAEView, psAccType, 1);

# Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAcc | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Account Template Measure
SubsetCreate(dmAccTempMeas, sAEView);
SubsetElementInsert(dmAccTempMeas, sAEView, 'factor', 1);

#*** BUILD VIEW ***#
VIEWCREATE (cbAccTemp, sAEView);
VIEWSUBSETASSIGN (cbAccTemp, sAEView, dmAccTemp, sAEView);
VIEWSUBSETASSIGN (cbAccTemp, sAEView, dmAccTempRecType, sAEView);
VIEWSUBSETASSIGN (cbAccTemp, sAEView, dmAccType, sAEView);
VIEWSUBSETASSIGN (cbAccTemp, sAEView, dmAcc, sAEView);
VIEWSUBSETASSIGN (cbAccTemp, sAEView, dmAccTempMeas, sAEView);

# *** DEFINE VIEW EXTRACT
ViewExtractSkipZeroesSet(cbAccTemp, sAEView, 1);
ViewSuppressZeroesSet(cbAccTemp, sAEView, 1);
ViewExtractSkipCalcsSet(cbAccTemp, sAEView, 1);


DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sAEView;


#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** IF THERE IS NO MAPPING THEN SKIP LINE ***#
IF (vsMeas @<> 'factor' & Value = 0);
     ITEMSKIP;
ENDIF;
    
#**** GET ID DETAILS DATA ***#
sAdjType = CELLGETS (cbID, psHLYear, psScenario, psID, 'Adjustment Type');
sReason = CELLGETS (cbID, psHLYear, psScenario, psID, 'reason');
sMeasCode = CELLGETS (cbID, psHLYear, psScenario, psID, 'measure');

sReason = DIMENSIONELEMENTPRINCIPALNAME (dmReason, sReason);
sMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, sMeasCode);

#*** GET PROGRAMME DETAILS DATA ***#
sOC = CELLGETS (cbProg, psHLYear, psScenario, psProg, 'outcome');
sFunc = CELLGETS (cbProg, psHLYear, psScenario, psProg, 'function');
sType = CELLGETS (cbProg, psHLYear, psScenario, psProg, 'appropriation type');
sItem = CELLGETS (cbProg, psHLYear, psScenario, psProg, 'appropriation item');
sSPP =  CELLGETS (cbProg, psHLYear, psScenario, psProg, 'spp');

#*** GET DIMENSION PRINCIPAL NAME ***#
sOC = DIMENSIONELEMENTPRINCIPALNAME (dmOC, sOC);
sFunc = DIMENSIONELEMENTPRINCIPALNAME (dmFunc, sFunc);
sType = DIMENSIONELEMENTPRINCIPALNAME (dmType, sType);
sItem = DIMENSIONELEMENTPRINCIPALNAME (dmItem, sItem);
sSPP = DIMENSIONELEMENTPRINCIPALNAME (dmSPP, sSPP);

psRE = DIMENSIONELEMENTPRINCIPALNAME(dmRE, psRE);
sNewRE = DIMENSIONELEMENTPRINCIPALNAME(dmRE, psRE);

#*************************************************************************************
#*** NOW CHECK IF ACCOUNT SELECTED HAS A MOVEMENT ACCOUNT ENABLED

sAccMACheck = ATTRS (dmAcc, vsAcc, 'movement account required');

IF (sAccMACheck @<> 'Y');
     #*** RELATED ENTITY CHECK FOR NON BALANCE SHEET/MOVEMENT ACCOUNT CODES
     sAccRECheck = ATTRS (dmAcc, vsAcc, 'related entity enabled'); 
     sAccRE = ATTRS (dmAcc, vsAcc, 'assumed related entity');

     IF (sAccRECheck @= 'Y');
     #*** RELATED ENTITY IS ENABLED ***#
          IF (sAccRE @= '');
               #*** ASSUMED RELATED ENTITY IS BLANK, SO USE USER ENTERED ***#
               sNewRE = psRE;
          ELSE;
               #*** ELSE SYSTEM DERIVED RELATED ENTITY
               sNewRE = sAccRE;
          ENDIF;
     ELSE;
          #*** NO RELATED ENTITY
         sNewRE = '-'; 
     ENDIF;

ELSE;

     #*** RELATED ENTITY CHECK FOR BALANCE SHEET/MOVEMENT ACCOUNT CODES
     sMARECheck = ATTRS (dmMA, vsMA, 'related entity enabled'); 
     sMARE = ATTRS (dmMA, vsMA, 'assumed related entity');

     IF (sMARECheck @= 'Y');
     #*** RELATED ENTITY IS ENABLED ***#
          IF (sMARE @= '');
               #*** ASSUMED RELATED ENTITY IS BLANK, SO USE USER ENTERED ***#
               sNewRE = psRE;
          ELSE;
               #*** ELSE SYSTEM DERIVED RELATED ENTITY
               sNewRE = sMARE;
          ENDIF;
     ELSE;
          IF (sMARE @<> '');
               sNewRE = sMARE;
          ELSE;
               #*** NO RELATED ENTITY
              sNewRE = '-'; 
          ENDIF;
     ENDIF;

ENDIF;

IF (psRE @= '');
     psRE = '-';
ENDIF;

#*************************************************************************************
#*** NOW CHECK IF ACCOUNT SELECTED HAS A JURISDICTION REQUIRED

sAccJurCheck = ATTRS (dmAcc, vsAcc, 'jurisdiction required');
IF (sAccJurCheck @<> 'Y');
     psJur = '-';
ENDIF;

#*************************************************************************************
#*** DO DATA ENTRY ***#

IF (vsMeas @= 'factor');
     IF (CELLISUPDATEABLE (cbAE, psHLYear, psScenario, psStatus, sOC, sNewRE, sFunc, sReason, sSPP, psMeasCode, sType, vsMA, sItem, psProg, vsAcc, psID, psJur, psPer) = 1);
          nOldValue = CELLGETN(cbAE, psHLYear, psScenario, psStatus, sOC, sNewRE, sFunc, sReason, sSPP, psMeasCode, sType, vsMA, sItem, psProg, vsAcc, psID, psJur, psPer);
          CELLPUTN ((pnValue * Value) + nOldValue, cbAE, psHLYear, psScenario, psStatus, sOC, sNewRE, sFunc, sReason, sSPP, psMeasCode, sType, vsMA, sItem, psProg, vsAcc, psID, psJur, psPer);
     ENDIF;

ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbAccTemp, sAEView);
SUBSETDESTROY (dmAccTemp, sAEView);
SUBSETDESTROY (dmAccTempRecType, sAEView);
SUBSETDESTROY (dmAccType, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmAccTempMeas, sAEView);
#endregion