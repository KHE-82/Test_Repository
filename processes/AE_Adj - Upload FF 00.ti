#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               AE_Adj - Upoad FF 00
#**** DESCRIPTION:       This process will run the upload process and determine which process to run
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#**** May 2024 	KG	 Updated to incorporate Costings FF Upload
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';

#******************************************************************************************************************
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#******************************************************************************************************************
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sFilePath = ATTRS (dmVar, 'sys_upload directory', 'value');
#sFileName = sFilePath | '\' | psFileName;
sFileName = sFilePath | psFileName;

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** CLEAR VALIDATION
#******************************************************************************************************************
CELLPUTS ('', cbClient, sUser,  'sys_ImpFileValidation', 'value');

#******************************************************************************************************************
#*** STEP 1 - IDENTIFY WHICH PROCESS TO RUN
#******************************************************************************************************************

IF (psFFType @= 'Old CBMS Format');

	#---- Standard CBMS Accounts
	sProcess = 'AE_Adj - Upload FF 01 - Original CBMS Format';
	EXECUTEPROCESS (sProcess, 'psUser', sUser, 'psFileName', sFileName, 'psSign', psSign);

ELSEIF (psFFType @= 'Standard CBMS Format'  % psFFType @= 'Standard CBMS' );

	#---- Standard CBMS Accounts
	sProcess = 'AE_Adj - Upload FF 02 - CBMSR Format';
	EXECUTEPROCESS (sProcess, 'psUser', sUser, 'psFileName', sFileName, 'psSign', psSign);

ELSEIF (psFFType @= 'Costings FF');

	#--------------------------------------
	#--- psFileName brings FULL file link
	#--------------------------------------
	sProcess = 'AE_Adj - Upload FF 05 - Costings Flatfile';
	EXECUTEPROCESS (sProcess, 'psUser', sUser, 'psFileName', psFileName, 'psSign', psSign);


ELSEIF (psFFType @= 'Account Template');

	#--- Account Template
	sProcess = 'AE_Adj - Upload FF 03 - Account Template Format';
	EXECUTEPROCESS (sProcess, 'psUser', sUser, 'psFileName', sFileName);

ELSEIF(psFFType @= 'FBO Template');

	#--- FBO
	sProcess = 'AE_Adj - Upload FF 05';

ENDIF;




#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion