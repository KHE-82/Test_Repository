#******************************************************************************************************************
#**** STEP 01 - CREATE ALL FE3 ADJUSTMENT
#******************************************************************************************************************
sFE3Meas = 'Total FE3 adjustment value';
sProcess = 'sys_AE Generate FE3 Adj 01 - Clear Temporary Dimension';
ExecuteProcess(sProcess);

sProcess = 'sys_AE Generate FE3 Adj 02 - Review and Populate ID List';
ExecuteProcess(sProcess,'psUser', psUser, 'psProg', psProg, 'psFE2Year', psFE2Year,  'psFE3Year', psFE3Year, 'psFE3Meas', sFE3Meas,'psCreateAdjByMeasures', psCreateAdjByMeasures);

sProcess = 'sys_AE Generate FE3 Adj 03 - Copy Data From FE3 Calculation Cube';
ExecuteProcess(sProcess, 'psUser', psUser, 'psProg', psProg, 'psFE2Year', psFE2Year,  'psFE3Year', psFE3Year, 'psFE3Meas', sFE3Meas, 'psCreateAdjByMeasures', psCreateAdjByMeasures);


#******************************************************************************************************************
