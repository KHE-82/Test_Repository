#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_AE_NewZeroID_07 - Index Cube - Load data to current round
#**** DESCRIPTION:       This process copies cumulative index data in the index cube from the newly archived scenario into the 
#****		          previous cumulative index element in the current scenario
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 12/05/2014    KG             Initial Revision
#**** 2019	KG	Updated for NEW GEUS
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE INDEX CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbIndex = 'index';
dmIndexMeas = ' index measure';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

#sHLYear = ATTRS(dmVar, 'archive year', 'old value');
#sScenario = ATTRS(dmVar, 'archive scenario', 'old value');
#sTargetHLYear = ATTRS(dmVar, 'archive year', 'value');
#sTargetScenario = ATTRS(dmVar, 'archive scenario', 'value');
sTargetHLYear = ATTRS(dmVar, 'headline year', 'value');
sTargetScenario = 'current';
#sHLYear = ATTRS(dmVar, 'archive year', 'value');
#sScenario = ATTRS(dmVar, 'archive scenario', 'value');
#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = '$ArchiveClear';
#sView = '$Archive';
sSubset = sView;
sIndexMeasure = 'index';
sTargetIndexMeasure = 'previous index';

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbIndex, sView);
SubsetDestroy(dmHLyear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmIndexMeas, sSubset);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLyear, sSubset);
SubsetElementInsert(dmHLyear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);

# Index measure
SubsetCreate(dmIndexMeas, sSubset);
SubsetElementInsert(dmIndexMeas, sSubset, sTargetIndexMeasure, 1);

#****BUILD VIEW****#
ViewCreate(cbIndex, sView);

ViewSubsetAssign(cbIndex, sView, dmHLyear, sSubset);
ViewSubsetAssign(cbIndex, sView, dmScenario, sSubset);
ViewSubsetAssign(cbIndex, sView, dmIndexMeas, sSubset);

ViewSetSkipZeroes(cbIndex, sView, 1);
ViewSetSkipCalcs(cbIndex, sView, 1);
ViewZeroOut(cbIndex, sView);

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbIndex, sView);
SubsetDestroy(dmHLyear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmIndexMeas, sSubset);


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SOURCE VIEWS
#---------------------------------------------------------------------------------------------------------------------------

sView = '$NewBaseline';
sSubset = sView;

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

# copy data to the previous index element in the index measure dimension
IF (CELLISUPDATEABLE (cbIndex, psTargetHLYear, psTargetScenario, vsIndex, sTargetIndexMeasure, vsPeriod) = 1);
	CELLPUTN(vnValue, cbIndex, psTargetHLYear, psTargetScenario, vsIndex, sTargetIndexMeasure, vsPeriod);
ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

cbIndex = 'index';
sView = '$NewBaseline';
sSubset = sView;

#****DELETE EXISTING VIEWS AND SUBSETS

ViewDestroy(cbIndex, sView);
SubsetDestroy(dmHLyear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmIndexMeas, sSubset);

#endregion