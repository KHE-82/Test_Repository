IF( CellIsUpdateable(cbMeasDet,vsHLYear, 'current',vsMeasCode,vsMeas)=1);

IF(vsMeas @= 'used' % vsMeas @= 'sys_current measure counter');
	CellPutN(1, cbMeasDet,vsHLYear, 'current',vsMeasCode,vsMeas);
ELSE;
	CellPutS(vsValue, cbMeasDet,vsHLYear, 'current',vsMeasCode,vsMeas);

ENDIF;

