#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               z_MIgration - Reason Dimension Update
#**** DESCRIPTION:       This process will create new attributes and update those attributes
#****
#****                                 
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 01/08/2017    KG             Initial Revision
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------
#-- Declare dimension and cube
#---------------------------------------------------------------------------------------------
dmDim = 'reason';
dmDimMeas =  '}ElementAttributes_' | dmDim;
cbAttr = '}ElementAttributes_' | dmDim;


#---------------------------------------------------------------------------------------------
#--- Declare attributes
#---------------------------------------------------------------------------------------------
sAttr1 = 'CBMS code and description';
sAttr2 = 'CBMS reason code';
sAttr3 = 'CBMS';
sAttr4 = 'CBMS-R Mapping';
#sAttr4 = 'description';
#sAttr5 = 'cbms1 old cash flow map';
#sAttr6 = 'cbms1 old assumed related entity';

#---------------------------------------------------------------------------------------------
#--- Create attributes
#---------------------------------------------------------------------------------------------
ATTRINSERT (dmDim, '', sAttr1, 'A');
ATTRINSERT (dmDim, '', sAttr2, 'A');
ATTRINSERT (dmDim, '', sAttr3, 'A');
ATTRINSERT (dmDim, '', sAttr4, 'S');
#ATTRINSERT (dmDim, '', sAttr4, 'A');
#ATTRINSERT (dmDim, '', sAttr5, 'S');
#ATTRINSERT (dmDim, '', sAttr6, 'S');

#---------------------------------------------------------------------------------------------
#-- STEP 01 : DELETE EXISTING ATTRIBUTES
#---------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------
#-- DESTROY EXISTING VIEW
#---------------------------------------------------------------------------------------------
sView = '$ClearAttr';
VIEWDESTROY (cbAttr, sView);
SUBSETDESTROY (dmDim, sView);
SUBSETDESTROY (dmDImMeas, sView);

#---------------------------------------------------------------------------------------------
#-- CREATE SUBSETS
#---------------------------------------------------------------------------------------------

# Dimension
MDX = '{TM1SUBSETALL( [' | dmDim | '] )}';
SUBSETCREATEBYMDX  (sView, MDX);

# Dimension Measure
SUBSETCREATE (dmDimMeas, sView);
SUBSETELEMENTINSERT (dmDimMeas, sView, sAttr1, 1);
SUBSETELEMENTINSERT (dmDimMeas, sView,sAttr2, 2);
SUBSETELEMENTINSERT (dmDimMeas, sView, sAttr3, 3);
SUBSETELEMENTINSERT (dmDimMeas, sView, sAttr4, 4);

#---------------------------------------------------------------------------------------------
#-- CREATE VIEWS
#---------------------------------------------------------------------------------------------
VIEWCREATE (cbAttr, sView);
VIEWSUBSETASSIGN (cbAttr, sView, dmDim, sView);
VIEWSUBSETASSIGN (cbAttr, sView, dmDimMeas, sView);

#VIEWZEROOUT (cbAttr, sView);

#---------------------------------------------------------------------------------------------
#-- DESTROY EXISTING VIEW
#---------------------------------------------------------------------------------------------
VIEWDESTROY (cbAttr, sView);
SUBSETDESTROY (dmDim, sView);
SUBSETDESTROY (dmDImMeas, sView);

#endregion
#region Metadata

