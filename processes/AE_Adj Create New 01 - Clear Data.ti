#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Adj Create New 01 - Clear Data
#**** DESCRIPTION:       This process creates a new adjustment and clears any current data in the current user set.
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';


#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED
#******************************************************************************************************************
sView = sUser | ' $NewAdj01';

#******************************************************************************************************************
#*** STEP 1 : CLEAR OUT OLD NEW ADJUSTMENT DATA SETS
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbClient, sView);
SUBSETDESTROY (dmClient, sView);
SUBSETDESTROY (dmClientPref, sView);

#******************************************************************************************************************
#*** CREATE SUBSETS
#******************************************************************************************************************
# Client
SUBSETCREATE (dmClient, sView);
SUBSETELEMENTINSERT (dmClient, sView, sUser, 1);

# Client Preference
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmClientPref | '] )}, 0)}, [' | dmClientPref | '].[system] = "")}';
SUBSETCREATEBYMDX (sView, MDX);
SUBSETMDXSET (dmClientPref, sView, MDX);

#******************************************************************************************************************
#*** BUILD VIEW
#******************************************************************************************************************
VIEWCREATE (cbClient, sView);
VIEWSUBSETASSIGN (cbClient, sView, dmClient, sView);
VIEWSUBSETASSIGN (cbClient, sView, dmClientPref, sView);


ViewExtractSkipZeroesSet(cbClient, sView, 1);
ViewSuppressZeroesSet(cbClient, sView, 1);
ViewExtractSkipCalcsSet(cbClient, sView, 1);

VIEWZEROOUT (cbClient, sView);

#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbClient, sView);
SUBSETDESTROY (dmClient, sView);
SUBSETDESTROY (dmClientPref, sView);


#******************************************************************************************************************
#*** ADD DEFAULT VALUES 
#******************************************************************************************************************
#-------------------------------------------------------
#--- Apply Parameters
#-------------------------------------------------------
CELLPUTS ('No', cbClient, sUser, 'adj_apply param', 'value');

#-------------------------------------------------------
#--- Measure Code
#-------------------------------------------------------
CELLPUTS ('No Measure', cbClient, sUser, 'adj_measure code', 'value');
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion