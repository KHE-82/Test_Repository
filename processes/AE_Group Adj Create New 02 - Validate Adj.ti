#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               AE_Group Adj Create New 02 - Validate Adj
#**** DESCRIPTION:       This process creates a new adjustment and validates
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#***********************************************************************************************************************


#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#******************************************************************************************************************
#*** DECLARE AE ID DETAILS CUBE DIMENSIONS
#******************************************************************************************************************
cbID = 'AE id details';
dmIDMeas = 'id measure';


#-------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE
#-------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';
dmCtrlType = 'control type';
dmFavID = 'favourites_id';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sNoMeasCode = ATTRS(dmVar, 'No Measure Code', 'value');

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED
#******************************************************************************************************************
sView = sUser | ' $NewGroupAdj02';

#******************************************************************************************************************
#*** VARIABLES USED 
#******************************************************************************************************************
sStatus = 'unauthorised';
sAdjType = 'Group';


#*****************************************************************************************************************************************************
#**** STEP 1 - VALIDATE CURRENT DATA ENTRY 
#******************************************************************************************************************
#*** VALIDATION CHECK RESETS
#*** These validation checks are set to 0, to reset. 
#*** 0 means valid, Greater than 0, means it is invalid
#******************************************************************************************************************

sErrCtrlType = '';
sErrProg = '';
sErrReason = '';
sErrMeasCode = '';
sErrTitle = '';
sErrDesc = '';

sErrFavID = '';
sErrOC = '';
sErrFunc = '';
sErrSPP = '';
sErrType = '';
sErrItem = '';

#----------------------------------------------------------------------
#*** Clear validate rules
#----------------------------------------------------------------------
CELLPUTS (sErrCtrlType, cbClient, sUser, 'adj_control type', 'validate');
CELLPUTS (sErrProg, cbClient, sUser, 'adj_programme code', 'validate');
CELLPUTS (sErrReason, cbClient, sUser, 'adj_reason', 'validate');
CELLPUTS (sErrMeasCode, cbClient, sUser, 'adj_measure code', 'validate');
CELLPUTS (sErrTitle, cbClient, sUser, 'adj_title', 'validate');
CELLPUTS (sErrDesc, cbClient, sUser, 'adj_description', 'validate');

CELLPUTS (sErrFavID, cbClient, sUser, 'adj_favourite id', 'validate');
CELLPUTS (sErrOC, cbClient, sUser, 'adj_outcome', 'validate');
CELLPUTS (sErrFunc, cbClient, sUser, 'adj_function', 'validate');
CELLPUTS (sErrSPP, cbClient, sUser, 'adj_SPP', 'validate');
CELLPUTS (sErrType, cbClient, sUser, 'adj_appropriation type', 'validate');
CELLPUTS (sErrItem, cbClient, sUser, 'adj_appropriation item', 'validate');

#----------------------------------------------------------------------
#*** Reset Validation Counters
#----------------------------------------------------------------------
nCtrlTypeValid = 0;
nProgValid = 0;
nReasonValid = 0;
nMeasCodeValid = 0;
nTItleValid = 0;
nDescValid = 0;

nFavIDValid = 0;
nOCValid = 0;
nFuncValid = 0;
nSPPValid = 0;
nTypeValid = 0;
nItemValid = 0;

nIDValid = 0;

#******************************************************************************************************************
#*** CONTROL TYPE
#*** Check if control type is valid
#******************************************************************************************************************

IF (DIMIX (dmCtrlType, psControlType) = 0);
	sErrCtrlType = 'Control Type selected does not exist';
	nCtrlTypeValid = nCtrlTypeValid + 1;
ENDIF;


#******************************************************************************************************************
#*** MEASURE CODE
#*** Check if this element exist
#******************************************************************************************************************
IF (DIMIX (dmMeasCode, psMeasCode) = 0);
	sErrMeasCode = 'Measure Code selected does not exist';
	nMeasCodeValid = nMeasCodeValid + 1;
ELSE;

	#*****************************************************************************
	#**** CHECK IF MEASURE CODE IS A POSTING LEVEL (N) LEVEL ELEMENT
	#*****************************************************************************
	sMeasCodeType = DTYPE (dmMeasCode, psMeasCode);
	IF (sMeasCodeType @<> 'N');
		nMeasCodeValid = nMeasCodeValid + 1;
		sErrMeasCode = 'Measure Code entered is not a Posting Level element';
	ENDIF;
ENDIF;

#******************************************************************************************************************
#*** REASON CODE
#*** Certain reason codes require initiative codes and/or commonwealth grants
#*** These reason codes need to be checked to ensure they are in line
#******************************************************************************************************************
sReasMeasReq = ATTRS (dmReason, psReason, 'measure required');
sReasMeasOpt = ATTRS (dmReason, psReason, 'measure optional');

#*** REASON CODE REQUIRES BOTH COMMONWEALTH GRANT & INITIATIVE CODE
IF (DIMIX (dmReason, psReason) = 0);
	nReasonValid = nReasonValid + 1;
	sErrReason = 'Reason Code selected does not exist';
ELSE;

	#******************************************************************************************************************
	#*** GET PRINCIPAL ELEMENT NAME FROM PARAMETERS
	#******************************************************************************************************************
	sMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, psMeasCode);

	#-------------------------------------------------------------------------------------
	#*** REASON CODE NEEDS A MEASURE CODE AND IS NOT OPTIONAL
	#-------------------------------------------------------------------------------------
	IF ((UPPER(sReasMeasReq) @= 'Y' & UPPER(sReasMeasOpt) @<> 'Y') & sMeasCode @= sNoMeasCode);
		nReasonValid = nReasonValid + 1;
		sErrMeasCode = 'Please select a valid Measure Code';
		sErrReason = 'Reason code selected requires a valid Measure Code';
		nReasonValid = nReasonValid + 1;

	ELSE;

		#------------------------------------------------------------------------------------
		#*** REASON CODE DOES NOT NEED A MEASURE CODE AND IS NOT OPTIONAL
		#-------------------------------------------------------------------------------------
		IF ((UPPER(sReasMeasReq) @<> 'Y' & UPPER(sReasMeasOpt) @<> 'Y') & sMeasCode @<> sNoMeasCode);
			sErrReason = 'Reason code selected does not require a Measure Code';
			sErrMeasCode = 'Please select No Measure for this reason code';
			nReasonValid = nReasonValid + 1;
		ENDIF;
	ENDIF;
ENDIF;



#******************************************************************************************************************
#*** TITLE
#*** Title can not be blank or greater than 250 characters
#******************************************************************************************************************
IF (psTitle @= '');
	sErrTitle = 'Title can not be blank';
	nTitleValid = nTitleValid + 1;
ELSE;
	IF (LONG(psTitle) > 250);
		sErrTitle = 'Please review title as it has more than 250 characters long';
		nTitleValid = nTitleValid + 1;
	ENDIF;
ENDIF;


#******************************************************************************************************************
#*** STEP 02 - PERFORM VALIDATION
#*** CALCULATE ALL VALIDATIONS
#******************************************************************************************************************
nIDValid = nCtrlTypeValid + nProgValid + nReasonValid + nMeasCodeValid + nTItleValid + nDescValid + nFavIDValid + nOCValid + nFuncValid + nSPPValid + nTypeValid + nItemValid;

IF (nIDValid > 0);

	#******************************************************************************************************************
	#*** VALIDATION FAILED
	#******************************************************************************************************************

	CELLPUTS (sErrCtrlType, cbClient, sUser, 'adj_control type', 'validate');
	CELLPUTS (sErrProg, cbClient, sUser, 'adj_programme code', 'validate');
	CELLPUTS (sErrReason, cbClient, sUser, 'adj_reason', 'validate');
	CELLPUTS (sErrMeasCode, cbClient, sUser, 'adj_measure code', 'validate');
	CELLPUTS (sErrTitle, cbClient, sUser, 'adj_title', 'validate');
	CELLPUTS (sErrDesc, cbClient, sUser, 'adj_description', 'validate');

	CELLPUTS (sErrFavID, cbClient, sUser, 'adj_favourite id', 'validate');
	CELLPUTS (sErrOC, cbClient, sUser, 'adj_outcome', 'validate');
	CELLPUTS (sErrFunc, cbClient, sUser, 'adj_function', 'validate');
	CELLPUTS (sErrSPP, cbClient, sUser, 'adj_SPP', 'validate');
	CELLPUTS (sErrType, cbClient, sUser, 'adj_appropriation type', 'validate');
	CELLPUTS (sErrItem, cbClient, sUser, 'adj_appropriation item', 'validate');


	#******************************************************************************************************************
	#*** RUN UPDATE CLIENT PREFERENCE AGAIN TO ENSURE LIST IS UPDATED IF THINGS CHANGE
	#******************************************************************************************************************
	#EXECUTEPROCESS ('sys_Client - Update Client Prefrence Picklists', 'psUser', psUser, 'psHLYear', curHLYear, 'psScenario', curScenario);

	#******************************************************************************************************************
	#*** STOP PROCESS SINCE VALIDATION FAILED
	#******************************************************************************************************************

	PROCESSQUIT;

ELSE;
	#******************************************************************************************************************
	#*** EXECUTE NEXT PROCESS
	#*** RUN PROCESS TO CREATE NEW SYSTEM ID
	#******************************************************************************************************************
	StringGlobalVariable ('NextID');

	sNewIDProcess = 'AE_Adj - Assign New ID';	
	sProcess = 'sys_Queue - Add Process to Queue';
	EXECUTEPROCESS(sProcess, 'psTI', sNewIDProcess, 'psParams','psUser;' | sUser);

	sNewID = NextID;

	#******************************************************************************************************************
	#*** VALIDATION PASSED 
	#*** CREATE NEW ADJUSTMENT
	#******************************************************************************************************************

	#******************************************************************************************************************
	#*** POST ENTERED DATA IN AE ID DETAIL CUBE
	#*** ALSO STORE WITHIN SYS CLIENT PREFERENCE CUBE
	#******************************************************************************************************************

	#******************************************************************************************************************
	#*** AE ID DETAIL CUBE POSTING
	#******************************************************************************************************************
	#CELLPUTN (1, cbID, curHLYear, curScenario, sNewID, 'used');
	CELLPUTS (sStatus, cbID, curHLYear, curScenario, sNewID, 'status');
	CELLPUTS (sAdjType, cbID, curHLYear, curScenario, sNewID, 'adjustment type');
	CELLPUTS ('Y', cbID, curHLYear, curScenario, sNewID, 'use new cash flow derivation');

	
	CELLPUTS (psGroupAdjType, cbID, curHLYear, curScenario, sNewID, 'Group Adj Type');

	#******************************************************************************************************************
	# **** GET DATE VALUES AND POST USER AND DATE STAMP
	#******************************************************************************************************************
     	sDNow = TimST( Now, '\D'); 
	sMNow = TimST( Now, '\m'); 
     	sYNow = TimST( Now, '\Y'); 

	sDay = TRIM(SUBST(sDNow, 1,2));

	IF (LONG (sDay) = 1);
          		sDay = '0' | sDay;
     	ELSE;
          		sDay = sDay;
     	ENDIF;

	sMonth = TRIM(SUBST(sMNow, 1,2));

	IF (LONG (sMonth) = 1);
          		sMonth = '0' | sMonth;
     	ELSE;
          		sMonth = sMonth;
     	ENDIF;

     	sYear = TRIM(SUBST(sYNow, 1,4));
	sNow = sDay | '/' | sMonth | '/' | sYear;

	CELLPUTS(sNow, cbID, curHLYear, curScenario, sNewID, 'created date');
	CELLPUTS(sUser, cbID, curHLYear, curScenario, sNewID, 'created by');

	#******************************************************************************************************************
	#*** GET PRINCIPAL ELEMENT NAME FROM PARAMETERS
	#******************************************************************************************************************

	sControlType = DIMENSIONELEMENTPRINCIPALNAME (dmCtrlType, psControlType);

	sProg = 'multiple';
	sReason = DIMENSIONELEMENTPRINCIPALNAME (dmReason, psReason);
	#sReasonDesc = ATTRS (dmReason, sReason, 'CBMS');
	sMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, psMeasCode);

	sOC = 'multiple';
	sFunc = 'multiple';
	sSPP = 'multiple';
	sType = 'multiple';
	sItem = 'multiple';
	sFavID = '';

	#******************************************************************************************************************
	#*** POST METADATA OF ADJUSTMENT IN AE ID DETAIL
	#******************************************************************************************************************

	CELLPUTS (sControlType,  cbID, curHLYear, curScenario, sNewID, 'control type');

	CELLPUTS (psTItle, cbID, curHLYear, curScenario, sNewID, 'title');
	CELLPUTS (psDesc, cbID, curHLYear, curScenario, sNewID, 'description');
	CELLPUTS (psComments, cbID, curHLYear, curScenario, sNewID, 'comments');

	CELLPUTS (sProg, cbID, curHLYear, curScenario, sNewID, snProg | ' code');

	CELLPUTS (sReason, cbID, curHLYear, curScenario, sNewID, 'reason');
	CELLPUTS (sMeasCode, cbID, curHLYear, curScenario, sNewID, 'measure');


	IF (psApplyParam @= 'Yes' % psApplyParam @= 'Y');
		CELLPUTS('Y', cbID, curHLYear, curScenario, sNewID, 'apply parameters');
	ELSE;
		CELLPUTS('', cbID, curHLYear, curScenario, sNewID, 'apply parameters');
	ENDIF;

	CELLPUTS (sOC, cbID, curHLYear, curScenario, sNewID, 'outcome');
	CELLPUTS (sFunc, cbID, curHLYear, curScenario, sNewID, 'function');
	CELLPUTS (sSPP, cbID, curHLYear, curScenario, sNewID, 'SPP');
	CELLPUTS (sType, cbID, curHLYear, curScenario, sNewID, 'appropriation type');
	CELLPUTS (sItem, cbID, curHLYear, curScenario, sNewID, 'appropriation item');

	CELLPUTS (sFavID,  cbID, curHLYear, curScenario, sNewID, 'account favourite template');


	CELLPUTS (curHLYear, cbClient, sUser, 'geus hlyear', 'value');
	CELLPUTS (curScenario, cbClient, sUser, 'geus scenario', 'value');
	CELLPUTS (sNewID, cbClient, sUser, 'geus adj', 'value');

	#---------------------------------------------------------------------------------------------
	#--- OTHER FIELDS
	#---------------------------------------------------------------------------------------------
	sMeasFundLife = ATTRS (dmMeasCode, sMeasCode, 'Funding Life');
	IF (sMeasFundLife @= '');
		sMeasFundLife = 'ongoing';
	ENDIF;

	CELLPUTS (sMeasFundLife,  cbID, curHLYear, curScenario, sNewID, 'funding life');


	#******************************************************************************************************************
	#*** PUBLISHED TITLE SAME AS TITLE WHEN NEW ADJUSTMENT IS CREATED
	#******************************************************************************************************************
	CELLPUTS (psTItle, cbID, curHLYear, curScenario, sNewID, 'published title');


ENDIF;


#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion