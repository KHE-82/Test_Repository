#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              AE_Adj - Upload FF 04 - Account Template Format - Send To AE Adj
#**** DESCRIPTION:       This process will load the entered values to the AE adjustments cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 01/07/2014    KG             Initial Revision
#**** 2019	KGi  	  Updated for NEW GEUS
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE TEMPORARY DIMENSION
#******************************************************************************************************************
dmTmpID = '}tmp_ID_tmp ' | sUser;

#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES
#******************************************************************************************************************
dmVar = 'variables'; 
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sAgencyCode = ATTRS(dmVar, 'agency code', 'value');
sExpFilePath = ATTRS(dmVar, 'sys_Costings Export Directory', ' value');
sImpFilePath = ATTRS(dmVar, 'sys_Costings Import Directory', ' value');
sImpLogFilePath = ATTRS(dmVar, 'sys_ImpFileExceptionLogs', ' value');
sDefCashAcc = ATTRS(dmVar, 'Default Cash Flow account', ' value');


DATASOURCETYPE ='SUBSET';
DATASOURCENAMEFORSERVER = dmTmpID;
DATASOURCEDIMENSIONSUBSET = 'All';
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


#*******************************************************************************************************************
#*** CALL PROCESS TO SEND DATA TO AE ADJUSTMENTS CUBE ***#
#*******************************************************************************************************************
sProcess = 'AE_GrpAdj_SendtoAdj';
EXECUTEPROCESS (sProcess, 'psUser', sUser, 'psHLYear', curHLYear, 'psScenario', curScenario, 'psID', vsID);

#*******************************************************************************************************************
#*** CALL PROCESS TO SEND DATA FOR WORKERS COMPENSATION JOURNAL ***#
#*******************************************************************************************************************
sWorkersCompCheck = ATTRS(dmTmpID, vsID, 'Workers Comp');
IF (sWorkersCompCheck @<> '');
	sProcess = 'AE_GrpAdj_WorkersCompAdj';
	EXECUTEPROCESS (sProcess, 'psUser', sUser, 'psHLYear', curHLYear, 'psScenario', curScenario, 'psID', vsID);
ENDIF;
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion