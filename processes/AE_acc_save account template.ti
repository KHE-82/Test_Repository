#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               AE_acc_save account template
#**** DESCRIPTION:       This process will create a temporary id for the account selected by the user
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 26/03/2014    KG             Initial Revision
#****
#***********************************************************************************************************************

#*** DECLARE CUBES & DIMENSIONS ***#
dmAccTemp = 'account template';

dmClients = '}Clients';

# *** IDENTIFY CURRENT USER ***#
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;

#**** NOW ADD TITLE AND DESCRIPTION TO ATTRIBUTES ***#
ATTRPUTS (psTitle, dmAccTemp, psID, 'title');
ATTRPUTS (psDesc, dmAccTemp, psID, 'description');
ATTRPUTS (psStatus, dmAccTemp, psID, 'status');

IF (psRE @= 'Yes');
     ATTRPUTS ('Y', dmAccTemp, psID, 'related entity enabled');
ELSE;
   ATTRPUTS ('', dmAccTemp, psID, 'related entity enabled');
ENDIF;

IF (psJur @= 'Yes');
     ATTRPUTS ('Y', dmAccTemp, psID, 'jurisdiction required');
ELSE;
     ATTRPUTS ('', dmAccTemp, psID, 'jurisdiction required');
ENDIF;

#endregion
