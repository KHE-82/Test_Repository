#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              AE_Reco - CBMSR Reconciliation Upoad
#**** DESCRIPTION:       This process will load a CBMS Upload file into GEUS for reconciliation purposes
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 13/06/2014    KG             Initial Revision
#**** 08/08/2017	KG	Converting this process from AE_CBMS Reconciliations to AE_Reco - CBMSR Reconciliatio Upload
#**** 2020 	KG	 Updated for New GEUS
#*** 16/11/2020	KG	  Updated validations
#*** 16/01/2024	BL	  Added Sys_Logging function to Data Tab
#*** 09/01/2025	KG	Updated to skip 5235501 and 5243002
#***********************************************************************************************************************

snProg = 'programme';
curPrc = GETPROCESSNAME();

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#*****************************************************************************
#*** DECLARE CUBES AND DIMENSIONS***#
#*****************************************************************************
sCube = 'AE adjustments';
sView = '$RECO';
sSubset = sView;

cbProg = snProg | ' details';
dmProg = snProg;

cbID = 'AE id details';

# BL ADDED 16/01/2024
cbSysLog = 'sys_logging';
dmRowID = 'RowID';
dmSysLogMeas = 'sys_logging measure';


#*****************************************************************************
#*** DECLARE AE ADJUSTMENTS DIMENSIONS ***#
#*****************************************************************************
dmID = 'id';
dmOC = 'outcome';
dmRE = 'related entity';
dmReason = 'reason';
dmType = 'appropriation type';
dmItem = 'appropriation item';
dmFunc = 'function';
dmMeas = 'measure code';
dmAcc = 'account';
dmMA = 'movement account';
dmSPP = 'spp';

#*****************************************************************************
#*** DECLARE SYSTEM VARIABLES
#*****************************************************************************
dmVar = 'variables';
dmVar = 'variables'; 
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sImpFilePath = ATTRS(dmVar, 'sys_ImpFileExceptionLogs', ' value');
sDefOC = ATTRS(dmVar, 'AE Default Outcome', 'value');
sOutputFile = 'cbms upload extract failed.csv';

sScenario = 'CBMS';
sStatus = 'data';
sReason = 'Other variations not elsewhere defined';
sID = '0000A';



#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, 'GEUS User Name');
                IF (sUser @= '');
                          PROCESSQUIT;
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;


#*****************************************************************************************************************************************************
#****  STEP 1 -CLEAR SYS LOGGING CUBE FOR USER #BL ADDED 16/01/2024
#*****************************************************************************************************************************************************
sView =sUser| ' $SysLogClear';

#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbSysLog, sView);
SUBSETDESTROY (dmClient, sView);
SUBSETDESTROY (dmrowID,sView);
SUBSETDESTROY (dmSysLogMeas, sView);

#-------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#-------------------------------------------------------------------------------------------------------------

#Clients
MDX = ' { [' | dmClient  | ' ].[' | psUser | '] } ';
SUBSETCREATEBYMDX ( sView, MDX );

#RowID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRowID | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

#sysLogMeasure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmsysLogMeas | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

#-------------------------------------------------------------------------------------------------------------
#*** BUILD VIEW
#-------------------------------------------------------------------------------------------------------------
VIEWCREATE (cbSysLog, sView);
VIEWSUBSETASSIGN (cbSysLog, sView, dmClient, sView);
VIEWSUBSETASSIGN (cbSysLog, sView ,dmRowID, sView);
VIEWSUBSETASSIGN (cbSysLog, sView, dmSysLogMeas, sView);

#-------------------------------------------------------------------------------------------------------------
# *** DEFINE VIEW EXTRACT
#-------------------------------------------------------------------------------------------------------------
VIEWSUPPRESSZEROESSET(cbsysLog, sView, 1);
VIEWEXTRACTSKIPZEROESSET (cbSysLog, sView, 1);
VIEWEXTRACTSKIPRULEVALUESSET (cbSysLog, sView, 1);
VIEWEXTRACTSKIPCALCSSET (cbSysLog, sView, 1);

#-------------------------------------------------------------------------------------------------------------
# ***CLEAR VIEW
#-------------------------------------------------------------------------------------------------------------
VIEWZEROOUT(cbSysLog,sView);

#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbSysLog, sView);
SUBSETDESTROY (dmClient, sView);
SUBSETDESTROY (dmrowID,sView);
SUBSETDESTROY (dmSysLogMeas, sView);


#*****************************************************************************************************************************************************
#****  STEP 2 - CLEAR TARGET AE ADJ VIEW
#*****************************************************************************************************************************************************


#*****************************************************************************
#****DELETE EXISTING VIEWS AND SUBSETS
#*****************************************************************************
ViewDestroy(sCube, sView);
SubsetDestroy('headline year', sSubset);
SubsetDestroy('scenario', sSubset);
SubsetDestroy(dmProg, sSubset);

#*****************************************************************************
#****CREATE SUBSETS****#
#*****************************************************************************
# headline year
SubsetCreate('headline year', sSubset);
SubsetElementInsert('headline year', sSubset, curHLYear, 1);

#*****************************************************************************
# Scenario
#*****************************************************************************
SubsetCreate('scenario', sSubset);
SubsetElementInsert('scenario', sSubset, sScenario, 1);

#*****************************************************************************
# Programme
#*****************************************************************************
#MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].[Total Programmes] }, ALL, RECURSIVE )}, 0)}';
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

#*****************************************************************************
#****BUILD VIEW
#*****************************************************************************
ViewCreate(sCube, sView);

ViewSubsetAssign(sCube, sView, 'headline year', sSubset);
ViewSubsetAssign(sCube, sView, 'scenario', sSubset);
ViewSubsetAssign(sCube, sView, dmProg, sSubset);

#ViewSetSkipZeroes(sCube, sView, 1);
#ViewSetSkipCalcs(sCube, sView, 1);
ViewZeroOut(sCube, sView);


#*****************************************************************************
#****DELETE EXISTING VIEWS AND SUBSETS
#*****************************************************************************
ViewDestroy(sCube, sView);
SubsetDestroy('headline year', sSubset);
SubsetDestroy('scenario', sSubset);
SubsetDestroy(dmProg, sSubset);


#*****************************************************************************
#*** FILE VALIDATION FLAG VARIABLES
#*****************************************************************************
nLine = 2;
nTotalValid = 0;

nValid = 0;
nTotalValid = 0;


#*****************************************************************************
#*** SET IMPORT FILE STATUS BACK TO PASS ***#
#*****************************************************************************
                ATTRPUTS ('PASS', dmVar, 'sys_ImpFileValidation', 'value');
                CELLPUTS ('PASS', cbClient, psUser, 'sys_ImpFileValidation', 'value');


#*****************************************************************************
#*** IDENTIFY SOURCE FILE
#*****************************************************************************
sFilePath = ATTRS (dmVar, 'sys_CBMS Upload directory', 'value');
#sFileName = sFilePath | '\' | psFileName;
sFileName = sFilePath | psFileName;
DATASOURCENAMEFORSERVER = sFileName;


sProcess = 'sys_logging - clear';
EXECUTEPROCESS (sProcess,'psUser', psUser);

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****



#*****************************************************************************
# SKIP CERTAIN ACCOUNTS
#*****************************************************************************
# Account
IF (vsAcc @= '3322001' % vsAcc @= '5235501' %vsAcc @= '5243002' % vsAcc @= '2330008' % vsAcc @= '2330009' % vsAcc @= '3322002' % vsAcc @= '9000510' % vsAcc @= '9000515' % vsAcc @= '9000520' % vsAcc @= '9000525' % vsAcc @= '8260010' % vsAcc @= '5235501' % vsAcc @= '5235502');
                ItemSkip;
ENDIF;

IF (vsMA @= '7894' );
                ItemSkip;
ENDIF;

IF( ABS(p00)+ABS(p01)+ABS(p02)+ABS(p03)+ABS(p04)+ABS(p05)+ABS(p06)+ABS(p07)+ABS(p08)+ABS(p09)+ABS(p10)+ABS(p11)+ABS(p12)+ABS(p13)+ABS(p14)+ABS(p15)=0);
                ItemSkip;
ENDIF;

IF( scan('(Annual Only)', vsAccName) <>0);
                ItemSkip;
ENDIF;


IF(vsProg@='6209');
                Itemskip;
ENDIF;

#*****************************************************************************
#*** PERFORM A VALIDATION TEST ***#
#*****************************************************************************

nProgValid = 0;
nOCValid = 0;
nMeasValid = 0;
nReasValid = 0;
nFuncValid = 0;
nMAValid = 0;
nAccValid = 0;
nItemValid = 0;
nTypeValid = 0;
nREValid  = 0;
nSPPValid = 0;

#*****************************************************************************
#**** PERFORM ADDITIONAL CHECKS - 20150407
#*****************************************************************************
nJurValid = 0;
nAccREValid = 0;
nAccJurValid = 0;
nAccMAValid = 0;
nMAREValid = 0;

nTitleValid = 0;



#*************************************************************************************************************************************#
#**** DEFAULT VALUES
#*************************************************************************************************************************************#

#---------------------------------------------------------------
# Get outcome element
#---------------------------------------------------------------
IF (vsOC @= 'Outcome Unallocated');
	vsOC = '12389';
ELSE;
	IF (DIMIX(dmOC, vsOC) = 0);
          		vsOC = '12389';
     	ELSE;
          		vsOC = vsOC;
     	ENDIF;
ENDIF;

#---------------------------------------------------------------
# Get movement account element
#---------------------------------------------------------------
IF (vsMA @= '');
	vsMA = '-';
ELSE;
	vsMA = vsMA;
ENDIF;

#---------------------------------------------------------------
# Get related entity element
#---------------------------------------------------------------
IF (vsRE @= '');
	vsRE = '-';
ELSE;
	vsRE = vsRE;
ENDIF;

#---------------------------------------------------------------
# Get SPP element
#---------------------------------------------------------------
IF (vsSPP @= '');
	vsSPP = '-';
ELSE;
	vsSPP = vsSPP;
ENDIF;

#---------------------------------------------------------------
# Get jurisdiction element
#---------------------------------------------------------------
IF (vsJur @= '');
	vsJur = '-';
ELSE;
	vsJur = vsJur;
ENDIF;

#---------------------------------------------------------------
#* Get Appropriation Item elemnent
#---------------------------------------------------------------
IF (vsItem @= '');
	vsItem = '-';
ELSE;
	vsItem = vsItem;
ENDIF;

#---------------------------------------------------------------
#* Get Measure Code Element
#---------------------------------------------------------------
IF (vsMeasCode @= '');
	vsMeasCode = 'M00000';
ELSE;
	vsMeasCode = 'M00000';
ENDIF;


#*************************************************************************************************************************************#
#**** VALIDATION CHECKS
#*************************************************************************************************************************************#

#---------------------------------------------------------------
#*** Check Programme
#---------------------------------------------------------------
IF (DIMIX (dmProg, vsProg) = 0);
	IF (vsProg @<> 'Program Unallocated');
		nProgValid = nProgValid + 1;
	ENDIF;
ELSE;
	sCtrlTypeCheck = CELLGETS (cbProg, curHLYear, curScenario, vsProg, 'Control Type');
	IF (sCtrlTypeCheck @<> vsControlType);
# 		nProgValid = nProgValid + 1;
     	ENDIF;
ENDIF;

#---------------------------------------------------------------
#*** Check Outcome
#---------------------------------------------------------------
IF (DIMIX (dmOC, vsOC) = 0);
	nOCValid = nOCValid + 1;
ENDIF;

#---------------------------------------------------------------
#*** Check Measure
#---------------------------------------------------------------
IF (DIMIX (dmMeas, vsMeasCode) = 0);
	sMeasValid = 'FAIL';
	nMeasValid = nMeasValid + 1;
ENDIF;

#---------------------------------------------------------------
#*** Check Reason
#---------------------------------------------------------------
IF (DIMIX (dmReason, vsReason) = 0);
	nReasValid = nReasValid + 1;
     	nReasValid = 0;
ENDIF;

#---------------------------------------------------------------
#*** Check Function
#---------------------------------------------------------------
IF (DIMIX (dmFunc, vsFunc) = 0);
	nFuncValid = nFuncValid + 1;
ENDIF;

#---------------------------------------------------------------
#*** Check MA
#---------------------------------------------------------------
IF (DIMIX (dmMA, vsMA) = 0);
	nMAValid = nMAValid + 1;
ENDIF;

#---------------------------------------------------------------
#*** Check Account
#---------------------------------------------------------------
IF (DIMIX (dmAcc, vsAcc) = 0);
	nAccValid = nAccValid + 1;
ENDIF;

#---------------------------------------------------------------
#*** Check Appropriation Item
#---------------------------------------------------------------
IF (DIMIX (dmItem, vsItem) = 0);
	nItemValid = nItemValid + 1;
ENDIF;

#---------------------------------------------------------------
#*** Appropriation Type
#---------------------------------------------------------------
IF (vsItem @= '-');
	vsType = CELLGETS (cbProg, curHLYear, sScenario, vsProg, 'appropriation type');
	IF (vsType @= '');
		vsType = 'Appropriation Type - Unallocated';
		vsItem = '-';
	ELSE;
		vsType = vsType;
		vsItem = CELLGETS(cbProg, curHLYear, sScenario, vsProg, 'appropriation item');
	ENDIF;
ELSE;
	vsType = SUBST(vsItem, 1,4);
ENDIF;


#---------------------------------------------------------------
#*** Check Appropriation Type
#---------------------------------------------------------------
IF (DIMIX (dmType, vsType) = 0);
	nTypeValid = nTypeValid + 1;
ENDIF;

#---------------------------------------------------------------
#*** Check Related Entity
#---------------------------------------------------------------
IF (DIMIX (dmRE, vsRE) = 0);
	nREValid = nREValid + 1;
ENDIF;

#---------------------------------------------------------------
#*** Check SPP
#---------------------------------------------------------------
IF (DIMIX (dmSPP, vsSPP) = 0);
	nSPPValid = nSPPValid + 1;
ENDIF;


#*************************************************************************************************************************************#
#**** CREATE OUTPUT FILES FOR FAILED VALIDATIONS
#*************************************************************************************************************************************#

nValid = nProgValid + nOCValid + nMeasValid + nReasValid + nFuncValid +  nMAValid + nAccValid +  nTypeValid + nItemValid + nREValid + nSPPValid;
nTotalValid = nTotalValid + nValid;
IF (nValid > 0);
     	IF (nProgValid > 0);
     		ASCIIOUTPUT ('program error.csv', 'Programme Code error on line ', NUMBERTOSTRING(nLine), vsProg, vsControlType);

		sErrMsg = 'Programme Code error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsProg |', '| vsControlType;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nMeasValid > 0);
     		ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Measure Code error on line ', NUMBERTOSTRING(nLine), vsMeasCode);

		sErrMsg = 'Measure Code error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsMeasCode;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nReasValid > 0);
          		ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Reason Code error on line ', NUMBERTOSTRING(nLine), vsReason);

		sErrMsg = 'Reason Code error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsReason;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nOCValid > 0);
          		ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Outcome Code error on line ', NUMBERTOSTRING(nLine), vsOC);

		sErrMsg = 'Outcome Code error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsOC;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nFuncValid > 0);
          		ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Function Code error on line ', NUMBERTOSTRING(nLine), vsFunc);

		sErrMsg = 'Function Code error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsFunc;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nMAValid > 0);	
          		ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Movement Account Code error on line ', NUMBERTOSTRING(nLine), vsMA);

		sErrMsg = 'Movewment Account Code error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsMA;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nAccValid > 0);
          		ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Account Code error on line ', NUMBERTOSTRING(nLine), vsAcc);

		sErrMsg = 'Account Code error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsAcc;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nTypeValid > 0);
          		ASCIIOUTPUT (sImpFilePath  | sOutputFile, 'Appropriation Type error on line ', NUMBERTOSTRING(nLine), curHLYear, sScenario, vsProg, vsType, vsItem);

		sErrMsg = 'Appropriation Type error on line ' | NUMBERTOSTRING(nLine);
		sCmt =  CurHLYear |'; '| sScenario |'; '| vsProg |'; '| vsType | '; ' |  vsItem;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nItemValid > 0);
          		ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Appropriation Item error on line ', NUMBERTOSTRING(nLine), vsItem);

		sErrMsg = 'Programme Code error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsItem;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nREValid > 0);
          		ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Related Entity error on line ', NUMBERTOSTRING(nLine), vsRE);

		sErrMsg = 'Related Entity error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsRE;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	IF (nSPPValid > 0);
          		ASCIIOUTPUT (sImpFilePath  | sOutputFile, 'SPP error on line ', NUMBERTOSTRING(nLine), vsSPP);

		sErrMsg = 'SPP error on line ' | NUMBERTOSTRING(nLine);
		sCmt = vsSPP;
		sProcess = 'sys_logging - update';
		EXECUTEPROCESS (sProcess,'psUser', psUser, 'psProcName', CurPrc, 'psErrorMsg', sErrMsg, 'psCmt', sCmt);
     	ENDIF;

     	

ENDIF;

nLine = nLine + 1;

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#*****************************************************************************
#**** SKIP LINE IF DIMENSIONS ARENT VALID ***#
#*****************************************************************************
IF (nTotalValid > 0);
               	ATTRPUTS ('FAIL', dmVar, 'sys_ImpFileValidation', 'value');
                
	#BL 16/01/2024 HASHED AOUT NEXT LINE & ADDED FOLLOWING LINES FOR SYS_LOGGING PROCESS
	#CELLPUTS ('FAIL', cbClient, psUser, 'sys_ImpFileValidation', 'value');
	CELLPUTS ('FAIL: ' | 'Please View the Upload Error Log and correct any data errors', cbClient, psUser,  'sys_ImpFileValidation', 'value');
	               	
	PROCESSBREAK;
               	ITEMSKIP;
ENDIF;

IF( ABS(p00)+ABS(p01)+ABS(p02)+ABS(p03)+ABS(p04)+ABS(p05)+ABS(p06)+ABS(p07)+ABS(p08)+ABS(p09)+ABS(p10)+ABS(p11)+ABS(p12)+ABS(p13)+ABS(p14)+ABS(p15)=0);
                ItemSkip;
ENDIF;	


# Account
IF (vsAcc @= '3322001' % vsAcc @= '5235501' %vsAcc @= '5243002' % vsAcc @= '2330008' % vsAcc @= '2330009' % vsAcc @= '3322002' % vsAcc @= '9000510' % vsAcc @= '9000515' % vsAcc @= '9000520' % vsAcc @= '9000525' % vsAcc @= '8260010' );
                ItemSkip;
ENDIF;

IF( scan('(Annual Only)', vsAccName) <>0);
                ItemSkip;
ENDIF;

IF(vsStage@='draft' % vsStage @='To authorise');
             #  Itemskip;
ENDIF;

IF(vsProg@='6209');
                Itemskip;
ENDIF;

IF( vsFormID@<>'');
                #ITemsKip;
ENDIF;




IF (vsMA @= '7894' );
                ItemSkip;
ENDIF;


#*****************************************************************************
#**** PERFORM DATA ENTRY
#*****************************************************************************
sID = '0000A';

#---------------------------------------------------------------
# Get period elements
#---------------------------------------------------------------
#Period02 = SUBST(ATTRS(dmVar, 'headline year', 'value'), 3, 9);
sHLPer = SUBST(ATTRS(dmVar, 'headline year', 'value'), 3, 9);

Period00 = DIMNM('period', DIMIX('period', sHLPer) -2);
Period01 = DIMNM('period', DIMIX('period', sHLPer) -1);
Period02 = DIMNM('period', DIMIX('period', sHLPer) -0);
Period03 = DNEXT('period', Period02);
Period04 = DNEXT('period', Period03);
Period05 = DNEXT('period', Period04);
Period06 = DNEXT('period', Period05);
Period07 = DNEXT('period', Period06);
Period08 = DNEXT('period', Period07);
Period09 = DNEXT('period', Period08);
Period10 = DNEXT('period', Period09);
Period11 = DNEXT('period', Period10);
Period12 = DNEXT('period', Period11);
Period13 = DNEXT('period', Period12);
Period14 = DNEXT('period', Period13);
Period15 = DNEXT('period', Period14);
Period16 = DNEXT('period', Period15);

#---------------------------------------------------------------
# Account
#---------------------------------------------------------------
IF (vsAcc @= '3322001' % vsAcc @= '3322002');
	ItemSkip;
ENDIF;

#********************************************************************************************
#**** DEFAULT ACCOUNTS ****#

#---------------------------------------------------------------
# Programme
#---------------------------------------------------------------

IF (DIMIX (dmProg, vsProg) = 0);
	IF (vsControlType @= 'Administered');
		vsProg = 'ABUDME';
     	ELSE;
          		vsProg = 'BUDME';
     	ENDIF;
ENDIF;

#---------------------------------------------------------------
# Get outcome element
#---------------------------------------------------------------
IF (vsOC @= 'Outcome Unallocated');
	vsOC = sDefOC;
ELSE;
	IF (DIMIX(dmOC, vsOC) = 0);
          		vsOC = sDefOC;
     	ELSE;
          		vsOC = vsOC;
     	ENDIF;
ENDIF;

#---------------------------------------------------------------
# Get movement account element
#---------------------------------------------------------------
IF (vsMA @= '');
	vsMA = '-';
ELSE;
	vsMA = vsMA;
ENDIF;

#---------------------------------------------------------------
# Get related entity element
#---------------------------------------------------------------
IF (vsRE @= '');
	vsRE = '-';
ELSE;
	vsRE = vsRE;
ENDIF;

#---------------------------------------------------------------
# Get SPP element
#---------------------------------------------------------------
IF (vsSPP @= '');
	vsSPP = '-';
ELSE;
	vsSPP = vsSPP;
ENDIF;

#---------------------------------------------------------------
# Get jurisdiction element
#---------------------------------------------------------------
IF (vsJur @= '');
	vsJur = '-';
ELSE;
	vsJur = vsJur;
ENDIF;

#---------------------------------------------------------------
#* Get Appropriation Item elemnent
#---------------------------------------------------------------
IF (vsItem @= '');
	vsItem = '-';
ELSE;
	vsItem = vsItem;
ENDIF;


#---------------------------------------------------------------
# Get programme element (deliberately at this position rather than at the beginning with the other elements)
#---------------------------------------------------------------
sSubProg = vsProg;
sElType = DTYPE(dmProg, sSubProg);
WHILE (sElType @= 'C');
	sSubProg = ELCOMP(dmProg, sSubProg, 1);
	sElType = DTYPE(dmProg, sSubProg);
END;

IF (vsItem @= '-');
	vsType = CELLGETS (cbProg, curHLYear, curScenario, sSubProg, 'appropriation type');
	IF (vsType @= '');
		vsType = 'Appropriation Type - Unallocated';
		vsItem = '-';
	ELSE;
		vsType = vsType;
		vsItem = CELLGETS(cbProg, curHLYear, curScenario, sSubProg, 'appropriation item');
	ENDIF;
ELSE;
	vsType = SUBST(vsItem, 1,4);
ENDIF;


#---------------------------------------------------------------
#* Get Measure Code Element
#---------------------------------------------------------------
IF (vsMeasCode @= '');
	vsMeasCode = 'M00000';
ELSE;
    	vsMeasCode = 'M00000';
ENDIF;


#****************************************************************************************************************************
#*** SEARCH DESCRIPTION IF IT HAS A GEUS ID AND FIND ID AND POPULATE ADJUSTMENT CODE ***#
#****************************************************************************************************************************
sGEUSID = SUBST(vsComments, 2, 5);
IF (DIMIX (dmID, sGEUSID) <> 0);
	sTitle = CELLGETS (cbID, curHLYear, curScenario, sGEUSID, 'title');

	#***************************************************************************************************************************
     	#*** GET DESCRIPTION VALUE, ONLY GET 100 CHARACTERS, SHOULD BE ENOUGH TO DO A CHECK
     	#***************************************************************************************************************************
     	sDesc = CELLGETS (cbID, curHLYear, curScenario, sGEUSID, 'description');
     	sDesc = TRIM(SUBST (sDesc, 1,100));
     	vsDesc = TRIM (SUBST(vsDesc, 1, 100));

     	IF (sTItle @<> '');
		sAdjType = CELLGETS (cbID, curHLYear, curScenario, sGEUSID, 'Adjustment Type');
          		IF (sAdjType @= 'Group');

               			#****************************************************************************************************************************
			#*** GROUP ADJUSTMENTS ***#
			#****************************************************************************************************************************
               			vsProg = vsProg;
               			sOldCBMSAdj = CELLGETS (cbID, curHLYear, curScenario, sGEUSID, 'CBMS ID');
               			nSCANCBMS = SCAN(vsFormID, sOldCBMSAdj);

               			IF (sOldCBMSAdj @= '');
                     
				#*** THIS IS IF THERE IS NO Adjustment ID ***#
                     			CELLPUTS (vsFormID, cbID, curHLYear, curScenario, sGEUSID, 'CBMS ID');
               			ELSE;
                     			CELLPUTS (sOldCBMSAdj |','| vsFormID, cbID, curHLYear, curScenario, sGEUSID, 'CBMS ID');
               			ENDIF;
          		ELSE;
               			#****************************************************************************************************************************
			#*** MANUAL ADJUSTMENTS ***#
			#****************************************************************************************************************************
               			sID = sGEUSID;
               			sProg = CELLGETS(cbID, curHLYear, curScenario, sGEUSID, 'programme code');
               			IF (DIMIX(dmProg, sProg) <> 0);

	    			#***************************************************************************************************************************
	    			#*** NEW CHECK IS ADDED AS SOMETIMES NOW CLIENTS HAVE BEEN ROLLING OVER TWICE
	   			#*** THIS CHECKS TO SEE IF THE DESCRIPTION IS THE SAME AS THE CBMS DESCRIPTION, IF SO USE THE DETAILS IN THE ID DETAILS CUBE
	    			#***************************************************************************************************************************
	    			IF (sTitle @= vsDesc);
                    				vsProg = sProg;
                    				CELLPUTS (vsFormID, cbID, curHLYear, curScenario, sGEUSID, 'CBMS ID');
	    			ELSE;
					vsProg = vsProg;
	    			ENDIF;

               			ELSE;
                    			vsProg = vsProg;
               			ENDIF;
          		ENDIF;
     	ELSE;
          		#*** DO NOTHING AS IF THERE IS NO TITLE FOR THIS ADJUSTMENT JUST LEAVE AS IS ***#
	ENDIF;
ENDIF;


#****************************************************************************************************************************
# Get existing value from cube
#****************************************************************************************************************************
OldP00 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period00);
OldP01 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period01);
OldP02 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period02);
OldP03 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period03);
OldP04 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period04);
OldP05 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period05);
OldP06 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period06);
OldP07 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period07);
OldP08 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period08);
OldP09 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period09);
OldP10 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period10);
OldP11 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period11);
OldP12 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period12);
OldP13 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period13);
OldP14 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period14);
OldP15 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period15);
#OldP16 = CellGetN(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period16);

#---------------------------------------------------------------
# Convert signage on flat file value
#---------------------------------------------------------------
IF (vsMA @= '-');
	X = ATTRS(dmAcc, vsAcc, 'DR/CR');
ELSE;
	X = ATTRS(dmMA, vsMA, 'DR/CR');
ENDIF;

IF (X @= 'CR');
	iConversion = -1;
ELSE;
	iConversion = 1;
ENDIF;

NP00 = P00 * iConversion;
NP01 = P01 * iConversion;
NP02 = P02 * iConversion;
NP03 = P03 * iConversion;
NP04 = P04 * iConversion;
NP05 = P05 * iConversion;
NP06 = P06 * iConversion;
NP07 = P07 * iConversion;
NP08 = P08 * iConversion;
NP09 = P09 * iConversion;
NP10 = P10 * iConversion;
NP11 = P11 * iConversion;
NP12 = P12 * iConversion;
NP13 = P13 * iConversion;
NP14 = P14 * iConversion;
NP15 = P15 * iConversion;
#NP16 = P16 * iConversion;

#****************************************************************************************************************************
# Get programme element (deliberately at this position rather than at the beginning with the other elements)
#****************************************************************************************************************************
sElType = DTYPE(dmProg, vsProg);
WHILE (sElType @= 'C');
	vsProg = ELCOMP(dmProg, vsProg, 1);
	sElType = DTYPE(dmProg, vsProg);
END;



IF (CellisUpdateable(sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period01) = 1);

	CellPutN(OldP00 + NP00, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period00);

     	CellPutN(OldP01 + NP01, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period01);
     	CellPutN(OldP02 + NP02, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period02);
     	CellPutN(OldP03 + NP03, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period03);
     	CellPutN(OldP04 + NP04, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period04);
     	CellPutN(OldP05 + NP05, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period05);
     	CellPutN(OldP06 + NP06, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period06);
     	CellPutN(OldP07 + NP07, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period07);
     	CellPutN(OldP08 + NP08, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period08);
     	CellPutN(OldP09 + NP09, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period09);
     	CellPutN(OldP10 + NP10, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period10);
     	CellPutN(OldP11 + NP11, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period11);
     	CellPutN(OldP12 + NP12, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period12);
     	CellPutN(OldP13 + NP13, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period13);
     	CellPutN(OldP14 + NP14, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period14);
     	CellPutN(OldP15 + NP15, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period15);
#     	CellPutN(OldP16 + NP16, sCube, curHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period16);

ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

IF (nTotalValid > 0);
	PROCESSQUIT;
ENDIF;

#*****************************************************************************
#**** VALIDATION PASSED ****#
#*****************************************************************************


#*****************************************************************************************************************************************************
#**** CLEAR SYS LOGGING CUBE FOR USER #BL ADDED 16/01/2024
#*****************************************************************************************************************************************************
sView =sUser| ' $SysLogClear';

#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbSysLog, sView);
SUBSETDESTROY (dmClient, sView);
SUBSETDESTROY (dmrowID,sView);
SUBSETDESTROY (dmSysLogMeas, sView);

#-------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#-------------------------------------------------------------------------------------------------------------

#Clients
MDX = ' { [' | dmClient  | ' ].[' | psUser | '] } ';
SUBSETCREATEBYMDX ( sView, MDX );

#RowID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRowID | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

#sysLogMeasure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmsysLogMeas | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

#-------------------------------------------------------------------------------------------------------------
#*** BUILD VIEW
#-------------------------------------------------------------------------------------------------------------
VIEWCREATE (cbSysLog, sView);
VIEWSUBSETASSIGN (cbSysLog, sView, dmClient, sView);
VIEWSUBSETASSIGN (cbSysLog, sView ,dmRowID, sView);
VIEWSUBSETASSIGN (cbSysLog, sView, dmSysLogMeas, sView);

#-------------------------------------------------------------------------------------------------------------
# *** DEFINE VIEW EXTRACT
#-------------------------------------------------------------------------------------------------------------
VIEWSUPPRESSZEROESSET(cbsysLog, sView, 1);
VIEWEXTRACTSKIPZEROESSET (cbSysLog, sView, 1);
VIEWEXTRACTSKIPRULEVALUESSET (cbSysLog, sView, 1);
VIEWEXTRACTSKIPCALCSSET (cbSysLog, sView, 1);

#-------------------------------------------------------------------------------------------------------------
# ***CLEAR VIEW
#-------------------------------------------------------------------------------------------------------------
VIEWZEROOUT(cbSysLog,sView);

#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbSysLog, sView);
SUBSETDESTROY (dmClient, sView);
SUBSETDESTROY (dmrowID,sView);
SUBSETDESTROY (dmSysLogMeas, sView);

#endregion