#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               sys_Nav - Home FF to Bulk Process
#**** DESCRIPTION:       This process is used for TM1 Web to navigate from Home Flatfile  to Bulk Process
#****
#****		          
#****                                
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#**** 2020	KG	. Updated to ensure if user doesnt have selected HLYear or Scenario, it will add current
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#******************************************************************************************************************
#*** DECLARE AE ID DETAILS
#******************************************************************************************************************
cbID = 'AE id details';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmID = 'id';
dmIDMeas = 'id measure';

#******************************************************************************************************************
#*** DECLARE CLIENT GROUPS CUBE
#******************************************************************************************************************
cbGroups = '}ClientGroups';
dmGroups = '}Groups';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');


#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** BULK PRINT SUBSETS
#******************************************************************************************************************

sPrintSubset = sUser | '_$sysBulkPrintList';
nMaxPrintCounter = 20;

#******************************************************************************************************************
#*** GET CLIENT DETAILS & ID DETAILS
#******************************************************************************************************************
sHLYear = CELLGETS (cbClient, sUser, 'geus hlyear', 'value');
sScenario = CELLGETS (cbClient, sUser, 'geus scenario', 'value');

#-----------------------------------------------------
#--- Validation to ensure a valid HLYear and Scenario is in User when they first go to bulk processing
#-----------------------------------------------------
IF (sHLYear @= '');
	CELLPUTS (psHLYear, cbClient, sUser, 'geus hlyear', 'value');
ENDIF;

IF (sScenario @= '');
	CELLPUTS (psScenario, cbClient, sUser, 'geus scenario', 'value');
ENDIF;



#******************************************************************************************************************
#*** EXECUTE PROCESS FOR CLIENT PREFERENCE PICK LIST
#******************************************************************************************************************
sProcess = 'sys_Client - Update Client Prefrence Picklists';
EXECUTEPROCESS (sProcess, 'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario);

#******************************************************************************************************************
#*** EXECUTE PROCESS TO UPDATE CLIENT BULK PROCESS SUBSET
#******************************************************************************************************************
sProcess = 'sys_Client - Update Bulk Process Subset';
sMDX = '{ [' | dmID | '].[cash flow]}';
sFilter = '';
EXECUTEPROCESS (sProcess, 'psUser', psUser, 'psMDX', sMDX, 'psFilter', sFilter, 'psHLYear', psHLYear, 'psScenario', psScenario);



#******************************************************************************************************************
#*** BULK PRINT SUBSETS
#******************************************************************************************************************
SUBSETDESTROY (dmID, sPrintSubset);
lPrintCounter = 1;


#******************************************************************************************************************
#*** PRE-POPULATE BULK PROCESS SELECT PROCESS FIELD TO FLATFILE CREATION
#******************************************************************************************************************
sProcess = 'Flat File Creation';
CELLPUTS (sProcess, cbClient, psUser, 'sys_bulk process', 'value');

#endregion
#region Metadata

