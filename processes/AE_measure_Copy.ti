#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_measure_Copy
#**** DESCRIPTION:       This process will create a copy of the selected measure
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 05/05/2014    KG             Initial Revision
#**** 23/06/2015    KG             Update Variables
#***   27/11/2015	KG	Updated - to incorporate using bulk process
#***********************************************************************************************************************



#*** DECLARE CUBES & DIMENSIONS ***#
cbMeasID = 'government measures details';
cbMeas = 'government measures';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmControlType = 'control type';
dmFundType = 'measure fund type';
dmMeasType = 'measure type';
dmMeasCode = 'measure code';
dmPer = 'period';
dmMeasDetail = 'measure details';

#*** DECLARE SYSTEM DIMENSIONS ***# 
dmVar = 'variables';
dmClients = '}Clients';
dmProg = 'program';

#*** DECLARE VARIABLES ***#
curHLYear = ATTRS(dmVar, 'headline year', 'value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sCurUser = TM1User();

dmClients = '}Clients';
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sObject = sUser | '_$ViewMeas';
sView =  sUser | '_$ViewMeas';

#*** RETRIEVE GOVERNMENT MEASURE DETAILS ***#
sCtrlType = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'control type');
sFundLife = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'funding life');
sMeasType = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure type');
sCBMSMeasCode = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'CBMS Measure Code');
sGovtDec = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'government decision');
sDecDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'decision date');
sTitle = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure title');
sDesc = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure description');
sProg = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'related programme code');
sStartDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'start date');
sEndDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'end date');
sTermYear = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'termination year');


#**************************************************************************************************************8
#*** STEP 1 - CREATE SOURCE MEASURE CUBE VIEW ***#

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbMeas, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmStatus, sView);
SUBSETDESTROY (dmControlType, sView);
SUBSETDESTROY (dmFundType, sView);
SUBSETDESTROY (dmMeasType, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmPer, sView);
SUBSETDESTROY (dmMeasDetail, sView);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sView);
SubsetElementInsert(dmHLYear, sView, psHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sView);
SubsetElementInsert(dmScenario, sView, psScenario, 1);

# Status
SubsetCreate(dmStatus, sView);
SubsetElementInsert(dmStatus, sView, 'data', 1);

# Control Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmControlType | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);


# Measure Fund Type
SubsetCreate(dmFundType, sView);
SubsetElementInsert(dmFundType, sView, sFundLife, 1);

# Measure Type
SubsetCreate(dmMeasType, sView);
SubsetElementInsert(dmMeasType, sView, sMeasType, 1);

# Measure Code
SubsetCreate(dmMeasCode, sView);
SubsetElementInsert(dmMeasCode, sView, psMeasCode, 1);


# Period
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")}';
SUBSETCREATEBYMDX (sView, MDX);


# Measure Details
SubsetCreate(dmMeasDetail, sView);
SubsetElementInsert(dmMeasDetail, sView, 'value', 1);
SubsetElementInsert(dmMeasDetail, sView, 'ASL', 2);

# Measure Details

#*** BUILD VIEW ***#
VIEWCREATE (cbMeas, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmHLYear, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmScenario, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmStatus, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmControlType, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmFundType, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmMeasType, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmMeasCode, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmPer, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmMeasDetail, sView);

# *** DEFINE VIEW EXTRACT
ViewExtractSkipZeroesSet(cbMeas, sView, 1);
ViewSuppressZeroesSet(cbMeas, sView, 1);
ViewExtractSkipCalcsSet(cbMeas, sView, 1);

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;


#*****************************************************************************************************************************************************
#*** STEP 2 - GET NEW ID NUMBER ***#
nNewID = CELLGETN(cbMeasID, curHLYear, curScenario, 'Total Measures', 'used') + 1;
sNewID = NUMBERTOSTRING(nNewID);

IF (LONG(sNewID) = 1);
     sNewID = 'M0000' | sNewID;
ENDIF;

IF (LONG(sNewID) = 2);
     sNewID = 'M000' | sNewID;
ENDIF;

IF (LONG(sNewID) = 3);
     sNewID = 'M00' | sNewID;
ENDIF;

IF (LONG(sNewID) = 4);
     sNewID = 'M0' | sNewID;
ENDIF;

IF (LONG(sNewID) = 5);
     sNewID = sNewID;
ENDIF;

lCounter = 0;

IF (DIMIX (dmMeasCode, sNewID) = 0);
	sProcess = 'AE_Create Measure Code';
	EXECUTEPROCESS(sProcess, 'psUser', sUser, 'psID', sNewID);
ENDIF;


#*****************************************************************************************************************************************************
# **** GET DATE VALUES ***#
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 

sDay = TRIM(SUBST(sDNow, 1,2));

IF (LONG (sDay) = 1);
     sDay = '0' | sDay;
ELSE;
     sDay = sDay;
ENDIF;

sMonth = TRIM(SUBST(sMNow, 1,2));

IF (LONG (sMonth) = 1);
     sMonth = '0' | sMonth;
ELSE;
     sMonth = sMonth;
ENDIF;

sYear = TRIM(SUBST(sYNow, 1,4));
sNow = sDay | '/' | sMonth | '/' | sYear;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** CREATE NEW ADJUSTMENT ***#

nYear = STRINGTONUMBER(SUBST(vsHLYear,3,4));
nCurrentYear = STRINGTONUMBER(SUBST(curHLYear,3,4));
nVariance = nCurrentYear - nYear;
snewHLYear = SUBST(vsHLYear,3,4);
snewcurHLYear = SUBST(curHLYear, 3,4);
sVariance = NUMBERTOSTRING(nvariance);

nPeriod1 = STRINGTONUMBER(SUBST(vsPer, 1,4));
nPeriod2 = STRINGTONUMBER(SUBST(vsPer, 6,4));

nNewPeriod1 = (nPeriod1 + nVariance);
nNewPeriod2 = (nPeriod2 + nVariance);

sNewPeriod = NUMBERTOSTRING(nNewPeriod1) |'-'| NUMBERTOSTRING(nNewPeriod2);

#*****************************************************************************************************************
#*** GET GOVERNMENT MEASURES DETAILS DATA ****#

IF (nVariance = 0 & vsScen @= 'current');
     #*** CHECK CURRENT ID DETAILS DATA
     sCtrlType = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'control type');
     sFundLife = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'funding life');
     sMeasType = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'measure type');
     sCBMSMeasCode = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'CBMS Measure Code');
     sGovtDec = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'government decision');
     sDecDate = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'decision date');
     sTitle = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'measure title');
     sDesc = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'measure description') | ' (Copy of measure ' | psMeasCode | ')';
     sProg = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'related programme code');
     sStartDate = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'start date');
     sEndDate = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'end date');
     sTermYear = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'termination year');

ELSE;
     sCtrlType = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'control type');
     sFundLife = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'funding life');
     sMeasType = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure type');
     sCBMSMeasCode = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'CBMS Measure Code');
     sGovtDec = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'government decision');
     sDecDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'decision date');
     sTitle = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure title');
     sDesc = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure description') | ' (Copy of measure ' | psMeasCode | ')';
     sProg = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'related programme code');
     sStartDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'start date');
     sEndDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'end date');
     sTermYear = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'termination year');
ENDIF;


#*****************************************************************************************************************
#**** INSERT DATA INTO GOVERNMENT MEASURES DETAILS CUBE ***#
CELLPUTN(1,cbMeasID, curHLYear, curScenario, sNewID, 'used');

sCurUser = TM1User();
sCurUser = ATTRS(dmClients, sCurUser, '}TM1_DefaultDisplayValue');

CELLPUTS(sCurUser, cbMeasID, curHLYear, curScenario, sNewID, 'Created By');
CELLPUTS ('draft', cbMeasID, curHLYear, curScenario, sNewID, 'status');

CELLPUTS (sCtrlType, cbMeasID, curHLYear, curScenario, sNewID, 'control type');
CELLPUTS (sFundLife, cbMeasID, curHLYear, curScenario, sNewID, 'funding life');
CELLPUTS (sMeasType, cbMeasID, curHLYear, curScenario, sNewID, 'measure type');
#CELLPUTS (sCBMSMeasCode, cbMeasID, curHLYear, curScenario, sNewID, 'CBMS Measure Code');
CELLPUTS ('TBA', cbMeasID, curHLYear, curScenario, sNewID, 'CBMS Measure Code');
CELLPUTS (sGovtDec, cbMeasID, curHLYear, curScenario, sNewID, 'government decision');
CELLPUTS (sDecDate, cbMeasID, curHLYear, curScenario, sNewID, 'decision date');
CELLPUTS (sTitle |  ' (Copy of measure ' | vsMeasCode | ')', cbMeasID, curHLYear, curScenario, sNewID, 'measure title');
CELLPUTS (sDesc, cbMeasID, curHLYear, curScenario, sNewID, 'measure description');

DIMENSIONELEMENTPRINCIPALNAME (dmProg, sProg);
CELLPUTS (sProg, cbMeasID, curHLYear, curScenario, sNewID, 'related programme code');

CELLPUTS (sStartDate, cbMeasID, curHLYear, curScenario, sNewID, 'start date');
CELLPUTS (sEndDate, cbMeasID, curHLYear, curScenario, sNewID, 'end date');
CELLPUTS (sTermYear, cbMeasID, curHLYear, curScenario, sNewID, 'termination year');
CELLPUTS ('Y', cbMeasID, curHLYear, curScenario, sNewID, 'current');


#*****************************************************************************************************************
#**** COPY VALUES INTO GOVERNMENT MEASURES CUBE ****#

IF (CELLISUPDATEABLE (cbMeas, curHLYear, curScenario, 'data', vsCtrlType, vsFundLife, vsMeasType, sNewID, sNewPeriod, vsMeas) = 1);
     CELLPUTN (Value, cbMeas, curHLYear, curScenario, 'data', vsCtrlType, vsFundLife, vsMeasType, sNewID, sNewPeriod, vsMeas);
ENDIF;

#*****************************************************************************************************************
#*** UPDATE MEASURE ATTRIBUTE ***#
sTitle = sTitle |  ' (Copy of measure ' | psMeasCode | ')';
sCDesc = sNewID | ' - ' | sTitle;

ATTRPUTS (sTitle , dmMeasCode, sNewID, 'title');
ATTRPUTS (sCDesc , dmMeasCode, sNewID, 'code and description');
ATTRPUTS (curHLYear, dmMeasCode, sNewID, 'Budget Round Created');
ATTRPUTS ('Y', dmMeasCode, sNewID, 'Active');
ATTRPUTS (sTermYear , dmMeasCode, sNewID, 'Termination Year');

#**** UPDATE USER PARAMETERS ****#
ATTRPUTS (curHLYear, dmClients, sCurUser, 'geus_hlyear');
ATTRPUTS (curScenario, dmClients, sCurUser, 'geus_scenario');
ATTRPUTS (sNewID, dmClients, sCurUser, 'geus_measure_id');

lCounter = lCounter + 1;



#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbMeas, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmStatus, sView);
SUBSETDESTROY (dmControlType, sView);
SUBSETDESTROY (dmFundType, sView);
SUBSETDESTROY (dmMeasType, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmPer, sView);
SUBSETDESTROY (dmMeasDetail, sView);

#*** THIS IS TO ADD TO GOVERNMENT MEASURES DETAILS CUBE REGARDLESS OF NO DATA AS DATA HAS BEEN COPIED ACCROSS ***#
IF (lCounter = 0);

     sCtrlType = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'control type');
     sFundLife = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'funding life');
     sMeasType = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure type');
     #sCBMSMeasCode = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'CBMS Measure Code');
     sGovtDec = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'government decision');
     sDecDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'decision date');
     sTitle = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure title');
     sDesc = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'measure description') | ' (Copy of measure ' | psMeasCode | ')';
     sProg = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'related programme code');
     sStartDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'start date');
     sEndDate = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'end date');
     sTermYear = CELLGETS (cbMeasID, psHLYear, psScenario, psMeasCode, 'termination year');

#*****************************************************************************************************************
     #**** INSERT DATA INTO GOVERNMENT MEASURES DETAILS CUBE ***#

     CELLPUTN(1,cbMeasID, curHLYear, curScenario, sNewID, 'used'); 
     CELLPUTS(sUser, cbMeasID, curHLYear, curScenario, sNewID, 'Created By');
     CELLPUTS ('draft', cbMeasID, curHLYear, curScenario, sNewID, 'status');
     CELLPUTS (sCtrlType, cbMeasID, curHLYear, curScenario, sNewID, 'control type');
     CELLPUTS (sFundLife, cbMeasID, curHLYear, curScenario, sNewID, 'funding life');
     CELLPUTS (sMeasType, cbMeasID, curHLYear, curScenario, sNewID, 'measure type');
     #CELLPUTS (sCBMSMeasCode, cbMeasID, curHLYear, curScenario, sNewID, 'CBMS Measure Code');
     CELLPUTS ('TBA', cbMeasID, curHLYear, curScenario, sNewID, 'CBMS Measure Code');
     CELLPUTS (sGovtDec, cbMeasID, curHLYear, curScenario, sNewID, 'government decision');
     CELLPUTS (sDecDate, cbMeasID, curHLYear, curScenario, sNewID, 'decision date');
     CELLPUTS (sTitle|  ' (Copy of measure ' | psMeasCode | ')', cbMeasID, curHLYear, curScenario, sNewID, 'measure title');
     CELLPUTS (sDesc, cbMeasID, curHLYear, curScenario, sNewID, 'measure description');

     DIMENSIONELEMENTPRINCIPALNAME (dmProg, sProg);
     CELLPUTS (sProg, cbMeasID, curHLYear, curScenario, sNewID, 'related programme code');

     CELLPUTS (sStartDate, cbMeasID, curHLYear, curScenario, sNewID, 'start date');
     CELLPUTS (sEndDate, cbMeasID, curHLYear, curScenario, sNewID, 'end date');
     CELLPUTS (sTermYear, cbMeasID, curHLYear, curScenario, sNewID, 'termination year');
     CELLPUTS ('Y', cbMeasID, curHLYear, curScenario, sNewID, 'current');

ENDIF;

#*****************************************************************************************************************
#*** UPDATE MEASURE ATTRIBUTE ***#
sTitle = sTitle |  '  (Copy of measure ' | psMeasCode | ')';
sCDesc = sNewID | ' - ' | sTitle;

ATTRPUTS (sTitle , dmMeasCode, sNewID, 'title');
ATTRPUTS (sCDesc , dmMeasCode, sNewID, 'code and description');
ATTRPUTS (curHLYear, dmMeasCode, sNewID, 'Budget Round Created');
ATTRPUTS ('Y', dmMeasCode, sNewID, 'Active');
ATTRPUTS (sTermYear , dmMeasCode, sNewID, 'Termination Year');
#endregion