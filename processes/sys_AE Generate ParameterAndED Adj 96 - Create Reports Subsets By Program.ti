#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE Generate ParameterAndED Adj 96 - Create Reports Subsets By Program

#*** DESCRIPTION:       This process will create a view for the parameters and efficiency dividend adjustments
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 28/04/2014    KG             Initial Revision
#**** 2019	KG	Update for NEW GEUS/PRIMUS
#****
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
dmProg = snProg;


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';
dmProgMeas = snProg | ' measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';


#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

curHLYear = ATTRS(dmVar, 'headline year', 'value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sNoMeasCode = ATTRS(dmVar, 'No Measure Code', 'value');
sNewReason = ATTRS(dmVar, 'FE3 Reason Code', 'value');






#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#******************************************************************************************************************
#*** RUN TI PROCESSES FOR GENERATION OF PARAMETERS/ED
#******************************************************************************************************************

#******************************************************************************************************************
#*** CLEAR SELECTED FLAGS
#******************************************************************************************************************
sProcess = 'sys_AE_Parameters 98 - Populate Generate Pack Flags';
ExecuteProcess(sProcess, 'psProg', psProg);


#******************************************************************************************************************
#**** STEP 03 - ADD SELECTED PROGRAMS TO REPORTING SUBSET WHICH CAN BE USED IN PRINT REPORTS
#******************************************************************************************************************
sProcess = 'sys_AE_Parameters 97 - Create Report Subsets';
ExecuteProcess(sProcess, 'psUser', psUser, 'psProg', psProg);


#******************************************************************************************************************
#*** CLEAR SELECTED FLAGS
#******************************************************************************************************************
sProcess = 'sys_AE_Parameters 99 - Clear Generate Pack Flags';
ExecuteProcess(sProcess, 'psProg', psProg);


#endregion