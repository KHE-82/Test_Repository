     CellPutN(OldP03 + NP03, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period03);
     CellPutN(OldP04 + NP04, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period04);
     CellPutN(OldP05 + NP05, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period05);
     CellPutN(OldP06 + NP06, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period06);
     CellPutN(OldP07 + NP07, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period07);
     CellPutN(OldP08 + NP08, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period08);
     CellPutN(OldP09 + NP09, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period09);
