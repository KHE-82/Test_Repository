#*****************************************************************************
#**** CONVERT SIGNAGE ON FLAT FILE VALUE
#*****************************************************************************  
IF (vsMA @= '-');
     X = ATTRS(dmAcc, vsAcc, 'DR/CR');
ELSE;
     X = ATTRS(dmMA, vsMA, 'DR/CR');
ENDIF;

IF (psSource @= 'CBMS');
     IF (X @= 'CR');
         iConversion = -1;
     ELSE;
          iConversion = 1;
     ENDIF;
ELSE;
     iConversion = 1;
ENDIF;


NP00 = P00 * iConversion;
NP01 = P01 * iConversion;
NP02 = P02 * iConversion;
NP03 = P03 * iConversion;
NP04 = P04 * iConversion;
NP05 = P05 * iConversion;
NP06 = P06 * iConversion;
NP07 = P07 * iConversion;
NP08 = P08 * iConversion;
NP09 = P09 * iConversion;
NP10 = P10 * iConversion;
NP11 = P11 * iConversion;
NP12 = P12 * iConversion;
NP13 = P13 * iConversion;
NP14 = P14 * iConversion;

#*****************************************************************************
#**** Get program element (deliberately at this position rather than at the beginning with the other elements)
#*****************************************************************************  
sElType = DTYPE(dmProg, vsProg);
WHILE (sElType @= 'C');
     vsProg = ELCOMP(dmProg, vsProg, 1);
     sElType = DTYPE(dmProg, vsProg);
END;

IF (CellisUpdateable(sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period01) = 1);

     CellPutN(OldP00 + NP00, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period00);
