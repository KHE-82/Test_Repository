     CellPutN(OldP11 + NP11, sCube, sHLYear, sScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, Period11);
