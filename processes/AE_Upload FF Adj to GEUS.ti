#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#***************************************************************************************************************************************************
#***** PROCESS : 			AE_Upload FF Adj to GEUS
#***** DESCRIPTION:		THIS TI PROCESS IS TO LOAD THE FLATFILE JOURNALS INTO GEUS
#*****				
#*****
#***** MODIFICATION HISTORY :	
#***** 
#*****
#***** DATE		INITIALS		COMMENTS
#***** =====		=======		==========
#***** 20/06/2014		KG		Updated Version
#***** 04/01/2016		KG		Updated metadata checks
#************************************************************************************************************************************************* 

snProg = 'programme';

#*** DECLARE CUBES AND DIMENSIONS***#
cbMeasID = 'government measures details';
cbAE = 'AE adjustments';
sCube = cbAE;
cbID = 'AE id details';

cbProg = snProg | ' details';
dmProg = snProg;


#*** DECLARE SYSTEM VARIABLES
dmClients = '}Clients';
dmVar = 'variables'; 
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
#sImpFilePath = ATTRS(dmVar, 'sys_Costings Import Directory', ' value');
sImpFilePath = ATTRS(dmVar, 'sys_ImpFileExceptionLogs', ' value');

sHLYear = curHLYear;
sScenario = curScenario;
sStatus = 'data';
sAdjType = 'Manual';

#*** DECLARE AE ADJUSTMENTS DIMENSIONS ***#
dmID = 'id';
dmOC = 'outcome';
dmRE = 'related entity';
dmReason = 'reason';
dmType = 'appropriation type';
dmItem = 'appropriation item';
dmFunc = 'function';
dmMeas = 'measure code';
dmAcc = 'account';
dmMA = 'movement account';
dmSPP = 'spp';
dmJur = 'jurisdiction';


sOldTitle = '';
sOldCBMS = '';
sOldID = '';

# *** IDENTIFY CURRENT USER ***#
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;

ATTRPUTS ('PASS', dmVar, 'sys_ImpFileValidation', 'value');

# **** GET DATE VALUES ***#
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 
sHNow = TimST (Now, '\h');
sMinNow = TimST (Now, '\i');
sSNow = TimST (Now, '\s');
 
sDay = TRIM(SUBST(sDNow, 1,2));
 
IF (LONG (sDay) = 1);
     sDay = '0' | sDay;
ELSE;
     sDay = sDay;
ENDIF;
 
sMonth = TRIM(SUBST(sMNow, 1,2));
 
IF (LONG (sMonth) = 1);
     sMonth = '0' | sMonth;
ELSE;
     sMonth = sMonth;
ENDIF;
 
sYear = TRIM(SUBST(sYNow, 1,4));
 
sNow = sYear | sMonth | sDay | sHNow | sMinNow | sSNow ;
 
 
sOutputFile = 'geus upload file failed' | sUser | ' ' | sNow | '.csv';


#*****************************************************************************
#***** COUNTERS USED
#*****************************************************************************
lHeaderCount = 0;
nLine = 1;
nValid = 0;
nTotalValid = 0;

#*****************************************************************************
#***** DATASOURCE VARIABLES
#*****************************************************************************
DATASOURCENAMEFORSERVER = psFile;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

# Account
IF (vsAcc @= '3322001' % vsAcc @= '2330008' % vsAcc @= '2330009' % vsAcc @= '3322002' % vsAcc @= '9000510' % vsAcc @= '9000515' % vsAcc @= '9000520' % vsAcc @= '9000525');
     ItemSkip;
ENDIF;


#*** PERFORM A VALIDATION TEST ***#
nProgValid = 0;
nOCValid = 0;
nMeasValid = 0;
nReasValid = 0;
nFuncValid = 0;
nMAValid = 0;
nAccValid = 0;
nItemValid = 0;
nTypeValid = 0;
nREValid  = 0;
nSPPValid = 0;

#*****************************************************************************
#**** PERFORM ADDITIONAL CHECKS - 20150407
#*****************************************************************************
nJurValid = 0;
nAccREValid = 0;
nAccJurValid = 0;
nAccMAValid = 0;
nMAREValid = 0;


#*************************************************************************************************************************************#
#**** DEFAULT ACCOUNTS ****#

# Get movement account element
IF (vsMA @= '');
     vsMA = '-';
ELSE;
     vsMA = vsMA;
ENDIF;

# Get related entity element
IF (vsRE @= '');
     vsRE = '-';
ELSE;
     vsRE = vsRE;
ENDIF;

# Get SPP element
IF (vsSPP @= '');
     vsSPP = '-';
ELSE;
     vsSPP = vsSPP;
ENDIF;

# Get jurisdiction element
IF (vsJur @= '');
     vsJur = '-';
ELSE;
     vsJur = vsJur;
ENDIF;

#* Get Appropriation Item elemnent
IF (vsItem @= '');
     vsItem = '-';
ELSE;
     vsItem = vsItem;
ENDIF;

#* Get Measure Code Element
IF (vsMeasCode @= '');
     vsMeasCode = 'M00000';
ELSE;
     vsMeasCode = vsMeasCode;
ENDIF;


#*************************************************************************************************************************************#
#*****************************************************************************
#**** VALIDATION CHECKS TO ENSURE THEY EXIST IN THE DIMENSION
#*****************************************************************************

#*** Check Programme
IF (DIMIX (dmProg, vsProg) = 0);
          nProgValid = nProgValid + 1;
ELSE;
     sCtrlTypeCheck = CELLGETS (cbProg, curHLYear, curScenario, vsProg, 'Control Type');
     IF (sCtrlTypeCheck @<> vsControlType);
          nProgValid = nProgValid + 1;     
     ENDIF;
ENDIF;

#*** Check Outcome
IF (DIMIX (dmOC, vsOC) = 0);
     nOCValid = nOCValid + 1;
ENDIF;

#*** Check Measure
IF (DIMIX (dmMeas, vsMeasCode) = 0);
     nMeasValid = nMeasValid + 1;
ENDIF;

#*** Check Reason
IF (DIMIX (dmReason, vsReason) = 0);
     nReasValid = nReasValid + 1;
ENDIF;

#*** Check Function
IF (DIMIX (dmFunc, vsFunc) = 0);
     nFuncValid = nFuncValid + 1;
ENDIF;

#*** Check MA
IF (DIMIX (dmMA, vsMA) = 0);
     nMAValid = nMAValid + 1;
ENDIF;

#*** Check Appropriation Item
IF (DIMIX (dmItem, vsItem) = 0);
     nItemValid = nItemValid + 1;
ENDIF;

#*** Check Appropriation Type
IF (DIMIX (dmType, vsType) = 0);
     nTypeValid = nTypeValid + 1;
ENDIF;

#*** Check Related Entity
IF (DIMIX (dmRE, vsRE) = 0);
     nREValid = nREValid + 1;
ENDIF;

#*** Check SPP
IF (DIMIX (dmSPP, vsSPP) = 0);
     nSPPValid = nSPPValid + 1;
ENDIF;

#*** Check Account
IF (DIMIX (dmAcc, vsAcc) = 0);
     nAccValid = nAccValid + 1;
ELSE;
     #*** NOW CHECK IF IT REQUIRES RELATED ENTITY OR JURISDICTION ***#
     sRECheck = ATTRS( dmAcc, vsAcc, 'related entity enabled');
     sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
     sJurCheck = ATTRS( dmAcc, vsAcc, 'jurisdiction required');
     sMACheck = ATTRS( dmAcc, vsAcc, 'movement account required');

   
     #*** Account has related entity enabled ***#
     IF (sRECheck @= 'Y');
     
           #*** CHECK IF assumed related entity is not blank, otherwise just use another related entity
            sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
            IF (sAssumedRE @= '');
                 #*** IF NO ASSUMED RELATED ENTITY, USE OTHER RELATED ENTITY ***#
                 IF (vsRE @<> '-');
                      #*** DO CHECK FOR RE EXISTS ***#
                      IF ( nREValid = 1);
                           #*** UTILIZES PREVIOUS CHECKS ***#
                           nAccREValid = nAccREValid + 1;
                      ENDIF;  
                 ENDIF;
            ELSE;
                 #*** DO CHECK FOR RE EXISTS ***#
                 IF ( nREValid = 1);
                      #*** UTILIZES PREVIOUS CHECKS ***#
                      vsRE = vsRE;
                 ELSE;
                      #*** IF Account has assumed RE Then use Assumed RE
                       IF (vsRE @<> sAssumedRE);
                             nAccREValid = nAccREValid + 1;
                        ENDIF;
                  ENDIF;
            ENDIF;
    
     ELSE;
          #*** SOMETIMES EVEN WITHOUT RELATED ENTITY ENABLED, THIS ACCOUNT SHOULD HAVE A RELATED ENTITY ***#
          sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
          IF (sAssumedRE @<> '');
               #*** DO CHECK FOR RE EXISTS ***#
               IF ( nREValid = 1);
                    #*** UTILIZES PREVIOUS CHECKS ***#
                    vsRE = vsRE;
                ELSE;
                    IF (vsRE @<> sAssumedRE);
                         vsRE = sAssumedRE;
                    ENDIF;
                ENDIF;
          ENDIF;

     ENDIF;

    #*** Account has Jurisdiction enabled ***#
     IF (sJurCheck @= 'Y');
     
          #*** Now check if Jurisdiction is Blank or '-' ***#
               IF (vsJur @= '-');
                    #*** Validation Fail for Jurisdiction as this account requires Jurisdiction not blank, if so, then account check failed
                    nAccJurValid = nAccJurValid + 1;
               ELSE;
                   #*** DO CHECK FOR JURISDICTION EXISTS ***#
                    IF (DIMIX (dmJur, vsJur) = 0);
                         nAccJurValid = nAccJurValid + 1;
                    ENDIF;
               ENDIF;       
     ENDIF;

     #*** Account has Movment Account enabled ***#
     IF (sMACheck @= 'Y');
     
          #*** Now check if Jurisdiction is Blank or '-' ***#
               IF (vsMA @= '-');
                    #*** Validation Fail for Movement Account as this account requires a Movement Account , if so, then account check failed
                    nAccMAValid = nAccMAValid + 1;
               ELSE;
                   #*** DO CHECK FOR MOVEMENT ACCOUNT EXISTS ***#
                    IF (nMAValid = 1);
                         #*** UTILIZES PREVIOUS CHECKS ***#
                    ELSE;
                         #*** IF MA EXISTS, CHECK ASSUMED RE ***#
                         sMARECheck = ATTRS (dmMA, vsMA, 'related entity enabled');
                         sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');

                         #*** Movement Account has related entity enabled ***#
                         IF (sMARECheck @= 'Y');
                              #*** CHECK IF assumed related entity is not blank, if so, then account check failed
                              sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');
                              IF (sMAAssumedRE @= '');
                                   #*** IF NO ASSUMED RELATED ENTITY, USE OTHER RELATED ENTITY ***#
                                   IF (vsRE @<> '-');
                                        #*** DO CHECK FOR RE EXISTS ***#
                                        IF ( nREValid = 1);
                                             #*** UTILIZES PREVIOUS CHECKS ***#
                                             nMAREValid = nMAREValid + 1;
                                        ENDIF;  
                                   ENDIF;

                              ELSE;
                                   #*** IF Account has assumed RE Then use Assumed RE
                                   IF (vsRE @<> sMAAssumedRE);
                                        vsRE = sMAAssumedRE;
                                   ENDIF;

                              ENDIF;
                       ELSE;
                             #*** DO CHECK FOR RE EXISTS ***#
                             IF ( nREValid = 1);
                                  #*** UTILIZES PREVIOUS CHECKS ***#
                             ELSE;

                                 #*** SOMETIMES EVEN WITHOUT RELATED ENTITY ENABLED, THIS ACCOUNT SHOULD HAVE A RELATED ENTITY ***#
                                 sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');
                                 IF (sMAAssumedRE @<> '');
                                      IF (vsRE @<> sMAAssumedRE);
                                           vsRE = sMAAssumedRE;
                                       ENDIF;
                                  ENDIF;
                             ENDIF;
                        ENDIF;
                    ENDIF;
               ENDIF;

     ELSE;

     #*** DO NOTHING IF ACCOUNT IS NO MOVEMENT ACCOUNT ***#

     ENDIF;


ENDIF;


#**************************************************************************************************************************************#
#*****************************************************************************
#**** OUTPUT FILES
#*****************************************************************************
#nValid = nProgValid + nOCValid + nMeasValid + nReasValid + nFuncValid +  nMAValid + nAccValid +  nTypeValid + nItemValid + nREValid + nSPPValid;

nValid = nProgValid + nOCValid + nReasValid + nFuncValid +  nMAValid + nAccValid +  nTypeValid + nItemValid + nREValid + nSPPValid + nJurValid + nAccREValid + nAccJurValid + nAccMAValid + nMAREValid;
nTotalValid = nTotalValid + nValid;


IF (nValid > 0);

     
     #*****************************************************************************
     #*** PUT A HEADER ON THE FILE 
     #*****************************************************************************
     IF (lHeaderCount = 0);
               ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Error Description', 'Line Number', 'Entered Value', 'Comments', 'Other Details/Assumed Values');
     ENDIF;

     #*****************************************************************************
     #**** VALIDATION FAILED
     #*****************************************************************************

     IF (nProgValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Programme Code error on line ', NUMBERTOSTRING(nLine), vsProg, vsControlType);
     ENDIF;

     IF (nMeasValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Measure Code error on line ', NUMBERTOSTRING(nLine), vsMeasCode);
     ENDIF;

     IF (nReasValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Reason Code error on line ', NUMBERTOSTRING(nLine), vsReason);
     ENDIF;

     IF (nOCValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Outcome Code error on line ', NUMBERTOSTRING(nLine), vsOC);
     ENDIF;

     IF (nFuncValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Function Code error on line ', NUMBERTOSTRING(nLine), vsFunc);
     ENDIF;

     IF (nMAValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Movement Account Code error on line ', NUMBERTOSTRING(nLine), vsMA);
     ENDIF;

     IF (nAccValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Account Code error on line ', NUMBERTOSTRING(nLine), vsAcc);
     ENDIF;

     IF (nAccREValid >0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Account has an invalid Related Entity Code error on line ', NUMBERTOSTRING(nLine), vsRE, vsAcc, sAssumedRE);
     ENDIF;

     IF (nAccJurValid >0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Account has an invalid Jurisdiction Code error on line ', NUMBERTOSTRING(nLine), vsJur, vsAcc);
     ENDIF;

     IF (nAccMAValid >0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Account is missing or has an invalid Movement Account Code error on line ', NUMBERTOSTRING(nLine), vsMA, vsAcc);
     ENDIF;

     IF (nMAREValid >0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Movement Account has an invalid Related Entity Code error on line ', NUMBERTOSTRING(nLine), vsRE, vsAcc, vsMA);
     ENDIF;

     IF (nTypeValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Appropriation Type error on line ', NUMBERTOSTRING(nLine), vsType);
     ENDIF;

     IF (nItemValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Appropriation Item error on line ', NUMBERTOSTRING(nLine), vsItem);
     ENDIF;

     IF (nREValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Related Entity error on line ', NUMBERTOSTRING(nLine), vsRE);
     ENDIF;

     IF (nSPPValid > 0);
          ASCIIOUTPUT (sImpFilePath | ' geus upload file failed.csv', 'SPP error on line ', NUMBERTOSTRING(nLine), vsSPP);
     ENDIF;

     IF (nJurValid > 0);
          ASCIIOUTPUT (sImpFilePath | sOutputFile, 'Jurisdiction error on line ', NUMBERTOSTRING(nLine), vsJur);
     ENDIF;

ELSE;

#*** VALIDATION PASSED ****#
# Do Nothing

ENDIF;

     #*** DISABLE HEADER LINE ***#
     lHeaderCount = lHeaderCount + 1;

     #*** ADD LINE NUMBER
     nLine = nLine + 1;
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#*****************************************************************************
#**** SKIP LINE IF DIMENSIONS ARENT VALID 
#*****************************************************************************

#**** SKIP LINE IF DIMENSIONS ARENT VALID ***#
IF (nTotalValid > 0);
     ATTRPUTS ('FAIL', dmVar, 'sys_ImpFileValidation', 'value');
     ITEMSKIP;
ELSE;
     ATTRPUTS ('PASS', dmVar, 'sys_ImpFileValidation', 'value');
ENDIF;

# Resets flag to say it is not a zero line
nZeroCheck = 1;


# Get period elements
Period01 = SUBST(ATTRS('variables', 'headline year', 'value'), 3, 9);
Period00 = DIMNM('period', DIMIX('period', Period01) -1);
Period02 = DNEXT('period', Period01);
Period03 = DNEXT('period', Period02);
Period04 = DNEXT('period', Period03);
Period05 = DNEXT('period', Period04);
Period06 = DNEXT('period', Period05);
Period07 = DNEXT('period', Period06);
Period08 = DNEXT('period', Period07);
Period09 = DNEXT('period', Period08);
Period10 = DNEXT('period', Period09);
Period11 = DNEXT('period', Period10);
Period12 = DNEXT('period', Period11);
Period13 = DNEXT('period', Period12);
Period14 = DNEXT('period', Period13);
Period15 = DNEXT('period', Period14);
Period16 = DNEXT('period', Period15);


#*****************************************************************************
#*** CERTAIN ACCOUNTS TO BE EXCLUDED FROM CHECKS
#*** THESE ACCOUNTS ARE RULE CALCULATED
#*****************************************************************************
IF (vsAcc @= '3322001' % vsAcc @= '2330008' % vsAcc @= '2330009' % vsAcc @= '3322002' % vsAcc @= '9000510' % vsAcc @= '9000515' % vsAcc @= '9000520' % vsAcc @= '9000525');
     ItemSkip;
ENDIF;

#*****************************************************************************
#**** DEFAULT ACCOUNTS USED WHEN FIELD IS BLANK
#*****************************************************************************
# Get movement account element
IF (vsMA @= '');
     vsMA = '-';
ELSE;
     vsMA = vsMA;
ENDIF;

# Get related entity element
IF (vsRE @= '');
     vsRE = '-';
ELSE;
     vsRE = vsRE;
ENDIF;

# Get SPP element
IF (vsSPP @= '');
     vsSPP = '-';
ELSE;
     vsSPP = vsSPP;
ENDIF;

# Get jurisdiction element
IF (vsJur @= '');
     vsJur = '-';
ELSE;
     vsJur = vsJur;
ENDIF;


# Get Appropriation Item
IF (vsItem @='');
     vsItem =  '-';
ENDIF;

#* Get Measure Code Element
IF (vsMeasCode @= '');
     vsMeasCode = 'M00000';
ELSE;
     vsMeasCode = vsMeasCode;
ENDIF;


#*************************************************************************************************************************************
#*****************************************************************************
#**** ACCOUNT RELATED ENTITY/MOVEMENT ACCOUNT FIXES 
#*** THESE CHECKS NOW ADD ASSUMED RELATED ENTITY DATA 
#*****************************************************************************
     #*** NOW CHECK IF IT REQUIRES RELATED ENTITY OR JURISDICTION ***#
     sRECheck = ATTRS( dmAcc, vsAcc, 'related entity enabled');
     sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
     sJurCheck = ATTRS( dmAcc, vsAcc, 'jurisdiction required');
     sMACheck = ATTRS( dmAcc, vsAcc, 'movement account required');

     #*** Account has related entity enabled ***#
     IF (sRECheck @= 'Y');
     
           #*** CHECK IF assumed related entity is not blank, otherwise just use another related entity
            sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
            IF (sAssumedRE @= '');
                 #*** IF NO ASSUMED RELATED ENTITY, USE OTHER RELATED ENTITY ***#
                 vsRE = vsRE;
            ELSE;
                 #*** IF Account has assumed RE Then use Assumed RE
                 IF (vsRE @<> sAssumedRE);
                      vsRE = sAssumedRE;
                 ENDIF;
            ENDIF;
    
     ELSE;
          #*** SOMETIMES EVEN WITHOUT RELATED ENTITY ENABLED, THIS ACCOUNT SHOULD HAVE A RELATED ENTITY ***#
          sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
          IF (sAssumedRE @<> '');
               IF (vsRE @<> sAssumedRE);
                    vsRE = sAssumedRE;
               ENDIF;
          ENDIF;

     ENDIF;

     #*** Account has Movment Account enabled ***#
     IF (sMACheck @= 'Y');
     
          #*** Now check if Jurisdiction is Blank or '-' ***#
               IF (vsMA @= '-');
                    #*** Validation Fail for Movement Account as this account requires a Movement Account , if so, then account check failed
                    nAccMAValid = nAccMAValid + 1;
               ELSE;
                   #*** DO CHECK FOR MOVEMENT ACCOUNT EXISTS ***#
                    IF (nMAValid = 1);
                         #*** UTILIZES PREVIOUS CHECKS ***#
                    ELSE;
                         #*** IF MA EXISTS, CHECK ASSUMED RE ***#
                         sMARECheck = ATTRS (dmMA, vsMA, 'related entity enabled');
                         sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');

                         #*** Movement Account has related entity enabled ***#
                         IF (sMARECheck @= 'Y');
                              #*** CHECK IF assumed related entity is not blank, if so, then account check failed
                              sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');
                              IF (sMAAssumedRE @<> '');
                                   #*** IF Movement Account has assumed RE Then use Assumed RE
                                   IF (vsRE @<> sMAAssumedRE);
                                        vsRE = sMAAssumedRE;
                                   ENDIF;
                              ENDIF;
                       ELSE;

                            #*** SOMETIMES EVEN WITHOUT RELATED ENTITY ENABLED, THIS ACCOUNT SHOULD HAVE A RELATED ENTITY ***#
                            sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');
                            IF (sMAAssumedRE @<> '');
                                 IF (vsRE @<> sMAAssumedRE);
                                      vsRE = sMAAssumedRE;
                                  ENDIF;
                             ENDIF;
                        ENDIF;
                    ENDIF;
               ENDIF;

     ELSE;
          #*****************************************************************************
          #**** ACCOUNT HAS NO MOVEMENT ACCOUNT ENABLED
          #*****************************************************************************       
     ENDIF;

#*************************************************************************************************************************************


#sNewID = NUMBERTOSTRING(sAdjID);


sCheckCBMSVar = vsCBMSVar | vsProg | vsOC | vsFunc | vsType | vsItem | vsSPP | vsReason | vsMeasCode | vsTitle;

#*****************************************************************************
#**** GET A NEW ID
#*****************************************************************************  

#IF (sOldCBMS @<> vsCBMSVar);
IF (sOldCBMS @<> sCheckCBMSVar);

     sNewID = '00000' | TRIM(STR(CELLGETN (cbID, sHLYear, sScenario, 'Total IDs', 'Used') + 1, 5, 0));
     sNewID = SUBST (sNewID, LONG (sNewID) - 4, 5);

     IF (LONG(sNewID) = 1);
          sNewID = '0000' | sNewID;
     ENDIF;

     IF (LONG(sNewID) = 2);
          sNewID = '000' | sNewID;
     ENDIF;

     IF (LONG(sNewID) = 3);
          sNewID = '00' | sNewID;
     ENDIF;

     IF (LONG(sNewID) = 4);
          sNewID = '0' | sNewID;
     ENDIF;

     IF (LONG(sNewID) = 5);
          sNewID = sNewID;
     ENDIF;

     sID = sNewID;

ELSE;

     sID = sOldID;
     sNewID = sID;

ENDIF;

IF (P00 = 0 & P01 = 0 & P02 = 0 & P03 = 0 & P04 = 0 & P05 = 0 & P06 = 0 & P07 = 0 & P08 = 0 & P09 = 0 & P10 = 0 & P11 = 0 & P12 = 0 & P13 = 0 & P14 = 0) ;
     nZeroCheck = P00 + P01 + P02 + P03 + P04 + P05 + P06 + P07 + P08 + P09 + P10 + P11 + P12  + P13 + P14;
ENDIF;

#*****************************************************************************
#**** IMPORT DATA INTO ID DETAILS CUBE
#*****************************************************************************   
CELLPUTN(1,cbID, sHLYear, sScenario, sNewID, 'used');
#CELLPUTS('Y', cbID, sHLYear, sScenario, sNewID, 'disagree cashflow');
CELLPUTS(vsProg, cbID, sHLYear, sScenario, sNewID,  snProg | ' code');
sProgDesc = ATTRS(dmProg, vsProg, 'code and description');
CELLPUTS(sProgDesc, cbID, sHLYear, sScenario, sNewID, snProg | ' description');
CELLPUTS(vsTitle, cbID, sHLYear, sScenario, sNewID, 'title');
CELLPUTS('(' | sNewID | ') ' | vsDesc, cbID, sHLYear, sScenario, sNewID, 'description');
CELLPUTS('unauthorised',cbID, sHLYear, sScenario, sNewID, 'status');
CELLPUTS(vsReason, cbID, sHLYear,sScenario, sNewID, 'reason');
CELLPUTS(vsOC, cbID, sHLYear, sScenario, sNewID, 'outcome');
CELLPUTS(vsFunc, cbID, sHLYear, sScenario, sNewID, 'function');
CELLPUTS(vsSPP, cbID, sHLYear, sScenario, sNewID, 'SPP');
CELLPUTS(vsItem, cbID, sHLYear, sScenario, sNewID, 'appropriation item');
CELLPUTS(vsType,cbID, sHLYear, sScenario, sNewID, 'appropriation type');
CELLPUTS('ongoing',cbID, sHLYear, sScenario, sNewID, 'funding life');
CELLPUTS(vsMeasCode,cbID, sHLYear, sScenario, sNewID, 'measure');
CELLPUTS(vsCBMSVar, cbID, sHLYear, sScenario, sNewID, 'CBMS ID');

CELLPUTS(vsComments, cbID, sHLYear, sScenario, sNewID, 'comments');

IF (UPPER(SUBST (vsApplyParam, 1,1)) @= 'Y');
     CELLPUTS('Y', cbID, sHLYear, sScenario, sNewID, 'apply parameters');
ELSE;
     CELLPUTS('', cbID, sHLYear, sScenario, sNewID, 'apply parameters');
ENDIF;

CELLPUTS(sUser, cbID, sHLYear, sScenario, sNewID, 'created by');

#*****************************************************************************
#**** GET DATE
#*****************************************************************************   

     # **** GET DATE VALUES ***#
     sDNow = TimST( Now, '\D'); 
     sMNow = TimST( Now, '\m'); 
     sYNow = TimST( Now, '\Y'); 

     sDay = TRIM(SUBST(sDNow, 1,2));

     IF (LONG (sDay) = 1);
          sDay = '0' | sDay;
     ELSE;
          sDay = sDay;
     ENDIF;

     sMonth = TRIM(SUBST(sMNow, 1,2));

     IF (LONG (sMonth) = 1);
          sMonth = '0' | sMonth;
     ELSE;
          sMonth = sMonth;
     ENDIF;

     sYear = TRIM(SUBST(sYNow, 1,4));

     sNow = sDay | '/' | sMonth | '/' | sYear;

CELLPUTS(sNow, cbID, sHLYear, sScenario, sNewID, 'created date');
CELLPUTS(sAdjType, cbID, curHLYear, curScenario, sNewID, 'Adjustment Type');
CELLPUTS(vsControlType, cbID, curHLYear, curScenario, sNewID, 'Control Type');

#*****************************************************************************
#**** GET MEASURE DATA
#*****************************************************************************   
sFundLife = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'funding life');

IF (vsMeasCode @= 'M00000');
     sFundLife = 'ongoing';
ENDIF;
     
IF (sFundLife @= '');
     sFundLife = 'ongoing';
ENDIF;

sEndDate = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'end date');

CELLPUTS (sFundLife, cbID, curHLYear, curScenario, sNewID, 'funding life');
CELLPUTS (sEndDate, cbID, curHLYear, curScenario, sNewID, 'end date');


#*****************************************************************************
#****  CASH FLOW CHECKS
#*****************************************************************************  
IF (nZeroCheck = 0);
     IF (SUBST(vsAcc,1,1) @= '6');
          CELLPUTS (vsAcc, cbID, sHLYear, sScenario, sNewID, 'zero cashflow account');
     ELSE;
          CELLPUTS ('', cbID, sHLYear, sScenario, sNewID, 'zero cashflow account');
     ENDIF;
ELSE;
     #*** THISI S TO PUT ZERO CASH FLOW FLAG BACK TO NOTHING
#     CELLPUTS ('', cbID, sHLYear, sScenario, sNewID, 'zero cashflow account');
ENDIF;


#*****************************************************************************
#*** TO INSERT TO DISAGREE CASH FLOW FLAG IF CASHFLOW IS INCLUDED FOR A PARTICULAR ID
#*****************************************************************************  
IF (SUBST(vsAcc,1,1) @= '6');
     CELLPUTS('Y', cbID, sHLYear, sScenario, sNewID, 'disagree cashflow');
ENDIF;

