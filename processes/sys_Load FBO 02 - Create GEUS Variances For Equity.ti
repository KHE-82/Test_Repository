cbID = 'ae id details';

sCube = cbAE;
sView = '$CBMSRFBO';
sSubset = sView;

#sSourceStatus = 'Total approved';
sSourceStatus = 'data';
#sSourceID = 'Total IDs';
sSourceID = '00FBO';
sSourceReason = 'Total reason';
sSourceMeasCode = 'Total Measures';
sSourceRE = 'Total related entity';
sSourceAcc = '3800001';
sSourceMA = 'Total movement';

sTargetStatus = 'data';
sTargetID = '00FBO';
sTargetReason = 'Other variations not elsewhere defined';
sTargetMeasCode = 'M00000';
sTargetAcc = '4100001';
sTargetMA = '7205';
sTargetRE = '-';


nStartPerIndex = DIMIX (dmPer, psPeriod);
nLastPerIndex = DIMIX (dmPer, '2045-2046');

#------------------------------------------------------------------------------------------------------------------------------------------
#--- STEP 01 : CLEAR OUT TARGET SCENARIO
#------------------------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);


#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);

# Status
SubsetCreate(dmStatus, sSubset);
SubsetElementInsert(dmStatus, sSubset, sTargetStatus, 1);

# Outcome
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmOC | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Function
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Reason
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);
SubsetCreate(dmReason, sSubset);
SubsetElementInsert(dmReason, sSubset, sTargetReason, 1);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Appropriation Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmType | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Movement account
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);

SubsetCreate(dmMA, sSubset);
SubsetElementInsert(dmMA, sSubset, sTargetMA, 1);

# Appropriation item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].[' | psProg | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Account
#MDX = '{{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000130]}, ALL, RECURSIVE )}, 0)}, ASC)},{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[3800001]}, ALL, RECURSIVE )}, 0)}, ASC)},{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000850]}, ALL, RECURSIVE )}, 0)}, ASC)}, {TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000003]}, ALL, RECURSIVE )}, 0)}, ASC)} }';
#SUBSETCREATEBYMDX (sSubset, MDX);

SubsetCreate(dmAcc, sSubset);
SubsetElementInsert(dmAcc, sSubset, sTargetAcc, 1);

# ID
SubsetCreate(dmID, sSubset);
SubsetElementInsert(dmID, sSubset, sTargetID, 1);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# Period
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


#****BUILD VIEW****#
ViewCreate(sCube, sView);

ViewSubsetAssign(sCube, sView, dmHLYear, sSubset);
ViewSubsetAssign(sCube, sView, dmScenario, sSubset);
ViewSubsetAssign(sCube, sView, dmStatus, sSubset);
ViewSubsetAssign(sCube, sView, dmOC, sSubset);
ViewSubsetAssign(sCube, sView, dmRE, sSubset);
ViewSubsetAssign(sCube, sView, dmFunc, sSubset);
ViewSubsetAssign(sCube, sView, dmReason, sSubset);
ViewSubsetAssign(sCube, sView, dmSPP, sSubset);
ViewSubsetAssign(sCube, sView, dmMeasCode, sSubset);
ViewSubsetAssign(sCube, sView, dmType, sSubset);
ViewSubsetAssign(sCube, sView, dmMA, sSubset);
ViewSubsetAssign(sCube, sView, dmItem, sSubset);
ViewSubsetAssign(sCube, sView, dmProg, sSubset);
ViewSubsetAssign(sCube, sView, dmAcc, sSubset);
ViewSubsetAssign(sCube, sView, dmID, sSubset);
ViewSubsetAssign(sCube, sView, dmJur, sSubset);
ViewSubsetAssign(sCube, sView, dmPer, sSubset);

ViewExtractSkipZeroesSet (sCube, sView, 1);
ViewExtractSkipCalcsSet (sCube, sView, 0);
ViewExtractSkipRuleValuesSet (sCube, sView, 0);

VIEWZEROOUT (sCube, sView);

#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);


#------------------------------------------------------------------------------------------------------------------------------------------
#--- STEP 02 : CREATE SOURCE VIEW
#------------------------------------------------------------------------------------------------------------------------------------------

#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);


#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

# Status
SubsetCreate(dmStatus, sSubset);
SubsetElementInsert(dmStatus, sSubset, sSourceStatus, 1);

# Outcome
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmOC | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Related Entity
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);

SubsetCreate(dmRE, sSubset);
SubsetElementInsert(dmRE, sSubset, sSourceRE, 1);

# Function
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Reason
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);
SubsetCreate(dmReason, sSubset);
SubsetElementInsert(dmReason, sSubset, sSourceReason, 1);


# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure Code
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);

SubsetCreate(dmMeasCode, sSubset);
SubsetElementInsert(dmMeasCode, sSubset, sSourceMeasCode, 1);

# Appropriation Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmType | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Movement account
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);

SubsetCreate(dmMA, sSubset);
SubsetElementInsert(dmMA, sSubset, sSourceMA, 1);

# Appropriation item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].[' | psProg | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# Account
#MDX = '{{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000130]}, ALL, RECURSIVE )}, 0)}, ASC)},{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[3800001]}, ALL, RECURSIVE )}, 0)}, ASC)},{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000850]}, ALL, RECURSIVE )}, 0)}, ASC)}, {TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000003]}, ALL, RECURSIVE )}, 0)}, ASC)} }';
#SUBSETCREATEBYMDX (sSubset, MDX);

SubsetCreate(dmAcc, sSubset);
SubsetElementInsert(dmAcc, sSubset, sSourceAcc, 1);

# ID
SubsetCreate(dmID, sSubset);
SubsetElementInsert(dmID, sSubset, sSourceID, 1);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Period
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);

SubsetCreate(dmPer, sSubset);
SubsetElementInsert(dmPer, sSubset, psPeriod, 1);


#****BUILD VIEW****#
ViewCreate(sCube, sView);

ViewSubsetAssign(sCube, sView, dmHLYear, sSubset);
ViewSubsetAssign(sCube, sView, dmScenario, sSubset);
ViewSubsetAssign(sCube, sView, dmStatus, sSubset);
ViewSubsetAssign(sCube, sView, dmOC, sSubset);
ViewSubsetAssign(sCube, sView, dmRE, sSubset);
ViewSubsetAssign(sCube, sView, dmFunc, sSubset);
ViewSubsetAssign(sCube, sView, dmReason, sSubset);
ViewSubsetAssign(sCube, sView, dmSPP, sSubset);
ViewSubsetAssign(sCube, sView, dmMeasCode, sSubset);
ViewSubsetAssign(sCube, sView, dmType, sSubset);
ViewSubsetAssign(sCube, sView, dmMA, sSubset);
ViewSubsetAssign(sCube, sView, dmItem, sSubset);
ViewSubsetAssign(sCube, sView, dmProg, sSubset);
ViewSubsetAssign(sCube, sView, dmAcc, sSubset);
ViewSubsetAssign(sCube, sView, dmID, sSubset);
ViewSubsetAssign(sCube, sView, dmJur, sSubset);
ViewSubsetAssign(sCube, sView, dmPer, sSubset);

ViewExtractSkipZeroesSet (sCube, sView, 1);
ViewExtractSkipCalcsSet (sCube, sView, 0);
ViewExtractSkipRuleValuesSet (sCube, sView, 0);

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

sNewProg = vsProg;
sElType = DTYPE(dmProg, sNewProg);
WHILE (sElType @= 'C');
	sNewProg = ELCOMP(dmProg, sNewProg, 1);
	sElType = DTYPE(dmProg, sNewProg);
END;

#sCheckProg = SUBST(vsProg, 4,3);
#IF (sCheckProg @<> '.01');
#	sNewProg = SUBST(vsProg, 1,3) | '.01';
#ELSE;
#	sNewProg = vsProg;
#ENDIF;

#ITEMSKIP;


#-------------------------------------------------------------------------------
#--- Find account codes if it has the word (Annual Only)
#-------------------------------------------------------------------------------
sAccDesc = ATTRS (dmAcc, vsAcc, 'description');
nSCAN = SCAN('Annual Only', sAccDesc);
IF (nSCAN > 0);
	ITEMSKIP;
ENDIF;



nTargetValue = vnValue * 1;
IF (CELLISUPDATEABLE (sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, sTargetRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTargetMA, vsItem, sNewProg, sTargetAcc, sTargetID, vsJur, vsPeriod) = 1);
	nOldTargetValue = CELLGETN (sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, sTargetRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTargetMA, vsItem, sNewProg, sTargetAcc, sTargetID, vsJur, vsPeriod);
	CELLPUTN (nOldTargetValue + nTargetValue, sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, sTargetRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTargetMA, vsItem, sNewProg, sTargetAcc, sTargetID, vsJur, vsPeriod);
	ASCIIOUTPUT ('transfertocurrent.csv', NUMBERTOSTRING (nTargetValue), NUMBERTOSTRING (nOldTargetValue),  sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, vsRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sTargetID, vsJur, vsPeriod);

	#-----------------------------------------------------
	#--- Post Flow On Effect
	#-----------------------------------------------------
	lCounter = 1;
	IF (ELISANC (dmAcc, '3800001', vsAcc) = 1 & vsMA @= '-');
		sNewPeriod = DIMNM (dmPer, DIMIX (dmPer, vsPeriod) + lCounter);
		nNewPerIndex = DIMIX (dmPer, sNewPeriod);
		WHILE (nNewPerIndex <= nLastPerIndex);
			nOldTargetValue = CELLGETN (sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, sTargetRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTargetMA, vsItem, sNewProg, sTargetAcc, sTargetID, vsJur, sNewPeriod);
			ASCIIOUTPUT ('checkflow.txt', NUMBERTOSTRING (nTargetValue), sNewProg, vsAcc, sNewPeriod, sTargetID);
			CELLPUTN (nOldTargetValue + nTargetValue, sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, sTargetRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTargetMA, vsItem, sNewProg, sTargetAcc, sTargetID, vsJur, sNewPeriod);			
			sNewPeriod = DIMNM (dmPer, DIMIX (dmPer, sNewPeriod) + lCounter);
			nNewPerIndex = DIMIX (dmPer, sNewPeriod);

		END;

	ENDIF;


ENDIF;
#endregion
