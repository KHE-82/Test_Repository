#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_FlatFile 02 - Generate CBMS-R Extract
#**** DESCRIPTION:       This process creates a view for the flatfile generation
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 02/08/2017    KG             Initial Revision
#**** 30/08/2017	KG	  Since Education security is different, hard coded sSaveLocation values
#**** 20202	KG	  Called to clear Flatfile Screen
#**** 01/09/2022    KG             Treasury GEU Customisation - Only Extract Jurisdiction when the jurisdiction is required
#***********************************************************************************************************************



DataSourceAsciiQuoteCharacter='';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmJur = 'jurisdiction';
dmPer = 'period';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
cbID = 'AE id details';
#---------------------------------------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
cbProg = snProg | ' details';
#---------------------------------------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE EXTRACT CUBE
cbProg = snProg | ' details';
#---------------------------------------------------------------------------------------------------------------------------
cbExtract = 'sys_extract';
dmFFScenario = 'sys_flatfile scenario';
dmID = 'id';
dmRowID = 'sys_extract row id';
dmExtractMeas = 'sys_flatfile measure';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------
sHLYear = ATTRS(dmVar,'headline year','value');
sScenario = ATTRS(dmVar, 'headline scenario', 'value');
sChangeStatus = 'CBMS';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sTM1User = TM1User();
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
 #    sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     sUser = ATTRS(dmClients, sUser, 'GEUS User Name');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;



#sObject  = sUser | '_$FlatFileExtract';
sAEView = sUser | '_$FlatFileExtract';
#sAEView = '$FlatFileExtract';
sFFScenario = 'upload';
sStatus = 'approved';
sExtractMeas = 'used';

#*****************************************************************************************************************************************************
#*** STEP 1 - CREATE SOURCCE VIEW ***#
#*****************************************************************************************************************************************************
#---------------------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
#---------------------------------------------------------------------------------------------------------------------------
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbExtract, sAEView);
SUBSETDESTROY (dmClients, sAEView);
SUBSETDESTROY (dmFFScenario, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmRowID, sAEView);
SUBSETDESTROY (dmExtractMeas, sAEView);


#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS****#
#---------------------------------------------------------------------------------------------------------------------------

# Client
SubsetCreate(dmClients, sAEView);
SubsetElementInsert(dmClients, sAEView, sUser, 1);

# FF Scenario
SubsetCreate(dmFFScenario, sAEView);
SubsetElementInsert(dmFFScenario, sAEView, sFFScenario, 1);

# ID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmID | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmID, sAEView, MDX);

# Row ID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRowID | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmRowID, sAEView, MDX);


# Extract Measure
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmExtractMeas | '] )}, 0)}';
#SUBSETCREATEBYMDX (sAEView, MDX);
#SUBSETMDXSET (dmExtractMeas, sAEView, MDX);

SubsetCreate(dmExtractMeas, sAEView);
SubsetElementInsert(dmExtractMeas, sAEView, sExtractMeas, 1);


#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW****#
#---------------------------------------------------------------------------------------------------------------------------
VIEWCREATE (cbExtract, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmClients, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmFFScenario, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmRowID, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmID, sAEView);
VIEWSUBSETASSIGN (cbExtract, sAEView, dmExtractMeas, sAEView);


# *** DEFINE VIEW EXTRACT
ViewExtractSkipZeroesSet(cbExtract, sAEView, 1);
ViewSuppressZeroesSet(cbExtract, sAEView, 1);
ViewExtractSkipCalcsSet(cbExtract, sAEView, 1);

#---------------------------------------------------------------------------------------------------------------------------
#--- OUTPUT FILE DETAILS
#---------------------------------------------------------------------------------------------------------------------------

# **** GET DATE VALUES ***#
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 
sHNow = TimST (Now, '\h');
sMinNow = TimST (Now, '\i');
sSNow = TimST (Now, '\s');
 
sDay = TRIM(SUBST(sDNow, 1,2));
 
IF (LONG (sDay) = 1);
     sDay = '0' | sDay;
ELSE;
     sDay = sDay;
ENDIF;
 
sMonth = TRIM(SUBST(sMNow, 1,2));
 
IF (LONG (sMonth) = 1);
     sMonth = '0' | sMonth;
ELSE;
     sMonth = sMonth;
ENDIF;
 
sYear = TRIM(SUBST(sYNow, 1,4));
 
sNow = sYear | sMonth | sDay | sHNow | sMinNow | sSNow ;
sSaveLocation =  ATTRS(dmVar, 'save location', 'value');
sOutputFile = sSaveLocation | sUser | ' cbmsr flatfile for ' | psHLYear | ' ' | psScenario | ' ' | sNow | '.csv';
#sOutputFile1 = sUser | ' cbmsr flatfile for ' | psHLYear | ' ' | psScenario | ' ' | sNow | '.csv';

lHeadercounter = 0;


#*****************************************************************************************************************************************************
#*** STEP 4 - GET PERIODS ***#
#*****************************************************************************************************************************************************

sHLYearPeriod = SUBST(psHLYear, 3,9);
sPA = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) -2);
sRB = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) -1);
sNB = sHLYearPeriod;
sFE01 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +1);
sFE02 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +2);
sFE03 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +3);
sFE04 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +4); 
sFE05 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +5);
sFE06 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +6);
sFE07 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +7);
sFE08 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +8);
sFE09 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +9);
sFE10 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +10);
sFE11 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +11);
sFE12 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +12);
sFE13 = DIMNM(dmPer, DIMIX (dmPer, sHLYearPeriod) +13);


DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sAEView;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#---------------------------------------------------------------------------------------------------------------------------
#**** GET METADATA
#---------------------------------------------------------------------------------------------------------------------------
sProg = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'programme');
sReason = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'reason');

IF (DIMIX (dmReason, sReason) <> 0);
	sReason = DIMENSIONELEMENTPRINCIPALNAME (dmReason, sReason);
	sReason = ATTRS (dmReason, sReason, 'CBMS reason code');
ELSE;
	sReason = sReason;
ENDIF;

sAcc  = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'account');
sRE = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'related entity');
sSPP = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'spp');
sAppropriation = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'appropriation');

IF (DIMIX (dmItem, sAppropriation) <> 0);
	sAppropriation = DIMENSIONELEMENTPRINCIPALNAME (dmItem, sAppropriation);
ELSE;
	sAppropriation = sAppropriation;
ENDIF;

#------------------------------------------------------------------------#
#------20220901 Treasury Geus Customisation----#
#------------------------------------------------------------------------#

sJurOpt = ATTRS(dmAcc,sAcc,'jurisdiction optional');

IF(sJurOpt @='Y');
	sJur = '';
ELSE;
	sJur = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'jurisdiction');	
ENDIF;
#------------------------------------------------------------------------#

sMA = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'Movement account');
sMeasCode = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'measure');
sTitle = TRIM(SUBST(CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'title'),1,60));
sDesc = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'description');
#-------------------------------------------------------------------------------------------------------------------------------------------------------------
#---- PATCH TO REMOVE BAD CHARACTERS FROM TITLE/ADJ DESCRIPTION
#---- OCTOBER 2017 - BY EXCELERATED CONSULTING
#-------------------------------------------------------------------------------------------------------------------------------------------------------------
nLenTitle = LONG (TRIM (sTitle));
#------------------------------------------------------------------
#--- SCAN FOR BAD CHARACTER
#--- LEFT OPEN BRACKET
#------------------------------------------------------------------
sBadChar = '(';
lCounter = 1;
nBadSCAN = SCAN(sBadChar, sTitle);
IF (nBadScan <> 0);
	WHILE (nBadSCAN <> 0);
		#----------------------------------------------------------
		#--- Remove Open Bracket
		#----------------------------------------------------------
		IF (nBadSCAN = 1);
			sTitle = TRIM(SUBST (sTitle, 2, nLenTitle));
		ELSE;
			sTitle = TRIM (SUBST(sTitle, 1, nBadSCAN - 1) | SUBST (sTitle, nBadSCAN + 1, nLenTitle)); 
		ENDIF;
		nBadSCAN = SCAN (sBadChar, sTitle);
		lCounter = lCounter + 1;
	END;	
ENDIF;


#------------------------------------------------------------------
#--- SCAN FOR BAD CHARACTER
#--- RIGHT CLOSED BRACKET
#------------------------------------------------------------------
nLenTitle = LONG (TRIM (sTitle));
sBadChar = ')';
lCounter = 1;
nBadSCAN = SCAN(sBadChar, sTitle);
IF (nBadScan <> 0);
	WHILE (nBadSCAN <> 0);
		#----------------------------------------------------------
		#--- Remove Open Bracket
		#----------------------------------------------------------
		IF (nBadSCAN = 1);
			sTitle = TRIM(SUBST (sTitle, 2, nLenTitle));
		ELSE;
			sTitle = TRIM (SUBST(sTitle, 1, nBadSCAN - 1) | SUBST (sTitle, nBadSCAN + 1, nLenTitle)); 
		ENDIF;
		nBadSCAN = SCAN (sBadChar, sTitle);
		lCounter = lCounter + 1;
	END;	
ENDIF;


#------------------------------------------------------------------
#--- SCAN FOR BAD CHARACTER
#--- SEMI COLON
#------------------------------------------------------------------
nLenTitle = LONG (TRIM (sTitle));
sBadChar = ';';
lCounter = 1;
nBadSCAN = SCAN(sBadChar, sTitle);
IF (nBadScan <> 0);
	WHILE (nBadSCAN <> 0);
		#----------------------------------------------------------
		#--- Remove Open Bracket
		#----------------------------------------------------------
		IF (nBadSCAN = 1);
			sTitle = TRIM(SUBST (sTitle, 2, nLenTitle));
		ELSE;
			sTitle = TRIM (SUBST(sTitle, 1, nBadSCAN - 1) | SUBST (sTitle, nBadSCAN + 1, nLenTitle)); 
		ENDIF;
		nBadSCAN = SCAN (sBadChar, sTitle);
		lCounter = lCounter + 1;
	END;	
ENDIF;
#------------------------------------------------------------------
#--- SCAN FOR BAD CHARACTER
#--- COMMA
#------------------------------------------------------------------
nLenTitle = LONG (TRIM (sTitle));
sBadChar = ',';
lCounter = 1;
nBadSCAN = SCAN(sBadChar, sTitle);
IF (nBadScan <> 0);
	WHILE (nBadSCAN <> 0);
		#----------------------------------------------------------
		#--- Remove Open Bracket
		#----------------------------------------------------------
		IF (nBadSCAN = 1);
			sTitle = TRIM(SUBST (sTitle, 2, nLenTitle));
		ELSE;
			sTitle = TRIM (SUBST(sTitle, 1, nBadSCAN - 1) | SUBST (sTitle, nBadSCAN + 1, nLenTitle)); 
		ENDIF;
		nBadSCAN = SCAN (sBadChar, sTitle);
		lCounter = lCounter + 1;
	END;	
ENDIF;

#-------------------------------------------------------------------------------------------------------------------------------------------------------------
#---- PATCH TO REMOVE BAD CHARACTERS FROM DESCRIPTION/CMT JUSTIFICATION
#---- OCTOBER 2017 - BY EXCELERATED CONSULTING
#---- APRIL 2023 - CURRENTLY DISABLED
#-------------------------------------------------------------------------------------------------------------------------------------------------------------

IF (1 = 0);
nLenDesc = LONG (TRIM (sDesc));
#------------------------------------------------------------------
#--- SCAN FOR BAD CHARACTER
#--- LEFT OPEN BRACKET
#------------------------------------------------------------------
sBadChar = '(';
lCounter = 1;
nBadSCAN = SCAN(sBadChar, sDesc);
IF (nBadScan <> 0);
	WHILE (nBadSCAN <> 0);
		#----------------------------------------------------------
		#--- Remove Open Bracket
		#----------------------------------------------------------
		IF (nBadSCAN = 1);
			sDesc = TRIM(SUBST (sDesc, 2, nLenDesc));
		ELSE;
			sDesc = TRIM (SUBST(sDesc, 1, nBadSCAN - 1) | SUBST (sDesc, nBadSCAN + 1, nLenDesc)); 
		ENDIF;
		nBadSCAN = SCAN (sBadChar, sDesc);
		lCounter = lCounter + 1;
	END;	
ENDIF;


#------------------------------------------------------------------
#--- SCAN FOR BAD CHARACTER
#--- RIGHT CLOSED BRACKET
#------------------------------------------------------------------
nLenDesc = LONG (TRIM (sDesc));
sBadChar = ')';
lCounter = 1;
nBadSCAN = SCAN(sBadChar, sDesc);
IF (nBadScan <> 0);
	WHILE (nBadSCAN <> 0);
		#----------------------------------------------------------
		#--- Remove Open Bracket
		#----------------------------------------------------------
		IF (nBadSCAN = 1);
			sDesc = TRIM(SUBST (sDesc, 2, nLenDesc));
		ELSE;
			sDesc = TRIM (SUBST(sDesc, 1, nBadSCAN - 1) | SUBST (sDesc, nBadSCAN + 1, nLenDesc)); 
		ENDIF;
		nBadSCAN = SCAN (sBadChar, sDesc);
		lCounter = lCounter + 1;
	END;	
ENDIF;


#------------------------------------------------------------------
#--- SCAN FOR BAD CHARACTER
#--- SEMI COLON
#------------------------------------------------------------------
nLenDesc = LONG (TRIM (sDesc));
sBadChar = ';';
lCounter = 1;
nBadSCAN = SCAN(sBadChar, sDesc);
IF (nBadScan <> 0);
	WHILE (nBadSCAN <> 0);
		#----------------------------------------------------------
		#--- Remove Open Bracket
		#----------------------------------------------------------
		IF (nBadSCAN = 1);
			sDesc = TRIM(SUBST (sDesc, 2, nLenDesc));
		ELSE;
			sDesc = TRIM (SUBST(sDesc, 1, nBadSCAN - 1) | SUBST (sDesc, nBadSCAN + 1, nLenDesc)); 
		ENDIF;
		nBadSCAN = SCAN (sBadChar, sDesc);
		lCounter = lCounter + 1;
	END;	
ENDIF;
#------------------------------------------------------------------
#--- SCAN FOR BAD CHARACTER
#--- COMMA
#------------------------------------------------------------------
nLenDesc = LONG (TRIM (sDesc));
sBadChar = ',';
lCounter = 1;
nBadSCAN = SCAN(sBadChar, sDesc);
IF (nBadScan <> 0);
	WHILE (nBadSCAN <> 0);
		#----------------------------------------------------------
		#--- Remove Open Bracket
		#----------------------------------------------------------
		IF (nBadSCAN = 1);
			sDesc = TRIM(SUBST (sDesc, 2, nLenDesc));
		ELSE;
			sDesc = TRIM (SUBST(sDesc, 1, nBadSCAN - 1) | SUBST (sDesc, nBadSCAN + 1, nLenDesc)); 
		ENDIF;
		nBadSCAN = SCAN (sBadChar, sDesc);
		lCounter = lCounter + 1;
	END;	
ENDIF;

ENDIF;

#-------------------------------------------------------------------------------------------------------------------------------------------------------------

sRBVal = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'RB');
sNBVal = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'NB');
sFE01Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE01');
sFE02Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE02');
sFE03Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE03');
sFE04Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE04');
sFE05Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE05');
sFE06Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE06');
sFE07Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE07');
sFE08Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE08');
sFE09Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE09');
sFE10Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE10');
sFE11Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE11');
sFE12Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE12');
sFE13Val = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'FE13');

#---------------------------------------------------------------------------------------------------------------------------
#---- OLD METADATA
#---------------------------------------------------------------------------------------------------------------------------
sHLyear = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'headline year');
sScenario = CELLGETS (cbExtract, vsClient, sFFScenario, vsID, vsRowID, 'scenario');

#---------------------------------------------------------------------------------------------------------------------------
#**** Identify Columns of extract file
#---- sCol01 = Program
#---- sCol02 = Reason Code
#---- sCol03 = Account
#---- sCol04 = Related Entity
#---- sCol05 = SPP
#---- sCol06 = Appropriation
#---- sCol07 = Jurisdiction
#---- sCol08 = Movement Account
#---- sCol09 = Measure Code
#---- sCol10 = Adj Title
#---- sCol11 = Cmt Justification
#---- sCol12 to 26 = RB to FE13
#---------------------------------------------------------------------------------------------------------------------------
sCol01 = sProg;
sCol02 = sReason;
sCol03 = sAcc;
sCol04 = sRE;
sCol05 = sSPP;
sCol06 = sAppropriation;
sCol07 = sJur;
sCol08 = sMA;
sCol09 = sMeasCode;
sCol10 = sTitle;
sCol11 = sDesc;
sCol12 = sRBVal;
sCol13 = sNBVal;
sCol14 = sFE01Val;
sCol15 = sFE02Val;
sCol16 = sFE03Val;
sCol17 = sFE04Val;
sCol18 = sFE05Val;
sCol19 = sFE06Val;
sCol20 = sFE07Val;
sCol21 = sFE08Val;
sCol22 = sFE09Val;
sCol23 = sFE10Val;
sCol24 = sFE11Val;
sCol25 = sFE12Val;
sCol26 = sFE13Val;


IF (lHeaderCounter = 0);
#	ASCIIOUTPUT (sOutputFile, 'Program', 'Reason Code', 'Account', 'Related Agency', 'SPP', 'Appropriation', 'Jurisdiction', 'Movement Account', 'Measure', 'Adjustment Description', 'Cmt_Justification', sRB, sNB, sFE01, sFE02, sFE03, sFE04, sFE05, sFE06, sFE07, sFE08, sFE09, sFE10, sFE11, sFE12, sFE13);
	ASCIIOUTPUT (sOutputFile, 'Program', 'Reason Code', 'Account', 'Related Agency', 'SPP', 'Appropriation', 'Jurisdiction', 'Movement Account', 'Measure', 'Adjustment Description', 'Cmt_Justification', 'RB Amount', 'NB Amount', 'FE 1', 'FE 2', 'FE 3', 'FE 4', 'FE 5', 'FE 6', 'FE 7',  'FE 8', 'FE 9', 'FE 10', 'FE 11', 'FE 12', 'FE 13');

#	ASCIIOUTPUT (sOutputFile1, 'Program', 'Reason Code', 'Account', 'Related Agency', 'SPP', 'Appropriation', 'Jurisdiction', 'Movement Account', 'Measure', 'Adjustment Description', 'Cmt_Justification', sRB, sNB, sFE01, sFE02, sFE03, sFE04, sFE05, sFE06, sFE07, sFE08, sFE09, sFE10, sFE11, sFE12, sFE13);
ENDIF;


ASCIIOUTPUT (sOutputFile, sCol01, sCol02, sCol03, sCol04, sCol05, sCol06, sCol07, sCol08, sCol09, sCol10, sCol11, sCol12, sCol13, sCol14, sCol15, sCol16, sCol17, sCol18, sCol19, sCol20, sCol21, sCol22, sCol23, sCol24, sCol25, sCol26);
#ASCIIOUTPUT (sOutputFile1, sCol01, sCol02, sCol03, sCol04, sCol05, sCol06, sCol07, sCol08, sCol09, sCol10, sCol11, sCol12, sCol13, sCol14, sCol15, sCol16, sCol17, sCol18, sCol19, sCol20, sCol21, sCol22, sCol23, sCol24, sCol25, sCol26);

#---------------------------------------------------------------------------------------------------------------------------
#---- UPDATE AE ID DETAILS STATUS FOR ADJUSMENT
#---------------------------------------------------------------------------------------------------------------------------
CELLPUTS (sChangeStatus, cbID, sHLYear, sScenario, vsID, 'status');

lHeaderCounter = lHeaderCounter + 1;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#---------------------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
#---------------------------------------------------------------------------------------------------------------------------
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbExtract, sAEView);
SUBSETDESTROY (dmClients, sAEView);
SUBSETDESTROY (dmFFScenario, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmRowID, sAEView);
SUBSETDESTROY (dmExtractMeas, sAEView);


#---------------------------------------------------------------------------------------------------------------------------
#*** CLEAR FLATFILE SCREEN
#---------------------------------------------------------------------------------------------------------------------------
sProcess = 'AE_FlatFile 99 - Clear sys_Extract';
EXECUTEPROCESS (sProcess, 
	'psUser', psUser,
	'psHLYear', psHLYear,
	'psScenario', psScenario);
#endregion