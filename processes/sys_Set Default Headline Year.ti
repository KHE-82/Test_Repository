sDim = 'headline year';
sSubset = 'Default';
sSubset1 = 'Current';
sHLYear = ATTRS('variables', 'headline year', 'value');

#****DELETE EXISTING VIEWS AND SUBSETS
#SubsetDestroy('headline year', sSubset);
SubsetDeleteAllElements('headline year', sSubset);
SubsetDeleteAllElements('headline year', sSubset1);

#****CREATE SUBSETS****#
# headline year
#SubsetCreate('headline year', sSubset);
SubsetElementInsert('headline year', sSubset, sHLYear, 1);
SubsetElementInsert('headline year', sSubset1, sHLYear, 1);

