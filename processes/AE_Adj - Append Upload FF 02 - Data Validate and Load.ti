#*****************************************************************************
#**** USE EXISTING ID
#*****************************************************************************  
sNewID=SUBST(vsID,2,5);

#*****************************************************************************
#**** DISABLED - IMPORT DATA INTO ID DETAILS CUBE - NOT REQUIRED
#*****************************************************************************   
#CELLPUTN(1,cbID, psHLYear, psScenario, psID, 'used');
##CELLPUTS('Y', cbID, psHLYear, psScenario, psID, 'disagree cashflow');
#CELLPUTS(sProg, cbID, psHLYear, psScenario, psID,  snProg | ' code');
#sProgDesc = ATTRS(dmProg, sProg, 'code and description');
#CELLPUTS(sProgDesc, cbID, psHLYear, psScenario, psID, snProg | ' description');
