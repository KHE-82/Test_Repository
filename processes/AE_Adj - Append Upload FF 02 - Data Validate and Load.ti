#CELLPUTS(vsReason, cbID, psHLYear, psScenario, psID, 'reason');
#CELLPUTS(sNewOC, cbID, psHLYear, psScenario, psID, 'outcome');
#CELLPUTS(sNewFunc, cbID, psHLYear, psScenario, psID, 'function');
#CELLPUTS(vsSPP, cbID, psHLYear, psScenario, psID, 'SPP');
##CELLPUTS(sNewItem, cbID, psHLYear, psScenario, psID, 'appropriation item');
##CELLPUTS(sNewType,cbID, psHLYear, psScenario, psID, 'appropriation type');
#CELLPUTS(sItem, cbID, psHLYear, psScenario, psID, 'appropriation item');
#CELLPUTS(sType,cbID, psHLYear, psScenario, psID, 'appropriation type');

#CELLPUTS('ongoing',cbID, psHLYear, psScenario, psID, 'funding life');
