##IF (UPPER(SUBST (vsApplyParam, 1,1)) @= 'Y');
#	CELLPUTS('Y', cbID, psHLYear, psScenario, psID, 'apply parameters');
##ELSE;
#	#CELLPUTS('', cbID, psHLYear, psScenario, psID, 'apply parameters');
##ENDIF;

#ASCIIOUTPUT('AEAdj Append02 CreatedBy.txt', sUser,psHLYear,psScenario, psID);

CELLPUTS(sUser, cbID, psHLYear, psScenario, psID, 'created by');

#*****************************************************************************
#**** GET DATE
#*****************************************************************************   
# **** GET DATE VALUES ***#
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 

sDay = TRIM(SUBST(sDNow, 1,2));

IF (LONG (sDay) = 1);
	sDay = '0' | sDay;
ELSE;
	sDay = sDay;
ENDIF;

sMonth = TRIM(SUBST(sMNow, 1,2));

IF (LONG (sMonth) = 1);
	sMonth = '0' | sMonth;
ELSE;
	sMonth = sMonth;
ENDIF;

sYear = TRIM(SUBST(sYNow, 1,4));

sNow = sDay | '/' | sMonth | '/' | sYear;

CELLPUTS(sNow, cbID, psHLYear, psScenario, psID, 'created date');
CELLPUTS(sAdjType, cbID, psHLYear, psScenario, psID, 'Adjustment Type');
CELLPUTS(vsControlType, cbID, psHLYear, psScenario, psID, 'Control Type');


#*****************************************************************************
#**** GET MEASURE DATA
#*****************************************************************************   
sFundLife = CELLGETS (cbMeasID, psHLYear, psScenario, vsMeasCode, 'funding life');

IF (vsMeasCode @= 'M00000');
	sFundLife = 'ongoing';
ENDIF;
     
IF (sFundLife @= '');
	sFundLife = 'ongoing';
ENDIF;

sEndDate = CELLGETS (cbMeasID, curHLYear, curScenario, vsMeasCode, 'end date');

CELLPUTS (sFundLife, cbID, curHLYear, curScenario, psID, 'funding life');
CELLPUTS (sEndDate, cbID, curHLYear, curScenario, psID, 'end date');


#*****************************************************************************
#****  CASH FLOW CHECKS
#*****************************************************************************  
IF (nZeroCheck = 0);
     	IF (SUBST(vsAcc,1,1) @= '6');
          		CELLPUTS (vsAcc, cbID, psHLYear, psScenario, psID, 'zero cashflow account');
     	ELSE;
          		CELLPUTS ('', cbID, psHLYear, psScenario, psID, 'zero cashflow account');
     	ENDIF;
ELSE;
	#*** THISI S TO PUT ZERO CASH FLOW FLAG BACK TO NOTHING
	#     CELLPUTS ('', cbID, psHLYear, psScenario, psNewID, 'zero cashflow account');
ENDIF;


