#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Adj - Append Upload FF 02 - Data Validate and Load
#**** DESCRIPTION:       This process will validate the Flatfile data and ADD the data to the existing adjustment
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 03/01/2024    BL             Initial Revision
#***********************************************************************************************************************

snProg = 'programme';



#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';


#*****************************************************************************
#*** DECLARE CUBES AND DIMENSIONS***#
#*****************************************************************************
cbMeasID = 'government measures details';
cbAE = 'AE adjustments';
sCube = cbAE;
cbID = 'AE id details';

cbProg = snProg | ' details';
dmProg = snProg;


#*****************************************************************************
#*** DECLARE SYSTEM VARIABLES
#*****************************************************************************
dmVar = 'variables'; 
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
#sImpFilePath = ATTRS(dmVar, 'sys_Costings Import Directory', ' value');
sImpFilePath = ATTRS(dmVar, 'sys_ImpFileExceptionLogs', ' value');

IF(psHLYear @='');
	sHLYear = curHLYear;
ELSE;
	sHLYear = psHLYear;
ENDIF;

IF(psScenario @='');
	sScenario = curScenario;
ELSE;
	sScenario = psScenario;
ENDIF;

sStatus = 'data';
sAdjType = 'Manual';

#*****************************************************************************
#*** DECLARE AE ADJUSTMENTS DIMENSIONS ***#
#*****************************************************************************
dmID = 'id';
dmOC = 'outcome';
dmRE = 'related entity';
dmReason = 'reason';
dmType = 'appropriation type';
dmItem = 'appropriation item';
dmFunc = 'function';
dmMeas = 'measure code';
dmAcc = 'account';
dmMA = 'movement account';
dmSPP = 'spp';
dmJur = 'jurisdiction';


sOldTitle = '';
sOldCBMS = '';
sOldID = '';


#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, 'GEUS User Name');
                IF (sUser @= '');
                          PROCESSQUIT;
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;


ATTRPUTS ('PASS', dmVar, 'sys_ImpFileValidation', 'value');

# **** GET DATE VALUES ***#
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 
sHNow = TimST (Now, '\h');
sMinNow = TimST (Now, '\i');
sSNow = TimST (Now, '\s');
 
sDay = TRIM(SUBST(sDNow, 1,2));
 
IF (LONG (sDay) = 1);
	sDay = '0' | sDay;
ELSE;
     	sDay = sDay;
ENDIF;
 
sMonth = TRIM(SUBST(sMNow, 1,2));
 
IF (LONG (sMonth) = 1);
     	sMonth = '0' | sMonth;
ELSE;
     	sMonth = sMonth;
ENDIF;
 
sYear = TRIM(SUBST(sYNow, 1,4));
sNow = sYear | sMonth | sDay | sHNow | sMinNow | sSNow ;
 
sOutputFile = 'geus append adj upload file failed' | sUser | ' ' | sNow | '.csv';


#*****************************************************************************
#***** COUNTERS USED
#*****************************************************************************
lHeaderCount = 0;
nLine = 1;
nValid = 0;

nProgValid = 0;
nOCValid = 0;
nMeasValid = 0;
nReasValid = 0;
nFuncValid = 0;
nMAValid = 0;
nAccValid = 0;
nItemValid = 0;
nTypeValid = 0;
nREValid  = 0;
nSPPValid = 0;
nJurValid = 0;
nAccREValid = 0;
nAccJurValid = 0;
nAccMAValid = 0;
nMAREValid = 0;

nTitleValid = 0;
nTotalValid = 0;

#*****************************************************************************
#*** IDENTIFY SOURCE FILE
#*****************************************************************************
sFilePath = ATTRS (dmVar, 'sys_CBMS Upload directory', 'value');

#--REMOVE THIS AFTER INITIAL LOAD-----#
#sFilePath='.\file conversion\';
#sFileName = sFilePath | psFileName;
#sFileName = psFileName;

DATASOURCENAMEFORSERVER = psFileName;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


# Resets flag to say it is not a zero line
nZeroCheck = 1;

IF (vnP01 = 0 & vnP02 = 0 & vnP03 = 0 & vnP04 = 0 & vnP05 = 0 & vnP06 = 0 & vnP07 = 0 & vnP08 = 0 & vnP09 = 0 & vnP10 = 0 & vnP11 = 0 & vnP12 = 0 & vnP13 = 0 & vnP14 = 0 & vnP15 = 0) ;
	nZeroCheck = vnP01 + vnP02 + vnP03 + vnP04 + vnP05 + vnP06 + vnP07 + vnP08 + vnP09 + vnP10 + vnP11 + vnP12  + vnP13 + vnP14 +vnP15;	
	nLine = nLine + 1;
	ITEMSKIP;
ENDIF;



#*****************************************************************************
# Get period elements
#*****************************************************************************

Period02 = SUBST(ATTRS(dmVar, 'headline year', 'value'), 3, 9);
Period00 = DIMNM('period', DIMIX('period', Period02) -2);
#Period00 = '2020-2021';
Period01 = DNEXT('period', Period00);
#Period02 = DNEXT('period', Period01);
Period03 = DNEXT('period', Period02);
Period04 = DNEXT('period', Period03);
Period05 = DNEXT('period', Period04);
Period06 = DNEXT('period', Period05);
Period07 = DNEXT('period', Period06);
Period08 = DNEXT('period', Period07);
Period09 = DNEXT('period', Period08);
Period10 = DNEXT('period', Period09);
Period11 = DNEXT('period', Period10);
Period12 = DNEXT('period', Period11);
Period13 = DNEXT('period', Period12);
Period14 = DNEXT('period', Period13);
Period15 = DNEXT('period', Period14);
Period16 = DNEXT('period', Period15);




#*****************************************************************************
# SKIP CERTAIN ACCOUNTS
#*****************************************************************************
IF (vsAcc @= '3322001' % vsAcc @= '2330008' % vsAcc @= '2330009' % vsAcc @= '3322002' % vsAcc @= '9000510' % vsAcc @= '9000515' % vsAcc @= '9000520' % vsAcc @= '9000525' % vsAcc @= '8260010');

     ItemSkip;
ENDIF;


#------TREASURY GEUS SPECIFIC------#
IF( vsCBMSProg @= '40005'  % vsMA @= '7894' % scan('831000', vsAcc) <>0);

	ITEMSKIP;
ENDIF;


#--REMOVE THIS AFTER INITIAL LOAD-----#
#IF(vsFormID@='' % vsStage @<>'validated');
#	ITEMSKIP;
#ENDIF;


#------IGNORE 4100001 /7201  7211 for SPPs - AE Adjustment Rule------#
IF( DIMIX(dmProg, vsSPP)  <> 0);
	IF( vsAcc @= '4100001' & vsMA @='7201');
		ItemSkip;
	ENDIF;

	IF( vsAcc @= '4100001' & vsMA @='7211');
		ItemSkip;
	ENDIF;

ENDIF;

IF( vsAcc @= '6100001' );
	ItemSkip;
ENDIF;

IF( vsAcc @= '9000883' );
	#ItemSkip;
ENDIF;

#IF( scan( '_old', vsProgName) <>0);
#	ITEMSKIP;
#ENDIF;
#*************************************************************************************************************************************#
#**** DEFAULT ACCOUNTS ****#
#**** If these dimensions are blank, use the specified default values:

# Get movement account element
IF (vsMA @= '');
	vsMA = '-';
ELSE;
	vsMA = DimensionElementPrincipalName(dmMA,vsMA);
ENDIF;

# Get related entity element
IF (vsRE @= '');
	vsRE = '-';
ELSE;
	vsRE = DimensionElementPrincipalName(dmRE,vsRE);
ENDIF;

# Get SPP element
IF (vsSPP @= '');
	vsSPP = '-';
ELSE;
	vsSPP = DimensionElementPrincipalName(dmSPP,vsSPP);
ENDIF;

# Get jurisdiction element
IF (vsJur @= '');
	vsJur = '-';
ELSE;
	vsJur = DimensionElementPrincipalName(dmJur,vsJur);
ENDIF;


#* Get Measure Code Element
IF (vsMeasCode @= '');
	vsMeasCode = 'M00000';
ELSE;
	vsMeasCode = DimensionElementPrincipalName(dmMeas,vsMeasCode);
ENDIF;


#--------------------------------------------------------------------------------
#*** Check Programme
#--------------------------------------------------------------------------------
vsProg = SUBST(vsProg,1,11);
IF( vsProg @= '');
	IF( DIMIX( dmProg ,vsCBMSProg) <> 0);
		sProg = vsCBMSProg;
		sProgType = DTYPE(dmProg, sProg);
	
		WHILE( sProgType @='C');
			sProg = ELCOMP(dmProg, sProg,1);
			sProgType = DTYPE(dmProg,sProg);

		END;

		sCtrlTypeCheck = CELLGETS (cbProg, curHLYear, curScenario, sProg, 'Control Type');
		sOC = CELLGETS (cbProg, curHLYear, curScenario, sProg, 'outcome');
		sFunc = CELLGETS (cbProg, curHLYear, curScenario, sProg, 'function');
		sType = CELLGETS (cbProg, curHLYear, curScenario, sProg, 'appropriation type');
		sItem = CELLGETS (cbProg, curHLYear, curScenario, sProg, 'appropriation item');

	ELSE;

		nProgValid = nProgValid + 1;
	ENDIF;	

ELSEIF (DIMIX (dmProg, vsProg) = 0);
	nProgValid = nProgValid + 1;
ELSE;

	IF( DTYPE(dmProg, vsProg) @='N');
		sCtrlTypeCheck = CELLGETS (cbProg, curHLYear, curScenario, vsProg, 'Control Type');
		sOC = CELLGETS (cbProg, curHLYear, curScenario, vsProg, 'outcome');
		sFunc = CELLGETS (cbProg, curHLYear, curScenario, vsProg, 'function');
		sType = CELLGETS (cbProg, curHLYear, curScenario, vsProg, 'appropriation type');
		sItem = CELLGETS (cbProg, curHLYear, curScenario, vsProg, 'appropriation item');
		sProg = vsProg;

		IF (sCtrlTypeCheck @<> vsControlType);
			nProgValid = nProgValid + 1;     
		ENDIF;
	ELSE;
			nProgValid = nProgValid + 1;    
		
		
	ENDIF;
ENDIF;

#--------------------------------------------------------------------------------
#*** Check Outcome
#--------------------------------------------------------------------------------
IF (vsOC @= '');
	sNewOC = sOC;
ELSE;
	sNewOC = vsOC;
ENDIF;

#--------------------------------------------------------------------------------
#*** Check Reason
#--------------------------------------------------------------------------------
IF (DIMIX (dmReason, vsReason) = 0 & vsReason @='');
	vsReason = '1029';
ENDIF;

#--------------------------------------------------------------------------------
#*** Check Function
#--------------------------------------------------------------------------------
IF (vsFunc @= '');
	sNewFunc = sFunc;
ELSE;
	sNewFunc = vsFunc;
ENDIF;

#--------------------------------------------------------------------------------
#*** Check Appropriation Item
#--------------------------------------------------------------------------------
IF (vsItem @= '');
	sNewItem = sItem;
ELSE;
	sNewItem = DimensionElementPrincipalName(dmItem,vsItem);
ENDIF;

IF (DIMIX (dmItem, sNewItem) = 0);
	nItemValid = nItemValid + 1;
ENDIF;

#--------------------------------------------------------------------------------
#*** Check Appropriation Type
#--------------------------------------------------------------------------------
IF (vsItem @= '');
	sNewType = sType;
ELSE;
	sNewType = SUBST(vsItem,1,4);
ENDIF;

IF (DIMIX (dmType, sNewType) = 0);
	nTypeValid = nTypeValid + 1;
ELSE;
	sItemType = SUBST (sNewItem, 1, 4);
	IF (sItemType @<> sNewType);
		nTypeValid = nTypeValid + 1;
	ENDIF;

ENDIF;


#--------------------------------------------------------------------------------
#*** Check Account
#--------------------------------------------------------------------------------
IF (DIMIX (dmAcc, vsAcc) = 0);
	nAccValid = nAccValid + 1;
ELSE;
	#--------------------------------------------------------------------------------
	#*** NOW CHECK IF IT REQUIRES RELATED ENTITY OR JURISDICTION ***#
	#--------------------------------------------------------------------------------
	sRECheck = ATTRS( dmAcc, vsAcc, 'related entity enabled');
	sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
	sJurCheck = ATTRS( dmAcc, vsAcc, 'jurisdiction required');
	sMACheck = ATTRS( dmAcc, vsAcc, 'movement account required');

	#--------------------------------------------------------------------------------   
	#*** Account has related entity enabled ***#
	#--------------------------------------------------------------------------------
	IF (sRECheck @= 'Y');
     
		#--------------------------------------------------------------------------------
		#*** CHECK IF assumed related entity is not blank, otherwise just use another related entity
		#--------------------------------------------------------------------------------
		sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
		IF (sAssumedRE @= '');

			#--------------------------------------------------------------------------------
                		#*** IF NO ASSUMED RELATED ENTITY, USE OTHER RELATED ENTITY ***#
			#--------------------------------------------------------------------------------
			IF (vsRE @<> '-');
				#--------------------------------------------------------------------------------
				#*** DO CHECK FOR RE EXISTS ***#
				#--------------------------------------------------------------------------------
				IF ( nREValid = 1);
					#*** UTILIZES PREVIOUS CHECKS ***#
                           				nAccREValid = nAccREValid + 1;
                      			ENDIF;  
                 		ENDIF;
            		ELSE;
			#--------------------------------------------------------------------------------
                		#*** DO CHECK FOR RE EXISTS ***#
			#--------------------------------------------------------------------------------
                 		IF ( nREValid = 1);
				#--------------------------------------------------------------------------------
                      			#*** UTILIZES PREVIOUS CHECKS ***#
				#--------------------------------------------------------------------------------
                 			vsRE = vsRE;
                 		ELSE;
				#--------------------------------------------------------------------------------
                      			#*** IF Account has assumed RE Then use Assumed RE
				#--------------------------------------------------------------------------------
                       			IF (vsRE @<> sAssumedRE);
                             				nAccREValid = nAccREValid + 1;
                        			ENDIF;
                  		ENDIF;
            		ENDIF;
    
    	ELSE;
		#--------------------------------------------------------------------------------
          		#*** SOMETIMES EVEN WITHOUT RELATED ENTITY ENABLED, THIS ACCOUNT SHOULD HAVE A RELATED ENTITY ***#
		#--------------------------------------------------------------------------------
          		sAssumedRE = ATTRS( dmAcc, vsAcc, 'assumed related entity');
          		IF (sAssumedRE @<> '');
               			#*** DO CHECK FOR RE EXISTS ***#
               			IF ( nREValid = 1);
				#--------------------------------------------------------------------------------
                    			#*** UTILIZES PREVIOUS CHECKS ***#
				#--------------------------------------------------------------------------------
                    			vsRE = vsRE;
                		ELSE;
                    			IF (vsRE @<> sAssumedRE);
                         				vsRE = sAssumedRE;
                    			ENDIF;
                		ENDIF;
          		ENDIF;

     	ENDIF;

	#--------------------------------------------------------------------------------
	#*** Account has Jurisdiction enabled ***#
	#--------------------------------------------------------------------------------
     	IF (sJurCheck @= 'Y');
     
          		#*** Now check if Jurisdiction is Blank or '-' ***#
               		IF (vsJur @= '-');
			#--------------------------------------------------------------------------------
                    		#*** Validation Fail for Jurisdiction as this account requires Jurisdiction not blank, if so, then account check failed
			#--------------------------------------------------------------------------------
                    		nAccJurValid = nAccJurValid + 1;
               		ELSE;
			#--------------------------------------------------------------------------------
                   		#*** DO CHECK FOR JURISDICTION EXISTS ***#
			#--------------------------------------------------------------------------------
                    		IF (DIMIX (dmJur, vsJur) = 0);
                         			nAccJurValid = nAccJurValid + 1;
                    		ENDIF;
               		ENDIF;       
     	ENDIF;

	#--------------------------------------------------------------------------------
     	#*** Account has Movment Account enabled ***#
	#--------------------------------------------------------------------------------
     	IF (sMACheck @= 'Y');
     
		#--------------------------------------------------------------------------------
          		#*** Now check if Jurisdiction is Blank or '-' ***#
		#--------------------------------------------------------------------------------
               		IF (vsMA @= '-');
			#--------------------------------------------------------------------------------
                    		#*** Validation Fail for Movement Account as this account requires a Movement Account , if so, then account check failed
			#--------------------------------------------------------------------------------
                    		nAccMAValid = nAccMAValid + 1;
               		ELSE;
			#--------------------------------------------------------------------------------
                   		#*** DO CHECK FOR MOVEMENT ACCOUNT EXISTS ***#
			#--------------------------------------------------------------------------------
                    		IF (nMAValid = 1);
				#--------------------------------------------------------------------------------
                        			#*** UTILIZES PREVIOUS CHECKS ***#
				#--------------------------------------------------------------------------------
                    		ELSE;
				#--------------------------------------------------------------------------------
                         			#*** IF MA EXISTS, CHECK ASSUMED RE ***#
				#--------------------------------------------------------------------------------
                         			sMARECheck = ATTRS (dmMA, vsMA, 'related entity enabled');
                         			sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');

				#--------------------------------------------------------------------------------
                         			#*** Movement Account has related entity enabled ***#
				#--------------------------------------------------------------------------------
                         			IF (sMARECheck @= 'Y');
					#--------------------------------------------------------------------------------
                              				#*** CHECK IF assumed related entity is not blank, if so, then account check failed
					#--------------------------------------------------------------------------------
                              				sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');

                              				IF (sMAAssumedRE @= '');
						#--------------------------------------------------------------------------------
                                   				#*** IF NO ASSUMED RELATED ENTITY, USE OTHER RELATED ENTITY ***#
						#--------------------------------------------------------------------------------
                                   				IF (vsRE @<> '-');
							#--------------------------------------------------------------------------------
                                        					#*** DO CHECK FOR RE EXISTS ***#
							#--------------------------------------------------------------------------------
                                        					IF ( nREValid = 1);
								#--------------------------------------------------------------------------------
                                             						#*** UTILIZES PREVIOUS CHECKS ***#
								#--------------------------------------------------------------------------------
                                             						nMAREValid = nMAREValid + 1;
                                        					ENDIF;  
                                   				ENDIF;
                              				ELSE;
						#--------------------------------------------------------------------------------
                                   				#*** IF Account has assumed RE Then use Assumed RE
						#--------------------------------------------------------------------------------
                                   				IF (vsRE @<> sMAAssumedRE);
                                        					vsRE = sMAAssumedRE;
                                   				ENDIF;
                              				ENDIF;
                       			ELSE;
					#--------------------------------------------------------------------------------
                             				#*** DO CHECK FOR RE EXISTS ***#
					#--------------------------------------------------------------------------------
                             				IF ( nREValid = 1);
						#--------------------------------------------------------------------------------
                                  				#*** UTILIZES PREVIOUS CHECKS ***#
						#--------------------------------------------------------------------------------
                             				ELSE;

						#--------------------------------------------------------------------------------
				                                #*** SOMETIMES EVEN WITHOUT RELATED ENTITY ENABLED, THIS ACCOUNT SHOULD HAVE A RELATED ENTITY ***#
                                 				sMAAssumedRE = ATTRS (dmMA, vsMA, 'assumed related entity');
						#--------------------------------------------------------------------------------
                                 				IF (sMAAssumedRE @<> '');
                                      					IF (vsRE @<> sMAAssumedRE);
                                           						vsRE = sMAAssumedRE;
                                       					ENDIF;
                                  				ENDIF;
                             				ENDIF;
                        			ENDIF;
                    		ENDIF;
               		ENDIF;
     	ELSE;
		#--------------------------------------------------------------------------------
     		#*** DO NOTHING IF ACCOUNT IS NO MOVEMENT ACCOUNT ***#
		#--------------------------------------------------------------------------------
	ENDIF;
ENDIF;

#*************************************************************************************************************************************

