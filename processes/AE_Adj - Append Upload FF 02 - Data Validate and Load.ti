	IF(nP15<>0);
	CellPutN(OldP15 + NP15, sCube, psHLYear, psScenario, sStatus, sNewOC, vsRE, sNewFunc, vsReason, vsSPP, vsMeasCode, sNewType, vsMA, sNewItem, sProg, vsAcc, psID, vsJur, Period15);
