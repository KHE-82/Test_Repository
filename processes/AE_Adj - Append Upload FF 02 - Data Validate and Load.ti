	CellPutN(OldP06 + NP06, sCube, psHLYear, psScenario, sStatus, sNewOC, vsRE, sNewFunc, vsReason, vsSPP, vsMeasCode, sNewType, vsMA, sNewItem, sProg, vsAcc, psID, vsJur, Period06);
	ENDIF;

	IF(nP07<>0);
	CellPutN(OldP07 + NP07, sCube, psHLYear, psScenario, sStatus, sNewOC, vsRE, sNewFunc, vsReason, vsSPP, vsMeasCode, sNewType, vsMA, sNewItem, sProg, vsAcc, psID, vsJur, Period07);
	ENDIF;

	IF(nP08<>0);
	CellPutN(OldP08 + NP08, sCube, psHLYear, psScenario, sStatus, sNewOC, vsRE, sNewFunc, vsReason, vsSPP, vsMeasCode, sNewType, vsMA, sNewItem, sProg, vsAcc, psID, vsJur, Period08);
