#*****************************************************************************
#**** SET FLAG TO USE NEW CASH FLOW DERIVATION
#*****************************************************************************  
#CELLPUTS ('Y', cbID, psHLYear, psScenario, psID, 'use new cash flow derivation');


#*****************************************************************************
#**** CONVERT SIGNAGE ON FLAT FILE VALUE
#*****************************************************************************  
IF (vsMA @= '-');
	X = ATTRS(dmAcc, vsAcc, 'DR/CR');
ELSE;
	X = ATTRS(dmMA, vsMA, 'DR/CR');
ENDIF;

#IF (psSource @= 'CBMS');
#IF (psSign @= 'Natural Sign');

IF (psSign @= 'All DR Sign');
	#-----------------------------------------------------------------------------------
	#--- Since its all DR Sign, there would be negatives, so would need to convert.
	#-----------------------------------------------------------------------------------
	IF (X @= 'CR');
         		iConversion = -1;
     	ELSE;
         		iConversion = 1;
     	ENDIF;
ELSE;
	iConversion = 1;
ENDIF;


#NP00 = P00 * iConversion;
NP01 = vnP01 * iConversion;
NP02 = vnP02 * iConversion;
NP03 = vnP03 * iConversion;
NP04 = vnP04 * iConversion;
NP05 = vnP05 * iConversion;
NP06 = vnP06 * iConversion;
NP07 = vnP07 * iConversion;
NP08 = vnP08 * iConversion;
NP09 = vnP09 * iConversion;
NP10 = vnP10 * iConversion;
NP11 = vnP11 * iConversion;
NP12 = vnP12 * iConversion;
NP13 = vnP13 * iConversion;
NP14 = vnP14 * iConversion;
NP15 = vnP15 * iConversion;


#*****************************************************************************
#**** GET EXISTING VALUE FROM CUBE
