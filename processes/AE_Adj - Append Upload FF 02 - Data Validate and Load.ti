	CellPutN(OldP02 + NP02, sCube, psHLYear, psScenario, sStatus, sNewOC, vsRE, sNewFunc, vsReason, vsSPP, vsMeasCode, sNewType, vsMA, sNewItem, sProg, vsAcc, psID, vsJur, Period02);
