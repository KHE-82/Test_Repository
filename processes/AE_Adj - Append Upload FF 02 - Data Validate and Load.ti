#sCheckCBMSVar = vsID | sProg | sNewOC | sNewFunc | sNewType | sNewItem | vsSPP | vsReason | vsMeasCode | vsDesc;
#sCheckCBMSVar = vsID | sProg | sNewOC | sNewFunc | vsSPP | vsReason | vsMeasCode | vsDesc;
sCheckCBMSVar = vsID | sProg | sNewOC | sNewFunc | vsReason | vsMeasCode | vsDesc;
