IF (CELLISUPDATEABLE(sCube, psHLYear, psScenario, sStatus, sNewOC, vsRE, sNewFunc, vsReason, vsSPP, vsMeasCode, sNewType, vsMA, sNewItem, sProg, vsAcc, psID, vsJur, Period01) = 1);
	
	#**** ONLY INCREMENT IF NEW VALUE  IS NOT ZERO
	IF(nP01<>0);
		CellPutN(OldP01 + NP01, sCube, psHLYear, psScenario, sStatus, sNewOC, vsRE, sNewFunc, vsReason, vsSPP, vsMeasCode, sNewType, vsMA, sNewItem, sProg, vsAcc, psID, vsJur, Period01);
