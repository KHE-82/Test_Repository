#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               AE_Measure Create New 02 - Validate
#**** DESCRIPTION:       This process creates a new adjustment and validates
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#***********************************************************************************************************************


#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#******************************************************************************************************************
#*** DECLARE GOVERNMENT MEASURES DETAILS CUBE DIMENSIONS
#******************************************************************************************************************
cbMeas = 'government measures details';
dmGovtMeas = 'measure details';


dmMeasType = 'measure type';
dmMeasFundType = 'measure fund type';


#******************************************************************************************************************
#*** DECLARE AE ID DETAILS CUBE DIMENSIONS
#******************************************************************************************************************
cbID = 'AE id details';
dmIDMeas = 'id measure';


#-------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE
#-------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';
dmCtrlType = 'control type';
dmFavID = 'favourites_id';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sNoMeasCode = ATTRS(dmVar, 'No Measure Code', 'value');

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED
#******************************************************************************************************************
sView = sUser | ' $NewAdj02';

#******************************************************************************************************************
#*** VARIABLES USED 
#******************************************************************************************************************
sStatus = 'draft';
sAdjType = 'Manual';


#*****************************************************************************************************************************************************
#**** STEP 1 - VALIDATE CURRENT DATA ENTRY 
#******************************************************************************************************************
#*** VALIDATION CHECK RESETS
#*** These validation checks are set to 0, to reset. 
#*** 0 means valid, Greater than 0, means it is invalid
#******************************************************************************************************************


sErrCBMSMeasCode = '';
sErrTitle = '';
sErrPubTitle = '';
sErrDesc = '';
sErrMeasType = '';
sErrFundLife = '';
sErrCostingID = '';
sErrProg = '';
sErrEndDay = '';
sErrEndMth = '';
sErrEndYear = '';

#----------------------------------------------------------------------
#*** Clear validate rules
#----------------------------------------------------------------------
CELLPUTS (sErrCBMSMeasCode, cbClient, sUser, 'meas_CBMS Measure Code', 'validate');
CELLPUTS (sErrTitle, cbClient, sUser, 'meas_title', 'validate');
CELLPUTS (sErrPubTitle, cbClient, sUser, 'meas_published title', 'validate');
CELLPUTS (sErrDesc, cbClient, sUser, 'meas_description', 'validate');
CELLPUTS (sErrMeasType, cbClient, sUser, 'meas_measure type', 'validate');
CELLPUTS (sErrFundLife, cbClient, sUser, 'meas_FundLife', 'validate');
CELLPUTS (sErrCostingID, cbClient, sUser, 'meas_costing ID', 'validate');
CELLPUTS (sErrProg, cbClient, sUser, 'meas_programme', 'validate');
CELLPUTS (sErrEndDay, cbClient, sUser, 'meas_end day', 'validate');
CELLPUTS (sErrEndMth, cbClient, sUser, 'meas_end month', 'validate');
CELLPUTS (sErrEndYear, cbClient, sUser, 'meas_end year', 'validate');



#----------------------------------------------------------------------
#*** Reset Validation Counters
#----------------------------------------------------------------------
nCBMSMeasCodeValid = 0;
nTItleValid = 0;
nPubTItleValid = 0;
nDescValid = 0;
nMeasTypeValid = 0;
nFundLifeValid = 0;
nProgValid = 0;
nCostingIDValid = 0;
nEndDayValid = 0;
nEndMthValid = 0;
nEndYearValid = 0;


#******************************************************************************************************************
#*** GET NEXT MEASURE ID
#******************************************************************************************************************
sPreFix = 'M';
nNewID = CELLGETN (cbMeas, curHLYear, curScenario, 'Total Measures', 'used') + 1;
sNewID = NUMBERTOSTRING (nNewID);
sNewID = sPreFix | FILL ('0', 5 - Long(sNewID)) | sNewID;


#******************************************************************************************************************
#*** MEASURE CODE
#*** Check if this element exist
#******************************************************************************************************************
IF (DIMIX (dmMeasCode, psCBMSMeasCode) = 0);
	#sErrMeasCode = 'Measure Code selected does not exist';
	#nMeasCodeValid = nMeasCodeValid + 1;
ELSE;
	#---------------------------------------------------------------------------------
	#--- CHECK IF MEASURE ALREADY EXISTS WITH ANOTHER ELEMENT
	#---------------------------------------------------------------------------------
	sUniqueMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, psCBMSMeasCode);
	IF (sUniqueMeasCode @<> sNewID);
		nCBMSMeasCodeValid = nCBMSMeasCodeValid + 1;
		sErrCBMSMeasCode = 'CBMS Measure Code already exists for ' | sUniqueMeasCode;
	ENDIF;
ENDIF;




#******************************************************************************************************************
#*** TITLE
#*** Title can not be blank or greater than 250 characters
#******************************************************************************************************************
IF (psTitle @= '');
	sErrTitle = 'Title can not be blank';
	nTitleValid = nTitleValid + 1;
ELSE;
	IF (LONG(psTitle) > 250);
		sErrTitle = 'Please review title as it has more than 250 characters long';
		nTitleValid = nTitleValid + 1;
	ENDIF;
ENDIF;

#******************************************************************************************************************
#*** DESCRIPTION
#*** Title can not be blank or greater than 250 characters
#******************************************************************************************************************
IF (psDesc @= '');
	sErrDesc = 'Description can not be blank';
	nDescValid = nDescValid + 1;
ELSE;

ENDIF;


#******************************************************************************************************************
#*** MEASURE TYPE
#*** Check if measurel type is valid
#******************************************************************************************************************

IF (DIMIX (dmMeasType, psMeasType) = 0);
	sErrMeasType = 'Measure Type selected does not exist';
	nMeasTypeValid = nMeasTypeValid + 1;
ENDIF;

#******************************************************************************************************************
#*** FUNDING LIFE
#*** Check if fundling life is valid
#******************************************************************************************************************

IF (DIMIX (dmMeasFundType, psFundLife) = 0);
	sErrFundLife = 'Measure Funding LIfe selected does not exist';
	nFundLifeValid = nFundLifeValid + 1;
ENDIF;

#******************************************************************************************************************
#*** END DAY
#*** Check if data exists if funding life is terminating
#******************************************************************************************************************
IF (psFundLife @= 'terminating');
	IF (psEndDay @= '' % psEndMth @= '' % psEndYear @= '');
		
		nEndDayValid = nEndDayValid + 1;
		nEndMthValid = nEndMthValid + 1;
		nEndYearValid = nEndYearValid + 1;

		sErrEndDay = 'Please enter a valid end date for a terminating measure';
		sErrEndMth = 'Please enter a valid end date for a terminating measure';
		sErrEndYear = 'Please enter a valid end date for a terminating measure';
	ENDIF;

ENDIF;


#******************************************************************************************************************
#*** STEP 02 - PERFORM VALIDATION
#*** CALCULATE ALL VALIDATIONS
#******************************************************************************************************************
nIDValid = nCBMSMeasCodeValid + nTItleValid + nDescValid + nMeasTypeValid + nFundLifeValid + nEndDayValid + nEndMthValid + nEndYearValid;

IF (nIDValid > 0);

	#******************************************************************************************************************
	#*** VALIDATION FAILED
	#******************************************************************************************************************

	CELLPUTS (sErrCBMSMeasCode, cbClient, sUser, 'meas_CBMS Measure Code', 'validate');
	CELLPUTS (sErrTitle, cbClient, sUser, 'meas_title', 'validate');
	CELLPUTS (sErrPubTitle, cbClient, sUser, 'meas_published title', 'validate');
	CELLPUTS (sErrDesc, cbClient, sUser, 'meas_description', 'validate');
	CELLPUTS (sErrMeasType, cbClient, sUser, 'meas_measure type', 'validate');
	CELLPUTS (sErrFundLife, cbClient, sUser, 'meas_FundLife', 'validate');
	CELLPUTS (sErrCostingID, cbClient, sUser, 'meas_costing ID', 'validate');
	CELLPUTS (sErrProg, cbClient, sUser, 'meas_programme', 'validate');
	CELLPUTS (sErrEndDay, cbClient, sUser, 'meas_end day', 'validate');
	CELLPUTS (sErrEndMth, cbClient, sUser, 'meas_end month', 'validate');
	CELLPUTS (sErrEndYear, cbClient, sUser, 'meas_end year', 'validate');


	#******************************************************************************************************************
	#*** STOP PROCESS SINCE VALIDATION FAILED
	#******************************************************************************************************************

	PROCESSQUIT;

ELSE;
	#******************************************************************************************************************
	#*** EXECUTE NEXT PROCESS
	#*** RUN PROCESS TO CREATE NEW SYSTEM ID
	#******************************************************************************************************************
	IF (DIMIX (dmMeasCode, sNewID) = 0);
		sProcess = 'AE_Create Measure Code';
		EXECUTEPROCESS (sProcess, 'psUser', sUser, 'psID', sNewID);
	ENDIF;
	

	#******************************************************************************************************************
	#*** VALIDATION PASSED 
	#*** CREATE NEW MEASURE
	#******************************************************************************************************************

	#******************************************************************************************************************
	#*** POST ENTERED DATA IN AE ID DETAIL CUBE
	#*** ALSO STORE WITHIN SYS CLIENT PREFERENCE CUBE
	#******************************************************************************************************************

	#******************************************************************************************************************
	#*** GOVERNMENT MEASURES DETAILS CUBE POSTING
	#******************************************************************************************************************
	CELLPUTN (1, cbMeas, curHLYear, curScenario, sNewID, 'used');
	CELLPUTS (sStatus, cbMeas, curHLYear, curScenario, sNewID, 'status');


	#******************************************************************************************************************
	# **** GET DATE VALUES AND POST USER AND DATE STAMP
	#******************************************************************************************************************
     	sDNow = TimST( Now, '\D'); 
	sMNow = TimST( Now, '\m'); 
     	sYNow = TimST( Now, '\Y'); 

	sDay = TRIM(SUBST(sDNow, 1,2));

	IF (LONG (sDay) = 1);
          		sDay = '0' | sDay;
     	ELSE;
          		sDay = sDay;
     	ENDIF;

	sMonth = TRIM(SUBST(sMNow, 1,2));

	IF (LONG (sMonth) = 1);
          		sMonth = '0' | sMonth;
     	ELSE;
          		sMonth = sMonth;
     	ENDIF;

     	sYear = TRIM(SUBST(sYNow, 1,4));
	sNow = sDay | '/' | sMonth | '/' | sYear;

	CELLPUTS(sNow, cbMeas, curHLYear, curScenario, sNewID, 'created date');
	CELLPUTS(sUser, cbMeas, curHLYear, curScenario, sNewID, 'created by');

	#******************************************************************************************************************
	#*** GET PRINCIPAL ELEMENT NAME FROM PARAMETERS
	#******************************************************************************************************************

	sMeasType = DIMENSIONELEMENTPRINCIPALNAME (dmMeasType, psMeasType);
	sFundLife = DIMENSIONELEMENTPRINCIPALNAME (dmMeasFundType, psFundLife);

	IF (DIMIX (dmProg, psProg) <> 0);
		sProg = DIMENSIONELEMENTPRINCIPALNAME (dmProg, psProg);
		sProgDesc = ATTRS (dmProg, sProg, 'code and description');
	ELSE;
		sProg  = psProg;
		sProgDesc = psProg;
	ENDIF;

	#******************************************************************************************************************
	#*** POST METADATA OF ADJUSTMENT IN AE ID DETAIL
	#******************************************************************************************************************
	IF (psCBMSMeasCode @= 'TBA' % psCBMSMeasCode @= '');
		sCBMSMeasCode = 'TBA';
	ELSE;
		sCBMSMeasCode = psCBMSMeasCode;
	ENDIF;

	CELLPUTS (sCBMSMeasCode,  cbMeas, curHLYear, curScenario, sNewID, 'CBMS Measure Code');

	CELLPUTS (psTitle, cbMeas, curHLYear, curScenario, sNewID, 'measure title');
	IF (psPublishedTitle @= '');

		CELLPUTS (psTitle, cbMeas, curHLYear, curScenario, sNewID, 'measure published title');
	ELSE;
		CELLPUTS (psPublishedTitle, cbMeas, curHLYear, curScenario, sNewID, 'measure published title');
	ENDIF;		
	CELLPUTS (psDesc, cbMeas, curHLYear, curScenario, sNewID, 'measure description');
	CELLPUTS (sMeasType, cbMeas, curHLYear, curScenario, sNewID, 'measure type');
	CELLPUTS (sFundLife, cbMeas, curHLYear, curScenario, sNewID, 'funding life');
	CELLPUTS (psCostingID, cbMeas, curHLYear, curScenario, sNewID, 'costing ID');
	CELLPUTS (sProg, cbMeas, curHLYear, curScenario, sNewID, 'related programme code');
	CELLPUTS (psGovtDec, cbMeas, curHLYear, curScenario, sNewID, 'government decision');

	#-------------------------------------------------------------------------
	#--- Decision Date
	#-------------------------------------------------------------------------
	CELLPUTS (psDecDay, cbMeas, curHLYear, curScenario, sNewID, 'sys_decision day');
	CELLPUTS (psDecMth, cbMeas, curHLYear, curScenario, sNewID, 'sys_decision month');
	CELLPUTS (psDecYear, cbMeas, curHLYear, curScenario, sNewID, 'sys_decision year');

	#-------------------------------------------------------------------------
	#--- Start Date
	#-------------------------------------------------------------------------
	CELLPUTS (psStartDay, cbMeas, curHLYear, curScenario, sNewID, 'sys_start day');
	CELLPUTS (psStartMth, cbMeas, curHLYear, curScenario, sNewID, 'sys_start month');
	CELLPUTS (psStartYear, cbMeas, curHLYear, curScenario, sNewID, 'sys_start year');

	#-------------------------------------------------------------------------
	#--- End Date
	#-------------------------------------------------------------------------
	CELLPUTS (psEndDay, cbMeas, curHLYear, curScenario, sNewID, 'sys_end day');
	CELLPUTS (psEndMth, cbMeas, curHLYear, curScenario, sNewID, 'sys_end month');
	CELLPUTS (psEndYear, cbMeas, curHLYear, curScenario, sNewID, 'sys_end year');

	#-------------------------------------------------------------------------
	#--- End Terminating/Termination Year
	#-------------------------------------------------------------------------
	IF (sFundLife @= 'terminating' & psEndYear @<> ''); 

		#------------------------------------------------------------------------------------------
		#--- System Terminating Year (1 Year forward after end year)
		#------------------------------------------------------------------------------------------
		nTerminatingYear = STRINGTONUMBER (psEndYear) + 1;
		sTerminatingYear = NUMBERTOSTRING (nTerminatingYear);
		sTerminatingYear = psEndYear | '-' | sTerminatingYear;

		CELLPUTS (sTerminatingYear, cbMeas, curHLYear, curScenario, sNewID, 'sys_terminating year');

		#------------------------------------------------------------------------------------------
		#--- System DisplayTerminating Year (1 Year before end year)
		#------------------------------------------------------------------------------------------
		nDisplayTerminatingYear = STRINGTONUMBER (psEndYear) - 1;
		sDisplayTerminatingYear = NUMBERTOSTRING (nDisplayTerminatingYear);
		sDisplayTerminatingYear = sDisplayTerminatingYear | '-' | psEndYear;

		IF (CELLISUPDATEABLE (cbMeas, curHLYear, curScenario, sNewID, 'sys_display terminating year') = 1);
			CELLPUTS (sDisplayTerminatingYear, cbMeas, curHLYear, curScenario, sNewID, 'sys_display terminating year');
		ENDIF;

	ENDIF;

	CELLPUTS (psNotForPublication, cbMeas, curHLYear, curScenario, sNewID, 'not for publication');

	#----------------------------------------------------------------------------
	#--- GET ADDITIONAL VALUES
	#----------------------------------------------------------------------------
	sPolicyEntity = CELLGETS (cbClient, sUser, 'meas_policy entity', 'value');
	sPubRound = CELLGETS (cbClient, sUser, 'meas_publication round', 'value');
	sPubYear = CELLGETS (cbClient, sUser, 'meas_publication year', 'value');
	sElectionCommit = CELLGETS (cbClient, sUser, 'meas_election commitment', 'value');

	CELLPUTS (sPolicyEntity, cbMeas, curHLYear, curScenario, sNewID, 'policy entity');
	CELLPUTS (sPubRound, cbMeas, curHLYear, curScenario, sNewID, 'publication round');
	CELLPUTS (sPubYear, cbMeas, curHLYear, curScenario, sNewID, 'publication year');
	CELLPUTS (sElectionCommit, cbMeas, curHLYear, curScenario, sNewID, 'election commitment');

	#-------------------------------------------------------------------------
	#--- UPDATE MEASURE CODE ATTRIBUTES
	#-------------------------------------------------------------------------
	ATTRPUTS (psTitle, dmMeasCode, sNewID, 'title');
	ATTRPUTS (curHLYear, dmMeasCode, sNewID, 'Budget Round Created');
	ATTRPUTS ('Y', dmMeasCode, sNewID, 'Active');
	ATTRPUTS(sFundLife, dmMeasCode, sNewID, 'Funding Life');

	IF (psCBMSMeasCode @= 'TBA' % psCBMSMeasCode @= '');
		ATTRPUTS ('', dmMeasCode, sNewID, 'CBMS');
	ELSE;
		ATTRPUTS (psCBMSMeasCode, dmMeasCode, sNewID, 'CBMS');
	ENDIF;

	ATTRPUTS (sTerminatingYear, dmMeasCode, sNewID, 'Termination Year');
	#ATTRPUTS (sTerminatingYear, dmMeasCode, sNewID, 'Terminating Year');

	#----------------------------------------------------------------------------
	#--- IDENTIFY MEASURE AS CURRENTLY CREATED (BOTH ELEMENT ATTRIBUTES AND GMD CUBE
	#----------------------------------------------------------------------------
	CELLPUTS ('Y', cbMeas, curHLYear, curScenario, sNewID, 'current');
	ATTRPUTS ('Y', dmMeasCode, sNewID, 'current');

	#-------------------------------------------------------------------------
	#--- UPDATE CLIENT PREFERENCE
	#-------------------------------------------------------------------------
	CELLPUTS (curHLYear, cbClient, sUser, 'geus hlyear', 'value');
	CELLPUTS (curScenario, cbClient, sUser, 'geus scenario', 'value');
	CELLPUTS (sNewID, cbClient, sUser, 'geus measure code', 'value');

ENDIF;


#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion