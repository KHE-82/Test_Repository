#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE_Archive_01 - Remove Unwanted IDS
#**** DESCRIPTION:       This process removes unwanted IDs from the adjustments cube and id details cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials      Comments
#****  ====              ======      =========
#**** 12/05/2014    KG           Initial Revision
#****  2019	KG	Updated For NEW GEUS
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------
#sHLYear = ATTRS(dmVar,'headline year','value');
#sScenario = ATTRS(dmVar, 'headline scenario', 'value');


sHLYear = ATTRS(dmVar, 'archive year', 'old value');
sScenario = ATTRS(dmVar, 'archive scenario', 'old value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;


sView = '$UnwantedIDs';
sSubset = sView;

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbAE, sView);
ViewDestroy(cbID, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmID, sSubset);
SubsetDestroy(dmIDMeas, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

# ID measure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmIDMeas | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# ID
sCube = cbID;
sDim = dmID;
SubsetCreate(sDim, sSubset);

lIndex = 3;
lCounter = 1;
lDimSize = CellGetN(cbID, psSourceHLYear, psSourceScenario, 'Total IDs', 'used') + 2;

WHILE (lIndex <= lDimSize);
	sElement = DIMNM(sDim, lIndex);
	sStatus = CellGetS(cbID, psSourceHLYear, psSourceScenario, sElement, 'status');
	IF(sStatus @= 'unauthorised' % sStatus @= 'delete' % sStatus @= 'deleted');
		SubsetElementInsert(sDim, sSubset, sElement, lCounter);
		lCounter = lCounter + 1;
	ENDIF;
	lIndex = lIndex + 1;
END;

#****CREATE VIEW IN ADJUSTMENTS CUBE
sCube = cbAE;
ViewCreate(sCube, sView);

ViewSubsetAssign(sCube, sView, dmHLYear, sSubset);
ViewSubsetAssign(sCube, sView, dmScenario, sSubset);
ViewSubsetAssign(sCube, sView, dmID, sSubset);

ViewSetSkipZeroes(sCube, sView, 1);
ViewSetSkipCalcs(sCube, sView, 1);
ViewZeroOut(sCube, sView);

#****CREATE VIEW IN ID DETAILS CUBE
sCube = cbID;
ViewCreate(sCube, sView);

ViewSubsetAssign(sCube, sView, dmHLYear, sSubset);
ViewSubsetAssign(sCube, sView, dmScenario, sSubset);
ViewSubsetAssign(sCube, sView, dmID, sSubset);
ViewSubsetAssign(sCube, sView, dmIDMeas, sSubset);

ViewSetSkipZeroes(sCube, sView, 1);
ViewSetSkipCalcs(sCube, sView, 1);
ViewZeroOut(sCube, sView);

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbAE, sView);
ViewDestroy(cbID, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmID, sSubset);
SubsetDestroy(dmIDMeas, sSubset);

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#------------------------------------------------------------------------
#--- Update System Process Administration Cube
#------------------------------------------------------------------------
cbProc = 'sys_process administration';
sProcess = GETPROCESSNAME ();
NUMERICGLOBALVARIABLE ('ProcessReturnCode');
sProcessReturnCode = NUMBERTOSTRING(ProcessReturnCode);

IF (ProcessReturnCode = ProcessExitNormal() );
	#-------------------------------------------------------------
	#--- Process Completed Successfully
	#-------------------------------------------------------------

	CELLPUTN (1, cbProc, sProcess, 'completed flag');
	CELLPUTS (sProcessReturnCode, cbProc, sProcess, 'error description');
	CELLPUTS ('SUCCESS', cbProc, sProcess, 'status flag');
ELSE;
	#-------------------------------------------------------------
	#--- Process Completed With Errors
	#-------------------------------------------------------------
	CELLPUTN (1, cbProc, sProcess, 'error flag');
	CELLPUTS (sProcessReturnCode, cbProc, sProcess, 'error description');
	CELLPUTS ('FAILED', cbProc, sProcess, 'status flag');

ENDIF;

#endregion