#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_Costings Export Financials - Reco
#**** DESCRIPTION:       This process creates a view and creates a copy of the other adjustment
#****			
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 06/10/2015    KG             Initial Revision
#**** 2020	KG	  Added ability to load CURRENT SCENARIO
#**** 22/08/2023	KG	  Updated process to load ID Details
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#******************************************************************************************************************
#*** DECLARE AE ID DETAILS
#******************************************************************************************************************
cbID = 'AE id details';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmID = 'id';
dmIDMeas = 'id measure';



#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE REPORTING CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
cbRpt = 'AE Reporting';
dmRptMeas = ' AE Reporting Measure';
dmStage='reporting stage';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#******************************************************************************************************************
#*** DECLARE PROGRAMME DETAILS CUBE
#******************************************************************************************************************
cbProg = snProg | ' details';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';
dmCtrlType = 'control type';
dmFavID = 'favourites_id';

#******************************************************************************************************************
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#******************************************************************************************************************
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sCurScenarioBudRound = ATTRS(dmVar, 'current budget round', 'value');
sNoMeasCode = ATTRS(dmVar, 'No Measure Code', 'value');
sDefFavID = ATTRS(dmVar, 'Default favourite id template', 'value');


#--------------------------------------------------------------------------------------------------------
#--- CHECK IF CBMS-R IS LIVE : New Code 08 August 2017 - KG
#--------------------------------------------------------------------------------------------------------
sCBMSRLive = ATTRS (dmVar, 'sys_CBMSR GoLive', 'value');
sCBMSRLiveHLYear = ATTRS (dmVar, 'sys_CBMSR GoLive Headline Year', 'value');
sCBMSRMigrationScenario = 'CBMS-R OBAL';

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;


#---------------------------------------------------
#--- DURING CHORE IT STORES A R* in the User
#---------------------------------------------------
IF (SCAN('R*', sUser)<>0);
	sUser = 'Admin';
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED FOR VIEWS
#******************************************************************************************************************
#IF (psSourceScenario @= 'current');
#	sTargetStage = SUBST(psSourceHLYear, 3,9) | ' ' | sCurScenarioBudRound;
#ELSE;
#	sTargetStage = SUBST(psSourceHLYear, 3,9) | ' ' | psSourceScenario;
#ENDIF;


#IF (DIMIX (dmStage, sTargetStage) = 0);
#	PROCESSQUIT;

#ENDIF;


sObject  = sUser | '_$RepTransferView';
sAEView = sUser | '_$RepTransferView';



#*****************************************************************************************************************************************************
#*** STEP 1 - CREATE SOURCE VIEW ***#
#*****************************************************************************************************************************************************
#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmOC, sAEView);
SUBSETDESTROY (dmRE, sAEView);
SUBSETDESTROY (dmFunc, sAEView);
SUBSETDESTROY (dmReason, sAEView);
SUBSETDESTROY (dmSPP, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmType, sAEView);
SUBSETDESTROY (dmMA, sAEView);
SUBSETDESTROY (dmItem, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmJur, sAEView);
SUBSETDESTROY (dmPer, sAEView);


#******************************************************************************************************************
#*** DEFINE TOTAL VARIABLES FOR POSTING METADATA
#******************************************************************************************************************
sTotalStatus = 'Total approved';
sTotalOC = 'Total outcomes';
sTotalRE = 'Total related entity';
sTotalFunc = 'Total functions';
sTotalSPP = 'Total SPP';
sTotalItem = 'Total approp item';
sTotalJur = 'Total jurisdictions';
sTotalMA = 'Total movement';
sTotalReason = 'Total reason';
sTotalMeasCode = 'Total Measures';
sTotalType = 'Total approp types';
sTextPeriod = '0000-0000';


#******************************************************************************************************************
#*** CREATE SUBSETS
#******************************************************************************************************************
# headline year
SubsetCreate(dmHLYear, sAEView);
#SubsetElementInsert(dmHLYear, sAEView,curHLYear, 1);
####TEST Round###
SubsetElementInsert(dmHLYear, sAEView, 'HL2025-2026', 1);
# Scenario
SubsetCreate(dmScenario, sAEView);
SubsetElementInsert(dmScenario, sAEView, 'current', 1);


# Status
sDim = dmStatus;
sEL  = 'data';
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Outcome
sDim = dmOC;
sEL  =sTotalOC;
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Related Entity
sDim = dmRE;
sEL  =sTotalRE;
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Function
sDim = dmFunc;
sEL  =sTotalFunc;
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Reason
sDim = dmReason;
sEL  =sTotalReason;
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);

# SPP
sDim = dmSPP;
sEL  =sTotalSPP;
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Measure Code
sDim = dmMeasCode;
sEL  =sTotalMeasCode;
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | sDim | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Appropriation Type
sDim = dmType;
sEL  =sTotalType;
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Movement Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Appropriation Item
sDim = dmItem;
sEL  =sTotalItem;
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Program
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAcc | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# ID
MDX = '{filter({TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmId | '] )}, 0)}, [ae id details].([headline year].[hl2025-2026],[scenario].[current],[id measure].[costing id]) <>"")}';
MDX = '{filter({TM1FILTERBYLEVEL( {TM1SUBSETALL( [id] )}, 0)}, [ae id details].([headline year].[hl2025-2026],[scenario].[current],[id measure].[costing id])<>"" )}';

SUBSETCREATEBYMDX (sAEView, MDX);

# Jurisdiction
sDim = dmJur;
sEL  =sTotalJur;
MDX = '{[' | sDim | '].[' | sEL|']}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Period
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
#MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")}';
SUBSETCREATEBYMDX (sAEView, MDX);


#******************************************************************************************************************
#*** BUILD VIEW ***#
#******************************************************************************************************************
VIEWCREATE (cbAE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmHLYear, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmScenario, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmStatus, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmOC, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmRE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmFunc, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmReason, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmSPP, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasCode, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMA, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmItem, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmProg, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmAcc, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmID, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmJur, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmPer, sAEView);


#******************************************************************************************************************
# *** DEFINE VIEW EXTRACT
#******************************************************************************************************************
VIEWEXTRACTSKIPZEROESSET (cbAE, sAEView, 1);
VIEWEXTRACTSKIPRULEVALUESSET (cbAE, sAEView, 0);
VIEWEXTRACTSKIPCALCSSET (cbAE, sAEView, 0);


DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sAEView;

lCounter = 0;
nHeader =0;


sDir = '../file_transfer/';
sDir = Attrs(dmVar, 'sys_costings export directory', 'value');

sFileName = 'geus reconciliation export.cma';
sFile = sDir | sFileName;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#asciioutput('src.csv', vsHLYear, vsScenario, vsStatus, vsOC, vsRE, vsfunc,vsreason, vsspp,vsMeascode, vsMA, vsItem,vsprog, vsacc,vsid,vsjur, vsperiod,numbertostring(vnValue));

col01title = 'Headline Year';
col02title = 'Budget Round';
col03title = 'GEUS_ID';
col04title = 'GEUS_Program';
col05title = 'GEUS_measure';
col06title = 'GEUS_ Account';
col07title = 'GEUS_Movement Account';
col08title = 'Period';
col09title = 'Amount';
col10title = 'Costing_ID';

IF( nHeader =0);
	asciioutput(sFile, col01title, col02title,col03title,col04title,col05title,col06title,col07title,col08title, col09title,col10title);
	nHeader =1;
ENDIF;

IF( vsPeriod @='0000-0000');
	ItemSkip;
ENDIF;

sDeptConsol = 'Departmental Programmes';
sAdminConsol = 'Administered Programmes';

IF( ELISANC(dmProg, sDeptConsol, vsProg) =1);
	IF( vsAcc @= '1280004' % vsMA @='7206');
	ELSE;
		ItemSkip;
	ENDIF;
ELSEIF( ELISANC(dmProg, sAdminConsol, vsProg) =1);
	IF(  vsMA @='7593' % vsMA@='7206');
	ELSE;
		ItemSkip;
	ENDIF;
ELSE;
	Itemskip;

ENDIF;



col01Val = vsHLYear;
col02Val = sCurScenarioBudRound;
col03Val = vsID;
col04Val = vsProg;
col05Val = vsMeasCode;
col06Val = vsAcc;
col07Val = vsMA;
col08Val = vsPeriod;
col09Val = numbertostring(vnValue);

col10val = CellGetS(cbID, vsHLYear, vsScenario, vsID, 'costing ID');

asciioutput(sFile, col01Val, col02Val,col03Val,col04Val,col05Val,col06Val,col07Val,col08Val,col09val,col10Val);
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#-------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS
#-------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmOC, sAEView);
SUBSETDESTROY (dmRE, sAEView);
SUBSETDESTROY (dmFunc, sAEView);
SUBSETDESTROY (dmReason, sAEView);
SUBSETDESTROY (dmSPP, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmType, sAEView);
SUBSETDESTROY (dmMA, sAEView);
SUBSETDESTROY (dmItem, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmJur, sAEView);
SUBSETDESTROY (dmPer, sAEView);
