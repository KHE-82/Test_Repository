#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_Load FBO 03 - Create GEUS Variances For Other Accounts
#**** DESCRIPTION:       
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 06/09/2018    KG             Initial Revision
#****
#***********************************************************************************************************************

#*** DECLARE CUBES AND DIMENSIONS ***#
snProg = 'program';
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

cbID = 'ae id details';

sCube = cbAE;
sView = '$CBMSRFBOMA';
sSubset = sView;

sSourceStatus = 'Total approved';
sSourceStatus = 'data';
#sSourceID = 'Total IDs';
sSourceID = '00FBO';
sSourceReason = 'Total reason';
sSourceMeasCode = 'Total Measures';

sTargetStatus = 'data';
sTargetID = '00FBO';
sTargetReason = 'Other variations not elsewhere defined';
sTargetMeasCode = 'M00000';

nStartPerIndex = DIMIX (dmPer, psPeriod);
nLastPerIndex = DIMIX (dmPer, '2045-2046');

cbFBOMap = 'sys_FBO Process Mapping';
dmRow = 'sys_extract row id';
dmFBOMapMeas = cbFBOMap | ' measure';

sFBOMapMeas01= 'Source Account';
sFBOMapMeas02 = 'Source Movement Account';
sFBOMapMeas03 = 'Target Account';
sFBOMapMeas04 = 'Target Movement Account';


nRowMax = DimSiz(dmRow);


#------------------------------------------------------------------------------------------------------------------------------------------
#--- STEP 01 : CREATE SOURCE VIEW
#------------------------------------------------------------------------------------------------------------------------------------------

#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);


#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

# Status
SubsetCreate(dmStatus, sSubset);
SubsetElementInsert(dmStatus, sSubset, sSourceStatus, 1);

# Outcome
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmOC | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Function
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Reason
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);
SubsetCreate(dmReason, sSubset);
SubsetElementInsert(dmReason, sSubset, sSourceReason, 1);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure Code
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
#SUBSETCREATEBYMDX (sSubset, MDX);

SubsetCreate(dmMeasCode, sSubset);
SubsetElementInsert(dmMeasCode, sSubset, sSourceMeasCode, 1);

# Appropriation Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmType | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Movement account
SubsetCreate(dmMA, sSubset);
SubsetElementInsert(dmMA, sSubset, 'Total movement', 1);
SubsetElementInsert(dmMA, sSubset, '7120', 2);
SubsetElementInsert(dmMA, sSubset, '7150', 3);
SubsetElementInsert(dmMA, sSubset, '7320', 4);
SubsetElementInsert(dmMA, sSubset, '7350', 5);
SubsetElementInsert(dmMA, sSubset, '7250', 6);


# Appropriation item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { [' | dmProg | '].[' | psProg |'] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Account
MDX = '{{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[3240000]}, ALL, RECURSIVE )}, 1)}, ASC)},{{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[4100000]}, ALL, RECURSIVE )}, 0)}, ASC)},{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[5310000]}, ALL, RECURSIVE )}, 0)}, ASC)},{[account].[6000000]}, {TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[5232000]}, ALL, RECURSIVE )}, 1)}, ASC)}}, {[account].[9000860]},{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[account].[9000881]}, ALL, RECURSIVE )}, 0)}, ASC)}}';
SUBSETCREATEBYMDX (sSubset, MDX);

# ID
SubsetCreate(dmID, sSubset);
SubsetElementInsert(dmID, sSubset, sSourceID, 1);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Period
SubsetCreate(dmPer, sSubset);
SubsetElementInsert(dmPer, sSubset, psPeriod, 1);


#****BUILD VIEW****#
ViewCreate(sCube, sView);

ViewSubsetAssign(sCube, sView, dmHLYear, sSubset);
ViewSubsetAssign(sCube, sView, dmScenario, sSubset);
ViewSubsetAssign(sCube, sView, dmStatus, sSubset);
ViewSubsetAssign(sCube, sView, dmOC, sSubset);
ViewSubsetAssign(sCube, sView, dmRE, sSubset);
ViewSubsetAssign(sCube, sView, dmFunc, sSubset);
ViewSubsetAssign(sCube, sView, dmReason, sSubset);
ViewSubsetAssign(sCube, sView, dmSPP, sSubset);
ViewSubsetAssign(sCube, sView, dmMeasCode, sSubset);
ViewSubsetAssign(sCube, sView, dmType, sSubset);
ViewSubsetAssign(sCube, sView, dmMA, sSubset);
ViewSubsetAssign(sCube, sView, dmItem, sSubset);
ViewSubsetAssign(sCube, sView, dmProg, sSubset);
ViewSubsetAssign(sCube, sView, dmAcc, sSubset);
ViewSubsetAssign(sCube, sView, dmID, sSubset);
ViewSubsetAssign(sCube, sView, dmJur, sSubset);
ViewSubsetAssign(sCube, sView, dmPer, sSubset);

ViewExtractSkipZeroesSet (sCube, sView, 1);
ViewExtractSkipCalcsSet (sCube, sView, 0);
ViewExtractSkipRuleValuesSet (sCube, sView, 0);

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#ITEMSKIP;
asciioutput('sourceview.csv', vsprog,vsAcc,vsMA,NumbertoString(vnValue),vsperiod);
sNewProg = vsProg;
sElType = DTYPE(dmProg, sNewProg);
WHILE (sElType @= 'C');
	sNewProg = ELCOMP(dmProg, sNewProg, 1);
	sElType = DTYPE(dmProg, sNewProg);
END;

#-------------------------------------------------------------------------------
#--- Find account codes if it has the word (Annual Only)
#-------------------------------------------------------------------------------
sAccDesc = ATTRS (dmAcc, vsAcc, 'description');
nSCAN = SCAN('Annual Only', sAccDesc);
IF (nSCAN > 0);
	ITEMSKIP;
ENDIF;
	
nTargetValue = ROUNDP(vnValue,0)*-1;

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#--- Post Flow On Effect For Balance Account - Special combinmations sourced from sys_FBO process mapping cube
#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
lOtherCounter = 1;
lCounter = 1;
nRowIndex = 1;

WHILE (nRowIndex <= nRowMax);
	
	sRowIndex = NumberToString(nRowIndex);
	sRowIndex = FILL('0',3-LONG(sRowIndex)) | sRowIndex; 

	sSrcAcc = CELLGETS( cbFBOMap, sRowIndex,sFBOMapMeas01 );
	sSrcMA = CELLGETS( cbFBOMap, sRowIndex, sFBOMapMeas02);
	sTarAcc = CELLGETS( cbFBOMap, sRowIndex, sFBOMapMeas03);
	sTarMA = CELLGETS( cbFBOMap, sRowIndex, sFBOMapMeas04);

	IF( DIMIX(dmAcc,sTarAcc) = 0 % DIMIX(dmMA,sTarMA) = 0);
		nRowIndex = nRowMax +1;
	ELSE;
		sNewPeriod = DIMNM (dmPer, DIMIX (dmPer, vsPeriod) + lCounter);
		nNewPerIndex = DIMIX (dmPer, sNewPeriod);
		#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
		#--- Post Flow On Effect For Balance Account With Movement Account but Roll over to a new MA ( opening balances in Equity/NFA)
		#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
		IF (ELISANC (dmAcc, sSrcAcc, vsAcc) = 1 & vsMA @= sSrcMA);
			IF (CELLISUPDATEABLE (sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, vsRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTarMA, vsItem, sNewProg, vsAcc, sTargetID, vsJur, sNewPeriod) = 1);
				WHILE (nNewPerIndex <= nLastPerIndex);
					sPeriodType = ATTRS (dmPer,sNewPeriod, 'type');
					IF (sNewPeriod @<> psPeriod & sPeriodType @= 'annual');
						nOldTargetValue = CELLGETN (sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, vsRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTarMA, vsItem, sNewProg, vsAcc, sTargetID, vsJur, sNewPeriod);
						CELLPUTN ((nOldTargetValue + nTargetValue)*-1, sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, vsRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTarMA, vsItem, sNewProg, vsAcc, sTargetID, vsJur, sNewPeriod);
					ENDIF;
					sNewPeriod = DIMNM (dmPer, DIMIX (dmPer, sNewPeriod) + lCounter);
					nNewPerIndex = DIMIX (dmPer, sNewPeriod);
				END;
			ENDIF;
		#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
		#--- Post Flow On Effect For Balance Account Without Movement Account but Roll over to a new Balance Sheet Account ( opening balances in Loans/Lease liabilities)
		#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
		ELSEIF (vsAcc @= sSrcAcc & vsMA @= sSrcMA);
			IF (CELLISUPDATEABLE (sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, vsRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTarMA, vsItem, sNewProg, sTarAcc, sTargetID, vsJur, sNewPeriod) = 1);
				WHILE (nNewPerIndex <= nLastPerIndex);
					sPeriodType = ATTRS (dmPer,sNewPeriod, 'type');
					IF (sNewPeriod @<> psPeriod & sPeriodType @= 'annual');
						nOldTargetValue = CELLGETN (sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, vsRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTarMA, vsItem, sNewProg, sTarAcc, sTargetID, vsJur, sNewPeriod);
						asciioutput('data.csv', numbertostring(nTargetValue ),sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, vsRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTarMA, vsItem, sNewProg, sTarAcc, sTargetID, vsJur, sNewPeriod);
						CELLPUTN ((nOldTargetValue + nTargetValue)*-1, sCube, psTargetHLYear, psTargetScenario, sTargetStatus, vsOC, vsRE, vsFunc, sTargetReason, vsSPP, sTargetMeasCode, vsType, sTarMA, vsItem, sNewProg, sTarAcc, sTargetID, vsJur, sNewPeriod);
					ENDIF;
					sNewPeriod = DIMNM (dmPer, DIMIX (dmPer, sNewPeriod) + lCounter);
					nNewPerIndex = DIMIX (dmPer, sNewPeriod);
				END;
			ENDIF;

	
		ENDIF;
		nRowIndex = nRowIndex +1 ;
	ENDIF;

#	nRowIndex = nRowIndex +1 ;
END;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

IF (1=1);
#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);
ENDIF;
#endregion