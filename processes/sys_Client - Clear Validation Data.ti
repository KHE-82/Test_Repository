#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               sys_Client - Clear Validation Data
#**** DESCRIPTION:       This process clears all validation data. Used when viewing and creating an adjustment
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 10/09/2015    KG             Initial Revision
#****
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
cbEAVar = '}ElementAttributes_variables';
dmVar = 'variables';

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED
#******************************************************************************************************************
sView = sUser | ' $ClearClientPref';

#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbClient, sView);
SUBSETDESTROY (dmClient, sView);
SUBSETDESTROY (dmClientPref, sView);
SUBSETDESTROY (dmClientMeas, sView);

#******************************************************************************************************************
#*** CREATE SUBSETS
#******************************************************************************************************************
# Client
SUBSETCREATE (dmClient, sView);
SUBSETELEMENTINSERT (dmClient, sView, sUser, 1);

# Client Preference
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmClientPref | '] )}, 0)}, [' | dmClientPref | '].[system] = "")}';
SUBSETCREATEBYMDX (sView, MDX);
SUBSETMDXSET (dmClientPref, sView, MDX);

# Client Preference Measure
SUBSETCREATE (dmClientMeas, sView);
SUBSETELEMENTINSERT (dmClientMeas, sView, 'validate', 1);

#******************************************************************************************************************
#*** BUILD VIEW
#******************************************************************************************************************
VIEWCREATE (cbClient, sView);
VIEWSUBSETASSIGN (cbClient, sView, dmClient, sView);
VIEWSUBSETASSIGN (cbClient, sView, dmClientPref, sView);
VIEWSUBSETASSIGN (cbClient, sView, dmClientMeas, sView);

VIEWSETSKIPZEROES (cbClient, sView, 1);
VIEWSETSKIPCALCS (cbClient, sView, 1);
VIEWZEROOUT (cbClient, sView);

#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbClient, sView);
SUBSETDESTROY (dmClient, sView);
SUBSETDESTROY (dmClientPref, sView);
SUBSETDESTROY (dmClientMeas, sView);




#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog

