#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Measure Change Code 01 - Prepare Data Entry
#**** DESCRIPTION:       This process just prepares the data entry when the user wants to amend the details
#****
#****		          
#****                                
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#******************************************************************************************************************
#*** DECLARE GOVERNMENT MEASURES DETAILS CUBE DIMENSIONS
#******************************************************************************************************************
cbMeas = 'government measures details';
dmGovtMeas = 'measure details';


dmMeasType = 'measure type';
dmMeasFundType = 'measure fund type';

#******************************************************************************************************************
#*** DECLARE AE ID DETAILS
#******************************************************************************************************************
cbID = 'AE id details';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmID = 'id';
dmIDMeas = 'id measure';

#******************************************************************************************************************
#*** DECLARE CLIENT GROUPS CUBE
#******************************************************************************************************************
cbGroups = '}ClientGroups';
dmGroups = '}Groups';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');


#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** STOP PROCESS IF MEASURE CODE IS BLANK
#******************************************************************************************************************
IF (psMeasCode @= '');
	PROCESSQUIT;
ENDIF;

#******************************************************************************************************************
#******************************************************************************************************************
#*** UPDATE USER ID AND SELECTED HLYEAR AND SCENARIO AND ALL OTHER DETAILS
#*** 
#******************************************************************************************************************
#******************************************************************************************************************

# Headline Year
CELLPUTS (psHLYear, cbClient, sUser, 'geus hlyear', 'value');

# Scenario
CELLPUTS (psScenario, cbClient, sUser, 'geus scenario', 'value');

# Measure Code
CELLPUTS (psMeasCode, cbClient, sUser, 'geus measure code', 'value');

#******************************************************************************************************************
#*** GET CLIENT DETAILS & ID DETAILS
#******************************************************************************************************************
sActive = ATTRS (dmMeasCode, psMeasCode, 'Active');
sStatus = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'status');
sCBMSMeasCode = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'CBMS Measure Code');
sTitle = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'measure title');
sPubTitle = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'measure published title');
sDesc = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'measure description');
sMeasType = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'measure type');
sFundLife = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'funding life');
sCostingID = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'costing ID');
sProg = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'related programme code');
sGovtDec = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'government decision');
sDecDay = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_decision day');
sDecMth = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_decision month');
sDecYear = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_decision year');
sStartDay = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_start day');
sStartMth = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_start month');
sStartYear = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_start year');
sEndDay = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_end day');
sEndMth = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_end month');
sEndYear = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_end year');
sTerminatingYear = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_terminating year');
sDisplayTerminatingYear = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'sys_display terminating year');
sNotForPublication = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'not for publication');
sPolicyEntity = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'policy entity');
sPubRound = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'publication round');
sPubYear = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'publication year');
sElectionCommit = CELLGETS (cbMeas, psHLYear, psScenario, psMeasCode, 'election commitment');

#*****************************************************************************************************************************************************
#**** ONLY CURRENT HEADLINE YEAR AND SCENARIO ARE EDITABLE
#*****************************************************************************************************************************************************
IF (psHLYear @<> curHLYear & psScenario @<> curScenario);

#	PROCESSQUIT;

ELSE;


	#*****************************************************************************************************************************************************
	#**** STEP 1 - CLEAR SYS_CLIENT PREFERENCE CUBE
	#*****************************************************************************************************************************************************
	EXECUTEPROCESS('sys_Client - Clear Client Preference Data', 'psUser', sUser);

	#*****************************************************************************************************************************************************
	#**** STEP 2 - TRANSFER AE ID DETAILS TO SYS CLIENT PREFERENCE CUBE
	#*****************************************************************************************************************************************************

	#******************************************************************************************************************
	#*** POST TO CLIENT DETAILS
	#******************************************************************************************************************

	#*** POST ON VALUE
	sMeasure = 'value';

	CELLPUTS (sActive, cbClient, sUser, 'meas_active', sMeasure);
	CELLPUTS (sStatus, cbClient, sUser, 'meas_status', sMeasure);
	CELLPUTS (sTitle, cbClient, sUser, 'meas_title', sMeasure);
	CELLPUTS (sPubTitle, cbClient, sUser, 'meas_published title', sMeasure);
	CELLPUTS (sDesc, cbClient, sUser, 'meas_description', sMeasure);

	CELLPUTS (sCBMSMeasCode, cbClient, sUser, 'meas_CBMS Measure Code', sMeasure);
	CELLPUTS (sMeasType, cbClient, sUser, 'meas_measure type', sMeasure);
	CELLPUTS (sCostingID, cbClient, sUser, 'meas_costing ID', sMeasure);
	CELLPUTS (sProg, cbClient, sUser, 'meas_programme', sMeasure);
	CELLPUTS (sFundLife, cbClient, sUser, 'meas_fund life', sMeasure);

	CELLPUTS (sGovtDec, cbClient, sUser, 'meas_govt decision', sMeasure);
	CELLPUTS (sDecDay, cbClient, sUser, 'meas_decision day', sMeasure);
	CELLPUTS (sDecMth, cbClient, sUser, 'meas_decision month', sMeasure);
	CELLPUTS (sDecYear, cbClient, sUser, 'meas_decision year', sMeasure);

	CELLPUTS (sStartDay, cbClient, sUser, 'meas_start day', sMeasure);
	CELLPUTS (sStartMth, cbClient, sUser, 'meas_start month', sMeasure);
	CELLPUTS (sStartYear, cbClient, sUser, 'meas_start year', sMeasure);

	CELLPUTS (sEndDay, cbClient, sUser, 'meas_end day', sMeasure);
	CELLPUTS (sEndMth, cbClient, sUser, 'meas_end month', sMeasure);
	CELLPUTS (sEndYear, cbClient, sUser, 'meas_end year', sMeasure);

	CELLPUTS (sNotForPublication, cbClient, sUser, 'meas_not for publication', sMeasure);

	CELLPUTS (sPolicyEntity, cbClient, sUser, 'meas_policy entity', sMeasure);
	CELLPUTS (sPubRound, cbClient, sUser, 'meas_publication round', sMeasure);
	CELLPUTS (sPubYear, cbClient, sUser, 'meas_publication year', sMeasure);
	CELLPUTS (sElectionCommit, cbClient, sUser, 'meas_election commitment', sMeasure);

	#*** POST ON OLD VALUE
	sMeasure = 'old value';

	CELLPUTS (sActive, cbClient, sUser, 'meas_active', sMeasure);
	CELLPUTS (sStatus, cbClient, sUser, 'meas_status', sMeasure);
	CELLPUTS (sTitle, cbClient, sUser, 'meas_title', sMeasure);
	CELLPUTS (sPubTitle, cbClient, sUser, 'meas_published title', sMeasure);
	CELLPUTS (sDesc, cbClient, sUser, 'meas_description', sMeasure);

	CELLPUTS (sCBMSMeasCode, cbClient, sUser, 'meas_CBMS Measure Code', sMeasure);
	CELLPUTS (sMeasType, cbClient, sUser, 'meas_measure type', sMeasure);
	CELLPUTS (sCostingID, cbClient, sUser, 'meas_costing ID', sMeasure);
	CELLPUTS (sProg, cbClient, sUser, 'meas_programme', sMeasure);
	CELLPUTS (sFundLife, cbClient, sUser, 'meas_fund life', sMeasure);

	CELLPUTS (sGovtDec, cbClient, sUser, 'meas_govt decision', sMeasure);
	CELLPUTS (sDecDay, cbClient, sUser, 'meas_decision day', sMeasure);
	CELLPUTS (sDecMth, cbClient, sUser, 'meas_decision month', sMeasure);
	CELLPUTS (sDecYear, cbClient, sUser, 'meas_decision year', sMeasure);

	CELLPUTS (sStartDay, cbClient, sUser, 'meas_start day', sMeasure);
	CELLPUTS (sStartMth, cbClient, sUser, 'meas_start month', sMeasure);
	CELLPUTS (sStartYear, cbClient, sUser, 'meas_start year', sMeasure);

	CELLPUTS (sEndDay, cbClient, sUser, 'meas_end day', sMeasure);
	CELLPUTS (sEndMth, cbClient, sUser, 'meas_end month', sMeasure);
	CELLPUTS (sEndYear, cbClient, sUser, 'meas_end year', sMeasure);

	CELLPUTS (sNotForPublication, cbClient, sUser, 'meas_not for publication', sMeasure);

	CELLPUTS (sPolicyEntity, cbClient, sUser, 'meas_policy entity', sMeasure);
	CELLPUTS (sPubRound, cbClient, sUser, 'meas_publication round', sMeasure);
	CELLPUTS (sPubYear, cbClient, sUser, 'meas_publication year', sMeasure);
	CELLPUTS (sElectionCommit, cbClient, sUser, 'meas_election commitment', sMeasure);

ENDIF;


# Headline Year
CELLPUTS (psHLYear, cbClient, sUser, 'geus hlyear', 'value');

# Scenario
CELLPUTS (psScenario, cbClient, sUser, 'geus scenario', 'value');

# Measure Code
CELLPUTS (psMeasCode, cbClient, sUser, 'geus measure code', 'value');



#endregion
