#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Rep - Reporting Cube - Data Transfer - Single Stage
#**** DESCRIPTION:       This process creates a view and creates a copy of the other adjustment
#****			
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 06/10/2015    KG             Initial Revision
#**** 2020	KG	  Added ability to load CURRENT SCENARIO
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#******************************************************************************************************************
#*** DECLARE AE ID DETAILS
#******************************************************************************************************************
cbID = 'AE id details';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmID = 'id';
dmIDMeas = 'id measure';



#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE REPORTING CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
cbRpt = 'AE Reporting';
dmRptMeas = ' AE Reporting Measure';
dmStage='reporting stage';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#******************************************************************************************************************
#*** DECLARE PROGRAMME DETAILS CUBE
#******************************************************************************************************************
cbProg = snProg | ' details';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';
dmCtrlType = 'control type';
dmFavID = 'favourites_id';

#******************************************************************************************************************
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#******************************************************************************************************************
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sCurScenarioBudRound = ATTRS(dmVar, 'current budget round', 'value');
sNoMeasCode = ATTRS(dmVar, 'No Measure Code', 'value');
sDefFavID = ATTRS(dmVar, 'Default favourite id template', 'value');

#--------------------------------------------------------------------------------------------------------
#--- CHECK IF CBMS-R IS LIVE : New Code 08 August 2017 - KG
#--------------------------------------------------------------------------------------------------------
sCBMSRLive = ATTRS (dmVar, 'sys_CBMSR GoLive', 'value');
sCBMSRLiveHLYear = ATTRS (dmVar, 'sys_CBMSR GoLive Headline Year', 'value');
sCBMSRMigrationScenario = 'CBMS-R OBAL';

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DECLARE VARIABLES USED FOR VIEWS
#******************************************************************************************************************
IF (psSourceScenario @= 'current');
	sTargetStage = SUBST(psSourceHLYear, 3,9) | ' ' | sCurScenarioBudRound;
ELSE;
	sTargetStage = SUBST(psSourceHLYear, 3,9) | ' ' | psSourceScenario;
ENDIF;

IF (DIMIX (dmStage, sTargetStage) = 0);
	PROCESSQUIT;
ENDIF;


sObject  = sUser | '_$RepTransferView';
sAEView = sUser | '_$RepTransferView';



#*****************************************************************************************************************************************************
#****  STEP 1 - CLEAR TARGET VIEW
#*****************************************************************************************************************************************************
#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************

#-------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS
#-------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sAEView);
VIEWDESTROY (cbRpt, sAEView);

SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStage, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmOC, sAEView);
SUBSETDESTROY (dmRE, sAEView);
SUBSETDESTROY (dmFunc, sAEView);
SUBSETDESTROY (dmReason, sAEView);
SUBSETDESTROY (dmSPP, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmType, sAEView);
SUBSETDESTROY (dmMA, sAEView);
SUBSETDESTROY (dmItem, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmJur, sAEView);
SUBSETDESTROY (dmPer, sAEView);
SUBSETDESTROY (dmRptMeas, sAEView);




#-------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#-------------------------------------------------------------------------------------------------------------

#Stage
SubsetCreate(dmStage, sAEView);
SubsetElementInsert(dmStage, sAEView, sTargetStage, 1);

# Status
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmStatus | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Outcome
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmOC | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Function
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Reason
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Appropriation Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmType | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Movement Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Appropriation Item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Program
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAcc | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# ID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmID | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Period
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Reporting Measure
SubsetCreate(dmRptMEas, sAEView);
SubsetElementInsert(dmRptMeas, sAEView, psTargetMeas, 1);

#-------------------------------------------------------------------------------------------------------------
#*** BUILD VIEW
#-------------------------------------------------------------------------------------------------------------
VIEWCREATE (cbRpt, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmStage, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmStatus, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmOC, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmRE, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmFunc, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmReason, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmSPP, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmMeasCode, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmType, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmMA, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmItem, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmProg, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmAcc, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmID, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmJur, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmPer, sAEView);
VIEWSUBSETASSIGN (cbRpt, sAEView, dmRptMeas, sAEView);

#-------------------------------------------------------------------------------------------------------------
# *** DEFINE VIEW EXTRACT
#-------------------------------------------------------------------------------------------------------------
ViewExtractSkipZeroesSet(cbRpt, sAEView, 1);
ViewSuppressZeroesSet(cbRpt, sAEView, 1);
ViewExtractSkipCalcsSet(cbRpt, sAEView, 1);



#-------------------------------------------------------------------------------------------------------------
# ***Zero out Cube
#-------------------------------------------------------------------------------------------------------------
VIEWZEROOUT(cbRpt,sAEView);


#-------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS
#-------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbRpt, sAEView);
SUBSETDESTROY (dmstage, sAEView);
#SUBSETDESTROY (dmHLYear, sAEView);
#SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmOC, sAEView);
SUBSETDESTROY (dmRE, sAEView);
SUBSETDESTROY (dmFunc, sAEView);
SUBSETDESTROY (dmReason, sAEView);
SUBSETDESTROY (dmSPP, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmType, sAEView);
SUBSETDESTROY (dmMA, sAEView);
SUBSETDESTROY (dmItem, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmJur, sAEView);
SUBSETDESTROY (dmPer, sAEView);
SUBSETDESTROY (dmRptMeas, sAEView);


#*****************************************************************************************************************************************************
#*** STEP 2 - CREATE SOURCE VIEW ***#
#*****************************************************************************************************************************************************
#******************************************************************************************************************
#*** DELETE EXISTING VIEWS AND SUBSETS
#******************************************************************************************************************
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmOC, sAEView);
SUBSETDESTROY (dmRE, sAEView);
SUBSETDESTROY (dmFunc, sAEView);
SUBSETDESTROY (dmReason, sAEView);
SUBSETDESTROY (dmSPP, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmType, sAEView);
SUBSETDESTROY (dmMA, sAEView);
SUBSETDESTROY (dmItem, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmJur, sAEView);
SUBSETDESTROY (dmPer, sAEView);

#******************************************************************************************************************
#*** CREATE SUBSETS
#******************************************************************************************************************
# headline year
SubsetCreate(dmHLYear, sAEView);
SubsetElementInsert(dmHLYear, sAEView, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sAEView);
SubsetElementInsert(dmScenario, sAEView, psSourceScenario, 1);


# Status
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmStatus | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Outcome
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmOC | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Function
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Reason
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Appropriation Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmType | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Movement Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Appropriation Item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Program
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAcc | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# ID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmId | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Period
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")}';
SUBSETCREATEBYMDX (sAEView, MDX);


#******************************************************************************************************************
#*** BUILD VIEW ***#
#******************************************************************************************************************
VIEWCREATE (cbAE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmHLYear, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmScenario, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmStatus, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmOC, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmRE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmFunc, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmReason, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmSPP, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasCode, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMA, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmItem, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmProg, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmAcc, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmID, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmJur, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmPer, sAEView);


#******************************************************************************************************************
# *** DEFINE VIEW EXTRACT
#******************************************************************************************************************
VIEWEXTRACTSKIPZEROESSET (cbAE, sAEView, 1);
VIEWEXTRACTSKIPRULEVALUESSET (cbAE, sAEView, 0);
VIEWEXTRACTSKIPCALCSSET (cbAE, sAEView, 1);


DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sAEView;

lCounter = 0;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#==============================
#** IF CURRENT SCENARIO, use the default 'budget round entered in variables'
#==============================

IF (vsScenario @= 'current');
	#ITEMSKIP;
	sTargetStage = SUBST(vsHLYear, 3,9) | ' ' |  sCurScenarioBudRound;
ELSE;

	sTargetStage = SUBST(vsHLYear, 3,9) | ' ' | vsScenario;
ENDIF;


#==============================
#** Load Data to AE Reporting Cube
#==============================

IF (DIMIX (dmStage, sTargetStage) = 0);
	ITEMSKIP;
ENDIF;

IF(CELLISUPDATEABLE(cbRpt, sTargetStage,vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeascode, vsType, vsMA, vsItem, vsProg, vsACC, vsID, vsJur, vsPeriod, psTargetMeas) = 1);
	nOldValue = CELLGETN ( cbRpt, sTargetStage,vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeascode, vsType, vsMA, vsItem, vsProg, vsACC, vsID, vsJur, vsPeriod, psTargetMeas);
	CELLPUTN(nOldValue + nValue, cbRpt, sTargetStage,vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeascode, vsType, vsMA, vsItem, vsProg, vsACC, vsID, vsJur, vsPeriod, psTargetMeas);
ENDIF;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#-------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS
#-------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmOC, sAEView);
SUBSETDESTROY (dmRE, sAEView);
SUBSETDESTROY (dmFunc, sAEView);
SUBSETDESTROY (dmReason, sAEView);
SUBSETDESTROY (dmSPP, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmType, sAEView);
SUBSETDESTROY (dmMA, sAEView);
SUBSETDESTROY (dmItem, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAcc, sAEView);
SUBSETDESTROY (dmID, sAEView);
SUBSETDESTROY (dmJur, sAEView);
SUBSETDESTROY (dmPer, sAEView);

#endregion