#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE_Recover Baseline_03 - Prog Cube
#**** DESCRIPTION:       This process creates a view of all data in the CURRENT scenario in the programme details cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 10/05/2014    KG             Initial Revision
#****  2019	KG	Updated For New GEUS
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';
dmProgMeas = snProg | ' measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

sHLYear = ATTRS(dmVar, 'archive year', 'old value');
sScenario = ATTRS(dmVar, 'archive scenario', 'old value');
#sTargetHLYear = ATTRS('variables', 'archive year', 'value');
#sTargetScenario = ATTRS('variables', 'archive scenario', 'value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = sUser | '_$RecoverBaseline';
sSubset = sView;

#***********************************************************************************************************************
#--- STEP 1 - DELETE TARGET VIEW
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbProg, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmProg, sSubset);
SubsetDestroy(dmProgMeas, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);


# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme Measure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProgMeas | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbProg, sView);
ViewSubsetAssign(cbProg, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbProg, sView, dmScenario, sSubset);
ViewSubsetAssign(cbProg, sView, dmProg, sSubset);
ViewSubsetAssign(cbProg, sView, dmProgMeas, sSubset);


ViewExtractSkipZeroesSet (cbProg, sView, 1);
ViewExtractSkipCalcsSet (cbProg, sView, 1);
ViewExtractSkipRuleValuesSet (cbProg, sView, 1);

#---------------------------------------------------------------------------------------------------------------------------
#--- ZERO OUT CUBE
#---------------------------------------------------------------------------------------------------------------------------
VIEWZEROOUT (cbProg, sView);


#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbProg, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmProg, sSubset);
SubsetDestroy(dmProgMeas, sSubset);



#***********************************************************************************************************************
#--- STEP 2 - CREATE SOURCE VIEW
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbProg, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmProg, sSubset);
SubsetDestroy(dmProgMeas, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);


# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme Measure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProgMeas | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbProg, sView);
ViewSubsetAssign(cbProg, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbProg, sView, dmScenario, sSubset);
ViewSubsetAssign(cbProg, sView, dmProg, sSubset);
ViewSubsetAssign(cbProg, sView, dmProgMeas, sSubset);


ViewExtractSkipZeroesSet (cbProg, sView, 1);
ViewExtractSkipCalcsSet (cbProg, sView, 1);
ViewExtractSkipRuleValuesSet (cbProg, sView, 1);


#---------------------------------------------------------------------------------------------------------------------------
#--- DEFINE DATA SOURCE
#---------------------------------------------------------------------------------------------------------------------------
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

IF (CELLISUPDATEABLE (cbProg, psTargetHLYear, psTargetScenario, vsProg, vsMeas) = 1);
	IF (VALUE_IS_STRING=0);
          		CellPutN(NVALUE, cbProg, psTargetHLYear, psTargetScenario, vsProg, vsMeas);
     	ELSE;
		CellPutS(SVALUE, cbProg, psTargetHLYear, psTargetScenario, vsProg, vsMeas);
	ENDIF;
ENDIF;


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#---------------------------------------------------------------------------------------------------------------------------
#--- ZERO OUT SOURCE VIEW
#---------------------------------------------------------------------------------------------------------------------------
VIEWZEROOUT (cbProg, sView);


#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
ViewDestroy(cbProg, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmProg, sSubset);
SubsetDestroy(dmProgMeas, sSubset);

#endregion