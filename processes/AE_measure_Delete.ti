#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:              AE_measure_Delete
#**** DESCRIPTION:       This process approves the selected measure by the user
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 05/05/2014    KG             Initial Revision
#**** 13/08/2014	KG	  Added 'deleted date' and Termination Year Clear
#**** 2019	KG	  UDPATED FOR GEUS PRIMUS
#***********************************************************************************************************************

#*** DECLARE CUBES & DIMENSIONS ***#
cbMeasID = 'government measures details';
cbMeas = 'government measures';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmControlType = 'control type';
dmFundType = 'measure fund type';
dmMeasType = 'measure type';
dmMeasCode = 'measure code';
dmPer = 'period';
dmMeasDetails = 'measure details';
dmVar = 'variables';

#*** DECLARE VARIABLES ***#
curHLYear = ATTRS(dmVar, 'headline year', 'value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sCurUser = TM1User();


dmClients = '}Clients';
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sObject = sUser | '_$DeleteMeas';
sView =  sUser | '_$DeleteMeas';

#**************************************************************************************************************8
#*** STEP 1 - CREATE SOURCE MEASURE CUBE VIEW ***#

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbMeas, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmStatus, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmPer, sView);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sView);
SubsetElementInsert(dmHLYear, sView, psHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sView);
SubsetElementInsert(dmScenario, sView, psScenario, 1);

# Status
SubsetCreate(dmStatus, sView);
SubsetElementInsert(dmStatus, sView, 'data', 1);


# Measure Code
SubsetCreate(dmMeasCode, sView);
SubsetElementInsert(dmMeasCode, sView, psMeasCode, 1);

# Period
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")}';
SUBSETCREATEBYMDX (sView, MDX);

#*** BUILD VIEW ***#
VIEWCREATE (cbMeas, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmHLYear, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmScenario, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmStatus, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmMeasCode, sView);
VIEWSUBSETASSIGN (cbMeas, sView, dmPer, sView);

#**** CLEAR CUBE ****#
VIEWZEROOUT (cbMeas, sView);

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbMeas, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmStatus, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmPer, sView);

#*****************************************************************************************************************************************************
#*** STEP 2 - CREATE SOURCE AE ID DETAILS VIEW ***#

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbMeasID, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmMeasDetails, sView);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sView);
SubsetElementInsert(dmHLYear, sView, psHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sView);
SubsetElementInsert(dmScenario, sView, psScenario, 1);


# Measure Code
SubsetCreate(dmMeasCode, sView);
SubsetElementInsert(dmMeasCode, sView, psMeasCode, 1);

# Measure Details
MDX = '{ EXCEPT( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [ ' | dmMeasDetails | '] )}, 0)}, { [' | dmMeasDetails | '].[used] }) }';
SUBSETCREATEBYMDX (sView, MDX);


#*** BUILD VIEW ***#
VIEWCREATE (cbMeasID, sView);
VIEWSUBSETASSIGN (cbMeasID, sView, dmHLYear, sView);
VIEWSUBSETASSIGN (cbMeasID, sView, dmScenario, sView);
VIEWSUBSETASSIGN (cbMeasID, sView, dmMeasCode, sView);
VIEWSUBSETASSIGN (cbMeasID, sView, dmMeasDetails, sView);


#**** CLEAR CUBE ****#
VIEWZEROOUT (cbMeasID, sView);

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbMeasID, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmMeasDetails, sView);

CELLPUTS (sUser, cbMeasID, psHLYear, psScenario, psMeasCode, 'deleted by');

# **** GET DATE VALUES ***#
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 

sDay = TRIM(SUBST(sDNow, 1,2));

IF (LONG (sDay) = 1);
	sDay = '0' | sDay;
ELSE;
	sDay = sDay;
ENDIF;

sMonth = TRIM(SUBST(sMNow, 1,2));

IF (LONG (sMonth) = 1);
	sMonth = '0' | sMonth;
ELSE;
	sMonth = sMonth;
ENDIF;

sYear = TRIM(SUBST(sYNow, 1,4));

sNow = sDay | '/' | sMonth | '/' | sYear;

CELLPUTS(sNow,  cbMeasID, psHLYear, psScenario, psMeasCode, 'deleted date');

#*** SET INACTIVE ATTRIBUTES AND CLEAR OUT ALL OTHER ATTRIBUTES***#
ATTRPUTS ('N', dmMeasCode, psMeasCode, 'Active');

sTitle = ATTRS (dmMeasCode, psMeasCode, 'title');
sTitle = sTitle | ' (DELETED)';
ATTRPUTS ('' , dmMeasCode, psMeasCode, 'title');

sDesc = ATTRS (dmMeasCode, psMeasCode, 'code and description');
sDesc = sDesc | ' (DELETED)';
ATTRPUTS ('', dmMeasCode, psMeasCode, 'code and description');

ATTRPUTS ('', dmMeasCode, psMeasCode, 'CBMS');

sCBMSCDesc = ATTRS (dmMeasCode, psMeasCode, 'CBMS code and description');
sCBMSCDesc = sCBMSCDesc | ' (DELETED)';
ATTRPUTS ('', dmMeasCode, psMeasCode, 'CBMS code and description');

ATTRPUTS ('', dmMeasCode, psMeasCode, 'Budget Round Created');
ATTRPUTS ('', dmMeasCode, psMeasCode, 'Termination Year');

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion