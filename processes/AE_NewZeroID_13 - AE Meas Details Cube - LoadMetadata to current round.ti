#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              AE_NewZeroID_13 - AE Meas Details Cube - LoadMetadata to current round
#**** DESCRIPTION:       This process repopulates the CURRENT scenario with the 'used' values in the government  measures details cube
#****		          
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 27/08/2014    KG             Initial Revision
#****
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE INDEX CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbIndex = 'index';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE CASHFLOW CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbCF= 'AE cash flow';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GOVERNMENT MEASURE CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbMeas = 'government measures';
dmMeasDet = 'measure details';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GOVERNMENT MEASURE DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbMeasDet = 'government measures details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GROUP ADJUSTMENT ENTRY CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbGrp = 'AE group adjustment entry';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------
sTargetHLYear = ATTRS(dmVar, 'headline year', 'value');
sTargetScenario = 'current';


#-------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;


sView = '$ArchiveClear';
sSubset = sView;



#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmHLyear, sSubset);
SubsetDestroy(dmScenario, sSubset);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLyear, sSubset);
SubsetElementInsert(dmHLyear, sSubset, sTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, sTargetScenario, 1);

#****BUILD VIEW****#
ViewCreate(cbMeasDet, sView);

ViewSubsetAssign(cbMeasDet, sView, dmHLyear, sSubset);
ViewSubsetAssign(cbMeasDet, sView, dmScenario, sSubset);

ViewSetSkipZeroes(cbMeasDet, sView, 1);
ViewSetSkipCalcs(cbMeasDet, sView, 1);
ViewZeroOut(cbMeasDet, sView);

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmHLyear, sSubset);
SubsetDestroy(dmScenario, sSubset);
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

IF (VALUE_IS_STRING=0);
     CellPutN(NVALUE, cbMeasDet, sTargetHLYear, sTargetScenario, vsMeasCode, vsMeasure);
ELSE;
     CellPutS(SVALUE, cbMeasDet, sTargetHLYear, sTargetScenario, vsMeasCode, vsMeasure);
ENDIF;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** DECLARE CUBES AND DIMENSIONS ***#
cbMeasDet = 'government measures details';
sView = '$NewBaseline';
sSubset = sView;

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmMeasDet, sSubset);
#endregion