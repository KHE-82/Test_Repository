#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE Generate ParameterAndED Adj 00 - Start

#*** DESCRIPTION:       This process will create a view for the parameters and efficiency dividend adjustments
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 28/04/2014    KG             Initial Revision
#**** 2019	KG	Update for NEW GEUS/PRIMUS
#****
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;


#******************************************************************************************************************
#*** DECLARE TEMPORARY DIMENSION
#******************************************************************************************************************
dmTmpID = '}tmp_ID_tmp ' | sUser;




#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#******************************************************************************************************************
#*** RUN TI PROCESSES FOR GENERATION OF PARAMETERS/ED
#******************************************************************************************************************

#******************************************************************************************************************
#***  BUILD TEMPORARY DIMENSION & ASSIGN VARIABLES
#*** BUILD A DIMENSION TO STORE IDS SO WE DONT KEEP GETTING NEW ONES
#******************************************************************************************************************
sProcess = 'sys_Temp Dimension - Create Temporary Dimensions';
EXECUTEPROCESS(sProcess);


#******************************************************************************************************************
#**** STEP 01 - CREATE PARAMETERS AND ED VIEW 
#******************************************************************************************************************
sProcess = 'sys_AE Generate ParameterAndED Adj 01 - Create View';
ExecuteProcess(sProcess,'psUser', psUser, 'psProg', psProg,'psAdjType', psAdjType,'psCreateAdjByMeasures', psCreateAdjByMeasures);


#******************************************************************************************************************
#**** STEP 02
#******************************************************************************************************************
sProcess = 'sys_AE Generate ParameterAndED Adj 02 - Create Adjustment';
ExecuteProcess(sProcess,'psUser', psUser, 'psProg', psProg,'psAdjType', psAdjType,'psCreateAdjByMeasures', psCreateAdjByMeasures);


#******************************************************************************************************************
#**** STEP 03 - ADD SELECTED PROGRAMS TO REPORTING SUBSET WHICH CAN BE USED IN PRINT REPORTS
#******************************************************************************************************************
sProcess = 'sys_AE Generate ParameterAndED Adj 97 - Create Report Subsets';
ExecuteProcess(sProcess, 'psUser', psUser, 'psProg', psProg,'psAdjType', psAdjType);


#******************************************************************************************************************
#*** CLEAR SELECTED FLAGS
#******************************************************************************************************************
sProcess = 'sys_AE Generate ParameterAndED Adj 99 - Clear Flags';
ExecuteProcess(sProcess, 'psAdjType', psAdjType);


#******************************************************************************************************************
#*** DELETE TEMPORARY DIMENSION
#******************************************************************************************************************
IF (DIMENSIONEXISTS (dmTmpID) = 1);
	DimensionDeleteAllElements (dmTmpID);
ENDIF;

#endregion