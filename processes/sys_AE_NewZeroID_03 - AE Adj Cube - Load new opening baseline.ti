#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_AE_NewZeroID_03 - AE Adj Cube - Load new opening baseline
#**** DESCRIPTION:       This process copies data from all IDs in the newly archived scenario and loads it to ID 0000A in the CURRENT scenario
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 12/05/2014    KG             Initial Revision
#**** 2019	KG	Updated for NEW GEUS
#***********************************************************************************************************************

# This process copies data from all IDs in the newly archived scenario and loads it to ID 0000A in the CURRENT scenario

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

#sHLYear = ATTRS(dmVar, 'archive year', 'old value');
#sScenario = ATTRS(dmVar, 'archive scenario', 'old value');
#sTargetHLYear = ATTRS(dmVar, 'archive year', 'value');
#sTargetScenario = ATTRS(dmVar, 'archive scenario', 'value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sStatus = 'Total approved';
sID = 'Total IDs';
sReason = 'Total reason';


sHLYear = ATTRS('variables', 'headline year', 'value');
sScenario = 'current';
sID = '0000A';
sNewStatus = 'data';
#sNewReason = 'Other';
sNewReason = 'Other variations not elsewhere defined';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SOURCE VIEWS
#---------------------------------------------------------------------------------------------------------------------------

sView = '$NewBaseline';
sSubset = sView;

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** DATA ENTRY TO ADJUSTMENTS CUBE ***#

#IF (CELLISUPDATEABLE (cbAE, psTargetHLYear, psTargetScenario, sNewStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, vsPeriod) = 1);
#	OldValue = CELLGETN (cbAE, psTargetHLYear, psTargetScenario, sNewStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, vsPeriod);
#	CELLPUTN (OldValue + Value, cbAE, psTargetHLYear, psTargetScenario, sNewStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, vsPeriod);
#ENDIF;

#*** USING 'OTHER FOR REASON CODE ***#
IF (CELLISUPDATEABLE (cbAE, psTargetHLYear, psTargetScenario, sNewStatus, vsOC, vsRE, vsFunc, sNewReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, vsPeriod) = 1);
	OldValue = CELLGETN (cbAE, psTargetHLYear, psTargetScenario, sNewStatus, vsOC, vsRE, vsFunc, sNewReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, vsPeriod);
	CELLPUTN (OldValue + Value, cbAE, psTargetHLYear, psTargetScenario, sNewStatus, vsOC, vsRE, vsFunc, sNewReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, vsPeriod);
ENDIF;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


cbAE = 'AE adjustments';
sView = '$NewBaseline';
sSubset = sView;

#****DELETE EXISTING VIEWS AND SUBSETS

VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);
#endregion