#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#***************************************************************************************************************************************************
#***** PROCESS : 			AE_Measure Upload 02 - Create New Measure Code
#***** DESCRIPTION:		THIS TI PROCESS IS TO LOAD NEW MEASURES VIA FLATFILE
#*****				
#*****
#***** MODIFICATION HISTORY :	
#***** 
#*****
#***** DATE		INITIALS		COMMENTS
#***** =====		=======		==========
#***** 20/06/2014		KG		Updated Version
#***** 04/01/2016		KG		Updated metadata checks
#***** 2019		KG		Updated for NEW GEUS
#************************************************************************************************************************************************* 


#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#*****************************************************************************
#*** DECLARE CUBES AND DIMENSIONS***#
#*****************************************************************************
cbMeas = 'government measures details';
cbEAMeasCode = '}ElementAttributes_measure code';
dmMeasCode = 'measure code';
dmDay = 'sys_day';
dmMonth = 'sys_month';
dmYear = 'sys_year';
dmPeriod = 'period';
sParent = 'Total Measures';

#*****************************************************************************
#*** DECLARE SYSTEM VARIABLES
#*****************************************************************************
dmVar = 'variables'; 
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sFilePath = ATTRS (dmVar, 'sys_upload directory', 'value');



#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** CREATE MEASURE CODE
#******************************************************************************************************************
DIMENSIONELEMENTINSERT (dmMeasCode, '', psNewID, 'N');
DIMENSIONELEMENTCOMPONENTADD (dmMeasCode, sParent, psNewID, 1);



#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****



#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#----------------------------------------------------------------------------------------------------------------
#--- CALL PROCESS DO CREATE NEW MEASURE CODE
#---------------------------------------------------------------------------------------------------------------
sProcess = 'AE_Measure Upload 03 - Update Data Fields';
EXECUTEPROCESS (sProcess, 'psUser', sUser, 
	'psNewID', psNewID,
	'psCBMSCode', psCBMSCode,
	'psTitle', psTitle,
	'psDesc', psDesc,
	'psPubTitle', psPubTitle,
	'psFundLife', psFundLife, 
	'psEndDay', psEndDay,
	'psEndMonth', psEndMonth,
	'psEndYear', psEndYear,
	'psTerminatingYear', psTerminatingYear,
	'psGovtDec', psGovtDec,
	'psDecDate', psDecDate,
	'psNotForPublication', psNotForPublication,
	'psMeasType', psMeasType,
	'psCostingID', psCostingID, 
	'psPolicyEntity', psPolicyEntity,
	'psProg', psProg,
	'psPubRound', psPubRound,
	'psPubYear', psPubYear);
#endregion