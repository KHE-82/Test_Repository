#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_measure_ChangeCode
#**** DESCRIPTION:       This process will change details of the measure
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 10/05/2014    KG             Initial Revision
#****
#***********************************************************************************************************************

#*** DECLARE AE CUBES & DIMENSIONS ***#
snProg = 'programme';
cbAE = 'government measures';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmCtrlType = 'control type';
dmFundType = 'measure fund type';
dmMeasType = 'measure type';
dmMeasCode = 'measure code';
dmPer = 'period';
dmMeasDet = 'measure details';

#*** DECLARE PROGRAMME DETAILS CUBE ***#
cbProg = snProg | ' details';


#*** DECLARE ID DETAILS CUBE DIMENSIONS
cbID = 'government measures details';

#*** DECLARE SYSTEM DIMENSIONS ***# 
dmVar = 'variables';
dmClients = '}Clients';

#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');

#*** DECLARE SUBSETS AND VIEWS ***#
# *** IDENTIFY CURRENT USER ***#
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;



sObject  = sUser | '_$ChangeMeasCodeView';
sAEView = sUser | '_$ChangeMeasCodeView';

#*** RETRIEVE CURRENT MEASURE DETAILS ***#
sCtrlType = CellGetS(cbID, psHLYear, psScenario, psID, 'control type');
sMeasType = CellGetS(cbID, psHLYear, psScenario, psID, 'measure type');
sFundType = CellGetS(cbID, psHLYear, psScenario, psID, 'funding life');
sMeasureCode = CellGetS(cbID, psHLYear, psScenario, psID, 'CBMS Measure Code');

#*****************************************************************************************************************************************************
#*** STEP 1 - CREATE TARGET VIEW TO CLEAR DATA ***#
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmCtrlType, sAEView);
SUBSETDESTROY (dmFundType, sAEView);
SUBSETDESTROY (dmMeasType, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmPer, sAEView);
SUBSETDESTROY (dmMeasDet, sAEView);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sAEView);
SubsetElementInsert(dmHLYear, sAEView, psHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sAEView);
SubsetElementInsert(dmScenario, sAEView, psScenario, 1);

# Status
SubsetCreate(dmStatus, sAEView);
SubsetElementInsert(dmStatus, sAEView, 'data', 1);

# ControlType
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmCtrlType | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Funding Type
SubsetCreate(dmFundType, sAEView);
SubsetElementInsert(dmFundType, sAEView, psFundType, 1);

# Measure Type
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasType | '] )}, 0)}';
#SUBSETCREATEBYMDX (sAEView, MDX);
SubsetCreate(dmMeasType, sAEView);
SubsetElementInsert(dmMeasType, sAEView, psMeasType, 1);


# Measure Code
SubsetCreate(dmMeasCode, sAEView);
SubsetElementInsert(dmMeasCode, sAEView, psID, 1);

# Period
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Measure Details
SubsetCreate(dmMeasDet, sAEView);
SubsetElementInsert(dmMeasDet, sAEView, 'ASL', 1);
SubsetElementInsert(dmMeasDet, sAEView, 'value', 2);

#*** BUILD VIEW ***#
VIEWCREATE (cbAE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmHLYear, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmScenario, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmStatus, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmCtrlType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmFundType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasCode, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmPer, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasDet, sAEView);

# *** DEFINE VIEW EXTRACT
ViewExtractSkipZeroesSet(cbAE, sAEView, 1);
ViewSuppressZeroesSet(cbAE, sAEView, 1);
ViewExtractSkipCalcsSet(cbAE, sAEView, 1);

#*** CLEAR THE VIEW
ViewZeroOut (cbAE, sAEView);

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmCtrlType, sAEView);
SUBSETDESTROY (dmFundType, sAEView);
SUBSETDESTROY (dmMeasType, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmPer, sAEView);
SUBSETDESTROY (dmMeasDet, sAEView);

#*****************************************************************************************************************************************************
#*** STEP 2 - CREATE SOURCE VIEW ***#

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmCtrlType, sAEView);
SUBSETDESTROY (dmFundType, sAEView);
SUBSETDESTROY (dmMeasType, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmPer, sAEView);
SUBSETDESTROY (dmMeasDet, sAEView);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sAEView);
SubsetElementInsert(dmHLYear, sAEView, psHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sAEView);
SubsetElementInsert(dmScenario, sAEView, psScenario, 1);

# Status
SubsetCreate(dmStatus, sAEView);
SubsetElementInsert(dmStatus, sAEView, 'data', 1);

# ControlType
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmCtrlType | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Funding Type
SubsetCreate(dmFundType, sAEView);
SubsetElementInsert(dmFundType, sAEView, sFundType, 1);

# Measure Type
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasType | '] )}, 0)}';
#SUBSETCREATEBYMDX (sAEView, MDX);
SubsetCreate(dmMeasType, sAEView);
SubsetElementInsert(dmMeasType, sAEView, sMeasType, 1);


# Measure Code
SubsetCreate(dmMeasCode, sAEView);
SubsetElementInsert(dmMeasCode, sAEView, psID, 1);

# Period
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")}';
SUBSETCREATEBYMDX (sAEView, MDX);

# Measure Details
SubsetCreate(dmMeasDet, sAEView);
SubsetElementInsert(dmMeasDet, sAEView, 'ASL', 1);
SubsetElementInsert(dmMeasDet, sAEView, 'value', 2);


#*** BUILD VIEW ***#
VIEWCREATE (cbAE, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmHLYear, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmScenario, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmStatus, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmCtrlType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmFundType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasType, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasCode, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmPer, sAEView);
VIEWSUBSETASSIGN (cbAE, sAEView, dmMeasDet, sAEView);

# *** DEFINE VIEW EXTRACT
ViewExtractSkipZeroesSet(cbAE, sAEView, 1);
ViewSuppressZeroesSet(cbAE, sAEView, 1);
ViewExtractSkipCalcsSet(cbAE, sAEView, 1);

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sAEView;

IF (psCBMSMeasCode @<> 'TBA');
     ATTRPUTS (psCBMSMeasCode, dmMeasCode, psID, 'CBMS');
ENDIF;



#*****************************************************************************************************************************************************


#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

IF (CELLISUPDATEABLE (cbAE, vsHLYear, vsScenario, vsStatus, vsCtrlType, psFundType, psMeasType, psID, vsPer, vsMeas) = 1);
     CELLPUTN (Value, cbAE, vsHLYear, vsScenario, vsStatus, vsCtrlType, psFundType, psMeasType, psID, vsPer, vsMeas);
ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** NOW ZERO OUT SOURCE VIEW AS IT IS NOT REQUIRED
ViewZeroOut (cbAE, sAEView);

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbAE, sAEView);
SUBSETDESTROY (dmHLYear, sAEView);
SUBSETDESTROY (dmScenario, sAEView);
SUBSETDESTROY (dmStatus, sAEView);
SUBSETDESTROY (dmCtrlType, sAEView);
SUBSETDESTROY (dmFundType, sAEView);
SUBSETDESTROY (dmMeasType, sAEView);
SUBSETDESTROY (dmMeasCode, sAEView);
SUBSETDESTROY (dmPer, sAEView);
SUBSETDESTROY (dmMeasDet, sAEView);

#endregion