#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               sys_Program Dimension Update - Upload 01 - Create Temp Dim
#**** DESCRIPTION:       This process will 
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date	Initials	Comments
#****  ====              ======    =========
#**** 15/08/2023     EC           Initial Revision
#***********************************************************************************************************************

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE
#-------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';
cbEAProg = '}ElementAttributes_'|snProg;
#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYS APPLICATION CUBE
#-------------------------------------------------------------------------------------------------------------
cbApp = 'sys_application';


#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYS CLIENT FAVOURITE APPLICATION CUBE
#-------------------------------------------------------------------------------------------------------------
cbFavApp = 'sys_client favourite application';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE ID DETAILS CUBE DIMENSIONS
#-------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS
#-------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
#dmClients = '}Clients';
cbEAVar = '}ElementAttributes_variables';

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#******************************************************************************************************************
#*** DECLARE CLIENT GROUPS CUBE
#******************************************************************************************************************
cbGroups = '}ClientGroups';


#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sCurUser = TM1User();

#--------------------------------------------------------------------------------------------------------
#--- CHECK IF CBMS-R IS LIVE : New Code 08 August 2017 - KG
#--------------------------------------------------------------------------------------------------------
sCBMSRLive = ATTRS (dmVar, 'sys_CBMSR GoLive', 'value');
sCBMSRLiveHLYear = ATTRS (dmVar, 'sys_CBMSR GoLive Headline Year', 'value');
sCBMSRMigrationScenario = 'CBMS-R OBAL';

#--------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#--------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sSubset  = sUser | '_$EditView';
sAEView = sUser | '_$EditView';

sVarUpLoad = 'sys_upload directory';

#******************************************************************************************************************
# **** GET DATE VALUES AND POST USER AND DATE STAMP
#******************************************************************************************************************
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 
sHNow = TimST( Now, '\h');
sMNow = TimST( Now, '\i');
sSNow = TimST( Now, '\s');

sDay = TRIM(SUBST(sDNow, 1,2));

IF (LONG (sDay) = 1);
	sDay = '0' | sDay;
ELSE;
	sDay = sDay;
ENDIF;

sMonth = TRIM(SUBST(sMNow, 1,2));

IF (LONG (sMonth) = 1);
	sMonth = '0' | sMonth;
ELSE;
	sMonth = sMonth;
ENDIF;

sYear = TRIM(SUBST(sYNow, 1,4));
sNow = sDay | '/' | sMonth | '/' | sYear;
sNow = sYNow | sMNow | sDNow | sHNow| sMNow | sSNow; 

nTime = 1;
#------Dimension------#
sOutPutDir = CellGetS( cbEAVar, sVarUpLoad ,'value');

sUpFile = sOutputDir | psFile;

DatasourceNameForServer=sUpFile;

#-------------------------------------------------------------------------------------------------------------
#*** Create Temp Dimension
#-------------------------------------------------------------------------------------------------------------

dmTemp = '}temp_' | sUser;
cbEATemp = '}ElementAttributes_'| dmTemp;

IF( DimensionExists(dmTemp) =1);
	DimensionDestroy(dmTemp);
ENDIF;

DimensionCreate(dmTemp);

sAttrName = 'sys_Type';
AttrInsert(dmTemp, '', sAttrName, 'S');

sAttrName = 'sys_Parent';
AttrInsert(dmTemp, '', sAttrName, 'S');

sAttrName = 'sys_Weight';
AttrInsert(dmTemp, '', sAttrName, 'N');

sAttrName = 'sys_Alt Hier';
AttrInsert(dmTemp, '', sAttrName, 'N');

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#------Skip Empty Lines------#
IF( vsEL @='');
	Itemskip;
ENDIF;

#------Insert Elements in Temp Dim------#
IF( DIMIX(dmTemp, vsEL) =0);
	DimensionElementInsertDirect(dmTemp, '', vsEL,'N');
	CellIncrementN(1, cbEATemp, vsEl, 'sys_Alt Hier' );
	sTempEL = vsEL;	
ELSEIF(vsType @='');
	nAltNum = CellGetN(cbEATemp, vsEl, 'sys_Alt Hier' );
	sAltNum = NumberTostring(nAltNum);
	sAltNum = Fill('0',2-Long(sAltNum)) |sAltNum;
	sAltEL = vsEL | '_Alt' | sAltNum;
#asciioutput('alt.csv', vsEL, sAltEL);
	DimensionElementInsertDirect(dmTemp, '', sAltEL,'N');
	CellPutN(nAltNum+1, cbEATemp, vsEl, 'sys_Alt Hier' );
	sTempEL = sAltEL;
ELSEIF (vsType@='C');
	sTempEL = vsEL;
ENDIF;

#------Store Component Parent------#
IF( vsType @='C');
	sPar = vsEL;
ENDIF;


#------Populate Weight Factor and Set Defaut to 1-----#
IF( vnWeight <>0);
	CellPutN(vnWeight, cbEATemp,sTempEL, 'sys_Weight' );	
ELSE;
	CellPutN(1, cbEATemp, sTempEL, 'sys_Weight' );	
ENDIF;

#------Populate Element Type-----#
#-----Once defined as C , cannot be changed to other types -----#
sOldType = CellGetS(cbEATemp, sTempEL, 'sys_type' );

IF( sOldType @<>'C');
	CellPutS(vsType, cbEATemp, sTempEL, 'sys_type' );
asciioutput('type.csv', vsType,sTempEL,sOldType);
ENDIF;


#------Populate Element Parent - Direct -----#
#------Only consider one parent to N------#
IF(vsType @<>'C');
	CellPutS(sPar, cbEATemp, sTempEL, 'sys_parent' );
ENDIF;
	
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****



#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion