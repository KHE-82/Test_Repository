#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               sys_Program Dimension Update - Add New Program
#**** DESCRIPTION:       This process will 
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date	Initials	Comments
#****  ====              ======    =========
#**** 15/07/2023     EC           Initial Revision
#***********************************************************************************************************************

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE
#-------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';
cbEAProg = '}ElementAttributes_'|snProg;
#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYS APPLICATION CUBE
#-------------------------------------------------------------------------------------------------------------
cbApp = 'sys_application';


#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYS CLIENT FAVOURITE APPLICATION CUBE
#-------------------------------------------------------------------------------------------------------------
cbFavApp = 'sys_client favourite application';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE ID DETAILS CUBE DIMENSIONS
#-------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS
#-------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
#dmClients = '}Clients';

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#******************************************************************************************************************
#*** DECLARE CLIENT GROUPS CUBE
#******************************************************************************************************************
cbGroups = '}ClientGroups';


#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sCurUser = TM1User();

#--------------------------------------------------------------------------------------------------------
#--- CHECK IF CBMS-R IS LIVE : New Code 08 August 2017 - KG
#--------------------------------------------------------------------------------------------------------
sCBMSRLive = ATTRS (dmVar, 'sys_CBMSR GoLive', 'value');
sCBMSRLiveHLYear = ATTRS (dmVar, 'sys_CBMSR GoLive Headline Year', 'value');
sCBMSRMigrationScenario = 'CBMS-R OBAL';

#--------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#--------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sObject  = sUser | '_$EditView';
sAEView = sUser | '_$EditView';

#-------------------------------------------------------------------------------------------------------------
#*** RETRIEVE ID DETAILS
#-------------------------------------------------------------------------------------------------------------
#sOutcome = CellGetS(cbID, psHLYear, psScenario, psID, 'outcome');
#sFunction = CellGetS(cbID, psHLYear, psScenario, psID, 'function');
#sReason = CellGetS(cbID, psHLYear, psScenario, psID, 'reason');
#sSPP = CellGetS(cbID, psHLYear, psScenario, psID, 'SPP');
#sAppropType = CellGetS(cbID, psHLYear, psScenario, psID, 'appropriation type');
#sAppropItem = CellGetS(cbID, psHLYear, psScenario, psID, 'appropriation item');
#sProg = CellGetS(cbID, psHLYear, psScenario, psID, snProg | ' code');
#sMeasureCode = CellGetS(cbID, psHLYear, psScenario, psID, 'measure');




#-------------------------------------------------------------------------------------------------------------
#*** Validation on Parameters 
#-------------------------------------------------------------------------------------------------------------
nValid =0;

sClientMeas = 'geus programme';
sValid = 'validate';
sErrorPreFix= 'Error : ';

CellPutS( '', cbClient, sUser, sClientMeas, sValid);



#------Element Type------#
IF( psProgType @= 'N' %  psProgType @= 'C');
ELSE;
	sMsgBody = 'New Program Type is not valid.';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;

ENDIF;


#------Parent Program------#
IF( Dimix(dmProg, psPar) =0);
	sMsgBody = 'Parent Program does not exisit.';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;

ELSEIF( Dtype(dmProg, psPar) @<>'C');
	sMsgBody = 'Parent Program is not a C level program';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;
ELSE;
	sPar = DimensionElementPrincipalName(dmProg, psPar);
ENDIF;

#------New Program Code------#
IF( Dimix(dmProg, psProgCode) <>0);
	sMsgBody = 'New program code already exisits if not blank.';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;

#-----Need to consider special charactor(s) here ----#

ENDIF;

#------New Program Description------#
IF( Dimix(dmProg, psProgDesc) <>0);
	sMsgBody = 'New program description already exisits if not blank.';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;
#-----Need to consider special charactor(s) here ----#

ENDIF;

IF( psProgType @='N');
#------Outcome------#
IF( Dimix(dmOC, psOC) =0);
	sMsgBody = 'Outcome code does not exisit.';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;

ELSEIF(Dtype(dmOC,psOC)@='C');
	sMsgBody = 'Outcome code is not valid';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;
ELSE;
	sOC = DimensionElementPrincipalName(dmOC,psOC);
ENDIF;

#------Function------#
IF( Dimix(dmFunc, psFunc) =0);
	sMsgBody = 'Function code does not exist';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;

ELSEIF(Dtype(dmFunc,psFunc)@='C');
	sMsgBody = 'Function code is not valid';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;

ELSE;
	sFunc = DimensionElementPrincipalName(dmfunc,psFunc);
ENDIF;

#------Appropriation Item------#
IF( Dimix(dmItem, psItem) =0);
	sMsgBody = 'Appropriation Item does not exisit';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;


ELSEIF(Dtype(dmItem,psItem)@='C');
	sMsgBody = 'Appropriation code is not valid';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;
ELSE;
	sItem = DimensionElementPrincipalName(dmItem,psItem);
ENDIF;

#------Appropriation Type------#
sType = Subst(sItem,1,4); 

#------SPP------#
IF( Dimix(dmSPP, psSPP) =0);
	sMsgBody = 'SPP code does not exisit';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;

ELSEIF(Dtype(dmSPP,psSPP)@='C');
	sMsgBody = 'SPP code is not valid';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;
ELSE;
	sSPP = DimensionElementPrincipalName(dmSPP,psSPP);
ENDIF;

#------CBMS Program------#
IF( Dimix(dmProg, psCBMSProg) =0);
	sMsgBody = 'CBMS Program is not valid';	
	sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

	IF( sOldMsg @='');
		sMsg = sErrorPreFix | sMsgBody;
	ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
		sMsg = sOldMsg |' | ' | sMsgBody;
	ELSE;
		sMsg = sErrorPreFix | sMsgBody;
	ENDIF; 

	CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
	nValid = nValid +1;
ELSE;
	sCBMSProg = DimensionElementPrincipalName(dmProg,psCBMSProg);
ENDIF;

#------Control Type------#
sAConsol = 'Administered Programmes';
sDConsol = 'Departmental Programmes';
sSPPConsol = 'National Partnership Programmes';

IF(ELISANC(dmProg, sAConsol , psPar) =1);
	sControlType = 'Adminstered';
ELSEIF(ELISANC(dmProg, sDConsol , psPar) =1);
	sControlType = 'Departmental';
ELSEIF(ELISANC(dmProg, sSPPConsol , psPar) =1);
	sControlType = 'National Partnership';
ENDIF;



#nChd = ELCOMPN(dmProg, sPar);

#IF( nChd >0);
#	#Same as the first N child of the parenet
#	sEL = ELCOMP(dmProg,sPar,1);
#	sELType = Dtype( dmProg, sEL );  

#	IF( sELType @= 'N');
#		sCBMSProg = CellGetS( cbProg, curHLYear, curScenario, sEL, 'programme');
#	ELSE;
#		sNewProg = sEL;
#		WHILE (sElType @= 'C');
#			sNewProg = ELCOMP(dmProg, sNewProg, 1);
#			sElType = DTYPE(dmProg, sNewProg);
#		END;
#		sCBMSProg = CellGetS( cbProg, curHLYear, curScenario, sNewProg, 'programme');
#	ENDIF;
#ELSE;

#	sCBMSProg = Subst(psProgCode,1,4);

#ENDIF;
ENDIF;


IF( nValid =0);
	#-----DIMENSION Update------#
	DimensionElementInsertDirect(dmProg, '', psProgCode,psProgType);
	DimensionElementComponentAddDirect(dmProg, sPar,psProgCode,1);

	#-----ATTRIBUTE Update------#
	CellPutS( 	psProgDesc, cbEAProg, psProgCode,'description');
	CellPutS( 	psProgCode | ' - ' | psProgDesc, cbEAProg, psProgCode,'code and description');

	sNewAttr = 'sys_prog DIM maintenance'; 
	IF( DIMIX(cbEAProg, sNewAttr) =0);
		AttrInsert(dmProg, '', sNewAttr, 'S');	
	ENDIF;
	CellPutS('Y', cbEAProg,psProgCode,sNewAttr);

	#------Program Details Cube Update ------#
	sMeas = 'Programme';
	CellPutS(sCBMSProg, cbProg, curHLYear, curScenario, psProgCode, sMeas);
	
	sMeas = 'Function';
	CellPutS(sFunc, cbProg, curHLYear, curScenario, psProgCode, sMeas);

	sMeas = 'Outcome';
	CellPutS(sOC, cbProg, curHLYear, curScenario, psProgCode, sMeas);

	sMeas = 'Appropriation Type';
	CellPutS(sType, cbProg, curHLYear, curScenario,psProgCode, sMeas);

	sMeas = 'Appropriation Item';
	CellPutS(sItem, cbProg, curHLYear, curScenario, psProgCode, sMeas);

	sMeas = 'SPP';
	CellPutS(sSPP, cbProg, curHLYear, curScenario, psProgCode, sMeas);

	sMeas = 'Control Type';
	CellPutS(sControlType, cbProg, curHLYear, curScenario, psProgCode, sMeas);


	sMsg ='<' | psProgCode |' - ' | psProgDesc |  '>  has been successfully created in the Programme dimension.';	
	CellPutS(sMSg,cbClient, sUser, sClientMeas, sValid);

ELSE;

	ProcessError;
ENDIF;



