#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_AE_NewZeroID_10 - AE Grp Adj Cube - Create Archive View
#**** DESCRIPTION:       This process creates a view of the newly archived scenario in the adjustments cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 12/05/2014    KG             Initial Revision
#**** 2019	KG	  Updated for NEW GEUS
#***********************************************************************************************************************
#  

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GROUP ADJUSTMENT ENTRY CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbGrp = 'AE group adjustment entry';
dmAccType = 'account type';
dmAccTemp = 'account template';
dmGrpMeas = 'group adjustment measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#sView = '$NewBaseline';
#sSubset = sView;

#-------------------------------------------------------------------------------------------------------------------------------------------------------------
#*** STEP 1 - CLEAR CURRENT SCENARIO DATA ***#
#-------------------------------------------------------------------------------------------------------------------------------------------------------------
sView = '$GrpClear';
sSubset = sView;

sScenario = 'current';

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbGrp, sView);
SubsetDestroy(dmScenario, sSubset);

#****CREATE SUBSETS****#
# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);

#****BUILD VIEW****#
ViewCreate(cbGrp, sView);

ViewSubsetAssign(cbGrp, sView, dmScenario, sSubset);

ViewSetSkipZeroes(cbGrp, sView, 1);
ViewSetSkipCalcs(cbGrp, sView, 1);
ViewZeroOut(cbGrp, sView);

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbGrp, sView);
SubsetDestroy(dmScenario, sSubset);

#-------------------------------------------------------------------------------------------------------------------------------------------------------------
#*** STEP 2 - CREATE ARCHIVE VIEW
#-------------------------------------------------------------------------------------------------------------------------------------------------------------
sView = '$NewBaseline';
sSubset = sView;

sHLYear = ATTRS(dmVar, 'archive year', 'value');
sScenario = ATTRS(dmVar, 'archive scenario', 'value');
sStatus = 'Total approved';
sID = 'Total IDs';

#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbGrp, sView);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAccType, sSubset);
SUBSETDESTROY (dmAccTemp, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);
SUBSETDESTROY (dmGrpMeas, sSubset);


#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

# Status
SubsetCreate(dmStatus, sSubset);
SubsetElementInsert(dmStatus, sSubset, sStatus, 1);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# Account Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAccType | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# Account Template
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAccTemp | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# ID
SubsetCreate(dmID, sSubset);
SubsetElementInsert(dmID, sSubset, sID, 1);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# Period
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Group Measure
SubsetCreate(dmGrpMeas, sSubset);
SubsetElementInsert(dmGrpMeas, sSubset, 'value', 1);


#****BUILD VIEW****#
ViewCreate(cbGrp, sView);

ViewSubsetAssign(cbGrp, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbGrp, sView, dmScenario, sSubset);
ViewSubsetAssign(cbGrp, sView, dmStatus, sSubset);
ViewSubsetAssign(cbGrp, sView, dmRE, sSubset);
ViewSubsetAssign(cbGrp, sView, dmMeasCode, sSubset);
ViewSubsetAssign(cbGrp, sView, dmProg, sSubset);
ViewSubsetAssign(cbGrp, sView, dmAccType, sSubset);
ViewSubsetAssign(cbGrp, sView, dmAccTemp, sSubset);
ViewSubsetAssign(cbGrp, sView, dmID, sSubset);
ViewSubsetAssign(cbGrp, sView, dmJur, sSubset);
ViewSubsetAssign(cbGrp, sView, dmPer, sSubset);
ViewSubsetAssign(cbGrp, sView, dmGrpMeas, sSubset);

ViewExtractSkipZeroesSet (cbGrp, sView, 1);
ViewExtractSkipCalcsSet (cbGrp, sView, 0);
ViewExtractSkipRuleValuesSet (cbGrp, sView, 0);

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion