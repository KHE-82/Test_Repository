#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Rep Extract 01 - Populate Flags
#**** DESCRIPTION:       This process creates a view and adds a flag to the combination to be used for the 02 process
#****			
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 20/09/2017    KG             Initial Revision
#**** 24/01/2024   BL             Updated process for sys_Extract Report cube
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = sUser | ' $SysExtractRpt';
sSubset = sView;


CubeSetLogChanges(cbAE , 0);


#***********************************************************************************************************************
#**** STEP 1 - CLEAR TARGET VIEW
#**** 
#***********************************************************************************************************************
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);


#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# Headline Year
SUBSETCREATE (dmHLYear, sView);
SUBSETELEMENTINSERT (dmHLYear, sSubset, psHLYear, 1);

# Scenario
IF (psFullHLExtract @= 'N');
	SUBSETCREATE (dmScenario, sView);
	SUBSETELEMENTINSERT (dmScenario, sSubset, psScenario, 1);
ELSE;
	MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmScenario | '].[sys_BudgetRound]}, ALL, RECURSIVE )}, 0)}';
	SUBSETCREATEBYMDX (sSubset, MDX);
ENDIF;

# Status
#SUBSETCREATE (dmStatus, sView);
#SUBSETELEMENTINSERT (dmStatus, sSubset, 'data', 1);

# Period
MDX = '{[' | dmPer | '].[0000-0000],[' | dmPer | '].[P0]}';

SUBSETCREATEBYMDX (sSubset, MDX);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbAE, sView);

ViewSubsetAssign(cbAE, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbAE, sView, dmScenario, sSubset);
#ViewSubsetAssign(cbAE, sView, dmStatus, sSubset);
ViewSubsetAssign(cbAE, sView, dmPer, sSubset);

ViewZeroOut(cbAE, sView);

#***********************************************************************************************************************
#**** STEP 1 - CREATE SOURCE VIEW
#**** THIS PROCESS WILL CREATE A SOURCE VIEW
#***********************************************************************************************************************
#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);


#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# Headline Year
SUBSETCREATE (dmHLYear, sView);
SUBSETELEMENTINSERT (dmHLYear, sSubset, psHLYear, 1);

# Scenario

IF (psFullHLExtract @= 'N');
	SUBSETCREATE (dmScenario, sView);
	SUBSETELEMENTINSERT (dmScenario, sSubset, psScenario, 1);
ELSE;
	MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmScenario | '].[sys_BudgetRound]}, ALL, RECURSIVE )}, 0)}';
	SUBSETCREATEBYMDX (sSubset, MDX);
ENDIF;

# Status


IF( psExtractType @='Adjusted Base');
SUBSETCREATE (dmStatus, sView);
SUBSETELEMENTINSERT (dmStatus, sSubset, psStatus, 1);
ELSE;
MDX = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[' | dmStatus | '].[' | psStatus | ']}, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);
ENDIF;

# Outcome
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmOC | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Function
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Reason
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Appropriation Type
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmType | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Movement account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Appropriation item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmProg | '].[' | psProg | ']}, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAcc | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);

# ID
IF( psExtractType @='Adjusted Base');
	MDX = '{[id].[Total IDs]}';
ELSE;
	MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmID | '] )}, 0)}';
ENDIF;
SUBSETCREATEBYMDX (sSubset, MDX);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sSubset, MDX);


# Period
#MDX = '{{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")},[' | dmPer | '].[0000-0000]}';
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}, [' | dmPer | '].[type] = "annual")}';

SUBSETCREATEBYMDX (sSubset, MDX);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbAE, sView);

ViewSubsetAssign(cbAE, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbAE, sView, dmScenario, sSubset);
ViewSubsetAssign(cbAE, sView, dmStatus, sSubset);
ViewSubsetAssign(cbAE, sView, dmOC, sSubset);
ViewSubsetAssign(cbAE, sView, dmRE, sSubset);
ViewSubsetAssign(cbAE, sView, dmFunc, sSubset);
ViewSubsetAssign(cbAE, sView, dmReason, sSubset);
ViewSubsetAssign(cbAE, sView, dmSPP, sSubset);
ViewSubsetAssign(cbAE, sView, dmMeasCode, sSubset);
ViewSubsetAssign(cbAE, sView, dmType, sSubset);
ViewSubsetAssign(cbAE, sView, dmMA, sSubset);
ViewSubsetAssign(cbAE, sView, dmItem, sSubset);
ViewSubsetAssign(cbAE, sView, dmProg, sSubset);
ViewSubsetAssign(cbAE, sView, dmAcc, sSubset);
ViewSubsetAssign(cbAE, sView, dmID, sSubset);
ViewSubsetAssign(cbAE, sView, dmJur, sSubset);
ViewSubsetAssign(cbAE, sView, dmPer, sSubset);

ViewExtractSkipZeroesSet (cbAE, sView, 1);
ViewExtractSkipCalcsSet (cbAE, sView, 0);
ViewExtractSkipRuleValuesSet (cbAE, sView, 0);


lHeaderCounter = 0;
nCount=0;
nLine=0;
#---------------------------------------------------------------------------------------------------------------------------
#--- DEFINE DATA SOURCE
#---------------------------------------------------------------------------------------------------------------------------
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#******************************************************************************************************************
#*** POPULATE FLAG
#******************************************************************************************************************
#*** INSERT 1 FLAG AGAINST PERIOD "0000-0000" ON ALL N IDs  WITH STATUS  = DATA For BASE + ADJUSTMENTS
#*** INSERT 1 FLAG AGAINST PERIOD "0000-0000" ON 0000A  WITH STATUS  = DATA ID =  For ADJUSTED BASE

IF( psExtractType @='Adjusted Base');
	sID = '0000A';
	sStatus = 'Data';
ELSE;
	sID = vsID;
	sStatus = vsStatus;
ENDIF;
sPeriod = '0000-0000';

IF (vsScenario @= 'current' & vnValue<>0);

	IF (CELLISUPDATEABLE (cbAE, vsHLYear, vsScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, sPeriod ) = 1);
		CELLPUTN (1, cbAE, vsHLYear, vsScenario, sStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, sPeriod );
	ENDIF;
ELSE;
#	ITEMSKIP;
	IF (CELLISUPDATEABLE (cbAE, vsHLYear, vsScenario, 'data', vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, sPeriod ) = 1);
		CELLPUTN (1, cbAE, vsHLYear, vsScenario, 'data', vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, sID, vsJur, sPeriod );
	ENDIF;
ENDIF;

nCount=nCount+1;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);


#******************************************************************************************************************
#*** RUN ALL OTHER PROCESS TO UPDATE DATA BASE ON RULES
#*** RULE 01
#*** Rule 1 = Exclude agency 99 (all)
#******************************************************************************************************************

IF(psFullHLExtract @= 'N' % psFullHLExtract @= 'No');
	sProcess = 'AE_Rep Extract 02 - Load Data';
	sNewScenario = psScenario;
ELSE;

	#--------------------------------------------------------
	#--- Perform Full Headline Year Extract
	#--------------------------------------------------------
	#sProcess = 'AE_Rep Extract 02 - Load Full Headline Year';
	#sNewScenario = 'sys_BudgetRound';
ENDIF;

#EXECUTEPROCESS (sProcess ,'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', sNewScenario, 'psStatus', psStatus, 'psProg', psProg, 'psFullHLExtract', psFullHLExtract, 'psExtractType', psExtractType);




CubeSetLogChanges(cbAE , 1);
#endregion