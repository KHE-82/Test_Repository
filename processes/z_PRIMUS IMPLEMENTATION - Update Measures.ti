#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Archive_14 - AE Meas Details Cube_Create Current View
#**** DESCRIPTION:       This process copies data in the government measures details cube from the CURRENT scenario into the target scenario, after clearing the target scenario
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 12/05/2014    KG             Initial Revision
#****
#***********************************************************************************************************************


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE INDEX CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbIndex = 'index';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE CASHFLOW CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbCF= 'AE cash flow';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GOVERNMENT MEASURE CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbMeas = 'government measures';
dmMeasDet = 'measure details';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GOVERNMENT MEASURE DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbMeasDet = 'government measures details';
dmMeasDet = 'measure details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GROUP ADJUSTMENT ENTRY CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbGrp = 'AE group adjustment entry';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

sHLYear = ATTRS(dmVar, 'archive year', 'old value');
sScenario = ATTRS(dmVar, 'archive scenario', 'old value');
#sTargetHLYear = ATTRS(dmVar, 'archive year', 'value');
#sTargetScenario = ATTRS(dmVar, 'archive scenario', 'value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = '$PRIMUSMeasCode';
sSubset = sView;

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmScenario, sSubset);
SubsetDestroy(dmMeasCode, sSubset);

#****CREATE SUBSETS****#
#Scenario


# Measure
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [measure code] )}, 0)}, [measure code].[Non-Measure] = "")}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Scenario
MDX = '{ EXCEPT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[scenario].[sys_BudgetRound]}, ALL, RECURSIVE )}, 0)}, { [scenario].[current] }) }';
SUBSETCREATEBYMDX (sSubset, MDX);


#****BUILD VIEW****#
ViewCreate(cbMeasDet, sView);
ViewSubsetAssign(cbMeasDet, sView, dmScenario, sSubset);
ViewSubsetAssign(cbMeasDet, sView, dmMeasCode, sSubset);

ViewSetSkipZeroes(cbMeasDet, sView, 1);
ViewSetSkipCalcs(cbMeasDet, sView, 1);
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


sBudRoundCreated = ATTRS (dmMeasCode, vsMeasCode, 'Budget Round Created');
IF (sBudRoundCreated @= psTargetHLYear % sBudRoundCreated @= '');
	ITEMSKIP;
ENDIF;


IF (CELLISUPDATEABLE (cbMeasDet, psTargetHLYear, psTargetScenario, vsMeasCode, vsMeasure) = 1);
	IF (VALUE_IS_STRING=0);
		CellPutN(NVALUE, cbMeasDet, psTargetHLYear, psTargetScenario, vsMeasCode, vsMeasure);
	ELSE;
     		CellPutS(SVALUE, cbMeasDet, psTargetHLYear, psTargetScenario, vsMeasCode, vsMeasure);
	ENDIF;
ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbMeasDet, sView);
SubsetDestroy(dmMeasCode, sSubset);
#endregion