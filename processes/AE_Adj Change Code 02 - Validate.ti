#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               AE_Adj Change Code 02 - Validate
#**** DESCRIPTION:       This process validates the data entered by the user
#****			
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 10/09/2015    KG             Initial Revision
#**** 20/08/2020	KG	  Ensure that program gets sent and added
#**** 24/09/2020	KG	  Updated code for new control type attribute
#**** 2021	KG	  Updated control type/program validation checks
#**** MAR 2021	KG	  Updated to include comments
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#******************************************************************************************************************
#*** DECLARE AE ID DETAILS CUBE DIMENSIONS
#******************************************************************************************************************
cbID = 'AE id details';
dmIDMeas = 'id measure';


#-------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE
#-------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';
dmCtrlType = 'control type';
dmFavID = 'favourites_id';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sNoMeasCode = ATTRS(dmVar, 'No Measure Code', 'value');

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** VARIABLES USED 
#******************************************************************************************************************
sStatus = 'unauthorised';
sAdjType = 'Manual';

#*****************************************************************************************************************************************************
#**** STEP 1 - VALIDATE CURRENT DATA ENTRY 
#******************************************************************************************************************
#*** VALIDATION CHECK RESETS
#*** These validation checks are set to 0, to reset. 
#*** 0 means valid, Greater than 0, means it is invalid
#******************************************************************************************************************

sErrCtrlType = '';
sErrProg = '';
sErrReason = '';
sErrMeasCode = '';
sErrTitle = '';
sErrPublishedTitle = '';
sErrDesc = '';

sErrFavID = '';
sErrOC = '';
sErrFunc = '';
sErrSPP = '';
sErrType = '';
sErrItem = '';


#----------------------------------------------------------------------
#*** Clear validate rules
#----------------------------------------------------------------------
CELLPUTS (sErrCtrlType, cbClient, sUser, 'adj_control type', 'validate');
CELLPUTS (sErrProg, cbClient, sUser, 'adj_programme code', 'validate');
CELLPUTS (sErrReason, cbClient, sUser, 'adj_reason', 'validate');
CELLPUTS (sErrMeasCode, cbClient, sUser, 'adj_measure code', 'validate');
CELLPUTS (sErrTitle, cbClient, sUser, 'adj_title', 'validate');
CELLPUTS (sErrPublishedTitle, cbClient, sUser, 'adj_published title', 'validate');
CELLPUTS (sErrDesc, cbClient, sUser, 'adj_description', 'validate');

CELLPUTS (sErrFavID, cbClient, sUser, 'adj_favourite id', 'validate');
CELLPUTS (sErrOC, cbClient, sUser, 'adj_outcome', 'validate');
CELLPUTS (sErrFunc, cbClient, sUser, 'adj_function', 'validate');
CELLPUTS (sErrSPP, cbClient, sUser, 'adj_SPP', 'validate');
CELLPUTS (sErrType, cbClient, sUser, 'adj_appropriation type', 'validate');
CELLPUTS (sErrItem, cbClient, sUser, 'adj_appropriation item', 'validate');

#----------------------------------------------------------------------
#*** Reset Validation Counters
#----------------------------------------------------------------------
nCtrlTypeValid = 0;
nProgValid = 0;
nReasonValid = 0;
nMeasCodeValid = 0;
nTItleValid = 0;
nPublishedTitleValid = 0;
nDescValid = 0;

nFavIDValid = 0;
nOCValid = 0;
nFuncValid = 0;
nSPPValid = 0;
nTypeValid = 0;
nItemValid = 0;

nIDValid = 0;

#******************************************************************************************************************
#*** ENSURE ENTERED DATA IS POSTED
#******************************************************************************************************************


#******************************************************************************************************************
#*** GET ENTERED DATA 
#*** GET DATA FROM SYS CLIENT PREFERENCE CUBE
#******************************************************************************************************************
#*** OLD VALUES
sMeasure = 'old value';
sOldID = CELLGETS (cbClient, sUser, 'geus adj', sMeasure);
sOldStatus = CELLGETS (cbClient, sUser, 'adj_status', sMeasure);
sOldTItle = CELLGETS (cbClient, sUser, 'adj_title', sMeasure);
sOldDesc = CELLGETS (cbClient, sUser, 'adj_description', sMeasure);
sOldComments = CELLGETS (cbClient, sUser, 'adj_comments', sMeasure);
sOldPublishedTitle = CELLGETS (cbClient, sUser, 'adj_published title', sMeasure);
sOldProg = CELLGETS (cbClient, sUser, 'adj_programme code', sMeasure);
sOldControlType = CELLGETS (cbClient, sUser, 'adj_control type', sMeasure);
sOldReason = CELLGETS (cbClient, sUser, 'adj_reason', sMeasure);
sOldMeasCode = CELLGETS (cbClient, sUser, 'adj_measure code', sMeasure);
sOldFavID = CELLGETS (cbClient, sUser, 'adj_favourite id', sMeasure);
sOldOC = CELLGETS (cbClient, sUser, 'adj_outcome', sMeasure);
sOldFunc = CELLGETS (cbClient, sUser, 'adj_function', sMeasure);
sOldSPP = CELLGETS (cbClient, sUser, 'adj_spp', sMeasure);
sOldType = CELLGETS (cbClient, sUser, 'adj_appropriation type', sMeasure);
sOldItem = CELLGETS (cbClient, sUser, 'adj_appropriation item', sMeasure);
sOldFundLife = CELLGETS (cbClient, sUser, 'adj_fund life', sMeasure);
sOldEndDate = CELLGETS (cbClient, sUser, 'adj_end date', sMeasure);
sOldParam = CELLGETS (cbClient, sUser, 'adj_apply param', sMeasure);
sOldDisagreeCF = CELLGETS (cbClient, sUser, 'adj_disagree cash flow', sMeasure);

#*** CURRENT VALUES
sMeasure = 'value';
sID = CELLGETS (cbClient, sUser, 'geus adj', sMeasure);
sStatus = CELLGETS (cbClient, sUser, 'adj_status', sMeasure);
sTItle = CELLGETS (cbClient, sUser, 'adj_title', sMeasure);
sDesc = CELLGETS (cbClient, sUser, 'adj_description', sMeasure);
sComments = CELLGETS (cbClient, sUser, 'adj_comments', sMeasure);
sPublishedTitle = CELLGETS (cbClient, sUser, 'adj_published title', sMeasure);
#sProg = CELLGETS (cbClient, sUser, 'adj_programme code', sMeasure);

#-----------------------------------------------------------
#--- Added to ensure it use psProg Instead
#-----------------------------------------------------------
sProg = DIMENSIONELEMENTPRINCIPALNAME( dmProg, psProg);
CELLPUTS (sProg, cbClient, sUser, 'adj_programme code', sMeasure);

sControlType = CELLGETS (cbClient, sUser, 'adj_control type', sMeasure);
sReason = CELLGETS (cbClient, sUser, 'adj_reason', sMeasure);
#sMeasCode = CELLGETS (cbClient, sUser, 'adj_measure code', sMeasure);
sMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, psMeasCode);
CELLPUTS (sMeasCode, cbClient, sUser, 'adj_measure code', sMeasure);

sFavID = CELLGETS (cbClient, sUser, 'adj_favourite id', sMeasure);
sOC = CELLGETS (cbClient, sUser, 'adj_outcome', sMeasure);
sFunc = CELLGETS (cbClient, sUser, 'adj_function', sMeasure);
sSPP = CELLGETS (cbClient, sUser, 'adj_spp', sMeasure);
sType = CELLGETS (cbClient, sUser, 'adj_appropriation type', sMeasure);
sItem = CELLGETS (cbClient, sUser, 'adj_appropriation item', sMeasure);
sFundLife = CELLGETS (cbClient, sUser, 'adj_fund life', sMeasure);
sEndDate = CELLGETS (cbClient, sUser, 'adj_end date', sMeasure);
sParam = CELLGETS (cbClient, sUser, 'adj_apply param', sMeasure);
sDisagreeCF = CELLGETS (cbClient, sUser, 'adj_disagree cash flow', sMeasure);

#******************************************************************************************************************
#*** CONTROL TYPE
#*** Check if control type is valid
#******************************************************************************************************************

IF (DIMIX (dmCtrlType, sControlType) = 0);
	sErrCtrlType = 'Control Type selected does not exist';
	nCtrlTypeValid = nCtrlTypeValid + 1;
ENDIF;

#******************************************************************************************************************
#*** PROGRAMME 
#*** Check if this element exist
#******************************************************************************************************************
IF (DIMIX (dmProg, psProg) = 0);
	sErrProg = 'Programme Code selected does not exist';
	nProgValid = nProgValid + 1;
ELSE;

	#*****************************************************************************
	#**** CHECK IF PROGRAMME CODE IS A POSTING LEVEL (N) LEVEL ELEMENT
	#*****************************************************************************
	sProgType = DTYPE (dmProg, psProg);
	IF (sProgType @<> 'N');
		nProgValid = nProgValid + 1;
		sErrProg = 'Programme Code entered is not a Posting Level element';
	ELSE;	
		#*****************************************************************************
		#**** CHECK IF PROGRAMME HAS A CONTROL TYPE IN PROGRAMME DETAILS
		#*****************************************************************************
		sCheckProgCtrlType = CELLGETS (cbProg, curHLYear, curScenario, psProg, 'control type');

		sControlType = DIMENSIONELEMENTPRINCIPALNAME (dmCtrlType, sControlType);
		#-----------------------------------------------------------------------------------
		#--- Get control type attribute from selected control type to be used to store in ae id detail : SEP 2020
		#-----------------------------------------------------------------------------------
		sAttrControlType = ATTRS (dmCtrlType, sControlType, 'control type');
		IF (sAttrControlType @= '');
			sControlType = sControlType;
		ELSE;
			sControlType = sAttrControlType;
		ENDIF;

		IF (UPPER (sControlType) @<> UPPER (sCheckProgCtrlType));
			sErrProg = 'Current selected programme is not part of this hierarchy';
			nProgValid = nProgValid + 1;
		ENDIF;
	ENDIF;
ENDIF;

#******************************************************************************************************************
#*** MEASURE CODE
#*** Check if this element exist
#******************************************************************************************************************
IF (DIMIX (dmMeasCode, psMeasCode) = 0);
	sErrMeasCode = 'Measure Code selected does not exist';
	nMeasCodeValid = nMeasCodeValid + 1;
ELSE;

	#*****************************************************************************
	#**** CHECK IF MEASURE CODE IS A POSTING LEVEL (N) LEVEL ELEMENT
	#*****************************************************************************
	sMeasCodeType = DTYPE (dmMeasCode, psMeasCode);
	IF (sMeasCodeType @<> 'N');
		nMeasCodeValid = nMeasCodeValid + 1;
		sErrMeasCode = 'Measure Code entered is not a Posting Level element';
	ENDIF;
ENDIF;


#******************************************************************************************************************
#*** REASON CODE
#*** Certain reason codes require initiative codes and/or commonwealth grants
#*** These reason codes need to be checked to ensure they are in line
#******************************************************************************************************************
sReasMeasReq = ATTRS (dmReason, sReason, 'measure required');

#*** REASON CODE REQUIRES BOTH COMMONWEALTH GRANT & INITIATIVE CODE
IF (DIMIX (dmReason, sReason) = 0);
	nReasonValid = nReasonValid + 1;
	sErrReason = 'Reason Code selected does not exist';
ELSE;

	#******************************************************************************************************************
	#*** GET PRINCIPAL ELEMENT NAME FROM PARAMETERS
	#******************************************************************************************************************
	sMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, psMeasCode);

	#-------------------------------------------------------------------------------------
	#*** REASON CODE NEEDS A MEASURE CODE
	#-------------------------------------------------------------------------------------
	IF (UPPER(sReasMeasReq) @= 'Y' & sMeasCode @= sNoMeasCode);
		nReasonValid = nReasonValid + 1;
		sErrMeasCode = 'Please select a valid Measure Code';
		sErrReason = 'Reason code selected requires a valid Measure Code';
		nReasonValid = nReasonValid + 1;

	ELSE;
		#-------------------------------------------------------------------------------------
		#*** REASON CODE DOES NOT NEED AN INITIATIVE CODE
		#-------------------------------------------------------------------------------------
		IF (UPPER(sReasMeasReq) @<> 'Y' & sMeasCode @<> sNoMeasCode);
			sErrReason = 'Reason code selected does not require a Measure Code';
			sErrMeasCode = 'Please select No Measure for this reason code';
			nReasonValid = nReasonValid + 1;
		ENDIF;
	ENDIF;
ENDIF;

#******************************************************************************************************************
#*** ID
#*** OLD ID and CURRENT ID IS NOT THE SAME
#******************************************************************************************************************
IF (sID @<> sOldID);
	sErrID= 'This adjustment can not be edited as another adjustment is opened.';
	nIDSelValid = nIDValid + 1;
ELSE;

ENDIF;



#******************************************************************************************************************
#*** TITLE
#*** Title can not be blank or greater than 250 characters
#******************************************************************************************************************
IF (sTitle @= '');
	sErrTitle = 'Title can not be blank';
	nTitleValid = nTitleValid + 1;
ELSE;
	IF (LONG(sTitle) > 250);
		sErrTitle = 'Please review title as it has more than 250 characters long';
		nTitleValid = nTitleValid + 1;
	ENDIF;
ENDIF;

#******************************************************************************************************************
#*** DESCRIPTION
#*** Description can not be blank or greater than 250 characters
#******************************************************************************************************************
IF (sDesc @= '');
#	sErrDesc = 'Description can not be blank';
#	nDescValid = nDescValid + 1;
ELSE;
	IF (LONG(sDesc) > 250);
		sErrDesc = 'Please review the description as it has more than 250 characters long';
		nDescValid = nDescValid + 1;
	ENDIF;
ENDIF;


#******************************************************************************************************************
#*** PUBLISHED TITLE
#*** Published Title can not be blank or greater than 250 characters
#******************************************************************************************************************
IF (sPublishedTitle @= '');
	sErrPublishedTitle = 'Published Title can not be blank';
	nPublishedTitleValid = nPublishedTitleValid + 1;
ELSE;
	IF (LONG(sPublishedTitle) > 250);
		sErrPublishedTitle = 'Please review the Published Title as it has more than 250 characters long';
		nPublishedValid = nPublishedTitleValid + 1;
	ENDIF;
ENDIF;

#******************************************************************************************************************
#*** OUTCOME
#*** Check if this element exist
#******************************************************************************************************************
IF (DIMIX (dmOC, sOC) = 0);
	sErrOC = 'Outcome selected does not exist';
	nOCValid = nOCValid + 1;
ELSE;

	#*****************************************************************************
	#**** CHECK IF ELEMENT IS A POSTING LEVEL (N) LEVEL ELEMENT
	#*****************************************************************************
	sOCType = DTYPE (dmOC, sOC);
	IF (sOCType @<> 'N');
		nOCValid = nOCValid + 1;
		sErrOC = 'Outcome entered is not a Posting Level element';
	ENDIF;
ENDIF;


#******************************************************************************************************************
#*** FUNCTION
#*** Check if this element exist
#******************************************************************************************************************
IF (DIMIX (dmFunc, sFunc) = 0);
	sErrFunc = 'Function Code selected does not exist';
	nFuncValid = nFuncValid + 1;
ELSE;

	#*****************************************************************************
	#**** CHECK IF ELEMENT IS A POSTING LEVEL (N) LEVEL ELEMENT
	#*****************************************************************************
	sFuncType = DTYPE (dmFunc, sFunc);
	IF (sFuncType @<> 'N');
		nFuncValid = nFuncValid + 1;
		sErrFunc = 'Function Code entered is not a Posting Level element';
	ENDIF;
ENDIF;


#******************************************************************************************************************
#*** STEP 02 - PERFORM VALIDATION
#*** CALCULATE ALL VALIDATIONS
#******************************************************************************************************************

nIDValid = nCtrlTypeValid + nProgValid + nReasonValid + nMeasCodeValid + nTItleValid + nDescValid + nFavIDValid + nOCValid + nFuncValid;

IF (nIDValid > 0);

	#******************************************************************************************************************
	#*** VALIDATION FAILED
	#******************************************************************************************************************

	CELLPUTS (sErrCtrlType, cbClient, sUser, 'adj_control type', 'validate');
	CELLPUTS (sErrProg, cbClient, sUser, 'adj_programme code', 'validate');
	CELLPUTS (sErrReason, cbClient, sUser, 'adj_reason', 'validate');
	CELLPUTS (sErrMeasCode, cbClient, sUser, 'adj_measure code', 'validate');
	CELLPUTS (sErrTitle, cbClient, sUser, 'adj_title', 'validate');
	CELLPUTS (sErrDesc, cbClient, sUser, 'adj_description', 'validate');

	CELLPUTS (sErrFavID, cbClient, sUser, 'adj_favourite id', 'validate');
	CELLPUTS (sErrOC, cbClient, sUser, 'adj_outcome', 'validate');
	CELLPUTS (sErrFunc, cbClient, sUser, 'adj_function', 'validate');
	#CELLPUTS (sErrSPP, cbClient, sUser, 'adj_SPP', 'validate');
	#CELLPUTS (sErrType, cbClient, sUser, 'adj_appropriation type', 'validate');
	#CELLPUTS (sErrItem, cbClient, sUser, 'adj_appropriation item', 'validate');

	#******************************************************************************************************************
	#*** STOP PROCESS SINCE VALIDATION FAILED
	#******************************************************************************************************************

	PROCESSQUIT;

ELSE;

	#******************************************************************************************************************
	#*** VALIDATION PASSED
	#*** UPDATE AE ID DETAILS
	#*** CREATE SOURCE VIEW TO TRANSFER DATA TO NEW COMBINATIONS
	#******************************************************************************************************************

	#******************************************************************************************************************
	#*** GET PRINCIPAL ELEMENT NAME FROM PARAMETERS
	#******************************************************************************************************************

	sControlType = DIMENSIONELEMENTPRINCIPALNAME (dmCtrlType, sControlType);
	#-----------------------------------------------------------------------------------
	#--- Get control type attribute from selected control type to be used to store in ae id detail : SEP 2020
	#-----------------------------------------------------------------------------------
	sAttrControlType = ATTRS (dmCtrlType, sControlType, 'control type');
	IF (sAttrControlType @= '');
		sControlType = sControlType;
	ELSE;
		sControlType = sAttrControlType;
	ENDIF;

	sProg = DIMENSIONELEMENTPRINCIPALNAME (dmProg, psProg);
	sProgDesc = ATTRS (dmProg, sProg, 'code and description');
	sReason = DIMENSIONELEMENTPRINCIPALNAME (dmReason, sReason);
	#sReasonDesc = ATTRS (dmReason, sReason, 'CBMS');
	sMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, psMeasCode);

	sOC = DIMENSIONELEMENTPRINCIPALNAME (dmOC, sOC);
	sFunc = DIMENSIONELEMENTPRINCIPALNAME (dmFunc, sFunc);
	sSPP = DIMENSIONELEMENTPRINCIPALNAME (dmSPP, sSPP);
	sType = DIMENSIONELEMENTPRINCIPALNAME (dmType, sType);
	sItem = DIMENSIONELEMENTPRINCIPALNAME (dmItem, sItem);
	sFavID = DIMENSIONELEMENTPRINCIPALNAME (dmFavID, sFavID);


	#******************************************************************************************************************
	#*** POST METADATA OF ADJUSTMENT IN AE ID DETAIL
	#******************************************************************************************************************

	CELLPUTS (sControlType,  cbID, psHLYear, psScenario, psID, 'control type');

	CELLPUTS (sTItle, cbID, psHLYear, psScenario, psID, 'title');
	CELLPUTS (sDesc, cbID, psHLYear, psScenario, psID, 'description');
	CELLPUTS (sComments, cbID, psHLYear, psScenario, psID, 'comments');


	CELLPUTS (sProgDesc, cbID, psHLYear, psScenario, psID, snProg | ' description');
	CELLPUTS (sProg, cbID, psHLYear, psScenario, psID, snProg | ' code');

	CELLPUTS (sReason, cbID, psHLYear, psScenario, psID, 'reason');
	CELLPUTS (sMeasCode, cbID, psHLYear, psScenario, psID, 'measure');

	CELLPUTS (sOC, cbID, psHLYear, psScenario, psID, 'outcome');
	CELLPUTS (sFunc, cbID, psHLYear, psScenario, psID, 'function');
	#CELLPUTS (sSPP, cbID, psHLYear, psScenario, psID, 'SPP');
	#CELLPUTS (sType, cbID, psHLYear, psScenario, psID, 'appropriation type');
	#CELLPUTS (sItem, cbID, psHLYear, psScenario, psID, 'appropriation item');

	#CELLPUTS (sFavID,  cbID, psHLYear, psScenario, psID, 'account favourite template');

	#---------------------------------------------------------------------------------------------
	#--- OTHER FIELDS
	#---------------------------------------------------------------------------------------------
	sMeasFundLife = ATTRS (dmMeasCode, sMeasCode, 'Funding Life');
	IF (sMeasFundLife @= '');
		sMeasFundLife = 'ongoing';
	ENDIF;

	CELLPUTS (sMeasFundLife,  cbID, psHLYear, psScenario, psID, 'funding life');

	#---------------------------------------------------------------------------------------------
	#---GET UNIQUE NAME AND SEE IF WE NEED TO SEND AND TRANSFER DATA
	#---------------------------------------------------------------------------------------------
	sOldReason = DIMENSIONELEMENTPRINCIPALNAME (dmReason, sOldReason);
	sReason = DIMENSIONELEMENTPRINCIPALNAME (dmReason, sReason);

	sOldMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, sOldMeasCode);
	sMeasCode = DIMENSIONELEMENTPRINCIPALNAME (dmMeasCode, sMeasCode);
	


	sOldProg = DIMENSIONELEMENTPRINCIPALNAME (dmProg, sOldProg);
	sProg = DIMENSIONELEMENTPRINCIPALNAME (dmProg, sProg);

	sOldFunc = DIMENSIONELEMENTPRINCIPALNAME (dmFunc, sOldFunc);
	sFunc = DIMENSIONELEMENTPRINCIPALNAME (dmFunc, sFunc);

	sOldOC = DIMENSIONELEMENTPRINCIPALNAME (dmOC, sOldOC);
	sOC = DIMENSIONELEMENTPRINCIPALNAME (dmOC, sOC);


	#ASCIIOUTPUT ('changecode02.txt', sOldReason, sReason, sOldMeasCode, sMeasCode, sOldProg, sProg, sOldFunc, sFunc, sOldOC, sOC);
	IF (sOldReason @<> sReason % sOldMeasCode @<> sMeasCode % sOldProg @<> sProg % sOldFunc @<> sFunc % sOldOC @<> sOC);

		sProcess = 'AE_Adj Change Code 03 - Transfer Data';
		ASCIIOUTPUT ('changecode02b.txt', sOldReason, sReason, sOldMeasCode, sMeasCode, sOldProg, sProg, sOldFunc, sFunc, sOldOC, sOC, sProcess, psID);
		EXECUTEPROCESS(sProcess,  'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario, 'psID', psID );
	ENDIF;

ENDIF;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#******************************************************************************************************************
#*** NOW POPULATE OLD VALUE FOR CLIENT PREFERENCE USING NEW VALUES
#*** TO ENSURE VALIDATION IS CHECKED AGAIN IF USER DOES NOT LEAVE SCREEN
#******************************************************************************************************************

IF (nIDValid = 0);

	#******************************************************************************************************************
	#*** GET ENTERED DATA 
	#*** GET DATA FROM SYS CLIENT PREFERENCE CUBE
	#******************************************************************************************************************
	#*** OLD VALUES
	sMeasure = 'old value';
	sOldStatus = CELLGETS (cbClient, sUser, 'adj_status', sMeasure);
	sOldTItle = CELLGETS (cbClient, sUser, 'adj_title', sMeasure);
	sOldDesc = CELLGETS (cbClient, sUser, 'adj_description', sMeasure);
	sOldComments = CELLGETS (cbClient, sUser, 'adj_comments', sMeasure);
	sOldPublishedTitle = CELLGETS (cbClient, sUser, 'adj_published title', sMeasure);
	sOldProg = CELLGETS (cbClient, sUser, 'adj_programme code', sMeasure);
	sOldControlType = CELLGETS (cbClient, sUser, 'adj_control type', sMeasure);
	sOldReason = CELLGETS (cbClient, sUser, 'adj_reason', sMeasure);
	sOldMeasCode = CELLGETS (cbClient, sUser, 'adj_measure code', sMeasure);
	sOldFavID = CELLGETS (cbClient, sUser, 'adj_favourite id', sMeasure);
	sOldOC = CELLGETS (cbClient, sUser, 'adj_outcome', sMeasure);
	sOldFunc = CELLGETS (cbClient, sUser, 'adj_function', sMeasure);
	sOldSPP = CELLGETS (cbClient, sUser, 'adj_spp', sMeasure);
	sOldType = CELLGETS (cbClient, sUser, 'adj_appropriation type', sMeasure);
	sOldItem = CELLGETS (cbClient, sUser, 'adj_appropriation item', sMeasure);
	sOldFundLife = CELLGETS (cbClient, sUser, 'adj_fund life', sMeasure);
	sOldEndDate = CELLGETS (cbClient, sUser, 'adj_end date', sMeasure);
	sOldApplyParam = CELLGETS (cbClient, sUser, 'adj_apply param', sMeasure);
	sOldDisagreeCF = CELLGETS (cbClient, sUser, 'adj_disagree cash flow', sMeasure);

	#*** CURRENT VALUES
	sMeasure = 'value';
	sStatus = CELLGETS (cbClient, sUser, 'adj_status', sMeasure);
	sTItle = CELLGETS (cbClient, sUser, 'adj_title', sMeasure);
	sDesc = CELLGETS (cbClient, sUser, 'adj_description', sMeasure);
