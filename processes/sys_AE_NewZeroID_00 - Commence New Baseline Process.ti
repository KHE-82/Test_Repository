#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE_NewZeroID_00 - Commence New Baseline Process
#**** DESCRIPTION:       This process is the master that calls all other New Baseline Processes
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials      Comments
#****  ====              ======      =========
#****  2019	KG	Initiative Version
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE CLIENT GROUPS CUBE
#-------------------------------------------------------------------------------------------------------------
cbGroups = '}ClientGroups';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYS CLIENT FAVOURITE APPLICATION CUBE
#-------------------------------------------------------------------------------------------------------------
cbFavApp = 'sys_client favourite application';
dmApp = 'sys_application';
dmFavAppMeas = 'sys_client favourite application measure';


#------------------------------------------------------------------------
#--- Update System Process Administration Cube
#------------------------------------------------------------------------
cbProc = 'sys_process administration';
dmReturnProcCode = 'sys_process return codes';

#--------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#--------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** PERFORM ARCHIVE PROCESS
#******************************************************************************************************************
#----------------------------------------------------------------------------------------------------------
#--- Process - Clear Flags in sys_process management cube
#----------------------------------------------------------------------------------------------------------
sProcess = 'sys_Process Administration - Clear Flags';
IF (psRunClearFlag @= 'Y');
	EXECUTEPROCESS (sProcess);
ENDIF;
	
#--------------------------------------------------------------------------------------------------------------------------------------------------------
#--- Process 01 & 02 & 3 - AE Adjustment Cube Processes
#--------------------------------------------------------------------------------------------------------------------------------------------------------
sProcess = 'sys_AE_NewZeroID_01 - AE Adj Cube - Clear Current Data';
EXECUTEPROCESS (sProcess, 
	'psUser', psUser,
	'psSourceHLYear', psSourceHLYear,
	'psSourceScenario', psSourceScenario,
	'psTargetHLYear', psTargetHLYear,
	'psTargetScenario', psTargetScenario);


#----------------------------------------------------------------
#--- Run Process To Update System Process Cube
#----------------------------------------------------------------
NUMERICGLOBALVARIABLE ('ProcessReturnCode');
sProcessReturnCode = NUMBERTOSTRING(ProcessReturnCode);
sProcessReturnCodeDesc = ATTRS (dmReturnProcCode, sProcessReturnCode, 'description');

IF (ProcessReturnCode = ProcessExitNormal() );
	#-------------------------------------------------------------
	#--- Process Completed Successfully
	#-------------------------------------------------------------

	CELLPUTN (1, cbProc, sProcess, 'completed flag');
	CELLPUTS (sProcessReturnCode, cbProc, sProcess, 'error description');
	CELLPUTS ('SUCCESS', cbProc, sProcess, 'status flag');
ELSE;
	#-------------------------------------------------------------
	#--- Process Completed With Errors
	#-------------------------------------------------------------
	CELLPUTN (1, cbProc, sProcess, 'error flag');
	CELLPUTS (sProcessReturnCodeDesc, cbProc, sProcess, 'error description');
	CELLPUTS ('FAILED', cbProc, sProcess, 'status flag');

ENDIF;


