#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              z_MIgration - Transfer To Current 02 - Prog Details
#**** DESCRIPTION:       This process creates a view 
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 07/08/2017    KG             Initial Revision
#****
#***********************************************************************************************************************

snProg = 'programme';
cbCube = snProg | ' details';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';
dmMeas = snProg | ' measure';

sView = '$CBMSRTransferToCurrent';
sSubset = sView;
sCube = cbCube;

#------------------------------------------------------------------------------------------------------------------------------------------
#--- STEP 01 : CLEAR OUT TARGET SCENARIO
#------------------------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbCube, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmMeas, sSubset);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);

# Programme
MDX = '{TM1SUBSETALL( [' | dmProg | '] )}';
SUBSETCREATEBYMDX (sSubset, MDX);

# Measure
SubsetCreate(dmMeas, sSubset);
SubsetElementInsert(dmMeas, sSubset, 'appropriation type', 1);
SubsetElementInsert(dmMeas, sSubset, 'appropriation item', 2);

#****BUILD VIEW****#
ViewCreate(cbCube, sView);
ViewSubsetAssign(cbCube, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbCube, sView, dmScenario, sSubset);
ViewSubsetAssign(cbCube, sView, dmProg, sSubset);
ViewSubsetAssign(cbCube, sView, dmMeas, sSubset);

ViewExtractSkipZeroesSet (cbCube, sView, 1);
ViewExtractSkipCalcsSet (cbCube, sView, 0);
ViewExtractSkipRuleValuesSet (cbCube, sView, 0);

VIEWZEROOUT (cbCube, sView);

#------------------------------------------------------------------------------------------------------------------------------------------
#--- STEP 01 : CLEAR OUT TARGET SCENARIO
#------------------------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbCube, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);

#------------------------------------------------------------------------------------------------------------------------------------------
#--- STEP 02 : CREATE SOURCE VIEW
#------------------------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbCube, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);


#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psSourceHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psSourceScenario, 1);

#****BUILD VIEW****#
ViewCreate(cbCube, sView);
ViewSubsetAssign(cbCube, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbCube, sView, dmScenario, sSubset);
ViewSubsetAssign(cbCube, sView, dmProg, sSubset);
ViewSubsetAssign(cbCube, sView, dmMeas, sSubset);

ViewExtractSkipZeroesSet (cbCube, sView, 1);
ViewExtractSkipCalcsSet (cbCube, sView, 0);
ViewExtractSkipRuleValuesSet (cbCube, sView, 0);

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;


#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


IF (CELLISUPDATEABLE (cbCube, psTargetHLYear, psTargetScenario, vsProg, vsMeas) = 1);
	CELLPUTS (vsValue, cbCube, psTargetHLYear, psTargetScenario, vsProg, vsMeas);
ENDIF;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbCube, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmMeas, sSubset);
#endregion