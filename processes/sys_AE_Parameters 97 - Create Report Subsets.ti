#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:             sys_AE_Parameters 97 - Create Report Subsets

#*** DESCRIPTION:       This process will create a subset for programmes selected for generating WCI or ED
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 28/04/2014    KG             Initial Revision
#**** 2019	KG	  Updated for GEUS PRIMUS
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CALCULATION CUBE
#---------------------------------------------------------------------------------------------------------------------------
cbFE3 = 'AE parameters and FE3 calculation';
dmFE3Meas = 'AE parameters and FE3 calculation measure';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';
dmProgMeas = snProg | ' measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

curHLYear = ATTRS(dmVar, 'headline year', 'value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sNoMeasCode = ATTRS(dmVar, 'No Measure Code', 'value');
sNewReason = ATTRS(dmVar, 'FE3 Reason Code', 'value');

#---------------------------------------------------------------------------------------------------------------------------
#--- SUBSETS USED FOR PRINT REPORT
#---------------------------------------------------------------------------------------------------------------------------
sProgSubset = 'sysRep_RecoWBAdj';
IF (SUBSETEXISTS (dmProg, sProgSubset) = 0);
	SUBSETCREATE (dmProg, sProgSubset);
	SUBSETELEMENTINSERT (dmProg, sProgSubset, 'cash flow', 1);
ELSE;
	SUBSETDELETEALLELEMENTS (dmProg, sProgSubset);
	SUBSETELEMENTINSERT (dmProg, sProgSubset, 'cash flow', 1);
ENDIF;

SUBSETALIASSET (dmProg, sProgSubset, 'description');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = sUser | '_$FE397';
sMeas = 'Generate parameter pack';

#***********************************************************************************************************************
#--- STEP 1 - CREATE SOURCE VIEW
#***********************************************************************************************************************
#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbProg, sView);

SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmProg, sView);
SUBSETDESTROY (dmProgMeas, sView);

#---------------------------------------------------------------------------------------------------------------------------
#*** CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------

# Headine Year
SUBSETCREATE (dmHLYear, sView);
SUBSETELEMENTINSERT (dmHLYear, sView, curHLYear, 1);

# Scenario
SUBSETCREATE (dmScenario, sView);
SUBSETELEMENTINSERT (dmScenario, sView, curScenario, 1);

# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmProg | '].[' | psProg | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Programme Measure
SubsetCreate(dmProgMeas, sView);
SubsetElementInsert(dmProgMeas, sView, sMeas, 1);

#---------------------------------------------------------------------------------------------------------------------------
#---- BUILD VIEW 
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate (cbProg, sView);
ViewSubsetAssign (cbProg, sView, dmHLYear, sView);
ViewSubsetAssign (cbProg, sView, dmScenario, sView);
ViewSubsetAssign (cbProg, sView, dmProg, sView);
ViewSubsetAssign (cbProg, sView, dmProgMeas, sView);

ViewExtractSkipZeroesSet (cbProg, sView, 1);
ViewExtractSkipCalcsSet (cbProg, sView, 1);
ViewExtractSkipRuleValuesSet (cbProg, sView, 1);

#---------------------------------------------------------------------------------------------------------------------------
#--- DEFINE DATA SOURCE
#---------------------------------------------------------------------------------------------------------------------------
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#---------------------------------------------------------------------------------------------------------------------------
#--- ADD ELEMENTS TO SUBSET
#---------------------------------------------------------------------------------------------------------------------------
sActive = ATTRS (dmProg, vsProg, 'disabled');
IF (sActive @= 'Y');
	ASCIIOUTPUT ('checkprogram.txt', vsProg);
	ITEMSKIP;


ELSE;
	SUBSETELEMENTINSERT (dmProg, sProgSubset, vsProg, 1);
ENDIF;

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbProg, sView);

SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmProg, sView);
SUBSETDESTROY (dmProgMeas, sView);

#endregion