#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_ME Upload 01 - Validate
#**** DESCRIPTION:       This process loads the generic geus ME Upload Template
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 16/05/2022    KG             Initial Revision
#***********************************************************************************************************************


#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#******************************************************************************************************************
#*** DECLARE MONTHLY ESTIMATES CUBE
#******************************************************************************************************************
cbMAMap = 'ME mapping';
cbProgDetails = 'programme details';

cbME = 'ME reporting';
dmMEMeas = 'ME reporting measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#*****************************************************************************
#*** DECLARE SYSTEM VARIABLES
#*****************************************************************************
cbMEVar = 'sys_ME variable';
dmVar = 'variables'; 

curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');

sImpFilePath = ATTRS(dmVar, 'sys_ImpFileExceptionLogs', ' value');


#--------------------------------------------------------------------------------------------------------------------------
#*** DIMENSION ATTRIBUTES
#--------------------------------------------------------------------------------------------------------------------------
dmReasonAttr = '}ElementAttributes_reason';
dmAccAttr = '}ElementAttributes_account';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';
dmProgMeas = snProg | ' measure';

#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

ATTRPUTS ('PASS', dmVar, 'sys_ImpFileValidation', 'value');

# **** GET DATE VALUES ***#
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 
sHNow = TimST (Now, '\h');
sMinNow = TimST (Now, '\i');
sSNow = TimST (Now, '\s');
 
sDay = TRIM(SUBST(sDNow, 1,2));
 
IF (LONG (sDay) = 1);
	sDay = '0' | sDay;
ELSE;
     	sDay = sDay;
ENDIF;
 
sMonth = TRIM(SUBST(sMNow, 1,2));
 
IF (LONG (sMonth) = 1);
     	sMonth = '0' | sMonth;
ELSE;
     	sMonth = sMonth;
ENDIF;
 
sYear = TRIM(SUBST(sYNow, 1,4));
sNow = sYear | sMonth | sDay | sHNow | sMinNow | sSNow ;
 
 
sOutputFile = 'ME GEUS upload file failed' | sUser | ' ' | sNow | '.csv';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAM SUBSET USED
#---------------------------------------------------------------------------------------------------------------------------
sProgSubset = sUser | ' ME Clear Program';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';
cbMEVar = 'sys_ME variable';

##Deprecated Function - CubeSetLogChanges in Tm1V12
#CubeSetLogChanges(cbME, 0);

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE STATIC VARIABLES
#---------------------------------------------------------------------------------------------------------------------------
sTargetID = '00001';
sMEMeas = 'value';


#*****************************************************************************
#***** COUNTERS USED
#*****************************************************************************
lHeaderCount = 0;
nLine = 1;
nValid = 0;
nTotalValid = 0;


#*************************************************************************************************************************************#
#**** STEP 1 - CLEAR SELECTED PROGRAMS
#*************************************************************************************************************************************#
sMEView = sUser | '_$MEClearProfiles';

#---------------------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbME, sMEView);
SUBSETDESTROY (dmHLYear, sMEView);
SUBSETDESTROY (dmScenario, sMEView);
SUBSETDESTROY (dmRE, sMEView);
SUBSETDESTROY (dmSPP, sMEView);
SUBSETDESTROY (dmMA, sMEView);
SUBSETDESTROY (dmProg, sMEView);
SUBSETDESTROY (dmItem, sMEView);
SUBSETDESTROY (dmAcc, sMEView);
SUBSETDESTROY (dmID, sMEView);
SUBSETDESTROY (dmJur, sMEView);
SUBSETDESTROY (dmPer, sMEView);
SUBSETDESTROY (dmMEMeas, sMEView);


#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sMEView);
SubsetElementInsert(dmHLYear, sMEView, psHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sMEView);
SubsetElementInsert(dmScenario, sMEView, psScenario, 1);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sMEView, MDX);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sMEView, MDX);

# Movement Account
MDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}, [' | dmMA |'].[editable] = "")}';
SUBSETCREATEBYMDX (sMEView, MDX);

# Program : Currently Using Subset from Process 01
#MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {' | dmProg | '].[' | psProg | ']}, ALL, RECURSIVE )}, 0)}';
#SUBSETCREATEBYMDX (sMEView, MDX);


# Item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sMEView, MDX);

# Account
MDX = '{{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmAcc | '].[9000130]}, ALL, RECURSIVE )}, 0)},{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmAcc | '].[3800001]}, ALL, RECURSIVE )}, 0)},{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmAcc | '].[9000003]}, ALL, RECURSIVE )}, 0)}} ';
SUBSETCREATEBYMDX (sMEView, MDX);

# ID

SubsetCreate(dmID, sMEView);
SubsetElementInsert(dmID, sMEView, sTargetID, 1);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sMEView, MDX);

# Month
#MDX = '{ EXCEPT( {FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer |'] )}, 0)}, [' | dmPer |'].[type] = "nMonth")}, { [' | dmPer |'].[P00] }) }';
MDX = '{ EXCEPT( {FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer |'] )}, 0)}, [' | dmPer |'].[type] = "Month")}, { [' | dmPer |'].[P0] }) }';
SUBSETCREATEBYMDX (sMEView, MDX);

# ME Measure
SubsetCreate(dmMEMEas, sMEView);
SubsetElementInsert(dmMEMEas, sMEView, sMEMeas, 1);


#*** BUILD VIEW ***#
VIEWCREATE (cbME, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmHLYear, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmScenario, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmRE, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmSPP, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmMA, sMEView);
#VIEWSUBSETASSIGN (cbME, sMEView, dmProg, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmProg, sProgSubset);
VIEWSUBSETASSIGN (cbME, sMEView, dmItem, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmAcc, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmID, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmJur, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmPer, sMEView);
VIEWSUBSETASSIGN (cbME, sMEView, dmMEMEas, sMEView);

# *** DEFINE VIEW EXTRACT
ViewExtractSkipZeroesSet(cbME, sMEView, 1);
ViewSuppressZeroesSet(cbME, sMEView, 1);
ViewExtractSkipCalcsSet(cbME, sMEView, 0);
ViewExtractSkipRuleValuesSet (cbME, sMEView, 0);

# *** ZERO OUT CUBE
VIEWZEROOUT (cbME, sMEView);

#---------------------------------------------------------------------------------------------------------------------------
#*** DELETE EXISTING VIEWS AND SUBSETS ***#
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbME, sMEView);
SUBSETDESTROY (dmHLYear, sMEView);
SUBSETDESTROY (dmScenario, sMEView);
SUBSETDESTROY (dmRE, sMEView);
SUBSETDESTROY (dmSPP, sMEView);
SUBSETDESTROY (dmMA, sMEView);
SUBSETDESTROY (dmProg, sMEView);
SUBSETDESTROY (dmProg, sProgSubset);
SUBSETDESTROY (dmItem, sMEView);
SUBSETDESTROY (dmAcc, sMEView);
SUBSETDESTROY (dmID, sMEView);
SUBSETDESTROY (dmJur, sMEView);
SUBSETDESTROY (dmPer, sMEView);
SUBSETDESTROY (dmMEMeas, sMEView);


#*****************************************************************************
#*** IDENTIFY SOURCE FILE
#*****************************************************************************
sFilePath = ATTRS (dmVar, 'sys_Upload directory', 'value');

sFileName = sFilePath | psFile;

#*****************************************************************************
#***** DATASOURCE VARIABLES
#*****************************************************************************
DATASOURCENAMEFORSERVER = sFileName;

#******************************************************************************************************************
#*** COUNTERS AND MONTHS
#******************************************************************************************************************
lHeaderCounter = 0;
sMonth01 = 'Jul';
sMonth02 = 'Aug';
sMonth03 = 'Sep';
sMonth04 = 'Oct';
sMonth05 = 'Nov';
sMonth06 = 'Dec';
sMonth07 = 'Jan';
sMonth08 = 'Feb';
sMonth09 = 'Mar';
sMonth10 = 'Apr';
sMonth11 = 'May';
sMonth12 = 'Jun';

nMonthCounter = 1;
nLastMonthCounter = 11;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****



#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


#------20221117 CHANGE ONLY USE CODE------#
IF(DIMIX(dmAcc,vsAcc)=0);
	vsAcc = TRIM(SUBST(vsAcc,1,7));
ENDIF;

IF( DIMIX(dmRE,vsRE) =0);
	vsRE = TRIM(SUBST(vsRE,1,5));
ENDIF;

IF(DIMIX(dmMA,vsMA) =0);
	vsMA = TRIM(SUBST(vsMA,1,4));
ENDIF;
#*****************************************************************************
# SKIP CERTAIN ACCOUNTS
#*****************************************************************************
IF (vsAcc @= '3322001' % vsAcc @= '2330008' % vsAcc @= '2330009' % vsAcc @= '3322002' % vsAcc @= '9000510' % vsAcc @= '9000515' % vsAcc @= '9000520' % vsAcc @= '9000525');
	ITEMSKIP;
ENDIF;

#*************************************************************************************************************************************#
#**** DEFAULT ACCOUNTS ****#
#*************************************************************************************************************************************#

# Get movement account element
IF (vsMA @= '');
	vsMA = '-';
ELSE;
	vsMA = vsMA;
ENDIF;

# Get related entity element
IF (vsRE @= '');
	vsRE = '-';
ELSE;
	vsRE = vsRE;
ENDIF;

# Get SPP element
IF (vsSPP @= '');
	vsSPP = '-';
ELSE;
	vsSPP = vsSPP;
ENDIF;

# Get jurisdiction element
IF (vsJur @= '');
	vsJur = '-';
ELSE;
	vsJur = vsJur;
ENDIF;

# Get Appropriation Item Element
IF (vsItem @= '');
	vsItem = '-';
ELSE;
	vsItem = vsItem;
ENDIF;


#******************************************************************************************************************
#*** POST DATA 
#******************************************************************************************************************
nMonthCounter = 1;
WHILE (nMonthCounter <= nLastMonthCounter);
	IF (nMonthCounter = 1);
		sMonth = 'Jul';
		nValue = ROUNDP (vnJul,0);
	ELSEIF(nMonthCounter = 2);
		sMonth = 'Aug';
		nValue = ROUNDP (vnAug,0);
	ELSEIF(nMonthCounter = 3);
		sMonth = 'Sep';
		nValue = ROUNDP (vnSep,0);
	ELSEIF(nMonthCounter = 4);
		sMonth = 'Oct';
		nValue = ROUNDP (vnOct,0);
	ELSEIF(nMonthCounter = 5);
		sMonth = 'Nov';
		nValue = ROUNDP (vnNov,0);
	ELSEIF(nMonthCounter = 6);
		sMonth = 'Dec';
		nValue = ROUNDP (vnDec,0);
	ELSEIF(nMonthCounter = 7);
		sMonth = 'Jan';
		nValue = ROUNDP (vnJan,0);
	ELSEIF(nMonthCounter = 8);
		sMonth = 'Feb';
		nValue = ROUNDP (vnFeb,0);
	ELSEIF(nMonthCounter = 9);
		sMonth = 'Mar';
		nValue = ROUNDP (vnMar,0);
	ELSEIF(nMonthCounter = 10);
		sMonth = 'Apr';
		nValue = ROUNDP (vnApr,0);
	ELSEIF(nMonthCounter = 11);
		sMonth = 'May';
		nValue = ROUNDP (vnMay,0);
	ELSEIF(nMonthCounter = 12);
		sMonth = 'Jun';
		nValue = ROUNDP (vnJun,0);
	ENDIF;

	#----------------------------------------------
	#---- IDENTIFY MONTH IF IT IS LOCKED
	#----------------------------------------------
	sMonthLock = ATTRS (dmPer, sMonth, 'me phasing lock');

	#----------------------------------------------
	#---- POST DATA
	#----------------------------------------------
	IF (sMonthLock @= '');
		IF (CELLISUPDATEABLE (cbME, psHLYear, psScenario, vsRE, vsSPP, vsMA, vsProg, vsItem, vsAcc, sTargetID, vsJur, sMonth, sMEMeas) = 1);
			CELLINCREMENTN (nValue, cbME, psHLYear, psScenario, vsRE, vsSPP, vsMA, vsProg, vsItem, vsAcc, sTargetID, vsJur, sMonth, sMEMeas);
		ENDIF;
	ENDIF;

	nMonthCounter = nMonthCounter + 1;
END;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*****************************************************************************
#**** SKIP LINE IF DIMENSIONS ARENT VALID 
#*****************************************************************************

IF (nTotalValid > 0);
	CELLPUTS ('FAIL', cbClient, sUser,  'sys_ImpFileValidation', 'value');
	PROCESSERROR;
ELSE;
	CELLPUTS ('PASS', cbClient, sUser, 'sys_ImpFileValidation', 'value');
	#sProcess = 'sys_ME Upload - Upload 02';

	#---------------------------------------------------------------------------------
	#--- VALIDATION CHECKS TO MAKE SURE PROCESS 02 RUNS SUCCESSFULLY
	#---------------------------------------------------------------------------------
	#RETURN_VALUE = EXECUTEPROCESS(sProcess, 'psUser', sUser, 'psHLYear', psHLYear, 'psScenario', psScenario,  'psFile', psFile);

	#----------------------------------------------------------
	#--- CHECK RETURN VALUE OF PROCESS
	#--- CREATE OUTPUT FILE TO SAY PROCESS 02 HAS FAILED
	#----------------------------------------------------------
	#IF (RETURN_VALUE <> ProcessExitNormal());
	#	CELLPUTS ('WARNING', cbClient, sUser,  'sys_ImpFileValidation', 'value');
	#ENDIF;

ENDIF;

#endregion