#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#*********************************************************************************************************************
#**** PROCESS:               sys_Program Dimension Update - Upload 03 - Update Original Dimension
#**** DESCRIPTION:       This process will 
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date	Initials	Comments
#****  ====              ======    =========
#**** 15/08/2023     EC           Initial Revision
#***********************************************************************************************************************

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE
#-------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';
cbEAProg = '}ElementAttributes_'|snProg;
#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYS APPLICATION CUBE
#-------------------------------------------------------------------------------------------------------------
cbApp = 'sys_application';


#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYS CLIENT FAVOURITE APPLICATION CUBE
#-------------------------------------------------------------------------------------------------------------
cbFavApp = 'sys_client favourite application';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE ID DETAILS CUBE DIMENSIONS
#-------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS
#-------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
#dmClients = '}Clients';
cbEAVar = '}ElementAttributes_variables';

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#******************************************************************************************************************
#*** DECLARE CLIENT GROUPS CUBE
#******************************************************************************************************************
cbGroups = '}ClientGroups';


#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');
sCurUser = TM1User();

#--------------------------------------------------------------------------------------------------------
#--- CHECK IF CBMS-R IS LIVE : New Code 08 August 2017 - KG
#--------------------------------------------------------------------------------------------------------
sCBMSRLive = ATTRS (dmVar, 'sys_CBMSR GoLive', 'value');
sCBMSRLiveHLYear = ATTRS (dmVar, 'sys_CBMSR GoLive Headline Year', 'value');
sCBMSRMigrationScenario = 'CBMS-R OBAL';

#--------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#--------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sSubset  = sUser | '_$EditView';
sAEView = sUser | '_$EditView';

sVarUpLoad = 'sys_upload directory';

#******************************************************************************************************************
# **** GET DATE VALUES AND POST USER AND DATE STAMP
#******************************************************************************************************************
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 
sHNow = TimST( Now, '\h');
sMNow = TimST( Now, '\i');
sSNow = TimST( Now, '\s');

sDay = TRIM(SUBST(sDNow, 1,2));

IF (LONG (sDay) = 1);
	sDay = '0' | sDay;
ELSE;
	sDay = sDay;
ENDIF;

sMonth = TRIM(SUBST(sMNow, 1,2));

IF (LONG (sMonth) = 1);
	sMonth = '0' | sMonth;
ELSE;
	sMonth = sMonth;
ENDIF;

sYear = TRIM(SUBST(sYNow, 1,4));
sNow = sDay | '/' | sMonth | '/' | sYear;
sNow = sYNow | sMNow | sDNow | sHNow| sMNow | sSNow; 

nTime = 1;

#-------------------------------------------------------------------------------------------------------------
#*** Validation on Parameters 
#-------------------------------------------------------------------------------------------------------------
nValid =0;

sClientMeas = 'geus programme';
sValid = 'validate';
sErrorPreFix= 'Error : ';

CellPutS( '', cbClient, sUser, sClientMeas, sValid);

#-------------------------------------------------------------------------------------------------------------
#*** Create Source in Temp Dimension
#-------------------------------------------------------------------------------------------------------------

dmTemp = '}temp_' | sUser;
cbEATemp = '}ElementAttributes_'| dmTemp;


SubsetDestroy(dmTemp,sSubSet);
MDX = '{TM1SUBSETALL( [' | dmTemp | '] )}';
SUBSETCREATEBYMDX (sSubset, MDX);
SUBSETMDXSET (dmTemp, sSubset, '');

DATASOURCENAMEFORSERVER = dmTemp;
DATASOURCETYPE = 'Subset';
DATASOURCEDIMENSIONSUBSET = sSubset;



#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#------Deal with Elements in Alternative Hierarchy-----#
sAltSuff = '_Alt';
nAltSuff = Scan(sAltSuff,vsEL);

IF(nAltSuff <>0);
	vsEL = SubSt(vsEL,1,nAltSuff-1);
ENDIF;

sConsolAlt = 'sys_unused elements';

IF( DIMIX(psDim, sConsolAlt) =0);
	DimensionElementInsert(psDim, '', sConsolAlt,'C');
ENDIF;

sPar = CellGetS(cbEATemp,vsEL, 'sys_Parent');

sType = CellGetS(cbEATemp,vsEL, 'sys_type');

IF(sType @='C');
		
	IF( DTYPE(psDim, vsEL) @='N');
		sMsgBody = vsEL | ' is a N level element and cannot be re-classified as C level element';

		sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

		IF( sOldMsg @='');
			sMsg = sErrorPreFix | sMsgBody;
		ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
			sMsg = sOldMsg |' | ' | sMsgBody;
		ELSE;
			sMsg = sErrorPreFix | sMsgBody;
		ENDIF; 

		CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 	
		
		nValid= nValid+1;
	ENDIF;
ENDIF;



IF(sType @='');

	IF( DTYPE(psDim, vsEL) @='C');

		sMsgBody = vsEL | ' is a C level element and cannot be re-classified as N level element';

		sOldMsg = CellGetS(cbClient, sUser, sClientMeas, sValid);

		IF( sOldMsg @='');
			sMsg = sErrorPreFix | sMsgBody;
		ELSEIF(scan(sErrorPreFix,sOldMsg) <>0);
			sMsg = sOldMsg |' | ' | sMsgBody;
		ELSE;
			sMsg = sErrorPreFix | sMsgBody;
		ENDIF; 

		CellPutS( sMsg,cbClient, sUser, sClientMeas, sValid); 
	
		nValid= nValid+1;

	ENDIF;
ENDIF;

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

IF( nValid <>0);
	ProcessQuit;
ENDIF;

#endregion