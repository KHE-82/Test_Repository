#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_AE_Parameters 01 - Transfer to Calculation Cube
#**** DESCRIPTION:       This process creates a view of the newly archived scenario in the adjustments cube
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 12/05/2014    KG             Initial Revision
#**** 2019	KG	Update for NEW GEUS
#***********************************************************************************************************************
#  

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CALCULATION CUBE
#---------------------------------------------------------------------------------------------------------------------------
cbFE3 = 'AE parameters and FE3 calculation';
dmFE3Meas = 'AE parameters and FE3 calculation measure';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------

curHLYear = ATTRS(dmVar, 'headline year', 'value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;


sView = sUser | '_$ParamCalcTransfer';
sSubset = sView;


#******************************************************************************************************************
#*** DECLARE VARIABLES USED FOR VIEWS
#******************************************************************************************************************
sStatus = 'Total approved';
sReason = 'Total reason';
sOC = 'Total outcomes';
sFunc = 'Total functions';
sType = 'Total approp types';
sID = 'Total IDs';

#******************************************************************************************************************
#*** DEFAULT POSTING DATA
#******************************************************************************************************************
sNewStatus = 'data';
sPostStatus = 'unuthorised';
sManualCF = '';
sAdjType = 'Generated';
sFE3Meas = 'original value';
sFE3ApplyMeas = 'original value to apply parameter';


#----------------------------------------------------------
#--- GET Periods to transfer data
#----------------------------------------------------------
sRBPeriod = DIMNM(dmPer,DIMIX(dmPer, psFE3Year) - 4);
sNBPeriod = DIMNM(dmPer,DIMIX(dmPer, psFE3Year) -3);
sFE1Period = DIMNM(dmPer,DIMIX(dmPer, psFE3Year) -2);
sFE2Period = psFE2Year;
sFE3Period = psFE3Year;


#***********************************************************************************************************************
#***********************************************************************************************************************
#*** STEP 1 - DELETE DATA FROM AE FE3 CALCULATION CUBE
#***********************************************************************************************************************
#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbFE3, sView);
VIEWDESTROY (cbAE, sView);

SUBSETDESTROY (dmProg, sView);
SUBSETDESTROY (dmSPP, sView);
SUBSETDESTROY (dmAcc, sView);
SUBSETDESTROY (dmMA, sView);
SUBSETDESTROY (dmRE, sView);
SUBSETDESTROY (dmJur, sView);
SUBSETDESTROY (dmItem, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmID, sView);
SUBSETDESTROY (dmPer, sView);
SUBSETDESTROY (dmFE3Meas, sView);

#---------------------------------------------------------------------------------------------------------------------------
#*** CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------

# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmProg | '].[' | psProg | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);
SUBSETMDXSET (dmProg, sView, MDX);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);


# Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAcc | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Movement account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Appropriation item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# ID
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmID | '] )}, 0)}';
MDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmID | '].[' | psID | '] }, ALL, RECURSIVE )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Period
SUBSETCREATE (dmPer, sView);
SUBSETELEMENTINSERT (dmPer, sView, sRBPeriod, 1);
SUBSETELEMENTINSERT (dmPer, sView, sNBPeriod, 2);
SUBSETELEMENTINSERT (dmPer, sView, sFE1Period, 3);
SUBSETELEMENTINSERT (dmPer, sView, sFE2Period, 4);
SUBSETELEMENTINSERT (dmPer, sView, sFE3Period, 5);

# Measure
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFE3Meas | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);


#---------------------------------------------------------------------------------------------------------------------------
#*** CREATE VIEW
#---------------------------------------------------------------------------------------------------------------------------
VIEWCREATE (cbFE3, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmProg, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmSPP, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmAcc, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmMA, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmRE, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmJur, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmItem, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmMeasCode, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmID, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmPer, sView);
VIEWSUBSETASSIGN (cbFE3, sView, dmFE3Meas, sView);

ViewExtractSkipZeroesSet (cbFE3, sView, 1);
ViewExtractSkipCalcsSet (cbFE3, sView, 1);
ViewExtractSkipRuleValuesSet (cbFE3, sView, 1);

#---------------------------------------------------------------------------------------------------------------------------
#*** ZERO OUT CUBE
#---------------------------------------------------------------------------------------------------------------------------
VIEWZEROOUT (cbFE3, sView);


#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbFE3, sView);
SUBSETDESTROY (dmProg, sView);
SUBSETDESTROY (dmSPP, sView);
SUBSETDESTROY (dmAcc, sView);
SUBSETDESTROY (dmMA, sView);
SUBSETDESTROY (dmRE, sView);
SUBSETDESTROY (dmJur, sView);
SUBSETDESTROY (dmItem, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmPer, sView);
SUBSETDESTROY (dmFE3Meas, sView);




#***********************************************************************************************************************
#--- STEP 1 - CREATE SOURCE VIEW
#***********************************************************************************************************************
#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmStatus, sView);
SUBSETDESTROY (dmOC, sView);
SUBSETDESTROY (dmRE, sView);
SUBSETDESTROY (dmFunc, sView);
SUBSETDESTROY (dmReason, sView);
SUBSETDESTROY (dmSPP, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmType, sView);
SUBSETDESTROY (dmMA, sView);
SUBSETDESTROY (dmItem, sView);
SUBSETDESTROY (dmProg, sView);
SUBSETDESTROY (dmAcc, sView);
SUBSETDESTROY (dmID, sView);
SUBSETDESTROY (dmJur, sView);
SUBSETDESTROY (dmPer, sView);


#---------------------------------------------------------------------------------------------------------------------------
#****CREATE SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
# headline year
SubsetCreate(dmHLYear, sView);
SubsetElementInsert(dmHLYear, sView, curHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sView);
SubsetElementInsert(dmScenario, sView, curScenario, 1);

# Status
SubsetCreate(dmStatus, sView);
SubsetElementInsert(dmStatus, sView, sStatus, 1);


# Outcome
SubsetCreate(dmOC, sView);
SubsetElementInsert(dmOC, sView, sOC, 1);

# Related Entity
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmRE | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Function
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmFunc | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Reason
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmReason | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# SPP
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmSPP | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Measure Code
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMeasCode | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Appropriation Type
SubsetCreate(dmType, sView);
SubsetElementInsert(dmType, sView, sType, 1);

# Movement account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmMA | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Appropriation item
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmItem | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Programme
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmProg | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Account
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAcc | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# ID
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmID | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);

# Jurisdiction
MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmJur | '] )}, 0)}';
SUBSETCREATEBYMDX (sView, MDX);


# Period
#MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmPer | '] )}, 0)}';
#SUBSETCREATEBYMDX (sView, MDX);

# Period
SUBSETCREATE (dmPer, sView);
SUBSETELEMENTINSERT (dmPer, sView, sRBPeriod, 1);
SUBSETELEMENTINSERT (dmPer, sView, sNBPeriod, 2);
SUBSETELEMENTINSERT (dmPer, sView, sFE1Period, 3);
SUBSETELEMENTINSERT (dmPer, sView, sFE2Period, 4);
SUBSETELEMENTINSERT (dmPer, sView, sFE3Period, 5);

#---------------------------------------------------------------------------------------------------------------------------
#****BUILD VIEW
#---------------------------------------------------------------------------------------------------------------------------
ViewCreate(cbAE, sView);

ViewSubsetAssign(cbAE, sView, dmHLYear, sView);
ViewSubsetAssign(cbAE, sView, dmScenario, sView);
ViewSubsetAssign(cbAE, sView, dmStatus, sView);
ViewSubsetAssign(cbAE, sView, dmOC, sView);
ViewSubsetAssign(cbAE, sView, dmRE, sView);
ViewSubsetAssign(cbAE, sView, dmFunc, sView);
ViewSubsetAssign(cbAE, sView, dmReason, sView);
ViewSubsetAssign(cbAE, sView, dmSPP, sView);
ViewSubsetAssign(cbAE, sView, dmMeasCode, sView);
ViewSubsetAssign(cbAE, sView, dmType, sView);
ViewSubsetAssign(cbAE, sView, dmMA, sView);
ViewSubsetAssign(cbAE, sView, dmItem, sView);
ViewSubsetAssign(cbAE, sView, dmProg, sView);
ViewSubsetAssign(cbAE, sView, dmAcc, sView);
ViewSubsetAssign(cbAE, sView, dmID, sView);
ViewSubsetAssign(cbAE, sView, dmJur, sView);
ViewSubsetAssign(cbAE, sView, dmPer, sView);

ViewExtractSkipZeroesSet (cbAE, sView, 1);
ViewExtractSkipCalcsSet (cbAE, sView, 0);
ViewExtractSkipRuleValuesSet (cbAE, sView, 0);

#---------------------------------------------------------------------------------------------------------------------------
#--- DEFINE DATA SOURCE
#---------------------------------------------------------------------------------------------------------------------------
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


nNewValue = ROUNDP (vnValue, 0);

IF (CELLISUPDATEABLE (cbFE3, vsProg, vsSPP, vsAcc, vsMA, vsRE, vsJur, vsItem, vsMeasCode, vsID, vsPeriod, sFE3Meas) = 1);

	CELLPUTN (nNewValue, cbFE3, vsProg, vsSPP, vsAcc, vsMA, vsRE, vsJur, vsItem, vsMeasCode, vsID, vsPeriod, sFE3Meas);
ENDIF;


#---------------------------------------------------------------------------------------------
#--- Load Data For ID's required for indexation
#---------------------------------------------------------------------------------------------
sIDParamCheck = CELLGETS (cbID, vsHLYear, vsScenario, vsID, 'apply parameters');
IF (sIDParamCheck @= 'Y');
	IF (CELLISUPDATEABLE (cbFE3, vsProg, vsSPP, vsAcc, vsMA, vsRE, vsJur, vsItem, vsMeasCode, vsID, vsPeriod, sFE3ApplyMeas) = 1);
	#	CELLPUTN (nNewValue, cbFE3, vsProg, vsSPP, vsAcc, vsMA, vsRE, vsJur, vsItem, vsMeasCode, vsID, vsPeriod, sFE3ApplyMeas);
	ENDIF;
ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****



#---------------------------------------------------------------------------------------------------------------------------
#****DELETE EXISTING VIEWS AND SUBSETS
#---------------------------------------------------------------------------------------------------------------------------
VIEWDESTROY (cbAE, sView);
SUBSETDESTROY (dmHLYear, sView);
SUBSETDESTROY (dmScenario, sView);
SUBSETDESTROY (dmStatus, sView);
SUBSETDESTROY (dmOC, sView);
SUBSETDESTROY (dmRE, sView);
SUBSETDESTROY (dmFunc, sView);
SUBSETDESTROY (dmReason, sView);
SUBSETDESTROY (dmSPP, sView);
SUBSETDESTROY (dmMeasCode, sView);
SUBSETDESTROY (dmType, sView);
SUBSETDESTROY (dmMA, sView);
SUBSETDESTROY (dmItem, sView);
SUBSETDESTROY (dmProg, sView);
SUBSETDESTROY (dmAcc, sView);
SUBSETDESTROY (dmID, sView);
SUBSETDESTROY (dmJur, sView);
SUBSETDESTROY (dmPer, sView);

#endregion