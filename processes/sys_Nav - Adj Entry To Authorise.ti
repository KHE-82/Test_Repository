#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_Nav - Adj Entry To Authorise
#**** DESCRIPTION:       This process is used for TM1 Web to navigate from View Adj to Financials/Data Entry
#****
#****		          
#****                                
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 2019    KG             Initial Revision
#**** 03/02/2021	KG	  Updated procoess to send to Group Adjustments
#***********************************************************************************************************************

#******************************************************************************************************************
#*** DECLARE CLIENT PREFRENCE CUBES & DIMENSIONS
#******************************************************************************************************************
cbClientPick = '}PickList_sys_client preference';
cbClient = 'sys_client preference';
dmClient = '}Clients';
dmClientPref = 'sys_client preference';
dmClientMeas = 'sys_client preference measure';
dmClientPickMeas = '}PickList';

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS 
#-------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

#******************************************************************************************************************
#*** DECLARE AE ID DETAILS
#******************************************************************************************************************
cbID = 'AE id details';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmID = 'id';
dmIDMeas = 'id measure';

#******************************************************************************************************************
#*** DECLARE CLIENT GROUPS CUBE
#******************************************************************************************************************
cbGroups = '}ClientGroups';
dmGroups = '}Groups';


#******************************************************************************************************************
#*** DECLARE SYSTEM VARIABLES CUBE AND DIMENSIONS
#******************************************************************************************************************
dmVar = 'variables';

#--------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#--------------------------------------------------------------------------------------------------------
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');


#******************************************************************************************************************
#*** IDENTIFY CURRENT USER
#******************************************************************************************************************
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** STOP PROCESS IF ID IS BLANK
#******************************************************************************************************************
IF (psID @= '');
	PROCESSQUIT;
ENDIF;

#******************************************************************************************************************
#******************************************************************************************************************
#*** UPDATE USER ID AND SELECTED HLYEAR AND SCENARIO AND ALL OTHER DETAILS
#*** 
#******************************************************************************************************************
#******************************************************************************************************************

# Headline Year
#CELLPUTS (psHLYear, cbClient, sUser, 'geus hlyear', 'value');

# Scenario
#CELLPUTS (psScenario, cbClient, sUser, 'geus scenario', 'value');

# ID
sSelID = CELLGETS (cbClient, sUser, 'geus adj', 'value');
#--------------------------------------------------------------------
#--- PASTE CURRENT ID TO OLD VALUE FOR VALIDATION CHECKS
#--------------------------------------------------------------------
CELLPUTS (sSelID, cbClient, sUser, 'geus adj', 'old value');


#******************************************************************************************************************
#*** EXECUTE PROCESS TO CLEAR CLIENT PREFERENCE VALIDATIONS
#******************************************************************************************************************
sProcess = 'sys_Client - Clear Validation Data';
EXECUTEPROCESS (sProcess);


#******************************************************************************************************************
#*** EXECUTE PROCESS FOR CLIENT PREFERENCE PICK LIST
#******************************************************************************************************************
sProcess = 'sys_Client - Update Client Prefrence Picklists';
EXECUTEPROCESS (sProcess, 'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario);

#******************************************************************************************************************
#*** SEND DATA ON GROUP ADJ
#******************************************************************************************************************
sAdjType = CELLGETS (cbID, psHLYear, psScenario, psID, 'Adjustment Type');
sStatus = CELLGETS (cbID, psHLYear, psScenario, psID, 'status');
IF (sAdjType @= 'Group');
	IF (psHLYear @= curHLYear & psScenario @= curScenario);
		IF (sStatus @= 'draft' % sStatus @= 'unauthorised' % sStatus @= 'submitted' % sStatus @= 'unbalanced');
			sProcess = 'AE_GrpAdj_SendtoAdj';
			EXECUTEPROCESS (sProcess, 'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario, 'psID', psID);
		ENDIF;
	ENDIF;
ENDIF;




#endregion
