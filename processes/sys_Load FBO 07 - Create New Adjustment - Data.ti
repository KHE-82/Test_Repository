#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:              sys_Load FBO 07 - Create New Adjustment - Data
#**** DESCRIPTION:       
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** July  2023           EC             Initial Revision
#**** 22/08/2024	KG	   Updated Program Outcome to get from Program details rather from source
#****
#***********************************************************************************************************************

#*** DECLARE CUBES AND DIMENSIONS ***#
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

cbID = 'ae id details';

cbProg = snProg | ' details';
dmProg = snProg;

#-------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS
#-------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClient = '}Clients';
cbClient = 'sys_client preference';

dmClient = '}Clients';
dmVar = 'variables'; 
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');


sCube = cbAE;

sHLYear = ATTRS ('variables', 'headline year', 'value');
sScenario = 'current';
sNewReason = '1040';
sNewStatus = 'Data';
sMeasureIDDet = 'Used';
sSrcProgID = 'progtrf_SrcProgID';

#sSourceStatus = 'Total approved';
sSourceStatus = 'data';
#sSourceID = 'Total IDs';
sSourceID = '00FBO';
sSourceReason = 'Total reason';
sSourceMeasCode = 'Total Measures';
sSourceAcc = '3800001';
sSourceMA = 'Total movement';

sSourceType = 'Total approp types';
sSourceItem = 'Total approp item';

sTargetStatus = 'data';
sTargetID = '00FBO';
sTargetReason = 'Other variations not elsewhere defined';
sTargetMeasCode = 'M00000';
sTargetAcc = '4100001';
sTargetMA = '7205';

nStartPerIndex = DIMIX (dmPer, psPeriod);
nChd = ELCOMPN(dmPer, 'Total years');
sLastPer = ELCOMP(dmPer, 'Total years', nChd);
nLastPerIndex = DIMIX (dmPer, sLastPer);

sImpFilePath = ATTRS(dmVar, 'sys_CBMS Upload Directory', ' value');

#--------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#--------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClient, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

#******************************************************************************************************************
#*** DATE TIMESTAMPS
#******************************************************************************************************************
sDNow = TimST( Now, '\D'); 
sMNow = TimST( Now, '\m'); 
sYNow = TimST( Now, '\Y'); 
sHNow = TimST (Now, '\h');
sMinNow = TimST (Now, '\i');
sSNow = TimST (Now, '\s');
 
sDay = TRIM(SUBST(sDNow, 1,2));
 
IF (LONG (sDay) = 1);
     sDay = '0' | sDay;
ELSE;
     sDay = sDay;
ENDIF;
 
sMonth = TRIM(SUBST(sMNow, 1,2));
 
IF (LONG (sMonth) = 1);
     sMonth = '0' | sMonth;
ELSE;
     sMonth = sMonth;
ENDIF;
 
sYear = TRIM(SUBST(sYNow, 1,4));
 
sNow = sYear | sMonth | sDay | sHNow | sMinNow | sSNow ;

sPrc = GetProcessName();
sView = sUser | ' - FBO Adj' ;
sSubset = sView;

#------VIEW SHOULD ALREADY EXIST FROM PREVIOUS TI------#

ViewExtractSkipZeroesSet (sCube, sView, 1);
ViewExtractSkipCalcsSet (sCube, sView, 0);
ViewExtractSkipRuleValuesSet (sCube, sView, 0);

DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;

#------------------------------------------------------------------------------------------------------------------------------------------
#---  CREATE TEMP DIM - IDENTIFY NUMBER OF NEW IDs 
#------------------------------------------------------------------------------------------------------------------------------------------
dmTmpID = 'tmp_ID_' |  sUser;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#** FIND NEXT AVAILABLE ID (IF REQUIRED)
#sIDProg = vsProg|vsOC|vsAppropType|vsAppropItem|vsFunc|vsSPP;
#sIDProg = vsProg|vsOC|vsFunc;
sIDProg = vsProg|vsOC;
sNewID = ATTRS (dmTmpID, sIDProg, 'ID');

sProgOC = CELLGETS (cbProg, sHLYear, sScenario, vsProg, 'outcome');
sProgFunc = CELLGETS (cbProg, sHLYear, sScenario, vsProg, 'function');

sProgType = CELLGETS (cbProg, sHLYear, sScenario, vsProg, 'appropriation type');
sProgItem = CELLGETS (cbProg, sHLYear, sScenario, vsProg, 'appropriation item');


#**** TEST IF WE NEED A NEW ID
IF (sNewID @= '');

     # GET A NEW ID
      sNewID = '00000' | TRIM(STR(CELLGETN (cbID, sHLYear, sScenario, 'Total IDs', sMeasureIDDet) + 1, 5, 0));
      sNewID = SUBST (sNewID, LONG (sNewID) - 4, 5);

      ATTRPUTS (sNewID, dmTmpID, sIDProg, 'ID');
      ATTRPUTS (vsProg, dmTmpID, sIDProg , 'Program');
      ATTRPUTS (vsType, dmTmpID, sIDProg, 'Appropriation Type');
      ATTRPUTS (vsFunc, dmTmpID, sIDProg , 'Function');

     #**** GET THE ADJUSTMENT TITLE AND DESCRIPTION (BOTH THE SAME)
     # sNewTitle = sTitle | '(' | sID | ')';

     # LOCK IN THE ID
     CellPutN (1, cbID, sHLYear, sScenario, sNewID, sMeasureIDDet);
	
     # POPULATE ID DETAILS CUBE

     sProgUni = DIMENSIONELEMENTPRINCIPALNAME (snProg, vsProg);
     CellPutS (sProgUni, cbID, sHLYear, sScenario, sNewID, 'programme code');
     CellPutS (ATTRS (snProg, vsProg, 'code and description'), cbID, sHLYear, sScenario, sNewID, 'programme description');
     sProgDescription = ATTRS (snProg, vsProg, 'description');
     sDescription = sProgDescription|' - FBO Adjustment';


     CellPutS (sDescription, cbID, sHLYear, sScenario, sNewID, 'title');
     CellPutS ('(' | sNewID | ') ' | sDescription, cbID, sHLYear, sScenario, sNewID, 'description');
     CellPutS ('unauthorised', cbID, sHLYear, sScenario, sNewID, 'status');	
     CellPutS (sNewReason, cbID, sHLYear, sScenario, sNewID, 'reason');
     CellPutS (sProgOC, cbID, sHLYear, sScenario, sNewID, 'outcome');
     CellPutS (sProgFunc, cbID, sHLYear, sScenario, sNewID, 'function');
     CellPutS (vsSPP, cbID, sHLYear, sScenario, sNewID, 'spp');
#     CellPutS (vsItem, cbID, sHLYear, sScenario, sNewID, 'appropriation item');
#     CellPutS (vsType, cbID, sHLYear, sScenario, sNewID, 'appropriation type');

     CellPutS (sProgItem, cbID, sHLYear, sScenario, sNewID, 'appropriation item');
     CellPutS (sProgType, cbID, sHLYear, sScenario, sNewID, 'appropriation type');


     CellPutS (vsMeasCode, cbID, sHLYear, sScenario, sNewID, 'measure');
     CellPutS ('ongoing', cbID, sHLYear, sScenario, sNewID, 'funding life');
    #CellPutS ('', cbID, sHLYear, sScenario, sNewID, 'disagree cashflow');
     CellPutS ('Y', cbID, sHLYear, sScenario, sNewID, 'disagree cashflow');
     CellPutS ('Manual', cbID, sHLYear, sScenario, sNewID, 'Adjustment Type');

     IF(ELISANC(dmProg, 'Administered Programmes', vsProg)=1);
	sControlType = 'Administered';
     ELSEIF(ELISANC(dmProg, 'Departmental Programmes', vsProg)=1);
	sControlType = 'Departmental';
     ELSE;
	sControlType = 'N/A';
     ENDIF;
		 
     CellPutS (sControlType, cbID, sHLYear, sScenario, sNewID, 'Control Type');
     CELLPUTS(sUser, cbID, sHLYear, sScenario, sNewID, 'Created By');

     # **** GET DATE VALUES ***#
     sDNow = TimST( Now, '\D'); 
     sMNow = TimST( Now, '\m'); 
     sYNow = TimST( Now, '\Y'); 

     sDay = TRIM(SUBST(sDNow, 1,2));

     IF (LONG (sDay) = 1);
          sDay = '0' | sDay;
     ELSE;
          sDay = sDay;
     ENDIF;

     sMonth = TRIM(SUBST(sMNow, 1,2));

     IF (LONG (sMonth) = 1);
          sMonth = '0' | sMonth;
     ELSE;
          sMonth = sMonth;
     ENDIF;

     sYear = TRIM(SUBST(sYNow, 1,4));

     sNow = sDay | '/' | sMonth | '/' | sYear;

     CELLPUTS(sNow, cbID, sHLYear, sScenario, sNewID, 'created date');
     CELLPUTS ('Y', cbID, sHLYear, sScenario, sNewID, 'use new cash flow derivation');
ENDIF;

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#** FIND NEXT AVAILABLE ID (IF REQUIRED)
#sIDProg = vsProg|vsOC|vsAppropType|vsAppropItem|vsFunc|vsSPP;
#sIDProg = vsProg|vsOC|vsFunc;
sIDProg = vsProg|vsOC;
sID = ATTRS (dmTmpID, sIDProg, 'ID');


sProgOC = CELLGETS (cbProg, sHLYear, sScenario, vsProg, 'outcome');
sProgFunc = CELLGETS (cbProg, sHLYear, sScenario, vsProg, 'function');

sProgType = CELLGETS (cbProg, sHLYear, sScenario, vsProg, 'appropriation type');
sProgItem = CELLGETS (cbProg, sHLYear, sScenario, vsProg, 'appropriation item');

IF (vsItem @= '-');
	sNewType = 'A010';
	sNewItem = 'A010-00014-01436';
ELSE;
	sNewType = sProgType;
	sNewItem = sProgItem;
ENDIF;

IF (psProg @= 'Departmental Programmes' % psProg @= '1083');
	sNewProg = vsProg | '.01.01';
ELSE;
	sNewProg = vsProg;
ENDIF;

#------Move Opening Bal------#
IF( vsMA @='7211');
	vsMA =' 7205';
ENDIF;

#-----For MOG - Adjustment Opening Balances----#
IF( vsMA @='7131');
                vsMA = '7141';
ENDIF;

IF( vsMA @='7161');
                vsMA = '7165';
ENDIF;

IF( vsMA @='7331');
                vsMA = '7341';
ENDIF;

IF( vsMA @='7361');
                vsMA = '7365';
ENDIF;


IF( vsAcc @='3240101');
                vsAcc = '3240106';
ENDIF;

IF( vsAcc @='6100001');
                vsAcc = '6900002 - Account impacts requiring manual adjustment in cash flow';
ENDIF;

IF (CELLISUPDATEABLE (cbAE, sHLYear, sScenario, sNewStatus, sProgOC, vsRE, sProgFunc, sNewReason, vsSPP, vsMeasCode, sProgType, vsMA, sProgItem, sNewProg, vsAcc, sID, vsJur, vsPeriod) = 1);
	CELLINCREMENTN(vnValue, cbAE, sHLYear, sScenario, sNewStatus, sProgOC, vsRE, sProgFunc, sNewReason, vsSPP,vsMeasCode,  sProgType, vsMA, sProgItem, sNewProg, vsAcc, sID, vsJur, vsPeriod);
	ASCIIOUTPUT ('adjustmentloadfbo.csv', NUMBERTOSTRING (vnValue), cbAE, sHLYear, sScenario, sNewStatus, sProgOC, vsRE, sProgFunc, sNewReason, vsSPP,vsMeasCode,  sProgType, vsMA, sProgItem, sNewProg, vsAcc, sID, vsJur, vsPeriod);
ENDIF;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

IF (1=1);
#****DELETE EXISTING VIEWS AND SUBSETS
VIEWDESTROY (cbAE, sSubset);
SUBSETDESTROY (dmHLYear, sSubset);
SUBSETDESTROY (dmScenario, sSubset);
SUBSETDESTROY (dmStatus, sSubset);
SUBSETDESTROY (dmOC, sSubset);
SUBSETDESTROY (dmRE, sSubset);
SUBSETDESTROY (dmFunc, sSubset);
SUBSETDESTROY (dmReason, sSubset);
SUBSETDESTROY (dmSPP, sSubset);
SUBSETDESTROY (dmMeasCode, sSubset);
SUBSETDESTROY (dmType, sSubset);
SUBSETDESTROY (dmMA, sSubset);
SUBSETDESTROY (dmItem, sSubset);
SUBSETDESTROY (dmProg, sSubset);
SUBSETDESTROY (dmAcc, sSubset);
SUBSETDESTROY (dmID, sSubset);
SUBSETDESTROY (dmJur, sSubset);
SUBSETDESTROY (dmPer, sSubset);
ENDIF;

#endregion