#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_Rep Extract 01 - Populate Flags
#**** DESCRIPTION:       This process creates a view and adds a flag to the combination to be used for the 02 process
#****			
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 20/09/2017    KG             Initial Revision
#**** 24/01/2024   BL             Updated process for sys_Extract Report cube
#**** 06/11/2024	KG	 Added Max Row in Variables
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';

cbClient = 'sys_client preference';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYS_EXTRACT REPORT CUBE***#
#---------------------------------------------------------------------------------------------------------------------------
cbSXR = 'sys_Extract Report';
dmRowID ='row id';
dmSXRMeas = 'sys_report extract measure';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

sMaxRow = ATTRS (dmVar, 'sys_rep extract max rows', 'value');
nMaxVarRow = STRINGTONUMBER (sMaxRow);
IF (nMaxVarRow = 0);
	nMaxRow = 5000;
ELSE;
	nMaxRow = nMaxVarRow;
ENDIF;


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = SUBST(sUser, lScan, 9);
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = sUser | ' $SysExtractRpt';
sSubset = sView;
CellPutS( '',cbClient, sUser, 'rep_programme','validate');



CubeSetLogChanges(cbSXR , 0);


#******************************************************************************************************************
#**** STEP 1 - RUN POPULATE FLAGS
#******************************************************************************************************************
sPrc= 'AE_Rep Extract 01 - Populate Flags';
EXECUTEPROCESS (sPrc ,'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario, 'psStatus', psStatus, 'psProg', psProg, 'psFullHLExtract', psFullHLExtract, 'psExtractType', psExtractType);


sPrc= 'AE_Rep Extract 98 - Load Counter Flag';
EXECUTEPROCESS (sPrc ,'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario, 'psStatus', psStatus, 'psProg', psProg, 'psFullHLExtract', psFullHLExtract, 'psExtractType', psExtractType);

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#---------------------------------------------------------------------------------------------------------------------------
#****Validation 
#---------------------------------------------------------------------------------------------------------------------------
sPer = '0000-0000';
sRow = 'Total Rows';

nCount = CELLGETN ( cbSXR, psUSer, psHLYear, psScenario, sRow, sPer, 'Counter');

IF (nCount>=nMaxRow);
	sMsg = 'Error: This extract has reached the maxium row limit (' | NumberTostring(nMaxRow) | '). It is estimated to require ' | numbertostring(nCount)|  ' rows. Please re-select the paramters and try again.';
	ASCIIOUTPUT ('checkmsg.txt', sMsg, sUser);
	CELLPUTS( sMsg,cbClient, sUser, 'rep_programme','validate');
	PROCESSQUIT;

ELSE;

	IF(psFullHLExtract @= 'N' % psFullHLExtract @= 'No');
		sProcess = 'AE_Rep Extract 02 - Load Data';
		sNewScenario = psScenario;
	ENDIF;

	EXECUTEPROCESS (sProcess ,'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', sNewScenario, 'psStatus', psStatus, 'psProg', psProg, 'psFullHLExtract', psFullHLExtract, 'psExtractType', psExtractType);

ENDIF;


#******************************************************************************************************************
#*** RUN ALL OTHER PROCESS TO UPDATE DATA BASE ON RULES
#*** RULE 01
#*** Rule 1 = Exclude agency 99 (all)
#******************************************************************************************************************
#sPrc= 'AE_Rep Extract 01 - Populate Flags';
#EXECUTEPROCESS (sPrc ,'psUser', psUser, 'psHLYear', psHLYear, 'psScenario', psScenario, 'psStatus', psStatus, 'psProg', psProg, 'psFullHLExtract', psFullHLExtract, 'psExtractType', psExtractType);





CubeSetLogChanges(cbSXR , 1);
#endregion