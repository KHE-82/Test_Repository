	CellPutN(OldP00 + NP00, sCube, sHLYear, sScenario, sStatus, sNewOC, vsRE, sNewFunc, vsReason, vsSPP, vsMeasCode, sNewType, vsMA, sNewItem, sProg, vsAcc, sID, vsJur, Period00);
