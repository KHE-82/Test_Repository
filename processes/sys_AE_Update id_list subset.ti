#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE_Update id_list subset - Updates the subset used for id list spreadsheet
#**** DESCRIPTION:       This process will update the subset MDX used for the id listing spreadsheet
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 19/11/2013    KG             Initial Revision
#**** 16/07/2014	KG	  Updates to TI Process
#****
#***********************************************************************************************************************

#*** DECLARE VARIABLES ***#
dmID = 'id';
dmMeas = 'id measure';
dmClients = '}Clients';
dmVar = 'variables';


#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
curHLYear = ATTRS(dmVar,'headline year','value');
curScenario = ATTRS(dmVar, 'headline scenario', 'value');

sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;

sSubset = sUser | '_sys_id_list';


IF (psShowCBMS @= 'No' );
     sAllMDX = '{TM1SORT({{FILTER( {EXCEPT( {[id].[Total IDs].Children}, {[00000],[id].[cash flow]} )}, INSTR( [AE id details].([Headline Year].[' | psHLYear | '],[scenario].[' | psScenario | '],[id measure].[status]), "CBMS" ) =0) }}, DESC)}';
ELSE;
#     sAllMDX = '{TM1SORT({{FILTER( {EXCEPT( {[id].[Total IDs].Children}, {[00000],[id].[cash flow]} )}, INSTR( [AE id details].([Headline Year].[' | psHLYear | '],[scenario].[' | psScenario | '],[id measure].[status]), "CBMS" ) >=1) }}, DESC)}';
     sAllMDX = '{TM1SORT({ EXCEPT( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [ ' | dmID | '] )}, 0)}, { [' | dmID | '].[0000A], [' | dmID | '].[0000B], [' | dmID | '].[00FBO] }) }, DESC)}';
ENDIF;


#*** DESTROY SUBSET ***#
SUBSETDESTROY (dmID, sSubset);

#*** RECREATE SUBSET ***#

IF (psFilter @<> '');
     MDX = psMDX;
ELSE;
     MDX = sAllMDX;
ENDIF;

SUBSETCREATEBYMDX (sSubset, MDX);


nCheck = SUBSETEXISTS (dmID, sSubset);

IF (SUBSETEXISTS (dmID, sSubset) = 0); 
     SUBSETCREATEBYMDX (sSubset, sAllMDX);
ENDIF;



#endregion
