#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_AE_Archive_03 - AE Adj Cube Populate Target Scenario
#**** DESCRIPTION:       This process copies data in the adjustments cube from the CURRENT scenario into the target scenario, after clearing the target scenario
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 12/05/2014    KG             Initial Revision
#****
#***********************************************************************************************************************


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE CUBES & DIMENSIONS ***#
#---------------------------------------------------------------------------------------------------------------------------
snProg = 'programme';
cbAE = 'AE adjustments';
dmHLYear = 'headline year';
dmScenario = 'scenario';
dmStatus = 'status';
dmOC = 'outcome';
dmRE = 'related entity';
dmFunc = 'function';
dmReason = 'reason';
dmSPP = 'spp';
dmMeasCode = 'measure code';
dmType = 'appropriation type';
dmMA = 'movement account';
dmItem = 'appropriation item';
dmProg = snProg;
dmAcc = 'account';
dmID = 'id';
dmJur = 'jurisdiction';
dmPer = 'period';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE AE ID DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbID = 'AE id details';
dmIDMeas = 'id measure';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE PROGRAMME DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbProg = snProg | ' details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE INDEX CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbIndex = 'index';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE CASHFLOW CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbCF= 'AE cash flow';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GOVERNMENT MEASURE CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbMeas = 'government measures';
dmMeasDet = 'measure details';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GOVERNMENT MEASURE DETAILS CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbMeasDet = 'government measures details';

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE GROUP ADJUSTMENT ENTRY CUBE ***#
#---------------------------------------------------------------------------------------------------------------------------
cbGrp = 'AE group adjustment entry';


#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SYSTEM DIMENSIONS ***# 
#---------------------------------------------------------------------------------------------------------------------------
dmVar = 'variables';
dmClients = '}Clients';

#---------------------------------------------------------------------------------------------------------------------------
#*** GET CURRENT HEADLINE YEAR AND SCENARIO ****#
#---------------------------------------------------------------------------------------------------------------------------
#sHLYear = ATTRS(dmVar,'headline year','value');
#sScenario = ATTRS(dmVar, 'headline scenario', 'value');

sTargetHLYear = ATTRS(dmVar, 'archive year', 'value');
sTargetScenario = ATTRS(dmVar, 'archive scenario', 'value');



#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SUBSETS AND VIEWS ***#
#---------------------------------------------------------------------------------------------------------------------------
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
                sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
                IF (sUser @<> '');
                                lScan = SCAN('\',sUser) + 1;
                                IF(lScan=1);
                                                lScan = SCAN('/',sUser) + 1;
                                ENDIF;
                                sUser = TRIM(SUBST(sUser, lScan, 100));
                ELSE;
                                sUser = TM1User();
                ENDIF;
ELSE;
                sUser = TM1User();
ENDIF;

sView = '$ArchiveClear';
sSubset = sView;


#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbAE, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);

#****CREATE SUBSETS****#
# headline year
SubsetCreate(dmHLYear, sSubset);
SubsetElementInsert(dmHLYear, sSubset, psTargetHLYear, 1);

# Scenario
SubsetCreate(dmScenario, sSubset);
SubsetElementInsert(dmScenario, sSubset, psTargetScenario, 1);

#****BUILD VIEW****#
ViewCreate(cbAE, sView);

ViewSubsetAssign(cbAE, sView, dmHLYear, sSubset);
ViewSubsetAssign(cbAE, sView, dmScenario, sSubset);

ViewSetSkipZeroes(cbAE, sView, 1);
ViewSetSkipCalcs(cbAE, sView, 1);
ViewZeroOut(cbAE, sView);

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbAE, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);

#---------------------------------------------------------------------------------------------------------------------------
#*** DECLARE SOURCE VIEWS
#---------------------------------------------------------------------------------------------------------------------------
sView = '$Archive';
DATASOURCETYPE = 'VIEW';
DATASOURCECUBEVIEW = sView;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#*** PERFORM DATA ENTRY INTO TARGET HL YEAR AND SCENARIO ***#
IF (CELLISUPDATEABLE (cbAE, psTargetHLYear, psTargetScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeas, vsAppropType, vsMA, vsAppropItem, vsProg, vsAcc, vsID, vsJur, vsPeriod) = 1);
	CELLPUTN(Value, cbAE, psTargetHLYear, psTargetScenario, vsStatus, vsOC, vsRE, vsFunc, vsReason, vsSPP, vsMeas, vsAppropType, vsMA, vsAppropItem, vsProg, vsAcc, vsID, vsJur, vsPeriod);
ENDIF;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

cbAE = 'AE adjustments';
sView = '$Archive';
sSubset = sView;

#****DELETE EXISTING VIEWS AND SUBSETS
ViewDestroy(cbAE, sView);
SubsetDestroy(dmHLYear, sSubset);
SubsetDestroy(dmScenario, sSubset);
#endregion