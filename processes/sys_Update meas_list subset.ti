#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               sys_Update meas_list subset - Updates the subset used for id list spreadsheet
#**** DESCRIPTION:       This process will update the subset MDX used for the id listing spreadsheet
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 05/05/2014    KG             Initial Revision
#****
#***********************************************************************************************************************

#*** DECLARE VARIABLES ***#
dmID = 'measure code';
dmMeas = 'measure details';
dmClients = '}Clients';

sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;

sSubset = sUser | '_sys_meas_list';

#sSubset = 'sys_meas_list';
sAllMDX = '{FILTER( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [ ' | dmID | '] )}, 0)}, [ ' | dmID | ' ].[Non-Measure] = "")}';


#*** DESTROY SUBSET ***#
SUBSETDESTROY (dmID, sSubset);

#*** RECREATE SUBSET ***#

IF (psFilter @<> '');
     MDX = psMDX;
ELSE;
     MDX = sAllMDX;
ENDIF;

SUBSETCREATEBYMDX (sSubset, MDX);

nCheck = SUBSETEXISTS (dmID, sSubset);

IF (SUBSETEXISTS (dmID, sSubset) = 0); 
     SUBSETCREATEBYMDX (sSubset, sAllMDX);
ENDIF;




#endregion
