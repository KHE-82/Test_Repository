#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               AE_acc_programme to account mapping
#**** DESCRIPTION:       This process will map the selected account template to a programme
#****
#****                                  It takes parameters from the source worksheet:
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 28/05/2014    KG             Initial Revision
#***********************************************************************************************************************

#*** DECLARE CUBES & DIMENSIONS ***#
snProg = 'programme';
cbMap = 'AE account template mapping';
dmAccTemp = 'account template';
dmAccTempMeas = 'account template measure';
dmProg = snProg;
dmClients = '}Clients';

#*** DECLARE SUBSETS AND VIEWS ***#
sUser = TM1User();
IF (SUBST(sUser,1,3) @= 'CAM');
     sUser = ATTRS(dmClients, sUser, '}TM1_DefaultDisplayValue');
     lScan = SCAN('\',sUser) + 1;
     sUser = TRIM(SUBST(sUser, lScan, 100));
ELSE;
     sUser = TM1User();
ENDIF;

sObject  = '$MapView';
sAEView = '$MapView';

psProg = DIMENSIONELEMENTPRINCIPALNAME (dmProg, psProg);
psAccTemp = DIMENSIONELEMENTPRINCIPALNAME (dmAccTemp, psAccTemp);

#*****************************************************************************************************************************************************
#*** STEP 1 - CREATE SOURCE VIEW ***#

#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbMap, sAEView);
SUBSETDESTROY (dmAccTemp, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAccTempMeas, sAEView);


# Account Template
#SubsetCreate(dmAccTemp, sAEView);
#SubsetElementInsert(dmAccTemp, sAEView, psAccTemp, 1);

MDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [' | dmAccTemp | '] )}, 0)}';
SUBSETCREATEBYMDX (sAEView, MDX);


# Program
SubsetCreate(dmProg, sAEView);
SubsetElementInsert(dmProg, sAEView, psProg, 1);

# Account Template Measure
SubsetCreate(dmAccTempMeas, sAEView);
SubsetElementInsert(dmAccTempMeas, sAEView, 'flag', 1);

#*** BUILD VIEW ***#
VIEWCREATE (cbMap, sAEView);
VIEWSUBSETASSIGN (cbMap, sAEView, dmAccTemp, sAEView);
VIEWSUBSETASSIGN (cbMap, sAEView, dmProg, sAEView);
VIEWSUBSETASSIGN (cbMap, sAEView, dmAccTempMeas, sAEView);

#*** CLEAR VIEW ONLY DURING THE FIRST INSTANCE ***#
IF (psCheck @= 'Y');
     VIEWZEROOUT (cbMap, sAEView);
ENDIF;


#*** DELETE EXISTING VIEWS AND SUBSETS ***#
VIEWDESTROY (cbMap, sAEView);
SUBSETDESTROY (dmAccTemp, sAEView);
SUBSETDESTROY (dmProg, sAEView);
SUBSETDESTROY (dmAccTempMeas, sAEView);


#*** IF AN ACCOUNT TEMPLATE IS SELECTED ***#
IF (psAccTemp @<> '');

#*****************************************************************************************************************************************************
#*** STEP 2 - POPULATE CUBE WITH UPDATED DATA ***#

     CELLPUTN (1, cbMap, psAccTemp, psProg, 'flag');

ENDIF;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

