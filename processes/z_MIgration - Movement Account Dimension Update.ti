#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#*********************************************************************************************************************
#**** PROCESS:               z_MIgration - Movement Account Dimension Update
#**** DESCRIPTION:       This process will create new attributes and update those attributes
#****
#****                                 
#****
#**** MODIFICATION HISTORY:
#****
#****  Date               Initials        Comments
#****  ====              ======      =========
#**** 01/08/2017    KG             Initial Revision
#***********************************************************************************************************************

#---------------------------------------------------------------------------------------------
#-- Declare dimension and cube
#---------------------------------------------------------------------------------------------
dmDim = 'movement account';
dmRE = 'related entity';
dmDimMeas =  '}ElementAttributes_' | dmDim;
cbAttr = '}ElementAttributes_' | dmDim;


#---------------------------------------------------------------------------------------------
#--- Declare attributes
#---------------------------------------------------------------------------------------------
sAttr1 = 'cbms1 old description';
sAttr2 = 'cbms1 old code and description';
sAttr3 = 'cbms1 old cash flow map';
sAttr4 = 'cbms1 old assumed related entity';
sAttr5 = 'appropriation type required';

sAttr1 = 'legacy description';
sAttr2 = 'legacy code and description';
sAttr3 = 'legacy cash flow map';
sAttr4 = 'legacy assumed related entity';
sAttr5 = 'appropriation type required';
sAttr6 = 'legacy related entity enabled';



#---------------------------------------------------------------------------------------------
#--- Create attributes
#---------------------------------------------------------------------------------------------
ATTRINSERT (dmDim, '', sAttr1, 'S');
ATTRINSERT (dmDim, '', sAttr2, 'S');
ATTRINSERT (dmDim, '', sAttr3, 'S');
ATTRINSERT (dmDim, '', sAttr4, 'S');
ATTRINSERT (dmDim, '', sAttr5, 'S');
#ATTRINSERT (dmDim, '', sAttr6, 'S');

#---------------------------------------------------------------------------------------------
#-- STEP 01 : DELETE EXISTING ATTRIBUTES
#---------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------
#-- DESTROY EXISTING VIEW
#---------------------------------------------------------------------------------------------
sView = '$ClearAttr';
VIEWDESTROY (cbAttr, sView);
SUBSETDESTROY (dmDim, sView);
SUBSETDESTROY (dmDImMeas, sView);

#---------------------------------------------------------------------------------------------
#-- CREATE SUBSETS
#---------------------------------------------------------------------------------------------

# Dimension
MDX = '{TM1SUBSETALL( [' | dmDim | '] )}';
SUBSETCREATEBYMDX  (sView, MDX);

# Dimension Measure
SUBSETCREATE (dmDimMeas, sView);
SUBSETELEMENTINSERT (dmDimMeas, sView, 'description', 1);
SUBSETELEMENTINSERT (dmDimMeas, sView,'code and description', 2);
SUBSETELEMENTINSERT (dmDimMeas, sView, 'assumed related entity', 3);
SUBSETELEMENTINSERT (dmDimMeas, sView, 'related entity enabled', 4);
SUBSETELEMENTINSERT (dmDimMeas, sView, 'cash flow map', 5);
SUBSETELEMENTINSERT (dmDimMeas, sView, 'flat file', 6);
SUBSETELEMENTINSERT (dmDimMeas, sView, 'editable', 7);
SUBSETELEMENTINSERT (dmDimMeas, sView, 'DR/CR', 8);


#---------------------------------------------------------------------------------------------
#-- CREATE VIEWS
#---------------------------------------------------------------------------------------------
VIEWCREATE (cbAttr, sView);
VIEWSUBSETASSIGN (cbAttr, sView, dmDim, sView);
VIEWSUBSETASSIGN (cbAttr, sView, dmDimMeas, sView);

VIEWZEROOUT (cbAttr, sView);

#---------------------------------------------------------------------------------------------
#-- DESTROY EXISTING VIEW
#---------------------------------------------------------------------------------------------
VIEWDESTROY (cbAttr, sView);
SUBSETDESTROY (dmDim, sView);
SUBSETDESTROY (dmDImMeas, sView);


#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#sAttr1 = 'cbms1 old description';
#sAttr2 = 'cbms1 old code and description';
#sAttr3 = 'cbms1 old cash flow map';
#sAttr4 = 'cbms1 old assumed related entity';
#sAttr5 = 'appropriation type required';

sAttr1 = 'legacy description';
sAttr2 = 'legacy code and description';
sAttr3 = 'legacy cash flow map';
sAttr4 = 'legacy assumed related entity';
sAttr5 = 'appropriation type required';
sAttr6 = 'legacy related entity enabled';


#---------------------------------------------------------------------------------------------
#--- REINSTATE ATTRIBUTES
#---------------------------------------------------------------------------------------------
CELLPUTS (vsCodeandDesc, cbAttr, vsMA, 'code and description');


IF (DIMIX (dmDim, vsDesc) = 0);
	CELLPUTS (vsDesc, cbAttr, vsMA, 'description');
ELSE;
	#------------------------------------------------------------------------
	#--- CHECK IF DESCRIPTION HAS BEEN USED
	#------------------------------------------------------------------------	
	sCheckAcc = DIMENSIONELEMENTPRINCIPALNAME (dmDim, vsDesc);
	IF (sCheckAcc @= vsMA);
		CELLPUTS (vsDesc, cbAttr, vsMA, 'description');
	ELSE;
		sNewDesc = vsDesc | ' (' | vsMA | ')';
		CELLPUTS (sNewDesc, cbAttr, vsMA, 'description');
	ENDIF;

ENDIF;

CELLPUTS (vsRERequired, cbAttr, vsMA, 'related entity enabled');
CELLPUTS (vsCFMap, cbAttr, vsMA, 'cash flow map');
CELLPUTS (vsEditable, cbAttr, vsMA, 'editable');
CELLPUTS (vsDRCR, cbAttr, vsMA, 'DR/CR');
CELLPUTS (vsFF, cbAttr, vsMA, 'flat file');

IF (vsAssumedRE @= 'NONE');
	vsAssumedRE = '';
ELSE;
	IF (DIMIX (dmRE, vsAssumedRE) <> 0);
		vsAssumedRE = DIMENSIONELEMENTPRINCIPALNAME (dmRE, vsAssumedRE);
	ELSE;
		vsAssumedRE = vsAssumedRE;
	ENDIF;
ENDIF;
CELLPUTS (vsAssumedRE, cbAttr, vsMA, 'assumed related entity');

#---------------------------------------------------------------------------------------------
#--- POST NEW CBMS-R ATTRIBUTES
#---------------------------------------------------------------------------------------------
CELLPUTS (vsCBMS1Desc, cbAttr, vsMA, sAttr1);
CELLPUTS (vsCBMS1CodeandDesc, cbAttr, vsMA, sAttr2);
CELLPUTS (vsCBMS1FFMap, cbAttr, vsMA, sAttr3);
CELLPUTS (vsCBMS1AssumedRE, cbAttr, vsMA, sAttr4);
CELLPUTS (vsAppropReq, cbAttr, vsMA, sAttr5);

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion