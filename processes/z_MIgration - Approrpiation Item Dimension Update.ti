#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#--------------------------------------------------------------------------------------------------------------
#---- UPDATE MAPPING ATTRIBUTES
#--------------------------------------------------------------------------------------------------------------


IF (DIMIX (dmDim, vsCBMS1Item) <> 0);
	IF (CELLISUPDATEABLE (cbAttr, vsCBMS1Item, sAttr1) = 1);
		CELLPUTS ('A' | vsAppropType,  cbAttr, vsCBMS1Item, sAttr1);
	ENDIF;

	IF (CELLISUPDATEABLE ( cbAttr, vsCBMS1Item, sAttr2) = 1);
		CELLPUTS (vsAppropItem,  cbAttr, vsCBMS1Item, sAttr2);
	ENDIF;
ENDIF;


#---------------------------------------------------------------------------------------------
#--- APPROP TYPE DESC
#---------------------------------------------------------------------------------------------
sAppropType = vsAppropType;
IF (DIMIX (dmDIm, sAppropType) <> 0);

	IF (DIMIX (dmDim, vsAppropTypeName) = 0);
		IF (CELLISUPDATEABLE( cbAttr, sAppropType, sAttr3) = 1);
			CELLPUTS (vsAppropTypeName, cbAttr, sAppropType, sAttr3);
		ENDIF;

		IF (CELLISUPDATEABLE( cbAttr, sAppropType, sAttr4) = 1);
			CELLPUTS (sAppropType | ' - ' | vsAppropTypeName, cbAttr, sAppropType, sAttr4);
		ENDIF;
	ELSE;
		sCheckAppropType = DIMENSIONELEMENTPRINCIPALNAME (dmDim, vsAppropTypeName);
		IF (sCheckAppropType @= sAppropType);
			IF (CELLISUPDATEABLE( cbAttr, sAppropType, sAttr3) = 1);
				CELLPUTS (vsAppropTypeName, cbAttr, sAppropType, sAttr3);
			ENDIF;
		ELSE;
			CELLPUTS (sAppropType | ' - ' | vsAppropTypeName, cbAttr, sAppropType, sAttr3);
		ENDIF;
	ENDIF;




ENDIF;


#---------------------------------------------------------------------------------------------
#--- REP GROUP DESC
#---------------------------------------------------------------------------------------------
sRepGroup = vsRepGroup;
IF (DIMIX (dmDIm, sRepGroup) <> 0);

	IF (DIMIX (dmDim, vsRepGroupName) = 0);
		IF (CELLISUPDATEABLE( cbAttr, sRepGroup, sAttr3) = 1);
			CELLPUTS (vsRepGroupName, cbAttr, sRepGroup, sAttr3);
			#ATTRPUTS (vsRepGroupName, dmDim, sRepGroup, sAttr3);
		ENDIF;

		IF (CELLISUPDATEABLE( cbAttr, sRepGroup, sAttr4) = 1);
			CELLPUTS (sRepGroup | ' - ' | vsRepGroupName, cbAttr, sRepGroup, sAttr4);
		ENDIF;

	ELSE;
		sCheckRepGroup = DIMENSIONELEMENTPRINCIPALNAME (dmDim, vsRepGroupName);
		IF (sCheckRepGroup @= sRepGroup);
			IF (CELLISUPDATEABLE( cbAttr, sRepGroup, sAttr3) = 1);
				CELLPUTS (vsRepGroupName, cbAttr, sRepGroup, sAttr3);
				#ATTRPUTS (vsRepGroupName, dmDim, sRepGroup, sAttr3);
			ENDIF;
		ELSE;
			CELLPUTS (sRepGroup | ' - ' | vsRepGroupName, cbAttr, sRepGroup, sAttr3);
		ENDIF;
	ENDIF;
ENDIF;


#---------------------------------------------------------------------------------------------
#--- APPROP ITEM DESC
#---------------------------------------------------------------------------------------------
IF (DIMIX (dmDIm, vsAppropItem) <> 0);

	IF (DIMIX (dmDim, vsFALongText) = 0);
		IF (CELLISUPDATEABLE( cbAttr, vsAppropItem, sAttr3) = 1);
			CELLPUTS (vsFALongText, cbAttr, vsAppropItem, sAttr3);
		ENDIF;

		IF (CELLISUPDATEABLE( cbAttr, vsAppropItem, sAttr4) = 1);
			CELLPUTS (vsAppropItem | ' - ' | vsFALongText, cbAttr, vsAppropItem, sAttr4);
		ENDIF;
	ELSE;

		sCheckAppropItem = DIMENSIONELEMENTPRINCIPALNAME (dmDim, vsFALongText);
		IF (sCheckAppropItem @= vsAppropItem);
			IF (CELLISUPDATEABLE( cbAttr, vsAppropItem, sAttr3) = 1);
				CELLPUTS (vsFALongText, cbAttr, vsAppropItem, sAttr3);
			ENDIF;
		ELSE;
			CELLPUTS (vsAppropItem | ' - ' | vsFALongText, cbAttr, vsAppropItem, sAttr3);
			CELLPUTS (vsAppropItem | ' - ' | vsFALongText, cbAttr, vsAppropItem, sAttr4);
		ENDIF;
		asciioutput('aaa.txt', vsAppropItem, vsFALongText);
	ENDIF;

ENDIF;

#---------------------------------------------------------------------------------------------
#--- APPROP ITEM DESC - OLD CBMS CODES
#---------------------------------------------------------------------------------------------
IF (DIMIX (dmDim, vsCBMS1Item) <> 0);
	IF (DIMIX (dmDim, vsCBMS1Desc) = 0);
		IF (CELLISUPDATEABLE( cbAttr, vsCBMS1Item, sAttr3) = 1);
			CELLPUTS (vsCBMS1Desc, cbAttr, vsCBMS1Item, sAttr3);
		ENDIF;

		IF (CELLISUPDATEABLE( cbAttr, vsCBMS1Item, sAttr4) = 1);
			CELLPUTS (vsCBMS1Item | ' - ' | vsCBMS1Desc, cbAttr, vsCBMS1Item, sAttr4);
		ENDIF;


	ELSE;

		IF (CELLISUPDATEABLE( cbAttr, vsCBMS1Item, sAttr3) = 1);
			CELLPUTS (vsCBMS1Item | ' - ' | vsCBMS1Desc, cbAttr, vsCBMS1Item, sAttr3);
		ENDIF;
		IF (CELLISUPDATEABLE( cbAttr, vsCBMS1Item, sAttr4) = 1);
			CELLPUTS (vsCBMS1Item | ' - ' | vsCBMS1Desc, cbAttr, vsCBMS1Item, sAttr4);
		ENDIF;

	ENDIF;
	



ENDIF;

