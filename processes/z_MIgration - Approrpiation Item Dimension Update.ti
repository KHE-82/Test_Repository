sParent = '002';
IF (DIMIX(dmDim, sParent) <> 0);
	sSubset = 'sys_A' | sParent;
	SUBSETDESTROY (dmDim, sSubset);
	MDX = '{TM1SORT( {TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | dmDim | '].[' | sParent | ']}, ALL, RECURSIVE )}, 0)}, ASC)}';
	SUBSETCREATEBYMDX (sSubset, MDX);
	SUBSETALIASSET (dmDim, sSubset, 'code and description');
ENDIF;


