#ENDIF;
	CellPutN(OldP00 + NP00, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period00);
     	CellPutN(OldP01 + NP01, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period01);
     	CellPutN(OldP02 + NP02, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period02);
     	CellPutN(OldP03 + NP03, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period03);
     	CellPutN(OldP04 + NP04, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period04);
     	CellPutN(OldP05 + NP05, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period05);
     	CellPutN(OldP06 + NP06, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period06);
     	CellPutN(OldP07 + NP07, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period07);
     	CellPutN(OldP08 + NP08, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period08);
     	CellPutN(OldP09 + NP09, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period09);
     	CellPutN(OldP10 + NP10, sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period10);
