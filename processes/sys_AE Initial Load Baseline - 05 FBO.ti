OldP04 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period04);
OldP05 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period05);
OldP06 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period06);
OldP07 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period07);
OldP08 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period08);
OldP09 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period09);
OldP10 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period10);
OldP11 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period11);
OldP12 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period12);
OldP13 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period13);
OldP14 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period14);
OldP15 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period15);
#OldP16 = CellGetN(sCube, psHLYear,psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period16);

#---------------------------------------------------------------
# Convert signage on flat file value
#---------------------------------------------------------------
IF (vsMA @= '-');
	X = ATTRS(dmAcc, vsAcc, 'DR/CR');
ELSE;
	X = ATTRS(dmMA, vsMA, 'DR/CR');
ENDIF;

IF (X @= 'CR');
	iConversion = -1;
ELSE;
	iConversion = 1;
ENDIF;

NP00 = P00 * iConversion;
NP01 = P01 * iConversion;
NP02 = P02 * iConversion;
NP03 = P03 * iConversion;
NP04 = P04 * iConversion;
NP05 = P05 * iConversion;
NP06 = P06 * iConversion;
NP07 = P07 * iConversion;
NP08 = P08 * iConversion;
NP09 = P09 * iConversion;
NP10 = P10 * iConversion;
NP11 = P11 * iConversion;
NP12 = P12 * iConversion;
NP13 = P13 * iConversion;
NP14 = P14 * iConversion;
NP15 = P15 * iConversion;
#NP16 = P16 * iConversion;

asciioutput('data2.csv',numbertostring(OldP00),numbertostring(NP00),numbertostring(P00),sCube, psHLYear, psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period00);
#asciioutput('error.csv',sCube, psHLYear, psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period01);
IF (CellisUpdateable(sCube, psHLYear, psScenario, sStatus, vsOC, vsRE, vsFunc, sReason, vsSPP, vsMeasCode, vsType, vsMA, vsItem, vsProg, vsAcc, psID, vsJur, Period01) = 1);
#IF( vsProg @='40056');
